","Cider Vinegar"],["30 g","Tomato Puree"],["20 g","Chipotle Paste"],["10 g","Vegetable Stock Paste"],["6","Plain Taco Tortillas"],["50 g","Baby Leaf Mix"],["75 g","Soured Cream"],["90 g","Diced Chorizo"],["1 tsp","Sugar for the Dressing"],["1 tbsp","Olive Oil for the Dressing"],["1 tsp","Sugar"],["150 ml","Water"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["450 g","Potatoes"],["1","Bell Pepper"],["1 carton","Black Beans"],["100 g","Mature Cheddar Cheese"],["15 ml","Cider Vinegar"],["30 g","Tomato Puree"],["20 g","Chipotle Paste"],["10 g","Vegetable Stock Paste"],["6","Plain Taco Tortillas"],["50 g","Baby Leaf Mix"],["75 g","Soured Cream"],["90 g","Diced Chorizo"],["1 tsp","Sugar for the Dressing"],["1 tbsp","Olive Oil for the Dressing"],["1 tsp","Sugar"],["150 ml","Water"]],"ingredientMeta":[{"id":"5a39929ec9fd0814815939c2","name":"Potatoes","type":"potatoes","family":"potato","amount":"450 g","sourceAmount":450,"sourceUnit":"grams","shipped":true,"shoppingName":"Potatoes","marketLabel":"potatoes 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632cf717b4f4bc890195c7d3","name":"Bell Pepper","type":"bell-pepper","family":"pepper","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Bell Pepper","marketLabel":"peppers pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5720c9df4dab71f02a8b4568","name":"Black Beans","type":"black beans","family":"beans","amount":"1 carton","sourceAmount":1,"sourceUnit":"carton(s)","shipped":true,"shoppingName":"Black Beans","marketLabel":"black beans tin","marketChecked":true,"priceMatchType":"source-identity"},{"id":"69146769623e0c85b6821082","name":"Mature Cheddar Cheese","type":"cheddar-cheese","family":"hard cheese","amount":"100 g","sourceAmount":100,"sourceUnit":"grams","shipped":true,"shoppingName":"Mature Cheddar Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55b8eb44ae9270ec308b4567","name":"Cider Vinegar","type":"cider vinegar","family":"vinegar","amount":"15 ml","sourceAmount":15,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Cider Vinegar","marketLabel":"cider vinegar 350ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a708af8b25ef93e8b4567","name":"Tomato Puree","type":"tomato-puree","family":"single ingredient paste","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Tomato Puree","marketLabel":"tomato puree 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a70affd2cb95a598b456f","name":"Chipotle Paste","type":"chipotle paste","family":"Chili sauce","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Chipotle Paste","marketLabel":"cooking paste equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"641093570565a60137055ba9","name":"Vegetable Stock Paste","type":"vegetable-stock-paste","family":"stock concentrate","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":true,"shoppingName":"Vegetable Stock Paste","marketLabel":"vegetable stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"683727bfd9848b9dac04fe03","name":"Plain Taco Tortillas","type":"plain-taco-tortilla","family":"none","amount":"6","sourceAmount":6,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Plain Taco Tortillas","marketLabel":"wraps or tortillas x8","marketChecked":true,"priceMatchType":"source-identity"},{"id":"56b23e4ef8b25e4c2d8b4567","name":"Baby Leaf Mix","type":"premium baby leaf mix","family":"salad mix","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Leaf Mix","marketLabel":"lettuce or salad leaves","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68382535f7d5496ac4a6a740","name":"Soured Cream","type":"soured-cream","family":"soured cream","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Soured Cream","marketLabel":"soured cream 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"66ab6339f66002bbd100b304","name":"Diced Chorizo","type":"chorizo-diced","family":"none","amount":"90 g","sourceAmount":90,"sourceUnit":"grams","shipped":true,"shoppingName":"Diced Chorizo","marketLabel":"prepared pork product equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb425688281450b8bd079","name":"Sugar for the Dressing","type":"sugar-for-the-dressing-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Dressing","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb168688281450b8bd062","name":"Olive Oil for the Dressing","type":"olive-oil-for-the-dressing-1-tbsp","family":"oil","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Olive Oil for the Dressing","marketLabel":"cooking oil 1 litre","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555093924dab71e7118b4568","name":"Sugar","type":"sugar-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"57484fa04dab7170318b4567","name":"Water","type":"water-100ml","family":"other drink","amount":"150 ml","sourceAmount":150,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 240°C/220°C fan/gas mark 9. Chop the white potatoes lengthways into 1cm slices, then chop into 1cm wide chips (no need to peel). Pop the chips onto a large baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Spread out in a single layer. Use two baking trays if necessary. When the oven is hot, bake on the middle shelf until golden, 25-35 mins. Turn halfway through.","Halve the pepper and discard the core and seeds. Slice into thin strips. Pop the pepper onto a baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. When the oven is hot, roast on the top shelf until soft and slightly charred, 10-12 mins.","Meanwhile, drain and rinse the black beans in a sieve, then pop half of them into a bowl and roughly mash with the back of a fork. Grate the cheese. In a medium bowl, combine the cider vinegar, sugar and oil for the dressing (use the quantities listed in the ingredients). Season with salt and pepper. Set aside for now.","Heat a drizzle of oil in a large frying pan on medium heat. Once hot, stir in the tomato puree and chorizo. Cook for 3-4 mins. Stir in the black beans (whole and mashed), chipotle paste (add less if you'd prefer things milder), veg stock paste, sugar and water (use the quantities listed in the ingredients). Season with salt and pepper. Simmer, stirring occasionally, until all the liquid has evaporated, 8-10 mins.","Once cooked, stir the roasted bell pepper through the bean mixture. Lay the tortillas onto a lightly oiled baking tray and spoon the bean mixture onto one half of each one. Sprinkle over cheese. Fold the other side over to make a semi-circle. Press down to keep together. Rub a little oil over the top of each one, then bake on the top shelf until golden, 6-8 mins. Just before everything's ready, add the baby leaves to the dressing and toss together.","Once golden, transfer the quesadillas to your plates. Serve the salad and chips alongside. Drizzle over the soured cream to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/694bee621676be04156e69bc/step-32bb3e00.jpg","caption":"Chip, Chip, Hooray"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/694bee621676be04156e69bc/step-05056110.jpg","caption":"Char the Pepper"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/694bee621676be04156e69bc/step-eafff820.jpg","caption":"Finish the Prep"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/694bee621676be04156e69bc/step-d6a8ad30.jpg","caption":"Flavour Town"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/694bee621676be04156e69bc/step-cfd93840.jpg","caption":"Bake the Quesadillas"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/694bee621676be04156e69bc/step-a12aa950.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/cheesy-beany-chipotle-and-chorizo-quesadillas-694bee621676be04156e69bc","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/cheesy-beany-chipotle-and-chorizo-quesadillas-694bee621676be04156e69bc","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"wrap","shoppingIngredients":[["450 g","Potatoes"],["1","Bell Pepper"],["1 carton","Black Beans"],["100 g","Mature Cheddar Cheese"],["15 ml","Cider Vinegar"],["30 g","Tomato Puree"],["20 g","Chipotle Paste"],["10 g","Vegetable Stock Paste"],["6","Plain Taco Tortillas"],["50 g","Baby Leaf Mix"],["75 g","Soured Cream"],["90 g","Diced Chorizo"],["1 tsp","Sugar for the Dressing"],["1 tbsp","Olive Oil for the Dressing"],["1 tsp","Sugar"],["150 ml","Water"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-6927209a01ae5540a928503b","sourceId":"6927209a01ae5540a928503b","title":"Chorizo and Chicken Sun-Dried Tomato Orzo","subtitle":"with Courgette, Pesto, Cheese and Lemon","time":30,"cost":24.29,"servings":2,"scaleSafe":true,"tags":["mediterranean","pasta-noodles","new","winter-warmers","high protein","italian","pork","pasta","quick"],"requiredEquipment":[],"sourceEquipment":["Sieve","Large Saucepan","Bowl","Zester","Pan","Garlic Press"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R16_W05_UK_F25281-3_Main_F25281-AP-1-3_var_high-761c2834.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/chorizo-and-chicken-sun-dried-tomato-orzo-6927209a01ae5540a928503b","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["180 g","Orzo"],["1","Courgette"],["2","Garlic Clove"],["1","Lemon"],["90 g","Diced Chorizo"],["1 carton","Tomato Passata"],["10 g","Chicken Stock Paste"],["40 g","Baby Spinach"],["25 g","Sun-Dried Tomato Paste"],["20 g","Grated Hard Italian Style Cheese"],["30 g","Basil Pesto with Cashew Nuts"],["240 g","Diced British Chicken Breast"],["1 tbsp","Honey"],["100 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["180 g","Orzo"],["1","Courgette"],["2","Garlic Clove"],["1","Lemon"],["90 g","Diced Chorizo"],["1 carton","Tomato Passata"],["10 g","Chicken Stock Paste"],["40 g","Baby Spinach"],["25 g","Sun-Dried Tomato Paste"],["20 g","Grated Hard Italian Style Cheese"],["30 g","Basil Pesto with Cashew Nuts"],["240 g","Diced British Chicken Breast"],["1 tbsp","Honey"],["100 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"6837308242dc4b928197f3bc","name":"Orzo","type":"orzo","family":"other noodle","amount":"180 g","sourceAmount":180,"sourceUnit":"grams","shipped":true,"shoppingName":"Orzo","marketLabel":"pasta 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a727dfd2cb959598b4574","name":"Courgette","type":"courgette","family":"zucchini","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Courgette","marketLabel":"courgettes pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a72ebfd2cb95a598b4570","name":"Lemon","type":"lemon","family":"lemon","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lemon","marketLabel":"lemons x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"66ab6339f66002bbd100b304","name":"Diced Chorizo","type":"chorizo-diced","family":"none","amount":"90 g","sourceAmount":90,"sourceUnit":"grams","shipped":true,"shoppingName":"Diced Chorizo","marketLabel":"prepared pork product equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55672166f8b25e412f8b4567","name":"Tomato Passata","type":"tomato passata","family":"single ingredient paste","amount":"1 carton","sourceAmount":1,"sourceUnit":"carton(s)","shipped":true,"shoppingName":"Tomato Passata","marketLabel":"passata 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60002d898c8c0a188200a96d","name":"Chicken Stock Paste","type":"chicken-stock-paste","family":"stock concentrate","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":true,"shoppingName":"Chicken Stock Paste","marketLabel":"chicken stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555c9dd5fd2cb92f6c8b4569","name":"Baby Spinach","type":"baby spinach","family":"spinach","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Spinach","marketLabel":"spinach 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5f327c6560efd3453038c2a8","name":"Sun-Dried Tomato Paste","type":"sundried-tomato-paste-duplicate","family":"single ingredient paste","amount":"25 g","sourceAmount":25,"sourceUnit":"grams","shipped":true,"shoppingName":"Sun-Dried Tomato Paste","marketLabel":"sun-dried tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5550865efd2cb974658b4568","name":"Grated Hard Italian Style Cheese","type":"grated-hard-italian-style-cheese-duplicate","family":"hard cheese","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Grated Hard Italian Style Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68c412723cfb117858763a9f","name":"Basil Pesto with Cashew Nuts","type":"basil-pesto-sauce","family":"none","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Basil Pesto with Cashew Nuts","marketLabel":"nuts and seeds equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6390aea605fc26d5313f23d2","name":"Diced British Chicken Breast","type":"chicken-breast-diced","family":"none","amount":"240 g","sourceAmount":240,"sourceUnit":"grams","shipped":true,"shoppingName":"Diced British Chicken Breast","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6172cb313021d49a7feafc84","name":"Honey","type":"honey-1-tbsp","family":"honey","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"100 ml","sourceAmount":100,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Bring a large saucepan of water to the boil with ½ tsp salt for the orzo. When boiling, add the orzo to the water and bring back to the boil. Cook until tender, 10 mins. Once cooked, drain in a sieve and pop back in the pan. Drizzle with oil and stir through to stop it sticking together.","Meanwhile, trim the courgette and slice into 1cm thick rounds. Peel and grate the garlic (or use a garlic press). Zest and cut the lemon into wedges. Heat a drizzle of oil in a large frying pan on high heat. When hot, add the courgette and cook until charred, 3-4 mins each side. Once cooked, season with salt and pepper, then transfer the courgette to a bowl. Squeeze over half of the lemon juice and turn to coat. Set aside.","Heat a drizzle of oil in the (now empty) frying pan on medium-high heat. Once hot, add the chicken to the pan and season with salt and pepper. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Cook until browned all over, 5-6 mins. Wash your hands and equipment after handling raw chicken. Next, add the chorizo. Fry until the chorizo starts to brown, 3-4 mins. Add the garlic and stir-fry until fragrant, 30 secs.","Once fragrant, add the passata, chicken stock paste, honey and water for the sauce (use the quantities listed in the ingredients) to the frying pan. Stir well to combine. Bring to the boil, then simmer until the sauce has slightly thickened, 3-4 mins. The chicken is cooked when no longer pink in the middle.","Add the spinach to the pan a handful at a time until wilted and piping hot, 1-2 mins. Stir the cooked orzo into the sauce. Add the sun-dried tomato paste and cheese and stir to combine. Add a splash of water if needed. Add the charred courgette to the sauce and carefully stir into the orzo. Squeeze in some lemon juice. Taste and season with salt and pepper or more lemon juice if needed.","Divide the orzo between bowls. Drizzle over the pesto. Sprinkle over the lemon zest and serve with any remaining lemon wedges for squeezing over to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6927209a01ae5540a928503b/step-8126cb00.jpg","caption":"Start the Orzo"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6927209a01ae5540a928503b/step-4b325010.jpg","caption":"Prep the Veg"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6927209a01ae5540a928503b/step-9103f920.jpg","caption":"Sizzle the Chicken"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6927209a01ae5540a928503b/step-a2730230.jpg","caption":"Build the Sauce"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6927209a01ae5540a928503b/step-fc238040.jpg","caption":"Finishing Touches"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6927209a01ae5540a928503b/step-9339e950.jpg","caption":"Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/chorizo-and-chicken-sun-dried-tomato-orzo-6927209a01ae5540a928503b","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/chorizo-and-chicken-sun-dried-tomato-orzo-6927209a01ae5540a928503b","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"pasta","shoppingIngredients":[["180 g","Orzo"],["1","Courgette"],["2","Garlic Clove"],["1","Lemon"],["90 g","Diced Chorizo"],["1 carton","Tomato Passata"],["10 g","Chicken Stock Paste"],["40 g","Baby Spinach"],["25 g","Sun-Dried Tomato Paste"],["20 g","Grated Hard Italian Style Cheese"],["30 g","Basil Pesto with Cashew Nuts"],["240 g","Diced British Chicken Breast"],["1 tbsp","Honey"],["100 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-691df1ce71644dd339c42fee","sourceId":"691df1ce71644dd339c42fee","title":"Smoky Chorizo, Refried Beans and Sweet Potato Tacos","subtitle":"with Baby Gem, Slaw and Cheese","time":25,"cost":23.74,"servings":2,"scaleSafe":true,"tags":["medium spice","quick","latin-american-faves","handhelds","mexican","pork","wrap"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Pan","Garlic Press","Potato Masher","Bowl","Grater"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R42_W46_UK_QV14279-9_Main_Add_diced_chorizo_in_the_tacos_edit_high-9d5feefb.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/smoky-chorizo-refried-beans-and-sweet-potato-tacos-691df1ce71644dd339c42fee","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["2","Sweet Potato"],["1 sachet","Smoked Paprika"],["2","Garlic Clove"],["1","Onion"],["90 g","Diced Chorizo"],["20 g","Chipotle Paste"],["10 g","Vegetable Stock Paste"],["1 carton","Mixed Beans"],["1","Baby Gem Lettuce"],["120 g","Sliced Carrot and Cabbage Mix"],["40 g","Mature Cheddar Cheese"],["6","Plain Taco Tortillas"],["1 tbsp","Honey"],["2 tbsp","Mayonnaise"],["20 g","Butter"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"],["30 ml","water"]],"sourceIngredients":[["2","Sweet Potato"],["1 sachet","Smoked Paprika"],["2","Garlic Clove"],["1","Onion"],["90 g","Diced Chorizo"],["20 g","Chipotle Paste"],["10 g","Vegetable Stock Paste"],["1 carton","Mixed Beans"],["1","Baby Gem Lettuce"],["120 g","Sliced Carrot and Cabbage Mix"],["40 g","Mature Cheddar Cheese"],["6","Plain Taco Tortillas"],["1 tbsp","Honey"],["2 tbsp","Mayonnaise"],["20 g","Butter"]],"ingredientMeta":[{"id":"555082a2f8b25e56468b4568","name":"Sweet Potato","type":"sweet potato","family":"potato","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Sweet Potato","marketLabel":"sweet potatoes 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6390aea6da082ea161fce4e2","name":"Smoked Paprika","type":"smoked-paprika","family":"none","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Smoked Paprika","marketLabel":"paprika jar","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a59324dab71626c8b4575","name":"Onion","type":"onion","family":"onion","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Onion","marketLabel":"brown onions 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"66ab6339f66002bbd100b304","name":"Diced Chorizo","type":"chorizo-diced","family":"none","amount":"90 g","sourceAmount":90,"sourceUnit":"grams","shipped":true,"shoppingName":"Diced Chorizo","marketLabel":"prepared pork product equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a70affd2cb95a598b456f","name":"Chipotle Paste","type":"chipotle paste","family":"Chili sauce","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Chipotle Paste","marketLabel":"cooking paste equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"641093570565a60137055ba9","name":"Vegetable Stock Paste","type":"vegetable-stock-paste","family":"stock concentrate","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":true,"shoppingName":"Vegetable Stock Paste","marketLabel":"vegetable stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a7056fd2cb959598b4573","name":"Mixed Beans","type":"organic mixed beans","family":"beans","amount":"1 carton","sourceAmount":1,"sourceUnit":"carton(s)","shipped":true,"shoppingName":"Mixed Beans","marketLabel":"beans equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68ecc674fa624b85e8848c26","name":"Baby Gem Lettuce","type":"baby gem lettuce","family":"salad mix","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Baby Gem Lettuce","marketLabel":"lettuce or salad leaves","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5be4237630006c222055d042","name":"Sliced Carrot and Cabbage Mix","type":"coleslaw-mix","family":"salad mix","amount":"120 g","sourceAmount":120,"sourceUnit":"grams","shipped":true,"shoppingName":"Sliced Carrot and Cabbage Mix","marketLabel":"carrots 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5550e3084dab71a81c8b4569","name":"Mature Cheddar Cheese","type":"cheddar-cheese","family":"hard cheese","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Mature Cheddar Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"683727bfd9848b9dac04fe03","name":"Plain Taco Tortillas","type":"plain-taco-tortilla","family":"none","amount":"6","sourceAmount":6,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Plain Taco Tortillas","marketLabel":"wraps or tortillas x8","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6172cb313021d49a7feafc84","name":"Honey","type":"honey-1-tbsp","family":"honey","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbe487e8afb1b135f069bd2","name":"Mayonnaise","type":"mayonnaise-tbsp","family":"mayonnaise","amount":"2 tbsp","sourceAmount":2,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Mayonnaise","marketLabel":"mayonnaise 500ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60c73507053f5e815cd52d5b","name":"Butter","type":"butter-100g","family":"butter","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":false,"shoppingName":"Butter","marketLabel":"butter 500g","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 240°C/220°C fan/gas mark 9. Chop the sweet potatoes into 2cm chunks (no need to peel). Pop the sweet potatoes onto a large baking tray. Drizzle with oil, sprinkle over the smoked paprika and season with salt and pepper. Toss to coat. Spread out in a single layer. Use two baking trays if necessary. When the oven is hot, roast on the top shelf until golden and tender, 20-22 mins. Turn halfway through.","Meanwhile, peel and grate the garlic (or use a garlic press). Halve, peel and chop the onion into small pieces. Heat a drizzle of oil in a large frying pan on medium-high heat. Once hot, add the chorizo and onion to the pan and stir-fry until softened, 4-5 mins. Add the garlic and chipotle paste (add less if you'd prefer things milder). Fry for 1 min.","Stir the veg stock paste, mixed beans and their liquid, and the honey (use the quantities listed in the ingredients) into the frying pan. Roughly mash half the beans using a potato masher or the back of a fork. Bring to the boil, then lower the heat and simmer until thickened, 5-6 mins.","Meanwhile, trim the baby gem, halve lengthways, then thinly slice. In a medium bowl, combine the coleslaw mix, baby gem and mayo (use the quantities listed in the ingredients). Season with salt and pepper, then set aside. Grate the cheese.","Pop the tortillas (3 per person) onto a large baking tray and into the oven to warm through, 1-2 mins. Once thickened, stir the butter (use the quantities listed in the ingredients) through the beans until melted, 1 min more. Taste and season the refried beans with salt and pepper if needed. Add a splash of water if it's a little too thick.","When everything's ready, assemble your tacos. Spoon the chorizo and refried beans down the centre of each taco. Top with sweet potato and some of the slaw salad. Sprinkle over the cheese. Serve with the remaining slaw salad on the side."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1ce71644dd339c42fee/step-ff571600.jpg","caption":"Roast the Sweet Potato"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1ce71644dd339c42fee/step-5545ff10.jpg","caption":"Frying Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1ce71644dd339c42fee/step-4d0d9f20.jpg","caption":"Make the Refried Beans"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1ce71644dd339c42fee/step-bd04c630.jpg","caption":"Slaw Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1ce71644dd339c42fee/step-5513c640.jpg","caption":"Warm the Tortillas"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1ce71644dd339c42fee/step-567dd650.jpg","caption":"Assemble and Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/smoky-chorizo-refried-beans-and-sweet-potato-tacos-691df1ce71644dd339c42fee","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/smoky-chorizo-refried-beans-and-sweet-potato-tacos-691df1ce71644dd339c42fee","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"wrap","shoppingIngredients":[["2","Sweet Potato"],["1 sachet","Smoked Paprika"],["2","Garlic Clove"],["1","Onion"],["90 g","Diced Chorizo"],["20 g","Chipotle Paste"],["10 g","Vegetable Stock Paste"],["1 carton","Mixed Beans"],["1","Baby Gem Lettuce"],["120 g","Sliced Carrot and Cabbage Mix"],["40 g","Mature Cheddar Cheese"],["6","Plain Taco Tortillas"],["1 tbsp","Honey"],["2 tbsp","Mayonnaise"],["20 g","Butter"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"],["30 ml","water"]],"isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-693adbb01101204cae74ecae","sourceId":"693adbb01101204cae74ecae","title":"Indonesian Style Spiced Prawn, Chicken and Peanut Noodles","subtitle":"with Fresh Lime, Garlic and Stir-Fried Veg","time":25,"cost":22.58,"servings":2,"scaleSafe":true,"tags":["quick","calorie smart","high protein","healthy options","thai","seafood","pasta"],"requiredEquipment":[],"sourceEquipment":["Large Frying Pan","Rolling Pin","Garlic Press","Kettle","Sieve","Medium Saucepan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R24_W09_UK_R52998-5_edit_chicken_Main_high-8d475125.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/thai-style-spiced-prawn-chicken-and-peanut-noodles-693adbb01101204cae74ecae","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1","Bell Pepper"],["80 g","Young Pea Pods"],["2","Garlic Clove"],["25 g","Salted Peanuts"],["1","Lime"],["150 g","King Prawns"],["15 g","Ginger Puree"],["20 ml","Soy Sauce"],["60 g","Hoisin Sauce"],["40 g","Tamarind Chutney"],["125 g","Egg Noodle Nest"],["240 g","Diced British Chicken Breast"],["1 tsp","Honey"],["75 ml","Water for the Sauce"],["as needed","cooking oil"]],"sourceIngredients":[["1","Bell Pepper"],["80 g","Young Pea Pods"],["2","Garlic Clove"],["25 g","Salted Peanuts"],["1","Lime"],["150 g","King Prawns"],["15 g","Ginger Puree"],["20 ml","Soy Sauce"],["60 g","Hoisin Sauce"],["40 g","Tamarind Chutney"],["125 g","Egg Noodle Nest"],["240 g","Diced British Chicken Breast"],["1 tsp","Honey"],["75 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"632cf717b4f4bc890195c7d3","name":"Bell Pepper","type":"bell-pepper","family":"pepper","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Bell Pepper","marketLabel":"peppers pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"66d08ea0a3a9934710b37319","name":"Young Pea Pods","type":"young-pea-pods","family":"none","amount":"80 g","sourceAmount":80,"sourceUnit":"grams","shipped":true,"shoppingName":"Young Pea Pods","marketLabel":"fresh green vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6877ced35a587f17f45951c6","name":"Salted Peanuts","type":"salted peanuts","family":"nut mix","amount":"25 g","sourceAmount":25,"sourceUnit":"grams","shipped":true,"shoppingName":"Salted Peanuts","marketLabel":"table salt 750g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6e2a4dab71a9058b4569","name":"Lime","type":"lime","family":"lime","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lime","marketLabel":"limes x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632c5abbb4f4bc890195c7a6","name":"King Prawns","type":"king prawns","family":"seafood preparation","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"King Prawns","marketLabel":"large king prawns 150g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"59f334f92c3e085ecd21b7f2","name":"Ginger Puree","type":"ginger-puree","family":"ginger","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Ginger Puree","marketLabel":"fresh ginger 100g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"680b9d014a6668c89d92df5a","name":"Soy Sauce","type":"soy sauce","family":"sauce","amount":"20 ml","sourceAmount":20,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Soy Sauce","marketLabel":"soy sauce 150ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5568784e4dab71d51e8b4569","name":"Hoisin Sauce","type":"hoisin-sauce","family":"asian paste","amount":"60 g","sourceAmount":60,"sourceUnit":"grams","shipped":true,"shoppingName":"Hoisin Sauce","marketLabel":"Asian cooking sauce equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"685924bf5baaf2916c0537a0","name":"Tamarind Chutney","type":"tamarind-chutney","family":"none","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Tamarind Chutney","marketLabel":"chutney jar equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68373080f7d5496ac4a65cdc","name":"Egg Noodle Nest","type":"egg-noodle-nest","family":"other noodle","amount":"125 g","sourceAmount":125,"sourceUnit":"grams","shipped":true,"shoppingName":"Egg Noodle Nest","marketLabel":"egg noodles 4 nests","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6390aea605fc26d5313f23d2","name":"Diced British Chicken Breast","type":"chicken-breast-diced","family":"none","amount":"240 g","sourceAmount":240,"sourceUnit":"grams","shipped":true,"shoppingName":"Diced British Chicken Breast","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"670e49ded1dd98c148b0988c","name":"Honey","type":"honey-1-tsp","family":"none","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"75 ml","sourceAmount":75,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Halve the bell pepper and discard the core and seeds. Slice into thin strips. Heat a drizzle of oil in a large frying pan on medium-high heat. Once hot, add the sliced pepper and chicken and fry until charred, 5-6 mins. Continue to stir while it cooks. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Wash your hands and equipment after handling raw chicken.","Meanwhile, slice the young pea pods in half lengthways. Peel and grate the garlic (or use a garlic press). Crush the peanuts with a rolling pin or the base of a small saucepan. Cut the lime into wedges. Drain the prawns.","Stir the garlic, young pea pods, ginger puree and prawns into the pan with a drizzle of oil and stir-fry for 2-3 mins. Wash your hands and equipment after handling raw prawns. Meanwhile, boil a full kettle.","Add the soy sauce, hoisin sauce, tamarind chutney, honey and water for the sauce (use the quantities listed in the ingredients) into the prawns. Stir and bring to the boil, reduce the heat slightly and simmer for 3-4 mins. The prawns are cooked when pink on the outside and opaque in the middle.","Meanwhile, pour the boiled water into a medium saucepan with ½ tsp salt and bring to the boil. Add the noodles and cook until tender, 4 mins. Once cooked, drain in a sieve and run under cold water to stop them sticking together. Once everything's cooked, add the noodles and a good squeeze of lime juice to the prawns. Toss to combine.","Share the prawn and chicken noodles between your serving bowls. Sprinkle with the crushed peanuts to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbb01101204cae74ecae/step-730af200.jpg","caption":"Get Started"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbb01101204cae74ecae/step-3e3f1a10.jpg","caption":"Finish Prepping"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbb01101204cae74ecae/step-61ac4a20.jpg","caption":"Build the Flavour"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbb01101204cae74ecae/step-4e970e30.jpg","caption":"Sauce Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbb01101204cae74ecae/step-2b1ab640.jpg","caption":"Boil the Noodles"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbb01101204cae74ecae/step-e687d050.jpg","caption":"Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/thai-style-spiced-prawn-chicken-and-peanut-noodles-693adbb01101204cae74ecae","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/thai-style-spiced-prawn-chicken-and-peanut-noodles-693adbb01101204cae74ecae","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"pasta","shoppingIngredients":[["1","Bell Pepper"],["80 g","Young Pea Pods"],["2","Garlic Clove"],["25 g","Salted Peanuts"],["1","Lime"],["150 g","King Prawns"],["15 g","Ginger Puree"],["20 ml","Soy Sauce"],["60 g","Hoisin Sauce"],["40 g","Tamarind Chutney"],["125 g","Egg Noodle Nest"],["240 g","Diced British Chicken Breast"],["1 tsp","Honey"],["75 ml","Water for the Sauce"],["as needed","cooking oil"]],"isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-693adbdfc92924105eca72bf","sourceId":"693adbdfc92924105eca72bf","title":"Galinhada Inspired Chicken and Chorizo Rice Bowl","subtitle":"with Central American Style Spices and Soured Cream","time":25,"cost":25.05,"servings":2,"scaleSafe":true,"tags":["quick","high protein","brasiliansk","poultry","rice"],"requiredEquipment":[],"sourceEquipment":["Medium Saucepan","Lid","Zester","Garlic Press","Pan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R41_W09_UK_L52113-5_edit_chorizo_Main_10_high-cb427011.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/galinhada-inspired-chicken-and-chorizo-rice-bowl-693adbdfc92924105eca72bf","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["150 g","Basmati Rice"],["1","Onion"],["1","Garlic Clove"],["1","Lime"],["240 g","Diced British Chicken Breast"],["1 sachet","Central American Style Spice Mix"],["30 g","Tomato Puree"],["10 g","Chicken Stock Paste"],["120 g","Peas"],["20 g","Wild Rocket"],["75 g","Soured Cream"],["90 g","Diced Chorizo"],["300 ml","Water for the Rice"],["1 tbsp","Honey"],["150 ml","Water for the Sauce"],["as needed","olive oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["150 g","Basmati Rice"],["1","Onion"],["1","Garlic Clove"],["1","Lime"],["240 g","Diced British Chicken Breast"],["1 sachet","Central American Style Spice Mix"],["30 g","Tomato Puree"],["10 g","Chicken Stock Paste"],["120 g","Peas"],["20 g","Wild Rocket"],["75 g","Soured Cream"],["90 g","Diced Chorizo"],["300 ml","Water for the Rice"],["1 tbsp","Honey"],["150 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"55508011fd2cb96c628b456c","name":"Basmati Rice","type":"basmati rice","family":"rice","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"Basmati Rice","marketLabel":"basmati rice 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a59324dab71626c8b4575","name":"Onion","type":"onion","family":"onion","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Onion","marketLabel":"brown onions 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6e2a4dab71a9058b4569","name":"Lime","type":"lime","family":"lime","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lime","marketLabel":"limes x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6390aea605fc26d5313f23d2","name":"Diced British Chicken Breast","type":"chicken-breast-diced","family":"none","amount":"240 g","sourceAmount":240,"sourceUnit":"grams","shipped":true,"shoppingName":"Diced British Chicken Breast","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"59ad32ea2c3e08228606b422","name":"Central American Style Spice Mix","type":"central-american-style-spice-mix","family":"spice blend","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Central American Style Spice Mix","marketLabel":"seasoning blend equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a708af8b25ef93e8b4567","name":"Tomato Puree","type":"tomato-puree","family":"single ingredient paste","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Tomato Puree","marketLabel":"tomato puree 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60002d898c8c0a188200a96d","name":"Chicken Stock Paste","type":"chicken-stock-paste","family":"stock concentrate","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":true,"shoppingName":"Chicken Stock Paste","marketLabel":"chicken stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556d6384fd2cb954078b4567","name":"Peas","type":"peas","family":"peas","amount":"120 g","sourceAmount":120,"sourceUnit":"grams","shipped":true,"shoppingName":"Peas","marketLabel":"garden peas 910g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555092a4f8b25ed3468b4569","name":"Wild Rocket","type":"rocket","family":"salad mix","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Wild Rocket","marketLabel":"rocket 60g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68382535f7d5496ac4a6a740","name":"Soured Cream","type":"soured-cream","family":"soured cream","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Soured Cream","marketLabel":"soured cream 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"66ab6339f66002bbd100b304","name":"Diced Chorizo","type":"chorizo-diced","family":"none","amount":"90 g","sourceAmount":90,"sourceUnit":"grams","shipped":true,"shoppingName":"Diced Chorizo","marketLabel":"prepared pork product equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"57bec7a892eec9ca688b4568","name":"Water for the Rice","type":"water-for-the-rice-100ml","family":"other drink","amount":"300 ml","sourceAmount":300,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Rice","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"6172cb313021d49a7feafc84","name":"Honey","type":"honey-1-tbsp","family":"honey","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"150 ml","sourceAmount":150,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Pour the water for the rice (use the quantities listed in the ingredients) into a medium saucepan with a tight-fitting lid. Stir in the rice and ¼ tsp salt and bring to the boil. Once boiling, turn the heat down to medium and cover with the lid. Leave to cook for 10 mins, then remove the pan from the heat (still covered) and leave to the side for another 10 mins or until ready to serve (the rice will continue to cook in its own steam).","Meanwhile, halve, peel and thinly slice the onion. Peel and grate the garlic (or use a garlic press). Zest and cut the lime into wedges.","Heat a drizzle of oil in a large frying pan on medium-high heat. Once hot, add the onion and cook until starting to soften, 3-4 mins. Add the chicken and chorizo to the pan and season with salt and pepper. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Fry until golden brown on the outside and cooked through, 8-10 mins. Wash your hands and equipment after handling raw chicken. It's cooked when no longer pink in the middle.","Once browned, add the Central American style spice mix, garlic and tomato puree. Fry until fragrant, 1 min. Once fragrant, add the chicken stock paste, honey and water for the sauce (use the quantities listed in the ingredients). Bring to the boil, then lower the heat and simmer until thickened slightly, 2-3 mins. Stir through the peas.","Once the rice is cooked, add it to the chicken pan and stir until completely coated in the sauce, 1-2 mins. Add a good squeeze of lime, sprinkle in a pinch of lime zest and season with salt and pepper.","When everything's ready, share the galinhada inspired chicken and rice between your bowls. Top the rice with a handful of rocket and drizzle a little olive oil over the leaves. Drizzle over the soured cream and serve with any remaining lime wedges for squeezing over to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbdfc92924105eca72bf/step-8fb1a400.jpg","caption":"Get Started"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbdfc92924105eca72bf/step-3e605210.jpg","caption":"Finish the Prep"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbdfc92924105eca72bf/step-fc413420.jpg","caption":"Fry Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbdfc92924105eca72bf/step-e6414e30.jpg","caption":"Add the Flavour"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbdfc92924105eca72bf/step-7d9b7e40.jpg","caption":"All Together Now"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbdfc92924105eca72bf/step-8f950850.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/galinhada-inspired-chicken-and-chorizo-rice-bowl-693adbdfc92924105eca72bf","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/galinhada-inspired-chicken-and-chorizo-rice-bowl-693adbdfc92924105eca72bf","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"rice","shoppingIngredients":[["150 g","Basmati Rice"],["1","Onion"],["1","Garlic Clove"],["1","Lime"],["240 g","Diced British Chicken Breast"],["1 sachet","Central American Style Spice Mix"],["30 g","Tomato Puree"],["10 g","Chicken Stock Paste"],["120 g","Peas"],["20 g","Wild Rocket"],["75 g","Soured Cream"],["90 g","Diced Chorizo"],["300 ml","Water for the Rice"],["1 tbsp","Honey"],["150 ml","Water for the Sauce"],["as needed","olive oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-691df228927c3f76100b040c","sourceId":"691df228927c3f76100b040c","title":"Creamy Lemon-Tarragon Prawn and Salmon Spaghetti","subtitle":"with Pear and Rocket Salad","time":25,"cost":22.58,"servings":2,"scaleSafe":true,"tags":["pescatarian","quick","mediterranean","pasta-noodles","high protein","italian","seafood","pasta"],"requiredEquipment":[],"sourceEquipment":["Bowl","Zester","Garlic Press","Large Saucepan","Baking Tray","Baking Paper","Colander","Large Frying Pan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R22_W04_UK_QR49124-4_Main_QR49124-AP-1-4_var_high-26ed70fa.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/creamy-lemon-tarragon-prawn-and-salmon-spaghetti-691df228927c3f76100b040c","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["3","Garlic Clove"],["1","Lemon"],["1 bunch","Tarragon"],["1","Pear"],["200 g","Salmon Fillets"],["180 g","Spaghetti"],["250 g","Large King Prawns"],["150 g","Creme Fraiche"],["10 g","Vegetable Stock Paste"],["40 g","Grated Hard Italian Style Cheese"],["20 g","Wild Rocket"],["1 tbsp","Honey"],["1 tbsp","Olive Oil for the Dressing"],["100 ml","Water for the Sauce"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["3","Garlic Clove"],["1","Lemon"],["1 bunch","Tarragon"],["1","Pear"],["200 g","Salmon Fillets"],["180 g","Spaghetti"],["250 g","Large King Prawns"],["150 g","Creme Fraiche"],["10 g","Vegetable Stock Paste"],["40 g","Grated Hard Italian Style Cheese"],["20 g","Wild Rocket"],["1 tbsp","Honey"],["1 tbsp","Olive Oil for the Dressing"],["100 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"3","sourceAmount":3,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a72ebfd2cb95a598b4570","name":"Lemon","type":"lemon","family":"lemon","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lemon","marketLabel":"lemons x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5568362f4dab711e1c8b456a","name":"Tarragon","type":"tarragon","family":"tarragon","amount":"1 bunch","sourceAmount":1,"sourceUnit":"bunch(es)","shipped":true,"shoppingName":"Tarragon","marketLabel":"herb equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55dc8889fd2cb933188b4568","name":"Pear","type":"pear","family":"pear","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Pear","marketLabel":"fresh fruit equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"62fcaa09bd9a2478e193effe","name":"Salmon Fillets","type":"skin-on-salmon-fillet","family":"none","amount":"200 g","sourceAmount":200,"sourceUnit":"grams","shipped":true,"shoppingName":"Salmon Fillets","marketLabel":"Scottish salmon fillets x2 240g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68373082f7d5496ac4a65cf3","name":"Spaghetti","type":"spaghetti (wheat)","family":"other noodle","amount":"180 g","sourceAmount":180,"sourceUnit":"grams","shipped":true,"shoppingName":"Spaghetti","marketLabel":"pasta 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"624207fa4905355ff379039a","name":"Large King Prawns","type":"large-king-prawns","family":"seafood preparation","amount":"250 g","sourceAmount":250,"sourceUnit":"grams","shipped":true,"shoppingName":"Large King Prawns","marketLabel":"large king prawns 150g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555084f34dab718e128b4569","name":"Creme Fraiche","type":"creme-fraiche","family":"soured cream","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"Creme Fraiche","marketLabel":"creme fraiche 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"641093570565a60137055ba9","name":"Vegetable Stock Paste","type":"vegetable-stock-paste","family":"stock concentrate","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":true,"shoppingName":"Vegetable Stock Paste","marketLabel":"vegetable stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5550865efd2cb974658b4568","name":"Grated Hard Italian Style Cheese","type":"grated-hard-italian-style-cheese-duplicate","family":"hard cheese","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Grated Hard Italian Style Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555092a4f8b25ed3468b4569","name":"Wild Rocket","type":"rocket","family":"salad mix","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Wild Rocket","marketLabel":"rocket 60g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6172cb313021d49a7feafc84","name":"Honey","type":"honey-1-tbsp","family":"honey","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb168688281450b8bd062","name":"Olive Oil for the Dressing","type":"olive-oil-for-the-dressing-1-tbsp","family":"oil","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Olive Oil for the Dressing","marketLabel":"cooking oil 1 litre","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"100 ml","sourceAmount":100,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Bring a large saucepan of water to the boil with ½ tsp salt for the spaghetti. Peel and grate the garlic (or use a garlic press). Zest and halve the lemon. Pick the tarragon leaves from their stalks and finely chop (discard the stalks). Quarter the pear lengthways (no need to peel), remove the core and thinly slice lengthways. Squeeze half the lemon juice into a medium bowl. Add the honey and olive oil for the dressing (use the quantities listed in the ingredients). Season with salt and pepper and mix.","Lay the salmon fillets, skin-side down, onto a lined baking tray. Spread half the garlic over the fillets and season with salt and pepper. When the oven is hot, bake on the top shelf until cooked through, 10-15 mins. Wash your hands and equipment after handling raw fish. It's cooked when opaque in the middle.","Meanwhile, when your pan of water is boiling, add the spaghetti and bring back to the boil. Cook until tender, 8 mins. Once cooked, drain in a colander and pop back in the pan. Drizzle with oil and stir through to stop the pasta sticking together.","While the pasta cooks, heat a drizzle of oil in a large frying pan on medium-high heat. Drain the prawns. Add the prawns to the pan and pan-fry, 2-3 mins. Add the remaining garlic and half the chopped tarragon. Cook for 30 secs. Stir in the creme fraiche, veg stock paste and water for the sauce (use the quantities listed in the ingredients). Simmer until piping hot, 3-4 mins. Wash your hands and equipment after handling raw prawns. They're cooked when pink on the outside and opaque in the middle.","Once the salmon is cooked, gently peel off and discard the skin. Using a fork, flake the fish into bite-sized pieces. Stir the cooked pasta, flaked salmon, hard Italian style cheese and a pinch of lemon zest into the sauce. Season with salt and pepper and add a good squeeze of lemon juice. Add a splash of water to loosen if needed.","When everything's ready, add the rocket and pear to the lemon dressing and toss to coat. Share the prawn and salmon pasta between your bowls. Finish with a sprinkle of the remaining tarragon if you'd like. Serve the salad alongside and cut any remaining lemon into wedges for squeezing over."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df228927c3f76100b040c/step-7750b300.jpg","caption":"Start the prep"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df228927c3f76100b040c/step-1bdbed10.jpg","caption":"Bake the Salmon"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df228927c3f76100b040c/step-6933e420.jpg","caption":"Cook the Pasta"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df228927c3f76100b040c/step-9c880d30.jpg","caption":"Bring on the Creamy Sauce"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df228927c3f76100b040c/step-a82a8140.jpg","caption":"Combine and Stir"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df228927c3f76100b040c/step-778fac50.jpg","caption":"Finish and Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/creamy-lemon-tarragon-prawn-and-salmon-spaghetti-691df228927c3f76100b040c","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/creamy-lemon-tarragon-prawn-and-salmon-spaghetti-691df228927c3f76100b040c","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"pasta","shoppingIngredients":[["3","Garlic Clove"],["1","Lemon"],["1 bunch","Tarragon"],["1","Pear"],["200 g","Salmon Fillets"],["180 g","Spaghetti"],["250 g","Large King Prawns"],["150 g","Creme Fraiche"],["10 g","Vegetable Stock Paste"],["40 g","Grated Hard Italian Style Cheese"],["20 g","Wild Rocket"],["1 tbsp","Honey"],["1 tbsp","Olive Oil for the Dressing"],["100 ml","Water for the Sauce"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-693adc1fc92924105eca7388","sourceId":"693adc1fc92924105eca7388","title":"Family Favourite: Cheesy Ratatouille Chicken Pasta Bake","subtitle":"For Adults: Add Red Chilli and Toasted Almonds","time":35,"cost":21.38,"servings":2,"scaleSafe":true,"tags":["family friendly","high protein","new","italian","poultry","pasta","cook"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Colander","Large Saucepan","Garlic Press","Grater","Medium Saucepan","Oven dish"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R08_W09_UK_V53366-3_edit_chicken_Main_15_high-b92aeb7c.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/family-favourite-cheesy-ratatouille-chicken-pasta-bake-693adc1fc92924105eca7388","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1","Courgette"],["1","Bell Pepper"],["180 g","Rigatoni Pasta"],["2","Garlic Clove"],["1","Red Chilli"],["80 g","Mature Cheddar Cheese"],["1 carton","Tomato Passata"],["75 g","Creme Fraiche"],["35 g","Caramelised Onion Paste"],["28 g","Red Wine Stock Paste"],["15 g","Toasted Flaked Almonds"],["240 g","Diced British Chicken Breast"],["1 tsp","Sugar"],["50 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1","Courgette"],["1","Bell Pepper"],["180 g","Rigatoni Pasta"],["2","Garlic Clove"],["1","Red Chilli"],["80 g","Mature Cheddar Cheese"],["1 carton","Tomato Passata"],["75 g","Creme Fraiche"],["35 g","Caramelised Onion Paste"],["28 g","Red Wine Stock Paste"],["15 g","Toasted Flaked Almonds"],["240 g","Diced British Chicken Breast"],["1 tsp","Sugar"],["50 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"554a727dfd2cb959598b4574","name":"Courgette","type":"courgette","family":"zucchini","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Courgette","marketLabel":"courgettes pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632cf717b4f4bc890195c7d3","name":"Bell Pepper","type":"bell-pepper","family":"pepper","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Bell Pepper","marketLabel":"peppers pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6837308142dc4b928197f3ad","name":"Rigatoni Pasta","type":"rigatoni-pasta","family":"other noodle","amount":"180 g","sourceAmount":180,"sourceUnit":"grams","shipped":true,"shoppingName":"Rigatoni Pasta","marketLabel":"pasta 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"597f3bd22c3e0823ee548883","name":"Red Chilli","type":"red-chilli","family":"chili","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Red Chilli","marketLabel":"red chillies x3","marketChecked":true,"priceMatchType":"source-identity"},{"id":"69146769623e0c85b6821082","name":"Mature Cheddar Cheese","type":"cheddar-cheese","family":"hard cheese","amount":"80 g","sourceAmount":80,"sourceUnit":"grams","shipped":true,"shoppingName":"Mature Cheddar Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55672166f8b25e412f8b4567","name":"Tomato Passata","type":"tomato passata","family":"single ingredient paste","amount":"1 carton","sourceAmount":1,"sourceUnit":"carton(s)","shipped":true,"shoppingName":"Tomato Passata","marketLabel":"passata 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555084f34dab718e128b4569","name":"Creme Fraiche","type":"creme-fraiche","family":"soured cream","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Creme Fraiche","marketLabel":"creme fraiche 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"682ddc6ec4a648afcad0da76","name":"Caramelised Onion Paste","type":"caramelised-onion-paste","family":"none","amount":"35 g","sourceAmount":35,"sourceUnit":"grams","shipped":true,"shoppingName":"Caramelised Onion Paste","marketLabel":"onion preserve equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5a4fc599c288003649295c52","name":"Red Wine Stock Paste","type":"red-wine-stock-pot","family":"stock concentrate","amount":"28 g","sourceAmount":28,"sourceUnit":"grams","shipped":true,"shoppingName":"Red Wine Stock Paste","marketLabel":"beef cooking concentrate equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6837308042dc4b928197f3a9","name":"Toasted Flaked Almonds","type":"toasted-flaked-almonds","family":"none","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Toasted Flaked Almonds","marketLabel":"nuts and seeds equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6390aea605fc26d5313f23d2","name":"Diced British Chicken Breast","type":"chicken-breast-diced","family":"none","amount":"240 g","sourceAmount":240,"sourceUnit":"grams","shipped":true,"shoppingName":"Diced British Chicken Breast","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555093924dab71e7118b4568","name":"Sugar","type":"sugar-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"50 ml","sourceAmount":50,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Trim the courgette and slice into 1cm thick rounds. Halve the bell pepper and discard the core and seeds. Chop into 2cm chunks. Add the veg to a baking tray and drizzle with oil. Season with salt and pepper. Toss to coat, then spread out in a single layer. When the oven is hot, roast on the top shelf until softened and browned, 18-20 mins. Turn halfway through.","Meanwhile, bring a large saucepan of water to the boil with ½ tsp salt. When boiling, add the rigatoni to the water and bring back to the boil. Cook until tender, 12 mins. Once cooked, drain in a colander and pop back in the pan. Drizzle with oil and stir through to stop it sticking together.","Next, peel and grate the garlic (or use a garlic press). Halve the chilli lengthways, deseed, then finely chop. Grate the Cheddar cheese.","Heat a drizzle of oil in a saucepan on medium heat. Once hot, add the diced chicken to the pan and season with salt and pepper. Cook until browned all over, 5-6 mins. Turn occasionally. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Wash your hands and equipment after handling raw chicken. Next, add the garlic and fry until fragrant, 1 min. Stir in the passata, creme fraiche, caramelised onion paste, red wine stock paste, sugar and water for the sauce (use the quantities listed in the ingredients). Bring to a boil, then reduce the heat and simmer until thickened, 3-4 mins. Stir half the cheese, cooked rigatoni and roasted veg into the pasta sauce.","Season the pasta with salt and pepper. Add a splash of water if you feel it needs it. Preheat your grill to high. Transfer the pasta to an appropriately sized ovenproof dish. Sprinkle over the remaining cheese. Pop onto the top shelf of your oven and grill until melted and golden, 5-6 mins. The chicken is cooked when no longer pink in the middle.","Share the cheesy ratatouille pasta bake between your serving bowls. Elevate Me: Sprinkle the chopped chilli and flaked almonds over the adults portions (and any kids that want it too!)."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adc1fc92924105eca7388/step-ea003d00.jpg","caption":"Prep the Veg"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adc1fc92924105eca7388/step-79f6db10.jpg","caption":"Boil the Pasta"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adc1fc92924105eca7388/step-c9be9f20.jpg","caption":"Finish Prepping"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adc1fc92924105eca7388/step-cd928130.jpg","caption":"Sauce Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adc1fc92924105eca7388/step-d6765540.jpg","caption":"All Together Now"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adc1fc92924105eca7388/step-6e2c6850.jpg","caption":"Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/family-favourite-cheesy-ratatouille-chicken-pasta-bake-693adc1fc92924105eca7388","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/family-favourite-cheesy-ratatouille-chicken-pasta-bake-693adc1fc92924105eca7388","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"pasta","shoppingIngredients":[["1","Courgette"],["1","Bell Pepper"],["180 g","Rigatoni Pasta"],["2","Garlic Clove"],["1","Red Chilli"],["80 g","Mature Cheddar Cheese"],["1 carton","Tomato Passata"],["75 g","Creme Fraiche"],["35 g","Caramelised Onion Paste"],["28 g","Red Wine Stock Paste"],["15 g","Toasted Flaked Almonds"],["240 g","Diced British Chicken Breast"],["1 tsp","Sugar"],["50 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-691df1d8927c3f76100b03b1","sourceId":"691df1d8927c3f76100b03b1","title":"Smoky Peri Peri Tuna and Prawn Rigatoni","subtitle":"with Lemon and Cheese","time":40,"cost":24.08,"servings":2,"scaleSafe":true,"tags":["mediterranean","pasta-noodles","high protein","pescatarian","italian","seafood","pasta","cook"],"requiredEquipment":[],"sourceEquipment":["Garlic Press","Small Bowl","Large Saucepan","Colander","Large Frying Pan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R23_W04_UK_R46817-3_Main_R46817-AP-1-3_var_high-a6d57a72.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/smoky-peri-peri-tuna-and-prawn-rigatoni-691df1d8927c3f76100b03b1","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1","Red Onion"],["1","Bell Pepper"],["3","Garlic Clove"],["1 tin","Skipjack Tuna in Water"],["12 ml","Red Wine Vinegar"],["180 g","Rigatoni Pasta"],["1 sachet","Peri Peri Seasoning"],["1 carton","Tomato Passata"],["10 g","Vegetable Stock Paste"],["50 g","Greek Style Salad Cheese"],["20 g","Wild Rocket"],["250 g","Large King Prawns"],["1 tsp","Sugar for the Pickle"],["0.5 tsp","Sugar for the Sauce"],["100 ml","Water for the Sauce"],["20 g","Butter"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1","Red Onion"],["1","Bell Pepper"],["3","Garlic Clove"],["1 tin","Skipjack Tuna in Water"],["12 ml","Red Wine Vinegar"],["180 g","Rigatoni Pasta"],["1 sachet","Peri Peri Seasoning"],["1 carton","Tomato Passata"],["10 g","Vegetable Stock Paste"],["50 g","Greek Style Salad Cheese"],["20 g","Wild Rocket"],["250 g","Large King Prawns"],["1 tsp","Sugar for the Pickle"],["0.5 tsp","Sugar for the Sauce"],["100 ml","Water for the Sauce"],["20 g","Butter"]],"ingredientMeta":[{"id":"554a6fb4fd2cb95a598b456e","name":"Red Onion","type":"red onion","family":"onion","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Red Onion","marketLabel":"red onions x3","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632cf717b4f4bc890195c7d3","name":"Bell Pepper","type":"bell-pepper","family":"pepper","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Bell Pepper","marketLabel":"peppers pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"3","sourceAmount":3,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"66e4649086402bd101d35b2e","name":"Skipjack Tuna in Water","type":"skipjack-tuna-in-water","family":"none","amount":"1 tin","sourceAmount":1,"sourceUnit":"tin(s)","shipped":true,"shoppingName":"Skipjack Tuna in Water","marketLabel":"tuna tin","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555ca1774dab7190138b4568","name":"Red Wine Vinegar","type":"red wine vinegar","family":"vinegar","amount":"12 ml","sourceAmount":12,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Red Wine Vinegar","marketLabel":"cooking vinegar equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6837308142dc4b928197f3ad","name":"Rigatoni Pasta","type":"rigatoni-pasta","family":"other noodle","amount":"180 g","sourceAmount":180,"sourceUnit":"grams","shipped":true,"shoppingName":"Rigatoni Pasta","marketLabel":"pasta 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6837ac5df7d5496ac4a6831f","name":"Peri Peri Seasoning","type":"peri-peri-seasoning","family":"spice blend","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Peri Peri Seasoning","marketLabel":"seasoning blend equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55672166f8b25e412f8b4567","name":"Tomato Passata","type":"tomato passata","family":"single ingredient paste","amount":"1 carton","sourceAmount":1,"sourceUnit":"carton(s)","shipped":true,"shoppingName":"Tomato Passata","marketLabel":"passata 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"641093570565a60137055ba9","name":"Vegetable Stock Paste","type":"vegetable-stock-paste","family":"stock concentrate","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":true,"shoppingName":"Vegetable Stock Paste","marketLabel":"vegetable stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6764b4a77de812ab26271141","name":"Greek Style Salad Cheese","type":"greek-style-cheese","family":"none","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Greek Style Salad Cheese","marketLabel":"feta 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555092a4f8b25ed3468b4569","name":"Wild Rocket","type":"rocket","family":"salad mix","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Wild Rocket","marketLabel":"rocket 60g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"624207fa4905355ff379039a","name":"Large King Prawns","type":"large-king-prawns","family":"seafood preparation","amount":"250 g","sourceAmount":250,"sourceUnit":"grams","shipped":true,"shoppingName":"Large King Prawns","marketLabel":"large king prawns 150g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5e3416f081143769dd33ba49","name":"Sugar for the Pickle","type":"sugar-for-the-pickle-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Pickle","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb612688281450b8bd07c","name":"Sugar for the Sauce","type":"sugar-for-the-sauce-1-tsp","family":"single spice","amount":"0.5 tsp","sourceAmount":0.5,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Sauce","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"100 ml","sourceAmount":100,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"60c73507053f5e815cd52d5b","name":"Butter","type":"butter-100g","family":"butter","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":false,"shoppingName":"Butter","marketLabel":"butter 500g","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Bring a large saucepan of water to the boil with ½ tsp salt for the rigatoni. Halve, peel and thinly slice the red onion. Halve the bell pepper and discard the core and seeds. Slice into thin strips. Peel and grate the garlic (or use a garlic press). Drain the tuna. Pop half the sliced onion into a small bowl and add the red wine vinegar and sugar for the pickle (use the quantities listed in the ingredients). Add a pinch of salt, mix and set aside to pickle.","When boiling, add the rigatoni to the water and bring back to the boil. Cook until tender, 12 mins. Once cooked, drain in a colander and pop back in the pan. Drizzle with oil and stir through to stop it sticking together.","Heat a drizzle of oil in a large frying pan on medium-high heat. Drain the prawns. Once hot, add the sliced pepper and remaining onion to the pan and stir-fry until softened, 4-6 mins. Add the prawns and stir-fry for 2-3 mins more. Wash your hands and equipment after handling raw prawns. Add the garlic and peri peri seasoning. Season with salt and pepper. Stir-fry for 1 min.","Stir the tuna, passata, vegetable stock paste, sugar and water for the sauce (use the quantities listed in the ingredients) into the frying pan. Bring to the boil, then simmer until the sauce has thickened slightly, 3-4 mins. The prawns are cooked when pink on the outside and opaque in the middle.","Once the sauce has thickened, stir in the butter (use the quantities listed in the ingredients). Add the cooked pasta to the pan and stir together until evenly combined. Taste the sauce and season with a pinch of salt and pepper if needed. Add a splash of water if it's a little too thick.","Divide the pasta between bowls. Top with the pickled onion and crumble over the cheese. Scatter over the rocket leaves to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1d8927c3f76100b03b1/step-d2e81300.jpg","caption":"Start the Prep"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1d8927c3f76100b03b1/step-37f51310.jpg","caption":"Cook the Pasta"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1d8927c3f76100b03b1/step-acd4f020.jpg","caption":"Fry the Veg"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1d8927c3f76100b03b1/step-f1534230.jpg","caption":"Simmer the Sauce"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1d8927c3f76100b03b1/step-3da44e40.jpg","caption":"Finishing Touches"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1d8927c3f76100b03b1/step-d7a10150.jpg","caption":"Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/smoky-peri-peri-tuna-and-prawn-rigatoni-691df1d8927c3f76100b03b1","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/smoky-peri-peri-tuna-and-prawn-rigatoni-691df1d8927c3f76100b03b1","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"pasta","shoppingIngredients":[["1","Red Onion"],["1","Bell Pepper"],["3","Garlic Clove"],["1 tin","Skipjack Tuna in Water"],["12 ml","Red Wine Vinegar"],["180 g","Rigatoni Pasta"],["1 sachet","Peri Peri Seasoning"],["1 carton","Tomato Passata"],["10 g","Vegetable Stock Paste"],["50 g","Greek Style Salad Cheese"],["20 g","Wild Rocket"],["250 g","Large King Prawns"],["1 tsp","Sugar for the Pickle"],["0.5 tsp","Sugar for the Sauce"],["100 ml","Water for the Sauce"],["20 g","Butter"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-691df1ed1d103273ffd589fd","sourceId":"691df1ed1d103273ffd589fd","title":"Char Siu Chicken and Sushi Rice Chirashi Bowl","subtitle":"with Stir-Fried Veg, Pickled Carrot and Peanuts","time":40,"cost":22.05,"servings":2,"scaleSafe":true,"tags":["calorie smart","pan-asian-plates","dinner-bowls","high protein","healthy options","new","japanese","poultry","rice","cook"],"requiredEquipment":[],"sourceEquipment":["Sieve","Kettle","Lid","Medium Saucepan","Bowl","Rolling Pin","Garlic Press","Peeler","Pan","Baking Paper","Aluminum Foil"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R18_W04_UK_R38277-3_edit_chicken_Main_high-37606322.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/char-siu-chicken-and-sushi-rice-chirashi-bowl-691df1ed1d103273ffd589fd","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["150 g","Sushi Rice"],["1","Carrot"],["15 ml","Rice Vinegar"],["1","Pak Choi"],["1","Garlic Clove"],["25 g","Salted Peanuts"],["80 g","Young Pea Pods"],["15 g","Ginger Puree"],["2","British Chicken Breasts"],["75 g","Char Siu Paste"],["300 ml","Boiled Water for the Rice"],["0.5 tsp","Sugar for Pickling"],["1 tbsp","Water for the Sauce"],["0.25 tsp","Salt for the Rice"],["as needed","cooking oil"],["to taste","black pepper"]],"sourceIngredients":[["150 g","Sushi Rice"],["1","Carrot"],["15 ml","Rice Vinegar"],["1","Pak Choi"],["1","Garlic Clove"],["25 g","Salted Peanuts"],["80 g","Young Pea Pods"],["15 g","Ginger Puree"],["2","British Chicken Breasts"],["75 g","Char Siu Paste"],["300 ml","Boiled Water for the Rice"],["0.5 tsp","Sugar for Pickling"],["1 tbsp","Water for the Sauce"],["0.25 tsp","Salt for the Rice"]],"ingredientMeta":[{"id":"610cfdedaa24686fa96b6f52","name":"Sushi Rice","type":"sushi-rice","family":"rice","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"Sushi Rice","marketLabel":"rice equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5f284dab71a6058b4567","name":"Carrot","type":"carrot","family":"carrot","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Carrot","marketLabel":"carrots 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a68fa4dab71aa058b4568","name":"Rice Vinegar","type":"rice vinegar","family":"vinegar","amount":"15 ml","sourceAmount":15,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Rice Vinegar","marketLabel":"cooking vinegar equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556857adf8b25e5a408b4567","name":"Pak Choi","type":"bok-choy","family":"vegetable mix","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Pak Choi","marketLabel":"pak choi x2","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6877ced35a587f17f45951c6","name":"Salted Peanuts","type":"salted peanuts","family":"nut mix","amount":"25 g","sourceAmount":25,"sourceUnit":"grams","shipped":true,"shoppingName":"Salted Peanuts","marketLabel":"table salt 750g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"66d08ea0a3a9934710b37319","name":"Young Pea Pods","type":"young-pea-pods","family":"none","amount":"80 g","sourceAmount":80,"sourceUnit":"grams","shipped":true,"shoppingName":"Young Pea Pods","marketLabel":"fresh green vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"59f334f92c3e085ecd21b7f2","name":"Ginger Puree","type":"ginger-puree","family":"ginger","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Ginger Puree","marketLabel":"fresh ginger 100g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5e56f8b25ed7288b4576","name":"British Chicken Breasts","type":"chicken-fillet","family":"chicken","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"British Chicken Breasts","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"663b35115e4dcee2f12272ef","name":"Char Siu Paste","type":"char-sui-paste","family":"none","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Char Siu Paste","marketLabel":"cooking paste equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"61f967e87f9b41760f4d2294","name":"Boiled Water for the Rice","type":"boiled-water-for-the-rice-100ml","family":"other drink","amount":"300 ml","sourceAmount":300,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Boiled Water for the Rice","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"62c428a71c8a9cff25bdb82d","name":"Sugar for Pickling","type":"sugar-for-pickling","family":"none","amount":"0.5 tsp","sourceAmount":0.5,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for Pickling","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60b8a3c08b148d1530c49fb7","name":"Water for the Sauce","type":"water-for-the-sauce","family":"other drink","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"5fbeb638688281450b8bd07d","name":"Salt for the Rice","type":"salt-for-the-rice-1-tsp","family":"single spice","amount":"0.25 tsp","sourceAmount":0.25,"sourceUnit":"tsp","shipped":false,"shoppingName":"Salt for the Rice","marketLabel":"table salt 750g","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Boil a half-full kettle. Thoroughly rinse the sushi rice under cold water in a sieve until it runs clear. Pour the boiled water for the rice (use the quantities listed in the ingredients) into a medium saucepan, bring back to the boil on high heat. Stir in the sushi rice and turn the heat down to low. Cover with a tight-fitting lid and cook for 15 mins. When ready, remove from the heat (still covered) and leave to the side for 5 mins or until ready to serve (the rice will continue to cook in its own steam).","While the rice cooks, trim and peel the carrot. Use the peeler to peel long ribbons down the length of the carrot, stopping at the core. In a medium bowl, combine the rice vinegar and sugar for pickling (use the quantities listed in the ingredients). Season with salt, then add the carrot. Mix well, then set aside to pickle. Meanwhile, trim the pak choi, then thinly slice widthways. Peel and grate the garlic (or use a garlic press). Crush the peanuts with a rolling pin or the base of a small saucepan.","Heat a drizzle of oil in a large frying pan on high heat. Once hot, add the pak choi and pea pods and stir-fry until just soft, 3-4 mins. Add the garlic and ginger puree. Stir-fry for another 30 secs, then season with salt and pepper and transfer the veg to a bowl. Cover to keep warm. Meanwhile, sandwich each chicken breast between two pieces of baking paper. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Pop onto a board and bash with a rolling pin until they're 1-2cm thick. Wash your hands and equipment after handling raw chicken.","Wipe out the (now empty) frying pan and pop back on medium-high heat with a drizzle of oil. Heat a drizzle of oil in the frying pan on medium-high heat. Season the chicken with salt and pepper. Once hot, lay in the chicken. Fry until golden brown, 5-6 mins each side.","Next, add the char siu paste and water for the sauce (use the quantities listed in the ingredients) to the pan, turning the chicken so they're nicely glazed on both sides. Simmer until piping hot, 30 secs, then transfer to a plate and cover with foil to rest. The chicken is cooked when no longer pink in the middle. While the chicken rests, stir the carrot pickling liquid and salt for the rice (use the quantities listed in the ingredients) through the rice.","Share the rice out between large serving bowls. Slice the chicken and lay it onto one third of the rice, spooning over the remaining sauce. Spoon the stir-fried veg onto another third of the rice, then finally add the pickled carrot to the remaining section of rice. Sprinkle over the peanuts to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1ed1d103273ffd589fd/step-98956600.jpg","caption":"Cook the Rice"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1ed1d103273ffd589fd/step-fe506710.jpg","caption":"Finish the Prep"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1ed1d103273ffd589fd/step-afd54320.jpg","caption":"Stir-Fry the Veg"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1ed1d103273ffd589fd/step-6437fb30.jpg","caption":"Fry the Chicken"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1ed1d103273ffd589fd/step-ead96940.jpg","caption":"Time to Glaze"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1ed1d103273ffd589fd/step-ad5a6e50.jpg","caption":"Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/char-siu-chicken-and-sushi-rice-chirashi-bowl-691df1ed1d103273ffd589fd","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/char-siu-chicken-and-sushi-rice-chirashi-bowl-691df1ed1d103273ffd589fd","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"rice","shoppingIngredients":[["150 g","Sushi Rice"],["1","Carrot"],["15 ml","Rice Vinegar"],["1","Pak Choi"],["1","Garlic Clove"],["25 g","Salted Peanuts"],["80 g","Young Pea Pods"],["15 g","Ginger Puree"],["2","British Chicken Breasts"],["75 g","Char Siu Paste"],["300 ml","Boiled Water for the Rice"],["0.5 tsp","Sugar for Pickling"],["1 tbsp","Water for the Sauce"],["0.25 tsp","Salt for the Rice"],["as needed","cooking oil"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-691df1e41d103273ffd589f0","sourceId":"691df1e41d103273ffd589f0","title":"Jerk Spiced Beef and Pepper Pilaf","subtitle":"with Sweetcorn and Kale","time":45,"cost":25.67,"servings":2,"scaleSafe":true,"tags":["discovery","world-flavors","dinner-bowls","caribbean","beef","rice","cook"],"requiredEquipment":[],"sourceEquipment":["Garlic Press","Lid","Zester","Sieve","Pan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R11_W04_UK_R20934-7_edit_mince_Main_high-953afcc1.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/jerk-spiced-beef-and-pepper-pilaf-691df1e41d103273ffd589f0","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1","Onion"],["2","Garlic Clove"],["150 g","Basmati Rice"],["20 g","Chicken Stock Paste"],["160 g","Sweetcorn"],["1","Lime"],["100 g","Chopped Kale"],["1","Bell Pepper"],["240 g","British Beef Mince"],["50 g","Jerk Paste"],["30 g","Tomato Puree"],["20 g","Butter"],["1 tsp","Sugar for the Onions"],["300 ml","Water for the Rice"],["100 ml","Water for the Sauce"],["1 tbsp","Honey"],["2 tbsp","Mayonnaise"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1","Onion"],["2","Garlic Clove"],["150 g","Basmati Rice"],["20 g","Chicken Stock Paste"],["160 g","Sweetcorn"],["1","Lime"],["100 g","Chopped Kale"],["1","Bell Pepper"],["240 g","British Beef Mince"],["50 g","Jerk Paste"],["30 g","Tomato Puree"],["20 g","Butter"],["1 tsp","Sugar for the Onions"],["300 ml","Water for the Rice"],["100 ml","Water for the Sauce"],["1 tbsp","Honey"],["2 tbsp","Mayonnaise"]],"ingredientMeta":[{"id":"554a59324dab71626c8b4575","name":"Onion","type":"onion","family":"onion","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Onion","marketLabel":"brown onions 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55508011fd2cb96c628b456c","name":"Basmati Rice","type":"basmati rice","family":"rice","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"Basmati Rice","marketLabel":"basmati rice 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60002d898c8c0a188200a96d","name":"Chicken Stock Paste","type":"chicken-stock-paste","family":"stock concentrate","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Chicken Stock Paste","marketLabel":"chicken stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6de44dab71a6058b456a","name":"Sweetcorn","type":"sweetcorn","family":"corn","amount":"160 g","sourceAmount":160,"sourceUnit":"grams","shipped":true,"shoppingName":"Sweetcorn","marketLabel":"sweetcorn tin","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6e2a4dab71a9058b4569","name":"Lime","type":"lime","family":"lime","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lime","marketLabel":"limes x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6242043ddf35475d1660ada1","name":"Chopped Kale","type":"chopped-kale","family":"kale","amount":"100 g","sourceAmount":100,"sourceUnit":"grams","shipped":true,"shoppingName":"Chopped Kale","marketLabel":"curly kale 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632cf717b4f4bc890195c7d3","name":"Bell Pepper","type":"bell-pepper","family":"pepper","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Bell Pepper","marketLabel":"peppers pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556c1c67fd2cb99f468b4567","name":"British Beef Mince","type":"beef mince","family":"beef","amount":"240 g","sourceAmount":240,"sourceUnit":"grams","shipped":true,"shoppingName":"British Beef Mince","marketLabel":"5% fat beef mince 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"679b631d33196a355d1e51aa","name":"Jerk Paste","type":"jerk-paste","family":"none","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Jerk Paste","marketLabel":"cooking paste equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a708af8b25ef93e8b4567","name":"Tomato Puree","type":"tomato-puree","family":"single ingredient paste","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Tomato Puree","marketLabel":"tomato puree 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60c73507053f5e815cd52d5b","name":"Butter","type":"butter-100g","family":"butter","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":false,"shoppingName":"Butter","marketLabel":"butter 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"610d5147a6d0dbd6f1c32b40","name":"Sugar for the Onions","type":"sugar-for-the-onions-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Onions","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"57bec7a892eec9ca688b4568","name":"Water for the Rice","type":"water-for-the-rice-100ml","family":"other drink","amount":"300 ml","sourceAmount":300,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Rice","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"100 ml","sourceAmount":100,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"6172cb313021d49a7feafc84","name":"Honey","type":"honey-1-tbsp","family":"honey","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbe487e8afb1b135f069bd2","name":"Mayonnaise","type":"mayonnaise-tbsp","family":"mayonnaise","amount":"2 tbsp","sourceAmount":2,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Mayonnaise","marketLabel":"mayonnaise 500ml","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Halve, peel and thinly slice the onion. Peel and grate the garlic (or use a garlic press). Melt the butter (use the quantities listed in the ingredients) in a deep saucepan (with a tight-fitting lid) on medium heat. Once melted, add the onion, season with salt and pepper and fry, stirring occasionally, until golden and soft, 8-10 mins. Once the onion has softened, stir through the garlic and sugar for the onions (use the quantities listed in the ingredients). Cook for 1 min more.","Stir the rice into the onions until coated, 1 min. Add ¼ tsp salt, the water for the rice (use the quantities listed in the ingredients) and half the chicken stock paste. Stir to combine and bring to the boil. Once boiling, turn the heat down to medium and cover with the lid. Leave to cook for 10 mins, then remove the pan from the heat (still covered) and leave to the side for another 10 mins or until ready to serve (the rice will continue to cook in its own steam).","Meanwhile, drain the sweetcorn in a sieve. Zest and cut the lime into wedges. Destalk the kale and discard the stems. Halve the bell pepper and discard the core and seeds. Slice into thin strips.","Heat a large frying pan on medium-high heat (no oil). Once hot, add the beef mince, pepper and sweetcorn. Fry until the mince has browned, 5-6 mins. Use a spoon to break up the mince as it cooks. When the mince has browned, drain and discard any excess fat. Season with salt and pepper. Wash your hands and equipment after handling raw mince. It's cooked when no longer pink in the middle.","Add the kale, jerk paste and tomato puree to the beef. Cook until fragrant, 2 min. Stir in the water for the sauce (use the quantities listed in the ingredients) and remaining chicken stock paste. Bring to the boil and simmer until reduced by half, 3-4 mins. Once the rice is cooked, add it to the mince and mix until well combined. Stir through the honey (use the quantities listed in the ingredients), lime zest and half the lime juice, then remove from the heat. Taste and season with salt, pepper and more lime juice if needed.","Share the pilaf between your bowls. Drizzle over the mayo (use the quantities listed in the ingredients). Serve with any remaining lime wedges alongside for squeezing over."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1e41d103273ffd589f0/step-16ba2d00.jpg","caption":"Get Started"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1e41d103273ffd589f0/step-79092910.jpg","caption":"Cook the Rice"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1e41d103273ffd589f0/step-3652bf20.jpg","caption":"Finish the Prep"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1e41d103273ffd589f0/step-d90a5130.jpg","caption":"Fry the Beef"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1e41d103273ffd589f0/step-179d7e40.jpg","caption":"Add the Flavour"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1e41d103273ffd589f0/step-65ea1a50.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/jerk-spiced-beef-and-pepper-pilaf-691df1e41d103273ffd589f0","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/jerk-spiced-beef-and-pepper-pilaf-691df1e41d103273ffd589f0","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"rice","shoppingIngredients":[["1","Onion"],["2","Garlic Clove"],["150 g","Basmati Rice"],["20 g","Chicken Stock Paste"],["160 g","Sweetcorn"],["1","Lime"],["100 g","Chopped Kale"],["1","Bell Pepper"],["240 g","British Beef Mince"],["50 g","Jerk Paste"],["30 g","Tomato Puree"],["20 g","Butter"],["1 tsp","Sugar for the Onions"],["300 ml","Water for the Rice"],["100 ml","Water for the Sauce"],["1 tbsp","Honey"],["2 tbsp","Mayonnaise"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-692720ce56f60405d91128cf","sourceId":"692720ce56f60405d91128cf","title":"Szechuan Chicken Gyros Inspired Loaded Flatbreads","subtitle":"with Spiced Chips, Hot Sauce Dressed Salad, Pickled Cucumber and Houmous","time":45,"cost":24.26,"servings":2,"scaleSafe":true,"tags":["world-flavors","handhelds","medium spice","high protein","new","hellofresh specials","fusion","poultry","wrap","cook"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Bowl","Medium Saucepan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R79_W05_UK_SSF42622-3_Main_high-d4d0988c.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/szechuan-chicken-gyros-inspired-loaded-flatbreads-692720ce56f60405d91128cf","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["450 g","Potatoes"],["1 sachet","Chinese Five Spice"],["2","British Chicken Breasts"],["1","Baby Cucumber"],["100 g","Radishes"],["1","Baby Gem Lettuce"],["15 ml","Rice Vinegar"],["60 g","Hot Sauce"],["64 g","Mayonnaise"],["75 g","Szechuan Paste"],["2","Greek Style Flatbreads"],["100 g","Houmous"],["1 tsp","Sugar for the Pickle"],["1 tbsp","Olive Oil for the Dressing"],["0.5 tsp","Sugar"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["450 g","Potatoes"],["1 sachet","Chinese Five Spice"],["2","British Chicken Breasts"],["1","Baby Cucumber"],["100 g","Radishes"],["1","Baby Gem Lettuce"],["15 ml","Rice Vinegar"],["60 g","Hot Sauce"],["64 g","Mayonnaise"],["75 g","Szechuan Paste"],["2","Greek Style Flatbreads"],["100 g","Houmous"],["1 tsp","Sugar for the Pickle"],["1 tbsp","Olive Oil for the Dressing"],["0.5 tsp","Sugar"]],"ingredientMeta":[{"id":"5a39929ec9fd0814815939c2","name":"Potatoes","type":"potatoes","family":"potato","amount":"450 g","sourceAmount":450,"sourceUnit":"grams","shipped":true,"shoppingName":"Potatoes","marketLabel":"potatoes 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"57b1d87177d68d1f068b4567","name":"Chinese Five Spice","type":"chinese-5-spice","family":"spice blend","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Chinese Five Spice","marketLabel":"seasoning blend equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5e56f8b25ed7288b4576","name":"British Chicken Breasts","type":"chicken-fillet","family":"chicken","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"British Chicken Breasts","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"62fcaa53bd9a2478e193f0b4","name":"Baby Cucumber","type":"baby-cucumber","family":"none","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Baby Cucumber","marketLabel":"cucumber","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5e285e7fa395ab02d4687bc8","name":"Radishes","type":"radishes","family":"radish","amount":"100 g","sourceAmount":100,"sourceUnit":"grams","shipped":true,"shoppingName":"Radishes","marketLabel":"fresh vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68ecc674fa624b85e8848c26","name":"Baby Gem Lettuce","type":"baby gem lettuce","family":"salad mix","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Baby Gem Lettuce","marketLabel":"lettuce or salad leaves","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a68fa4dab71aa058b4568","name":"Rice Vinegar","type":"rice vinegar","family":"vinegar","amount":"15 ml","sourceAmount":15,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Rice Vinegar","marketLabel":"cooking vinegar equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5e285e8c281b6b2b4a03982b","name":"Hot Sauce","type":"hot-sauce","family":"asian paste","amount":"60 g","sourceAmount":60,"sourceUnit":"grams","shipped":true,"shoppingName":"Hot Sauce","marketLabel":"table sauce equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555c9d234dab7162138b4568","name":"Mayonnaise","type":"mayonnaise-tbsp","family":"mayonnaise","amount":"64 g","sourceAmount":64,"sourceUnit":"grams","shipped":true,"shoppingName":"Mayonnaise","marketLabel":"mayonnaise 500ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5f88503749bf791e225cf9d8","name":"Szechuan Paste","type":"szechuan-paste-duplicate","family":"sauce","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Szechuan Paste","priceMatchType":"source-identity"},{"id":"690e1cf948e7b2ec1b11f101","name":"Greek Style Flatbreads","type":"greek-flatbreads","family":"bread dough","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Greek Style Flatbreads","marketLabel":"flatbreads x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"64938f3cf855bec59c8fd364","name":"Houmous","type":"houmous","family":"hummus","amount":"100 g","sourceAmount":100,"sourceUnit":"grams","shipped":true,"shoppingName":"Houmous","marketLabel":"hummus 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5e3416f081143769dd33ba49","name":"Sugar for the Pickle","type":"sugar-for-the-pickle-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Pickle","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb168688281450b8bd062","name":"Olive Oil for the Dressing","type":"olive-oil-for-the-dressing-1-tbsp","family":"oil","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Olive Oil for the Dressing","marketLabel":"cooking oil 1 litre","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555093924dab71e7118b4568","name":"Sugar","type":"sugar-1-tsp","family":"single spice","amount":"0.5 tsp","sourceAmount":0.5,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Chop the potatoes lengthways into 1cm slices, then chop into 1cm wide chips (no need to peel). Pop the chips onto a large baking tray. Drizzle with oil, sprinkle over the Chinese Five Spice, season with salt and pepper, then toss to coat. Spread out in a single layer. Use two baking trays if necessary. When the oven is hot, bake on the middle shelf until golden, 30-40 mins. Turn halfway through.","Meanwhile, lay a chicken breast onto your chopping board, place your hand flat on top and slice into it from the side until there's 2cm left (be careful not to slice all the way through). Open it up like a book. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Repeat with the other breast(s) - you've butterflied your chicken! Wash your hands and equipment after handling raw chicken.","Lay the open chicken breasts on a lined baking tray. Drizzle over some oil and season with salt and pepper. When the chips are halfway through cooking, bake on the top shelf of your oven until golden and cooked through, 15-20 mins. The chicken is cooked when no longer pink in the middle. Meanwhile, trim the cucumber, then halve lengthways. Thinly slice widthways. Trim and quarter the radishes. Trim the baby gem, halve lengthways, then thinly slice.","In a medium bowl, combine the rice vinegar, half the hot sauce and sugar for the pickle (use the quantities listed in the ingredients). Season with salt and pepper. Stir in the cucumber. Set aside for now. In a large bowl, mix together the remaining hot sauce, mayo and olive oil for the dressing (use the quantities listed in the ingredients). Season with salt and pepper, then set aside.","When the chicken has 5 mins remaining, add the Szechuan paste to a small saucepan and heat until piping hot, 1-2 mins. Meanwhile, pop the flatbreads onto a baking tray and into the oven until warm and starting to turn golden, 3-4 mins. Once finished roasting, sprinkle the sugar (use the quantities listed in the ingredients) over the spiced chips and toss together. Cut the chicken widthways into 2cm thick slices.","Add the radish and baby gem salad to the hot sauce mayo dressing and toss together. Share the flatbreads between your plates and spread over the houmous. Scatter over a handful of spiced chips and the pickled cucumber. Top with the sliced chicken, then spoon over the Szechuan sauce. Serve the remaining chips and hot sauce mayo salad on the side."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/692720ce56f60405d91128cf/step-db7b7e00.jpg","caption":"Chip, Chip, Hooray"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/692720ce56f60405d91128cf/step-a3d1f910.jpg","caption":"Butterfly the Chicken"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/692720ce56f60405d91128cf/step-ab7efd20.jpg","caption":"Finish Prepping"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/692720ce56f60405d91128cf/step-8f19cc30.jpg","caption":"Build the Dressings"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/692720ce56f60405d91128cf/step-aa235640.jpg","caption":"Final Touches"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/692720ce56f60405d91128cf/step-b48d5450.jpg","caption":"Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/szechuan-chicken-gyros-inspired-loaded-flatbreads-692720ce56f60405d91128cf","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/szechuan-chicken-gyros-inspired-loaded-flatbreads-692720ce56f60405d91128cf","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"wrap","shoppingIngredients":[["450 g","Potatoes"],["1 sachet","Chinese Five Spice"],["2","British Chicken Breasts"],["1","Baby Cucumber"],["100 g","Radishes"],["1","Baby Gem Lettuce"],["15 ml","Rice Vinegar"],["60 g","Hot Sauce"],["64 g","Mayonnaise"],["75 g","Szechuan Paste"],["2","Greek Style Flatbreads"],["100 g","Houmous"],["1 tsp","Sugar for the Pickle"],["1 tbsp","Olive Oil for the Dressing"],["0.5 tsp","Sugar"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-6930738e9351d52b5c263d58","sourceId":"6930738e9351d52b5c263d58","title":"Curried Coconut Chicken Breast and Rice Noodles","subtitle":"with Young Pea Pods and Peanuts","time":30,"cost":16.07,"servings":2,"scaleSafe":true,"tags":["discovery","high protein","calorie smart","healthy options","low carb","indian","poultry","pasta","quick"],"requiredEquipment":[],"sourceEquipment":["Pan","Rolling Pin","Garlic Press"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R10_W44_UK_R29431-3_edit_peas_Mainhigh-0f50f7f3.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/curried-coconut-chicken-breast-and-rice-noodles-6930738e9351d52b5c263d58","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["240 g","Diced British Chicken Breast"],["2","Garlic Clove"],["1","Carrot"],["25 g","Salted Peanuts"],["1 sachet","Curry Powder Mix"],["15 g","Ginger Puree"],["180 ml","Coconut Milk"],["15 g","Chicken Stock Paste"],["80 g","Young Pea Pods"],["220 g","Rice Noodles"],["1 tsp","Sugar"],["150 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["240 g","Diced British Chicken Breast"],["2","Garlic Clove"],["1","Carrot"],["25 g","Salted Peanuts"],["1 sachet","Curry Powder Mix"],["15 g","Ginger Puree"],["180 ml","Coconut Milk"],["15 g","Chicken Stock Paste"],["80 g","Young Pea Pods"],["220 g","Rice Noodles"],["1 tsp","Sugar"],["150 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"6390aea605fc26d5313f23d2","name":"Diced British Chicken Breast","type":"chicken-breast-diced","family":"none","amount":"240 g","sourceAmount":240,"sourceUnit":"grams","shipped":true,"shoppingName":"Diced British Chicken Breast","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5f284dab71a6058b4567","name":"Carrot","type":"carrot","family":"carrot","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Carrot","marketLabel":"carrots 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6877ced35a587f17f45951c6","name":"Salted Peanuts","type":"salted peanuts","family":"nut mix","amount":"25 g","sourceAmount":25,"sourceUnit":"grams","shipped":true,"shoppingName":"Salted Peanuts","marketLabel":"table salt 750g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556827b74dab71b6178b4567","name":"Curry Powder Mix","type":"curry-powder","family":"spice blend","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Curry Powder Mix","marketLabel":"curry spice blend equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"59f334f92c3e085ecd21b7f2","name":"Ginger Puree","type":"ginger-puree","family":"ginger","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Ginger Puree","marketLabel":"fresh ginger 100g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a62e1f8b25eef3e8b4567","name":"Coconut Milk","type":"coconut milk","family":"canned coconut milk","amount":"180 ml","sourceAmount":180,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Coconut Milk","marketLabel":"coconut milk 400ml tin","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60002d898c8c0a188200a96d","name":"Chicken Stock Paste","type":"chicken-stock-paste","family":"stock concentrate","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Chicken Stock Paste","marketLabel":"chicken stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"66d08ea0a3a9934710b37319","name":"Young Pea Pods","type":"young-pea-pods","family":"none","amount":"80 g","sourceAmount":80,"sourceUnit":"grams","shipped":true,"shoppingName":"Young Pea Pods","marketLabel":"fresh green vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"56fe8e014dab71e5418b4567","name":"Rice Noodles","type":"rice-noodle","family":"other noodle","amount":"220 g","sourceAmount":220,"sourceUnit":"grams","shipped":true,"shoppingName":"Rice Noodles","priceMatchType":"source-identity"},{"id":"555093924dab71e7118b4568","name":"Sugar","type":"sugar-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"150 ml","sourceAmount":150,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Heat a drizzle of oil in a large frying pan on medium-high heat. Once hot, add the chicken to the pan. Season with salt and pepper and fry until browned on each side and cooked through, 8-10 mins. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Turn every 2-3 mins. Wash your hands and equipment after handling raw chicken. It's cooked when no longer pink in the middle.","While the chicken fries, peel and grate the garlic (or use a garlic press). Trim the carrot, then halve lengthways (no need to peel). Slice widthways into pieces about ½ cm thick. Crush the peanuts with a rolling pin or the base of a small saucepan.","Once your chicken has finished cooking, remove the pan from the heat. Cover the chicken and set aside. Put the pan back on medium-high heat (no need to clean) with another drizzle of oil (if needed). Once hot, add the carrot to the frying pan and cook until starting to soften, 8-10 mins.","Add the curry powder mix, ginger puree and garlic to the veg and fry until fragrant, 1-2 mins more. Stir in the coconut milk, chicken stock paste, sugar and water for the sauce (use the quantities listed in the ingredients). Bring up to a boil, then lower to a simmer. Add the chicken back into the pan along with the young pea pods and cook until the sauce has thickened slightly, 3-4 mins.","Once your sauce has thickened, add the rice noodles to the pan. Gently toss to coat and simmer until piping hot, 1-2 mins. Taste the sauce and season with salt and pepper if needed. Add a splash of water if the sauce is looking a little thick.","Share your chicken noodles between your serving bowls. Top with a sprinkling of peanuts."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930738e9351d52b5c263d58/step-daa2b700.jpg","caption":"Fry the Chicken"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930738e9351d52b5c263d58/step-4e89e710.jpg","caption":"Get Prepped"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930738e9351d52b5c263d58/step-0b0a2320.jpg","caption":"Fry the Veg"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930738e9351d52b5c263d58/step-eba5f530.jpg","caption":"Add the Flavour"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930738e9351d52b5c263d58/step-4bc9fc40.jpg","caption":"Finishing Touches"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930738e9351d52b5c263d58/step-6d6e7250.jpg","caption":"Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/curried-coconut-chicken-breast-and-rice-noodles-6930738e9351d52b5c263d58","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/curried-coconut-chicken-breast-and-rice-noodles-6930738e9351d52b5c263d58","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"pasta","shoppingIngredients":[["240 g","Diced British Chicken Breast"],["2","Garlic Clove"],["1","Carrot"],["25 g","Salted Peanuts"],["1 sachet","Curry Powder Mix"],["15 g","Ginger Puree"],["180 ml","Coconut Milk"],["15 g","Chicken Stock Paste"],["80 g","Young Pea Pods"],["220 g","Rice Noodles"],["1 tsp","Sugar"],["150 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-6930733f7558b9c7de4dc38e","sourceId":"6930733f7558b9c7de4dc38e","title":"Honeyed Chicken Breast and Veggie 'Nduja Traybake","subtitle":"with Sesame Roast Potatoes, Kale and Green Beans","time":40,"cost":15.7,"servings":2,"scaleSafe":true,"tags":["prepped in 10","high protein","mediterranean","sheet pan","calorie smart","medium spice","healthy options","italian","poultry","other","cook"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Aluminum Foil"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R18_W26_UK_R21919-4_Main_high-4a9c133a.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/honeyed-chicken-breast-and-veggie-nduja-traybake-6930733f7558b9c7de4dc38e","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["450 g","Potatoes"],["5 g","Roasted White Sesame Seeds"],["160 g","Green Beans"],["2","British Chicken Breasts"],["30 g","Honey"],["40 g","Vegan ‘Nduja"],["100 g","Kale"],["2 tbsp","Mayonnaise"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["450 g","Potatoes"],["5 g","Roasted White Sesame Seeds"],["160 g","Green Beans"],["2","British Chicken Breasts"],["30 g","Honey"],["40 g","Vegan ‘Nduja"],["100 g","Kale"],["2 tbsp","Mayonnaise"]],"ingredientMeta":[{"id":"5a39929ec9fd0814815939c2","name":"Potatoes","type":"potatoes","family":"potato","amount":"450 g","sourceAmount":450,"sourceUnit":"grams","shipped":true,"shoppingName":"Potatoes","marketLabel":"potatoes 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68371fa942dc4b928197f185","name":"Roasted White Sesame Seeds","type":"roasted-white-sesame-seeds","family":"sesame seed","amount":"5 g","sourceAmount":5,"sourceUnit":"grams","shipped":true,"shoppingName":"Roasted White Sesame Seeds","marketLabel":"sesame seeds 100g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555080c2f8b25e4d4c8b4568","name":"Green Beans","type":"green beans","family":"beans","amount":"160 g","sourceAmount":160,"sourceUnit":"grams","shipped":true,"shoppingName":"Green Beans","marketLabel":"green beans 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5e56f8b25ed7288b4576","name":"British Chicken Breasts","type":"chicken-fillet","family":"chicken","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"British Chicken Breasts","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555363fff8b25e5e0c8b4567","name":"Honey","type":"honey","family":"honey","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"64ad6bee48c7b9302c3330bc","name":"Vegan ‘Nduja","type":"vegan-nduja","family":"none","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Vegan ‘Nduja","marketLabel":"plant protein equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55f98c5879a23ca86e8b4567","name":"Kale","type":"kale","family":"kale","amount":"100 g","sourceAmount":100,"sourceUnit":"grams","shipped":true,"shoppingName":"Kale","marketLabel":"curly kale 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbe487e8afb1b135f069bd2","name":"Mayonnaise","type":"mayonnaise-tbsp","family":"mayonnaise","amount":"2 tbsp","sourceAmount":2,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Mayonnaise","marketLabel":"mayonnaise 500ml","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Chop the potatoes into 2cm chunks (no need to peel). Pop the chunks onto one side of a large baking tray. Drizzle with oil and sprinkle over the sesame seeds. Season, then toss to coat. Spread out in a single layer. Use two baking trays if necessary. When the oven is hot, roast the potato chunks on the middle shelf until golden, 30-40 mins. Turn halfway through.","Meanwhile, trim the green beans. Pop your beans onto a piece of foil with a drizzle of oil and season with salt and pepper. Toss to coat. Fold the foil, sealing on all sides to create a parcel.","Pop the parcel onto one side of a large baking tray. Meanwhile, lay the chicken breasts on a large plate. Season with salt and pepper. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Drizzle over the honey and vegan 'nduja (add less if you'd prefer things milder), then rub to coat. Wash your hands and equipment after handling raw chicken. If the measured honey is very thick, warm it briefly so it pours easily.","Roast the parcel and chicken breasts on the top shelf of your oven until the beans are tender and the chicken is browned and cooked through, 25-30 mins. The chicken is cooked when no longer pink in the middle.","When the potatoes have 8 mins remaining, remove the tray from the oven. Spread the kale on the other side of the baking tray, drizzle with oil and season with a pinch of salt and pepper to taste. Return the tray to the oven for the remaining time, until the kale is crispy, 7-8 mins.","Once roasted, share the chicken between your plates. Serve the roasted potatoes, kale and green beans alongside. Add a dollop of mayo (use the quantities listed in the ingredients) for dipping."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930733f7558b9c7de4dc38e/step-81ac3400.jpg","caption":"Roast the Potatoes"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930733f7558b9c7de4dc38e/step-df2ec510.jpg","caption":"Do the Prep"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930733f7558b9c7de4dc38e/step-d2345420.jpg","caption":"Get Roasting"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930733f7558b9c7de4dc38e/step-97724930.jpg","caption":"Bake the Chicken"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930733f7558b9c7de4dc38e/step-9f13f240.jpg","caption":"Roast the Kale"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930733f7558b9c7de4dc38e/step-1a857350.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/honeyed-chicken-breast-and-veggie-nduja-traybake-6930733f7558b9c7de4dc38e","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/honeyed-chicken-breast-and-veggie-nduja-traybake-6930733f7558b9c7de4dc38e","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"other","shoppingIngredients":[["450 g","Potatoes"],["5 g","Roasted White Sesame Seeds"],["160 g","Green Beans"],["2","British Chicken Breasts"],["30 g","Honey"],["40 g","Vegan ‘Nduja"],["100 g","Kale"],["2 tbsp","Mayonnaise"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-6930736d9351d52b5c263d37","sourceId":"6930736d9351d52b5c263d37","title":"Seared Monkfish Medallions on Super Green Risotto","subtitle":"with Homemade Bacon Jam and Rocket Salad","time":45,"cost":31.56,"servings":2,"scaleSafe":true,"tags":["mediterranean","pasta-noodles","hellofresh specials","italian","seafood","rice","cook"],"requiredEquipment":[],"sourceEquipment":["Bowl","Zester","Garlic Press","Kettle","Pan","Measuring Jug","Medium Saucepan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R75_W06_UK_P2936-14_Main_high-e0cfb6dc.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/seared-monkfish-medallions-on-super-green-risotto-6930736d9351d52b5c263d37","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1","Echalion Shallot"],["1","Garlic Clove"],["0.5","Lemon"],["125 g","Baby Plum Tomatoes"],["90 g","British Smoked Bacon Lardons"],["40 g","Onion Marmalade"],["20 g","Vegetable Stock Paste"],["175 g","Risotto Rice"],["200 g","Monkfish Medallions"],["30 g","Unsalted Butter"],["40 g","Grated Hard Italian Style Cheese"],["60 g","Basil Pesto with Cashew Nuts"],["120 g","Peas"],["40 g","Wild Rocket"],["2 tbsp","Olive Oil for the Dressing"],["100 ml","Water"],["800 ml","Boiled Water for the Stock"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1","Echalion Shallot"],["1","Garlic Clove"],["0.5","Lemon"],["125 g","Baby Plum Tomatoes"],["90 g","British Smoked Bacon Lardons"],["40 g","Onion Marmalade"],["20 g","Vegetable Stock Paste"],["175 g","Risotto Rice"],["200 g","Monkfish Medallions"],["30 g","Unsalted Butter"],["40 g","Grated Hard Italian Style Cheese"],["60 g","Basil Pesto with Cashew Nuts"],["120 g","Peas"],["40 g","Wild Rocket"],["2 tbsp","Olive Oil for the Dressing"],["100 ml","Water"],["800 ml","Boiled Water for the Stock"]],"ingredientMeta":[{"id":"5568817d4dab71121f8b4568","name":"Echalion Shallot","type":"echalion shallot","family":"onion","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Echalion Shallot","marketLabel":"brown onions 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a72ebfd2cb95a598b4570","name":"Lemon","type":"lemon","family":"lemon","amount":"0.5","sourceAmount":0.5,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lemon","marketLabel":"lemons x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5a3cee59c2880024501f6622","name":"Baby Plum Tomatoes","type":"baby-plum-tomatoes","family":"tomato","amount":"125 g","sourceAmount":125,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Plum Tomatoes","marketLabel":"fresh fruit equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6061f8b25ed7288b4577","name":"British Smoked Bacon Lardons","type":"pancetta","family":"pork","amount":"90 g","sourceAmount":90,"sourceUnit":"grams","shipped":true,"shoppingName":"British Smoked Bacon Lardons","marketLabel":"prepared pork product equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5852bce27d69bf2b3f5a65e1","name":"Onion Marmalade","type":"original-onion-marmalade","family":"fruit preserves","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Onion Marmalade","marketLabel":"onion preserve equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"641093570565a60137055ba9","name":"Vegetable Stock Paste","type":"vegetable-stock-paste","family":"stock concentrate","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Vegetable Stock Paste","marketLabel":"vegetable stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5992fd2cb95a598b456a","name":"Risotto Rice","type":"risotto-rice","family":"rice","amount":"175 g","sourceAmount":175,"sourceUnit":"grams","shipped":true,"shoppingName":"Risotto Rice","marketLabel":"risotto rice 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5d41512a9fe95c0010630ff0","name":"Monkfish Medallions","type":"monkfish-medallions","family":"Fish","amount":"200 g","sourceAmount":200,"sourceUnit":"grams","shipped":true,"shoppingName":"Monkfish Medallions","marketLabel":"white fish equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"57c0191877d68d50168b4568","name":"Unsalted Butter","type":"netherend-butter-unsalted","family":"butter","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Unsalted Butter","marketLabel":"butter 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5550865efd2cb974658b4568","name":"Grated Hard Italian Style Cheese","type":"grated-hard-italian-style-cheese-duplicate","family":"hard cheese","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Grated Hard Italian Style Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68c412723cfb117858763a9f","name":"Basil Pesto with Cashew Nuts","type":"basil-pesto-sauce","family":"none","amount":"60 g","sourceAmount":60,"sourceUnit":"grams","shipped":true,"shoppingName":"Basil Pesto with Cashew Nuts","marketLabel":"nuts and seeds equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556d6384fd2cb954078b4567","name":"Peas","type":"peas","family":"peas","amount":"120 g","sourceAmount":120,"sourceUnit":"grams","shipped":true,"shoppingName":"Peas","marketLabel":"garden peas 910g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555092a4f8b25ed3468b4569","name":"Wild Rocket","type":"rocket","family":"salad mix","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Wild Rocket","marketLabel":"rocket 60g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb168688281450b8bd062","name":"Olive Oil for the Dressing","type":"olive-oil-for-the-dressing-1-tbsp","family":"oil","amount":"2 tbsp","sourceAmount":2,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Olive Oil for the Dressing","marketLabel":"cooking oil 1 litre","marketChecked":true,"priceMatchType":"source-identity"},{"id":"57484fa04dab7170318b4567","name":"Water","type":"water-100ml","family":"other drink","amount":"100 ml","sourceAmount":100,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"61f965857f9b41760f4d2287","name":"Boiled Water for the Stock","type":"boiled-water-for-the-stock-100ml","family":"other drink","amount":"800 ml","sourceAmount":800,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Boiled Water for the Stock","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Boil a full kettle. Halve, peel and chop the shallot into small pieces. Peel and grate the garlic (or use a garlic press). Zest and halve the lemon. Halve the baby plum tomatoes and pop into a large bowl. Season the tomatoes with salt and pepper, squeeze on some lemon juice and drizzle with the olive oil for the dressing (use the quantities listed in the ingredients). Stir and set aside.","Heat a drizzle of oil in a medium frying pan on medium-high heat. Once hot, add the bacon lardons. Stir-fry until golden, 4-5 mins. Wash your hands and equipment after handling raw meat. Cook bacon thoroughly. Once golden, pour away any excess fat and stir the onion marmalade into the pan along with the water (use the quantities listed in the ingredients). Bubble until sticky, 30-60 secs, then transfer to a bowl and set aside - this is your bacon jam. Set the pan aside for later.","Pour the boiled water for the stock (use the quantities listed in the ingredients) into a large measuring jug. Stir in the vegetable stock paste - this is your stock. Heat a drizzle of oil in a large, wide-bottomed saucepan on medium heat. Once hot, add the shallot and season with salt and pepper. Cook, stirring, until softened, 5-6 mins. Stir in the garlic and cook for 1 min more.","Add the risotto rice, stir and cook until the edges of the rice are translucent, 1-2 mins. Pour in a third of the stock and stir to combine. Bring to the boil and simmer until absorbed, then repeat with the remaining stock, a third at a time. Stir occasionally. The total cooking time should take 20-25 mins and your risotto is done when the rice is ‘al dente’ - cooked through but with a tiny bit of firmness left in the middle.","When the rice has about 5 mins remaining, wipe out the (now empty) frying pan and pop on high heat with a drizzle of oil. Pat the monkfish dry with kitchen paper, then season with salt and pepper. When hot, add the monkfish pieces to the pan. Cook the monkfish pieces for 3-4 mins each side, adjusting the heat as necessary. When cooked, remove the pan from the heat. Add a pinch of lemon zest and a squeeze of lemon juice. Wash your hands and equipment after handling raw fish. It's cooked when opaque in the middle.","When the risotto is cooked, stir through the hard Italian style cheese, butter, pesto, peas and a squeeze of lemon juice. Taste and season with salt, pepper and more lemon juice if needed. Add a splash of water to loosen the risotto to your desired consistency. Spoon the risotto into your bowls and top with the monkfish, then spoon over the bacon jam. Add the rocket to the tomato bowl and toss to coat. Serve alongside the risotto."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930736d9351d52b5c263d37/step-c6a5fb00.jpg","caption":"Prep Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930736d9351d52b5c263d37/step-45891b10.jpg","caption":"Make your Bacon Jam"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930736d9351d52b5c263d37/step-0ec80d20.jpg","caption":"Start your Risotto"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930736d9351d52b5c263d37/step-61935230.jpg","caption":"Time to Cook"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930736d9351d52b5c263d37/step-a15d2340.jpg","caption":"Fry the Monkfish"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930736d9351d52b5c263d37/step-9e47eb50.jpg","caption":"Finish and Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/seared-monkfish-medallions-on-super-green-risotto-6930736d9351d52b5c263d37","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/seared-monkfish-medallions-on-super-green-risotto-6930736d9351d52b5c263d37","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"rice","shoppingIngredients":[["1","Echalion Shallot"],["1","Garlic Clove"],["0.5","Lemon"],["125 g","Baby Plum Tomatoes"],["90 g","British Smoked Bacon Lardons"],["40 g","Onion Marmalade"],["20 g","Vegetable Stock Paste"],["175 g","Risotto Rice"],["200 g","Monkfish Medallions"],["30 g","Unsalted Butter"],["40 g","Grated Hard Italian Style Cheese"],["60 g","Basil Pesto with Cashew Nuts"],["120 g","Peas"],["40 g","Wild Rocket"],["2 tbsp","Olive Oil for the Dressing"],["100 ml","Water"],["800 ml","Boiled Water for the Stock"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-693ada5dc92924105eca7121","sourceId":"693ada5dc92924105eca7121","title":"Sausages and German Style Warm Potato Salad","subtitle":"with Fresh Chives, Mustard-Mayo Dip and Crisp Green Salad","time":25,"cost":19.78,"servings":2,"scaleSafe":true,"tags":["quick","discovery","new","german","pork","salad"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Large Saucepan","Pan","Garlic Press","Kitchen Shears","Bowl","Colander","Lid"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R36_W08_UK_QR49273-3_Main_high-7c20e192.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/honey-mustard-sausages-and-german-style-warm-potato-salad-693ada5dc92924105eca7121","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["4","British Honey Mustard Sausages"],["350 g","Salad Potatoes"],["1","Echalion Shallot"],["1","Apple"],["2","Garlic Clove"],["1 bunch","Chives"],["30 ml","Cider Vinegar"],["10 g","Chicken Stock Paste"],["10 g","Wholegrain Mustard"],["64 g","Mayonnaise"],["50 g","Baby Leaf Mix"],["0.5 tsp","Sugar for the Sauce"],["50 ml","Water for the Sauce"],["0.5 tsp","Sugar for the Dressing"],["1 tbsp","Olive Oil for the Dressing"],["30 g","Butter"],["1 tbsp","Honey"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["4","British Honey Mustard Sausages"],["350 g","Salad Potatoes"],["1","Echalion Shallot"],["1","Apple"],["2","Garlic Clove"],["1 bunch","Chives"],["30 ml","Cider Vinegar"],["10 g","Chicken Stock Paste"],["10 g","Wholegrain Mustard"],["64 g","Mayonnaise"],["50 g","Baby Leaf Mix"],["0.5 tsp","Sugar for the Sauce"],["50 ml","Water for the Sauce"],["0.5 tsp","Sugar for the Dressing"],["1 tbsp","Olive Oil for the Dressing"],["30 g","Butter"],["1 tbsp","Honey"]],"ingredientMeta":[{"id":"55bf6859ae9270cd108b4567","name":"British Honey Mustard Sausages","type":"honey-mustard-sausages","family":"beef veal pork","amount":"4","sourceAmount":4,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"British Honey Mustard Sausages","marketLabel":"herb equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5dbc6e87b96bdd752017bc59","name":"Salad Potatoes","type":"salad-potatoes","family":"potato","amount":"350 g","sourceAmount":350,"sourceUnit":"grams","shipped":true,"shoppingName":"Salad Potatoes","marketLabel":"baby potatoes 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5568817d4dab71121f8b4568","name":"Echalion Shallot","type":"echalion shallot","family":"onion","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Echalion Shallot","marketLabel":"brown onions 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556c34ebf8b25eb9658b4567","name":"Apple","type":"apple","family":"apple","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Apple","marketLabel":"crisp apples x6","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555cabbffd2cb92f6c8b456b","name":"Chives","type":"chives","family":"chive","amount":"1 bunch","sourceAmount":1,"sourceUnit":"bunch(es)","shipped":true,"shoppingName":"Chives","marketLabel":"fresh chives 20g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55b8eb44ae9270ec308b4567","name":"Cider Vinegar","type":"cider vinegar","family":"vinegar","amount":"30 ml","sourceAmount":30,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Cider Vinegar","marketLabel":"cider vinegar 350ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60002d898c8c0a188200a96d","name":"Chicken Stock Paste","type":"chicken-stock-paste","family":"stock concentrate","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":true,"shoppingName":"Chicken Stock Paste","marketLabel":"chicken stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556c147a4dab71ac398b4567","name":"Wholegrain Mustard","type":"wholegrain mustard","family":"mustard","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":true,"shoppingName":"Wholegrain Mustard","marketLabel":"mustard 185g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555c9d234dab7162138b4568","name":"Mayonnaise","type":"mayonnaise-tbsp","family":"mayonnaise","amount":"64 g","sourceAmount":64,"sourceUnit":"grams","shipped":true,"shoppingName":"Mayonnaise","marketLabel":"mayonnaise 500ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"56b23e4ef8b25e4c2d8b4567","name":"Baby Leaf Mix","type":"premium baby leaf mix","family":"salad mix","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Leaf Mix","marketLabel":"lettuce or salad leaves","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb612688281450b8bd07c","name":"Sugar for the Sauce","type":"sugar-for-the-sauce-1-tsp","family":"single spice","amount":"0.5 tsp","sourceAmount":0.5,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Sauce","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"50 ml","sourceAmount":50,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"5fbeb425688281450b8bd079","name":"Sugar for the Dressing","type":"sugar-for-the-dressing-1-tsp","family":"single spice","amount":"0.5 tsp","sourceAmount":0.5,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Dressing","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb168688281450b8bd062","name":"Olive Oil for the Dressing","type":"olive-oil-for-the-dressing-1-tbsp","family":"oil","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Olive Oil for the Dressing","marketLabel":"cooking oil 1 litre","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60c73507053f5e815cd52d5b","name":"Butter","type":"butter-100g","family":"butter","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":false,"shoppingName":"Butter","marketLabel":"butter 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6172cb313021d49a7feafc84","name":"Honey","type":"honey-1-tbsp","family":"honey","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 240°C/220°C fan/gas mark 9. Bring a large saucepan of water with ½ tsp salt to the boil on high heat for the potatoes. Pop the sausages onto a baking tray. When the oven is hot, roast on the top shelf until browned and cooked through, 16-18 mins. Turn halfway through. Wash your hands and equipment after handling raw meat. The sausages are cooked when no longer pink in the middle.","Meanwhile, quarter the salad potatoes (no need to peel). When boiling, add the potatoes to the water, lower the heat to medium and cook until tender, 15-20 mins. While the potatoes boil, halve, peel and chop the shallot into small pieces. Quarter, core and thinly slice the apple (no need to peel).","Heat a drizzle of oil in a medium frying pan on medium heat. Add the shallot and cook until softened, 4-5 mins. While the shallot fries, peel and grate the garlic (or use a garlic press). Finely chop the chives (use scissors if easier). Add the garlic to the shallot and cook for 30 secs.","Pour half the cider vinegar into the shallot pan and allow it to evaporate. Add the sugar and water for the sauce (use the quantities listed in the ingredients), chicken stock paste and half the mustard. Bring to the boil, then lower the heat and simmer until thickened, 2-3 mins. Meanwhile, in a large bowl, combine the remaining cider vinegar with the sugar and olive oil for the dressing (use the quantities listed in the ingredients). Season with salt and pepper and set aside for now.","In a small bowl, mix the mayo and half the mustard. When the sauce has thickened, stir in the butter (use the quantities listed in the ingredients) until melted, then remove from the heat. Stir the chives into the sauce. Cover with a lid or foil to keep warm. Once the potatoes are cooked, drain with a colander, then return to the pan and spoon over the sauce and toss to coat the potatoes.","When the sausages are cooked, drizzle over the honey (use the quantities listed in the ingredients) and turn to coat. Add the apple and baby leaves to the salad dressing and toss. Share the sausages between your plates. Serve the apple salad, warm potato salad and mustard mayo alongside."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada5dc92924105eca7121/step-f456f700.jpg","caption":"Roast the Sausages"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada5dc92924105eca7121/step-26f93c10.jpg","caption":"Boil the Potatoes"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada5dc92924105eca7121/step-14e53920.jpg","caption":"Finish Prepping"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada5dc92924105eca7121/step-f1ee7c30.jpg","caption":"Build the Flavour"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada5dc92924105eca7121/step-caa85940.jpg","caption":"Final Touches"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada5dc92924105eca7121/step-d86fe450.jpg","caption":"Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/honey-mustard-sausages-and-german-style-warm-potato-salad-693ada5dc92924105eca7121","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/honey-mustard-sausages-and-german-style-warm-potato-salad-693ada5dc92924105eca7121","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"salad","shoppingIngredients":[["4","British Honey Mustard Sausages"],["350 g","Salad Potatoes"],["1","Echalion Shallot"],["1","Apple"],["2","Garlic Clove"],["1 bunch","Chives"],["30 ml","Cider Vinegar"],["10 g","Chicken Stock Paste"],["10 g","Wholegrain Mustard"],["64 g","Mayonnaise"],["50 g","Baby Leaf Mix"],["0.5 tsp","Sugar for the Sauce"],["50 ml","Water for the Sauce"],["0.5 tsp","Sugar for the Dressing"],["1 tbsp","Olive Oil for the Dressing"],["30 g","Butter"],["1 tbsp","Honey"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-693adbb11101204cae74ecb4","sourceId":"693adbb11101204cae74ecb4","title":"French Style Chicken Breast Blanquette and Pilaf Rice","subtitle":"with Creme Fraiche, Lemon, Leek and Fresh Parsley","time":35,"cost":25.14,"servings":2,"scaleSafe":true,"tags":["high protein","tasty-adventures","french","poultry","rice","cook"],"requiredEquipment":[],"sourceEquipment":["Garlic Press","Medium Saucepan","Bowl","Pan","Lid"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R10_W09_UK_R44876-7_edit_chicken_RAN_HA__Main_high-921cf2c2.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/french-style-chicken-breast-blanquette-and-pilaf-rice-693adbb11101204cae74ecb4","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["2","Garlic Clove"],["150 g","Basmati Rice"],["240 g","Diced British Chicken Breast"],["1","Leek"],["1","Carrot"],["150 g","Creme Fraiche"],["10 g","Chicken Stock Paste"],["1 bunch","Flat Leaf Parsley"],["1","Lemon"],["20 g","Grated Hard Italian Style Cheese"],["10 g","Butter"],["1 tsp","Sugar"],["300 ml","Water for the Rice"],["150 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["2","Garlic Clove"],["150 g","Basmati Rice"],["240 g","Diced British Chicken Breast"],["1","Leek"],["1","Carrot"],["150 g","Creme Fraiche"],["10 g","Chicken Stock Paste"],["1 bunch","Flat Leaf Parsley"],["1","Lemon"],["20 g","Grated Hard Italian Style Cheese"],["10 g","Butter"],["1 tsp","Sugar"],["300 ml","Water for the Rice"],["150 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55508011fd2cb96c628b456c","name":"Basmati Rice","type":"basmati rice","family":"rice","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"Basmati Rice","marketLabel":"basmati rice 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6390aea605fc26d5313f23d2","name":"Diced British Chicken Breast","type":"chicken-breast-diced","family":"none","amount":"240 g","sourceAmount":240,"sourceUnit":"grams","shipped":true,"shoppingName":"Diced British Chicken Breast","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5e334dab71a9058b4567","name":"Leek","type":"leek","family":"leek","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Leek","marketLabel":"leeks 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5f284dab71a6058b4567","name":"Carrot","type":"carrot","family":"carrot","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Carrot","marketLabel":"carrots 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555084f34dab718e128b4569","name":"Creme Fraiche","type":"creme-fraiche","family":"soured cream","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"Creme Fraiche","marketLabel":"creme fraiche 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60002d898c8c0a188200a96d","name":"Chicken Stock Paste","type":"chicken-stock-paste","family":"stock concentrate","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":true,"shoppingName":"Chicken Stock Paste","marketLabel":"chicken stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5904fd2cb9324b8b4575","name":"Flat Leaf Parsley","type":"flat leaf parsley","family":"parsley","amount":"1 bunch","sourceAmount":1,"sourceUnit":"bunch(es)","shipped":true,"shoppingName":"Flat Leaf Parsley","marketLabel":"fresh parsley 30g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a72ebfd2cb95a598b4570","name":"Lemon","type":"lemon","family":"lemon","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lemon","marketLabel":"lemons x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5550865efd2cb974658b4568","name":"Grated Hard Italian Style Cheese","type":"grated-hard-italian-style-cheese-duplicate","family":"hard cheese","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Grated Hard Italian Style Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60c73507053f5e815cd52d5b","name":"Butter","type":"butter-100g","family":"butter","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":false,"shoppingName":"Butter","marketLabel":"butter 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555093924dab71e7118b4568","name":"Sugar","type":"sugar-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"57bec7a892eec9ca688b4568","name":"Water for the Rice","type":"water-for-the-rice-100ml","family":"other drink","amount":"300 ml","sourceAmount":300,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Rice","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"150 ml","sourceAmount":150,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Halve, peel and thinly slice the shallot. Peel and grate the garlic (or use a garlic press). Heat a drizzle of oil in a deep saucepan (with a tight-fitting lid) on medium heat. Once hot, add half the butter (use the quantities listed in the ingredients) and allow it to melt. Add the shallot and season. Fry, stirring occasionally, until golden and soft, 8-10 mins. Once softened, add the sugar (use the quantities listed in the ingredients) and half the garlic to the pan. Stir together and cook for 1 min more. Stir the rice into the shallot and garlic until coated, 1 min. Add ¼ tsp salt and the water for the rice (use the quantities listed in the ingredients) and bring to the boil.","Once boiling, turn the heat down to medium and cover with the lid. Leave to cook for 10 mins, then remove the pan from the heat (still covered). Set aside for another 10 mins (the rice will continue to cook in its own steam). Heat a large frying pan on medium-high heat with a drizzle of oil. Once hot, add the diced chicken. Season with salt and pepper. Fry until the chicken is browned, 5-6 mins. Once browned, transfer the chicken to a bowl and cover with a lid or foil to keep warm. Wash your hands and equipment after handling raw chicken.","While the chicken fries, trim the root and dark green leafy part from the leek and discard. Halve lengthways, then thinly slice. Trim and halve the carrot lengthways. Slice widthways into ½cm thick half moons. Return the (now empty) frying pan to a medium-high heat with a drizzle of oil. Once hot, add the leek and carrot and season with salt and pepper. Cook until softened, 6-8 mins, stirring occasionally. Add the remaining garlic and fry, 1 min.","Stir in the creme fraiche, chicken stock paste and water for the sauce (use the quantities listed in the ingredients). Add the chicken back to the pan and cover with the liquid. Bring to the boil, then lower the heat and simmer until the liquid has thickened and the chicken is cooked through, 3-4 mins. The chicken is cooked when no longer pink in the middle.","While the chicken simmers, roughly chop the parsley (stalks and all). Cut the lemon into wedges. When the chicken has simmered, stir in a good squeeze of lemon juice and half the parsley. Season with salt and pepper. Add a splash of water if it's a little too thick. Once the rice is cooked, fluff up the grains with a fork.","Share the pilaf rice between your serving bowls. Spoon over the creamy sauce and veg. Top with the chicken . Finish by sprinkling over the cheese and the remaining parsley. Serve with any remaining lemon wedges for squeezing over."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbb11101204cae74ecb4/step-6982a500.jpg","caption":"Cook the Pilaf"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbb11101204cae74ecb4/step-55d5a710.jpg","caption":"Sear the Chicken"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbb11101204cae74ecb4/step-ae7a3820.jpg","caption":"Cook the Veg"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbb11101204cae74ecb4/step-ce435a30.jpg","caption":"Sauce Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbb11101204cae74ecb4/step-49cff540.jpg","caption":"All Together Now"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbb11101204cae74ecb4/step-4248a350.jpg","caption":"Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/french-style-chicken-breast-blanquette-and-pilaf-rice-693adbb11101204cae74ecb4","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/french-style-chicken-breast-blanquette-and-pilaf-rice-693adbb11101204cae74ecb4","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"rice","shoppingIngredients":[["2","Garlic Clove"],["150 g","Basmati Rice"],["240 g","Diced British Chicken Breast"],["1","Leek"],["1","Carrot"],["150 g","Creme Fraiche"],["10 g","Chicken Stock Paste"],["1 bunch","Flat Leaf Parsley"],["1","Lemon"],["20 g","Grated Hard Italian Style Cheese"],["10 g","Butter"],["1 tsp","Sugar"],["300 ml","Water for the Rice"],["150 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-693adc0d1101204cae74ee11","sourceId":"693adc0d1101204cae74ee11","title":"Pide Inspired Aubergine Flatbreads","subtitle":"with Roasted Potatoes, Mint Yoghurt and Pickled Shallot Salad","time":35,"cost":17.55,"servings":2,"scaleSafe":true,"tags":["calorie smart","veggie","taste of middle east","handhelds","turkish","wrap","cook"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Bowl"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y24_R50_W47_UK_HVV26849-3_Main_high-cc9fda4c.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/pide-inspired-aubergine-flatbreads-693adc0d1101204cae74ee11","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["450 g","Potatoes"],["1","Aubergine"],["1","Echalion Shallot"],["12 ml","Red Wine Vinegar"],["60 g","Tomato Puree"],["1 bunch","Mint"],["2","Greek Style Flatbreads"],["75 g","Greek Style Natural Yoghurt"],["20 g","Wild Rocket"],["50 g","Greek Style Salad Cheese"],["1 tsp","Sugar for the Pickle"],["0.5 tsp","Sugar for the Sauce"],["1.5 tbsp","Water for the Sauce"],["1 tbsp","Honey"],["0.5 tbsp","Olive Oil for the Dressing"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["450 g","Potatoes"],["1","Aubergine"],["1","Echalion Shallot"],["12 ml","Red Wine Vinegar"],["60 g","Tomato Puree"],["1 bunch","Mint"],["2","Greek Style Flatbreads"],["75 g","Greek Style Natural Yoghurt"],["20 g","Wild Rocket"],["50 g","Greek Style Salad Cheese"],["1 tsp","Sugar for the Pickle"],["0.5 tsp","Sugar for the Sauce"],["1.5 tbsp","Water for the Sauce"],["1 tbsp","Honey"],["0.5 tbsp","Olive Oil for the Dressing"]],"ingredientMeta":[{"id":"5a39929ec9fd0814815939c2","name":"Potatoes","type":"potatoes","family":"potato","amount":"450 g","sourceAmount":450,"sourceUnit":"grams","shipped":true,"shoppingName":"Potatoes","marketLabel":"potatoes 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6363fd2cb959598b4570","name":"Aubergine","type":"aubergine","family":"aubergine","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Aubergine","marketLabel":"aubergine","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5568817d4dab71121f8b4568","name":"Echalion Shallot","type":"echalion shallot","family":"onion","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Echalion Shallot","marketLabel":"brown onions 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555ca1774dab7190138b4568","name":"Red Wine Vinegar","type":"red wine vinegar","family":"vinegar","amount":"12 ml","sourceAmount":12,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Red Wine Vinegar","marketLabel":"cooking vinegar equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a708af8b25ef93e8b4567","name":"Tomato Puree","type":"tomato-puree","family":"single ingredient paste","amount":"60 g","sourceAmount":60,"sourceUnit":"grams","shipped":true,"shoppingName":"Tomato Puree","marketLabel":"tomato puree 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5e96f8b25e1e268b4578","name":"Mint","type":"mint","family":"mint","amount":"1 bunch","sourceAmount":1,"sourceUnit":"bunch(es)","shipped":true,"shoppingName":"Mint","marketLabel":"fresh mint 30g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"690e1cf948e7b2ec1b11f101","name":"Greek Style Flatbreads","type":"greek-flatbreads","family":"bread dough","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Greek Style Flatbreads","marketLabel":"flatbreads x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a56e74dab71d76f8b4570","name":"Greek Style Natural Yoghurt","type":"natural-yoghurt","family":"yogurt","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Greek Style Natural Yoghurt","marketLabel":"yoghurts pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555092a4f8b25ed3468b4569","name":"Wild Rocket","type":"rocket","family":"salad mix","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Wild Rocket","marketLabel":"rocket 60g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6764b4a77de812ab26271141","name":"Greek Style Salad Cheese","type":"greek-style-cheese","family":"none","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Greek Style Salad Cheese","marketLabel":"feta 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5e3416f081143769dd33ba49","name":"Sugar for the Pickle","type":"sugar-for-the-pickle-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Pickle","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb612688281450b8bd07c","name":"Sugar for the Sauce","type":"sugar-for-the-sauce-1-tsp","family":"single spice","amount":"0.5 tsp","sourceAmount":0.5,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Sauce","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60b8a3c08b148d1530c49fb7","name":"Water for the Sauce","type":"water-for-the-sauce","family":"other drink","amount":"1.5 tbsp","sourceAmount":1.5,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"6172cb313021d49a7feafc84","name":"Honey","type":"honey-1-tbsp","family":"honey","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb168688281450b8bd062","name":"Olive Oil for the Dressing","type":"olive-oil-for-the-dressing-1-tbsp","family":"oil","amount":"0.5 tbsp","sourceAmount":0.5,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Olive Oil for the Dressing","marketLabel":"cooking oil 1 litre","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Chop the potatoes into 2cm chunks (no need to peel). Pop the chunks onto a large baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Spread out in a single layer. Use two baking trays if necessary. When the oven is hot, roast on the middle shelf until golden, 30-40 mins. Turn halfway through.","Meanwhile, trim the aubergine, then halve lengthways. Slice widthways into 1cm pieces. Pop the aubergine onto another baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Spread out in a single layer. Roast the aubergine on the top shelf until soft and golden, 18-20 mins. Turn halfway through.","While everything roasts, halve, peel and thinly slice the shallot. In a medium bowl, mix the shallot, red wine vinegar, sugar for the pickle (use the quantities listed in the ingredients) and a pinch of salt, then set aside to pickle. In a small bowl, mix the tomato puree, sugar and water for the sauce (use the quantities listed in the ingredients). Season with salt and pepper. Pick the mint leaves from their stalks and roughly chop (discard the stalks).","Place the flatbreads (use the amount listed in the ingredients) onto another baking tray and spread the tomato sauce across the top of each one. When the aubergine has 5 mins remaining, warm the flatbreads through on the bottom shelf of your oven until warm and starting to turn golden, 3-4 mins. Meanwhile, wipe out the (now empty) small bowl, then add the Greek style yoghurt and half the mint. Season with salt and pepper, then mix together.","When the aubergine has roasted, drizzle over the honey (use the quantities listed in the ingredients) and toss to coat. Add the rocket to the pickled shallot. Drizzle with olive oil for the dressing (use the quantities listed in the ingredients) and toss to coat.","Share the flatbreads between your plates. Top with the roasted aubergine and some pickled shallot and rocket salad. Drizzle over the mint yoghurt dressing, then crumble on the Greek style salad cheese. Sprinkle over the remaining mint. Serve the roasted potatoes alongside."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adc0d1101204cae74ee11/step-60e6ec00.jpg","caption":"Roast the Potatoes"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adc0d1101204cae74ee11/step-e17ecd10.jpg","caption":"Aubergine Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adc0d1101204cae74ee11/step-c23bc920.jpg","caption":"Get in a Pickle"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adc0d1101204cae74ee11/step-8f83d930.jpg","caption":"Bake your Flatbreads"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adc0d1101204cae74ee11/step-7b2ce540.jpg","caption":"Finishing Touches"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adc0d1101204cae74ee11/step-b0679a50.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/pide-inspired-aubergine-flatbreads-693adc0d1101204cae74ee11","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/pide-inspired-aubergine-flatbreads-693adc0d1101204cae74ee11","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"wrap","shoppingIngredients":[["450 g","Potatoes"],["1","Aubergine"],["1","Echalion Shallot"],["12 ml","Red Wine Vinegar"],["60 g","Tomato Puree"],["1 bunch","Mint"],["2","Greek Style Flatbreads"],["75 g","Greek Style Natural Yoghurt"],["20 g","Wild Rocket"],["50 g","Greek Style Salad Cheese"],["1 tsp","Sugar for the Pickle"],["0.5 tsp","Sugar for the Sauce"],["1.5 tbsp","Water for the Sauce"],["1 tbsp","Honey"],["0.5 tbsp","Olive Oil for the Dressing"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-693adbfe1101204cae74eddc","sourceId":"693adbfe1101204cae74eddc","title":"Quick Teriyaki Ginger Beef Noodles","subtitle":"with Pak Choi, Young Pea Pods and Lime","time":20,"cost":16.81,"servings":2,"scaleSafe":true,"tags":["high protein","quick","calorie smart","pan-asian-plates","noodle-stir-fry","healthy options","asian","beef","pasta"],"requiredEquipment":[],"sourceEquipment":["Garlic Press","Kettle","Sieve","Medium Saucepan","Pan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R55_W09_UK_QR12710-24_Main_5_high-d5aced50.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/quick-teriyaki-ginger-beef-noodles-693adbfe1101204cae74eddc","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1","Pak Choi"],["0.5","Lime"],["2","Garlic Clove"],["125 g","Egg Noodle Nest"],["240 g","British Beef Mince"],["80 g","Young Pea Pods"],["15 g","Ginger Puree"],["1 sachet","Chinese Five Spice"],["15 g","Sambal Paste"],["75 g","Teriyaki Sauce"],["10 ml","Soy Sauce"],["50 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1","Pak Choi"],["0.5","Lime"],["2","Garlic Clove"],["125 g","Egg Noodle Nest"],["240 g","British Beef Mince"],["80 g","Young Pea Pods"],["15 g","Ginger Puree"],["1 sachet","Chinese Five Spice"],["15 g","Sambal Paste"],["75 g","Teriyaki Sauce"],["10 ml","Soy Sauce"],["50 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"697cbee6d608bbef6ca06f3f","name":"Pak Choi","type":"bok-choy","family":"vegetable mix","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Pak Choi","marketLabel":"pak choi x2","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6e2a4dab71a9058b4569","name":"Lime","type":"lime","family":"lime","amount":"0.5","sourceAmount":0.5,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lime","marketLabel":"limes x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68373080f7d5496ac4a65cdc","name":"Egg Noodle Nest","type":"egg-noodle-nest","family":"other noodle","amount":"125 g","sourceAmount":125,"sourceUnit":"grams","shipped":true,"shoppingName":"Egg Noodle Nest","marketLabel":"egg noodles 4 nests","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556c1c67fd2cb99f468b4567","name":"British Beef Mince","type":"beef mince","family":"beef","amount":"240 g","sourceAmount":240,"sourceUnit":"grams","shipped":true,"shoppingName":"British Beef Mince","marketLabel":"5% fat beef mince 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"66d08ea0a3a9934710b37319","name":"Young Pea Pods","type":"young-pea-pods","family":"none","amount":"80 g","sourceAmount":80,"sourceUnit":"grams","shipped":true,"shoppingName":"Young Pea Pods","marketLabel":"fresh green vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"59f334f92c3e085ecd21b7f2","name":"Ginger Puree","type":"ginger-puree","family":"ginger","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Ginger Puree","marketLabel":"fresh ginger 100g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"57b1d87177d68d1f068b4567","name":"Chinese Five Spice","type":"chinese-5-spice","family":"spice blend","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Chinese Five Spice","marketLabel":"seasoning blend equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60accf96e728ee63dd0d01d2","name":"Sambal Paste","type":"sambal","family":"Chili sauce","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Sambal Paste","marketLabel":"cooking paste equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"67f0611cb777f3317f54763f","name":"Teriyaki Sauce","type":"teriyaki-sauce","family":"sauce","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Teriyaki Sauce","marketLabel":"teriyaki sauce 150ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"680b9d014a6668c89d92df5a","name":"Soy Sauce","type":"soy sauce","family":"sauce","amount":"10 ml","sourceAmount":10,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Soy Sauce","marketLabel":"soy sauce 150ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"50 ml","sourceAmount":50,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Boil a half-full kettle. Trim the pak choi, then thinly slice widthways. Cut the lime into wedges (use the amount listed in the ingredients). Peel and grate the garlic (or use a garlic press).","Pour the boiled water into a medium saucepan with ½ tsp salt and bring back to the boil. Add the noodles and cook until tender, 4 mins. Once cooked, drain in a sieve and run under cold water to stop the noodles sticking together.","Meanwhile, heat a large frying pan on medium-high heat (no oil). Once hot, add the beef mince and fry until browned, 5-6 mins. Use a spoon to break it up as it cooks, then drain and discard any excess fat. Wash your hands and equipment after handling raw mince. It's cooked when no longer pink in the middle.","Once the beef is cooked, turn the heat down to medium. Add the young pea pods, garlic, ginger puree, Chinese Five Spice and pak choi. Fry until fragrant, 2-3 min. Pour in the sambal, teriyaki sauce, soy sauce and water for the sauce (use the quantities listed in the ingredients). Stir to combine and simmer until glossy, 1-2 min.","Toss the cooked noodles into the sauce until coated and piping hot, 1 min. Add a squeeze of lime juice from a lime wedge. Taste and season with salt and pepper if needed.","When ready, share the fragrant beef noodles between your bowls. Serve the remaining lime wedges alongside for squeezing over."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbfe1101204cae74eddc/step-69108300.jpg","caption":"Get Prepped"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbfe1101204cae74eddc/step-58b0d210.jpg","caption":"Bring on the Noodles"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbfe1101204cae74eddc/step-694fd120.jpg","caption":"Fry the Beef"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbfe1101204cae74eddc/step-3780dc30.jpg","caption":"Sauce Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbfe1101204cae74eddc/step-da3e8040.jpg","caption":"Combine and Stir"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbfe1101204cae74eddc/step-feab7b50.jpg","caption":"Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/quick-teriyaki-ginger-beef-noodles-693adbfe1101204cae74eddc","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/quick-teriyaki-ginger-beef-noodles-693adbfe1101204cae74eddc","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"pasta","shoppingIngredients":[["1","Pak Choi"],["0.5","Lime"],["2","Garlic Clove"],["125 g","Egg Noodle Nest"],["240 g","British Beef Mince"],["80 g","Young Pea Pods"],["15 g","Ginger Puree"],["1 sachet","Chinese Five Spice"],["15 g","Sambal Paste"],["75 g","Teriyaki Sauce"],["10 ml","Soy Sauce"],["50 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-693adbba1101204cae74eccb","sourceId":"693adbba1101204cae74eccb","title":"Stir-Fried Hoisin Chicken Noodles","subtitle":"with Baby Corn and Young Pea Pods","time":25,"cost":18.44,"servings":2,"scaleSafe":true,"tags":["high protein","quick","calorie smart","pan-asian-plates","noodle-stir-fry","healthy options","chinese","poultry","pasta"],"requiredEquipment":[],"sourceEquipment":["Garlic Press","Sieve","Large Saucepan","Pan","Bowl"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R56_W09_UK_QR23178-12_Main_7_high-d16a0197.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/stir-fried-hoisin-chicken-noodles-693adbba1101204cae74eccb","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["60 g","Baby Corn"],["80 g","Young Pea Pods"],["2","Garlic Clove"],["125 g","Egg Noodle Nest"],["240 g","Diced British Chicken Breast"],["15 g","Ginger Puree"],["60 g","Hoisin Sauce"],["10 ml","Soy Sauce"],["16 ml","Sriracha Sauce"],["5 g","Roasted White Sesame Seeds"],["1 tbsp","Honey"],["75 ml","Water for the Sauce"],["as needed","cooking oil"]],"sourceIngredients":[["60 g","Baby Corn"],["80 g","Young Pea Pods"],["2","Garlic Clove"],["125 g","Egg Noodle Nest"],["240 g","Diced British Chicken Breast"],["15 g","Ginger Puree"],["60 g","Hoisin Sauce"],["10 ml","Soy Sauce"],["16 ml","Sriracha Sauce"],["5 g","Roasted White Sesame Seeds"],["1 tbsp","Honey"],["75 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"556876f2fd2cb983298b4569","name":"Baby Corn","type":"baby corn","family":"corn","amount":"60 g","sourceAmount":60,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Corn","marketLabel":"fresh vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"66d08ea0a3a9934710b37319","name":"Young Pea Pods","type":"young-pea-pods","family":"none","amount":"80 g","sourceAmount":80,"sourceUnit":"grams","shipped":true,"shoppingName":"Young Pea Pods","marketLabel":"fresh green vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68373080f7d5496ac4a65cdc","name":"Egg Noodle Nest","type":"egg-noodle-nest","family":"other noodle","amount":"125 g","sourceAmount":125,"sourceUnit":"grams","shipped":true,"shoppingName":"Egg Noodle Nest","marketLabel":"egg noodles 4 nests","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6390aea605fc26d5313f23d2","name":"Diced British Chicken Breast","type":"chicken-breast-diced","family":"none","amount":"240 g","sourceAmount":240,"sourceUnit":"grams","shipped":true,"shoppingName":"Diced British Chicken Breast","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"59f334f92c3e085ecd21b7f2","name":"Ginger Puree","type":"ginger-puree","family":"ginger","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Ginger Puree","marketLabel":"fresh ginger 100g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5568784e4dab71d51e8b4569","name":"Hoisin Sauce","type":"hoisin-sauce","family":"asian paste","amount":"60 g","sourceAmount":60,"sourceUnit":"grams","shipped":true,"shoppingName":"Hoisin Sauce","marketLabel":"Asian cooking sauce equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"680b9d014a6668c89d92df5a","name":"Soy Sauce","type":"soy sauce","family":"sauce","amount":"10 ml","sourceAmount":10,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Soy Sauce","marketLabel":"soy sauce 150ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5c3f3eadc445fa4233599443","name":"Sriracha Sauce","type":"sriracha (anchovy)","family":"Chili sauce","amount":"16 ml","sourceAmount":16,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Sriracha Sauce","marketLabel":"table sauce equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68371fa942dc4b928197f185","name":"Roasted White Sesame Seeds","type":"roasted-white-sesame-seeds","family":"sesame seed","amount":"5 g","sourceAmount":5,"sourceUnit":"grams","shipped":true,"shoppingName":"Roasted White Sesame Seeds","marketLabel":"sesame seeds 100g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6172cb313021d49a7feafc84","name":"Honey","type":"honey-1-tbsp","family":"honey","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"75 ml","sourceAmount":75,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Halve the baby corn lengthways. Cut the young pea pods in half lengthways. Peel and grate the garlic (or use a garlic press).","Meanwhile, bring a large saucepan of water to the boil with ½ tsp salt for the noodles. When boiling, add the noodles and cook until tender, 4 mins. Once the noodles are cooked, drain in a sieve and run under cold water to stop them sticking together. Set aside for later.","Heat a drizzle of oil in a large frying pan on medium-high. Once hot, add the chicken. Stir-fry until the chicken is golden brown and cooked through, 8-10 mins. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Wash your hands and equipment after handling raw chicken. It's cooked when no longer pink in the middle. Add the garlic and ginger puree, stir-fry until fragrant, 1 min.","While the chicken cooks, in a small bowl, combine the hoisin sauce, soy sauce, sriracha, honey and water for the sauce (use the quantities listed in the ingredients).","Once everything's cooked, add the noodles, baby corn, pea pods and hoisin glaze to the chicken. Mix well to combine and simmer until everything's piping hot and the sauce has thickened slightly, 2-3 mins. Season to taste. Add a splash of water if you feel it needs it.","Share the hoisin chicken noodles between your bowls. Sprinkle over the sesame seeds to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbba1101204cae74eccb/step-a9032b00.jpg","caption":"Prep the Veg"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbba1101204cae74eccb/step-253bf710.jpg","caption":"Cook the Noodles"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbba1101204cae74eccb/step-a69b9320.jpg","caption":"Stir-Fry the Chicken"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbba1101204cae74eccb/step-6bf68830.jpg","caption":"Make the Hoisin Glaze"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbba1101204cae74eccb/step-848f9a40.jpg","caption":"Combine and Stir"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693adbba1101204cae74eccb/step-26573250.jpg","caption":"Time to Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/stir-fried-hoisin-chicken-noodles-693adbba1101204cae74eccb","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/stir-fried-hoisin-chicken-noodles-693adbba1101204cae74eccb","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"pasta","shoppingIngredients":[["60 g","Baby Corn"],["80 g","Young Pea Pods"],["2","Garlic Clove"],["125 g","Egg Noodle Nest"],["240 g","Diced British Chicken Breast"],["15 g","Ginger Puree"],["60 g","Hoisin Sauce"],["10 ml","Soy Sauce"],["16 ml","Sriracha Sauce"],["5 g","Roasted White Sesame Seeds"],["1 tbsp","Honey"],["75 ml","Water for the Sauce"],["as needed","cooking oil"]],"isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-693ada5c1101204cae74ebb1","sourceId":"693ada5c1101204cae74ebb1","title":"Easy Sun-Dried Tomato Chorizo Linguine","subtitle":"with Peas, Rocket and Balsamic Glaze","time":25,"cost":15.75,"servings":2,"scaleSafe":true,"tags":["family friendly","quick","mediterranean","pasta-noodles","italian","pork","pasta"],"requiredEquipment":[],"sourceEquipment":["Colander","Large Saucepan","Pan","Garlic Press"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y23_R09_W32_UK_G11648-13273-9_add_ruccola_edit_Main_high-ea924b3c.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/easy-sun-dried-tomato-chorizo-linguine-693ada5c1101204cae74ebb1","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["180 g","Linguine"],["2","Garlic Clove"],["90 g","Diced Chorizo"],["10 g","Chicken Stock Paste"],["150 g","Creme Fraiche"],["120 g","Peas"],["25 g","Sun-Dried Tomato Paste"],["40 g","Grated Hard Italian Style Cheese"],["20 g","Wild Rocket"],["12 g","Balsamic Glaze"],["75 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["180 g","Linguine"],["2","Garlic Clove"],["90 g","Diced Chorizo"],["10 g","Chicken Stock Paste"],["150 g","Creme Fraiche"],["120 g","Peas"],["25 g","Sun-Dried Tomato Paste"],["40 g","Grated Hard Italian Style Cheese"],["20 g","Wild Rocket"],["12 g","Balsamic Glaze"],["75 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"68373081d9848b9dac050010","name":"Linguine","type":"linguine","family":"other noodle","amount":"180 g","sourceAmount":180,"sourceUnit":"grams","shipped":true,"shoppingName":"Linguine","marketLabel":"pasta 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"66ab6339f66002bbd100b304","name":"Diced Chorizo","type":"chorizo-diced","family":"none","amount":"90 g","sourceAmount":90,"sourceUnit":"grams","shipped":true,"shoppingName":"Diced Chorizo","marketLabel":"prepared pork product equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60002d898c8c0a188200a96d","name":"Chicken Stock Paste","type":"chicken-stock-paste","family":"stock concentrate","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":true,"shoppingName":"Chicken Stock Paste","marketLabel":"chicken stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555084f34dab718e128b4569","name":"Creme Fraiche","type":"creme-fraiche","family":"soured cream","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"Creme Fraiche","marketLabel":"creme fraiche 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556d6384fd2cb954078b4567","name":"Peas","type":"peas","family":"peas","amount":"120 g","sourceAmount":120,"sourceUnit":"grams","shipped":true,"shoppingName":"Peas","marketLabel":"garden peas 910g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5f327c6560efd3453038c2a8","name":"Sun-Dried Tomato Paste","type":"sundried-tomato-paste-duplicate","family":"single ingredient paste","amount":"25 g","sourceAmount":25,"sourceUnit":"grams","shipped":true,"shoppingName":"Sun-Dried Tomato Paste","marketLabel":"sun-dried tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5550865efd2cb974658b4568","name":"Grated Hard Italian Style Cheese","type":"grated-hard-italian-style-cheese-duplicate","family":"hard cheese","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Grated Hard Italian Style Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555092a4f8b25ed3468b4569","name":"Wild Rocket","type":"rocket","family":"salad mix","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Wild Rocket","marketLabel":"rocket 60g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6099506c9c6d58742c5645ca","name":"Balsamic Glaze","type":"balsamic-glaze","family":"vinegar","amount":"12 g","sourceAmount":12,"sourceUnit":"grams","shipped":true,"shoppingName":"Balsamic Glaze","marketLabel":"balsamic glaze equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"75 ml","sourceAmount":75,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Bring a large saucepan of water to the boil with ½ tsp salt. When boiling, add the linguine to the water and bring back to the boil. Cook until tender, 12 mins. Once the pasta is cooked, drain in a colander and pop back in the pan. Drizzle with oil and stir through to stop it sticking together.","While the pasta cooks, peel and grate the garlic (or use a garlic press). Heat a drizzle of oil in a large frying pan on medium-high heat.","Once the oil is hot, add the chorizo and fry until it starts to brown, 3-4 mins. Next, add the garlic and stir-fry for 30 secs.","Stir the chicken stock paste, creme fraiche and water for the sauce (use the quantities listed in the ingredients) into the pan. Bring to the boil, then lower the heat and simmer until thickened, 2-3 mins.","Once the sauce has thickened, stir in the peas, sun-dried tomato paste and the hard Italian style cheese. Cook until the peas are piping hot, 1-2 mins. Stir in the cooked pasta. Taste and season with salt and pepper if needed. Add a splash of water if it's a little too thick.","Share the creamy chorizo linguine between your bowls. Top with a handful of rocket and drizzle over the balsamic glaze to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada5c1101204cae74ebb1/step-832a8100.jpg","caption":"Cook the Pasta"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada5c1101204cae74ebb1/step-24d97a10.jpg","caption":"Garlic Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada5c1101204cae74ebb1/step-02ce7620.jpg","caption":"Fry the Chorizo"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada5c1101204cae74ebb1/step-4190f930.jpg","caption":"Make your Creamy Sauce"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada5c1101204cae74ebb1/step-24981640.jpg","caption":"Peas and Cheese Please"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada5c1101204cae74ebb1/step-952f6650.jpg","caption":"Finish and Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/easy-sun-dried-tomato-chorizo-linguine-693ada5c1101204cae74ebb1","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/easy-sun-dried-tomato-chorizo-linguine-693ada5c1101204cae74ebb1","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"pasta","shoppingIngredients":[["180 g","Linguine"],["2","Garlic Clove"],["90 g","Diced Chorizo"],["10 g","Chicken Stock Paste"],["150 g","Creme Fraiche"],["120 g","Peas"],["25 g","Sun-Dried Tomato Paste"],["40 g","Grated Hard Italian Style Cheese"],["20 g","Wild Rocket"],["12 g","Balsamic Glaze"],["75 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-693ada31dce6a2dc39a7e8ba","sourceId":"693ada31dce6a2dc39a7e8ba","title":"Stovetop Goat's Cheese, Chicken and Sun-Dried Tomato Risotto","subtitle":"with Roasted Tomato Parcel and Rocket","time":40,"cost":25.64,"servings":2,"scaleSafe":true,"tags":["mediterranean","pasta-noodles","high protein","italian","poultry","rice","cook"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Garlic Press","Aluminum Foil","Measuring Jug","Kettle","Large Saucepan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y24_R43_W05_UK_R3148-18_Main_R_R3148-AP-1-1_var_high-b9ec67ee.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/stovetop-goats-cheese-chicken-and-sun-dried-tomato-risotto-693ada31dce6a2dc39a7e8ba","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["2","Garlic Clove"],["1","Onion"],["125 g","Baby Plum Tomatoes"],["20 g","Vegetable Stock Paste"],["175 g","Risotto Rice"],["25 g","Sun-Dried Tomato Paste"],["20 g","Grated Hard Italian Style Cheese"],["75 g","Goat's Cheese"],["20 g","Wild Rocket"],["12 g","Balsamic Glaze"],["240 g","Diced British Chicken Breast"],["1 tbsp","Honey"],["800 ml","Water for the Stock"],["30 g","Butter"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["2","Garlic Clove"],["1","Onion"],["125 g","Baby Plum Tomatoes"],["20 g","Vegetable Stock Paste"],["175 g","Risotto Rice"],["25 g","Sun-Dried Tomato Paste"],["20 g","Grated Hard Italian Style Cheese"],["75 g","Goat's Cheese"],["20 g","Wild Rocket"],["12 g","Balsamic Glaze"],["240 g","Diced British Chicken Breast"],["1 tbsp","Honey"],["800 ml","Water for the Stock"],["30 g","Butter"]],"ingredientMeta":[{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a59324dab71626c8b4575","name":"Onion","type":"onion","family":"onion","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Onion","marketLabel":"brown onions 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5a3cee59c2880024501f6622","name":"Baby Plum Tomatoes","type":"baby-plum-tomatoes","family":"tomato","amount":"125 g","sourceAmount":125,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Plum Tomatoes","marketLabel":"fresh fruit equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"641093570565a60137055ba9","name":"Vegetable Stock Paste","type":"vegetable-stock-paste","family":"stock concentrate","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Vegetable Stock Paste","marketLabel":"vegetable stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5992fd2cb95a598b456a","name":"Risotto Rice","type":"risotto-rice","family":"rice","amount":"175 g","sourceAmount":175,"sourceUnit":"grams","shipped":true,"shoppingName":"Risotto Rice","marketLabel":"risotto rice 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5f327c6560efd3453038c2a8","name":"Sun-Dried Tomato Paste","type":"sundried-tomato-paste-duplicate","family":"single ingredient paste","amount":"25 g","sourceAmount":25,"sourceUnit":"grams","shipped":true,"shoppingName":"Sun-Dried Tomato Paste","marketLabel":"sun-dried tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5550865efd2cb974658b4568","name":"Grated Hard Italian Style Cheese","type":"grated-hard-italian-style-cheese-duplicate","family":"hard cheese","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Grated Hard Italian Style Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"69008edb29be8924040c8492","name":"Goat's Cheese","type":"goat's cheese","family":"hard cheese","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Goat's Cheese","marketLabel":"porridge oats 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555092a4f8b25ed3468b4569","name":"Wild Rocket","type":"rocket","family":"salad mix","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Wild Rocket","marketLabel":"rocket 60g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6099506c9c6d58742c5645ca","name":"Balsamic Glaze","type":"balsamic-glaze","family":"vinegar","amount":"12 g","sourceAmount":12,"sourceUnit":"grams","shipped":true,"shoppingName":"Balsamic Glaze","marketLabel":"balsamic glaze equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6390aea605fc26d5313f23d2","name":"Diced British Chicken Breast","type":"chicken-breast-diced","family":"none","amount":"240 g","sourceAmount":240,"sourceUnit":"grams","shipped":true,"shoppingName":"Diced British Chicken Breast","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6172cb313021d49a7feafc84","name":"Honey","type":"honey-1-tbsp","family":"honey","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"574f08ebfd2cb9e7538b4568","name":"Water for the Stock","type":"water-for-the-stock-100ml","family":"other drink","amount":"800 ml","sourceAmount":800,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Stock","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"60c73507053f5e815cd52d5b","name":"Butter","type":"butter-100g","family":"butter","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":false,"shoppingName":"Butter","marketLabel":"butter 500g","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Peel and grate the garlic (or use a garlic press). Halve, peel and chop the onion into small pieces. Halve the tomatoes and pop them onto a piece of foil with a drizzle of oil, the honey (use the quantities listed in the ingredients) and a pinch of salt and pepper. Fold the foil, sealing on all sides to create a parcel, then pop it onto a baking tray.","Boil a full kettle. Pour the boiled water for the stock (use the quantities listed in the ingredients) into a large measuring jug. Stir in the veg stock paste - this is your stock. When the oven is hot, roast the tomato parcel on the bottom shelf until softened, 15-20 mins. If you prefer oven-baking your risotto, use an ovenproof pan in the next step and 2p: 600ml, 3p: 900ml, 4p: 1200ml of boiled water.","Meanwhile, heat a drizzle of oil in a large, wide-bottomed saucepan on medium heat. Once hot, add the diced chicken and onion to the pan and season with salt and pepper. Cook until browned all over, 5-6 mins. Turn occasionally. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Wash your hands and equipment after handling raw chicken. Stir in the garlic and cook for 1 min. Add the risotto rice, then stir and cook until the edges of the rice are translucent, 1-2 mins.","Pour in a third of the stock and stir to combine. Bring to the boil and simmer until absorbed, then repeat with the remaining stock, a third at a time. Stir occasionally. The total cooking time should take 20-25 mins and your risotto is done when the rice is ‘al dente’ - cooked through but with a tiny bit of firmness left in the middle. The chicken is cooked when no longer pink in the middle. For oven-baking, pour in all the water at once and cover with a lid or foil. Bake until the water has been absorbed, 25-30 mins.","Once the risotto is cooked, stir in the roasted tomatoes (discarding the juices), sun-dried tomato paste, hard Italian style cheese and butter (use the quantities listed in the ingredients) until combined. Taste and season with salt and pepper if needed. Crumble in half the goat's cheese and stir through. Remove from the heat. Add a splash of water to loosen the risotto to your desired consistency.","Share the tomato risotto between your bowls and crumble over the remaining goat's cheese. Top with a handful of rocket. Drizzle over the balsamic glaze."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada31dce6a2dc39a7e8ba/step-ce366600.jpg","caption":"Get Prepped"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada31dce6a2dc39a7e8ba/step-5f901610.jpg","caption":"Make the Stock"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada31dce6a2dc39a7e8ba/step-5731a520.jpg","caption":"Build the Flavour"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada31dce6a2dc39a7e8ba/step-b1fb7830.jpg","caption":"Cook your Risotto"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada31dce6a2dc39a7e8ba/step-46bb2c40.jpg","caption":"Finishing Touches"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada31dce6a2dc39a7e8ba/step-7082dc50.jpg","caption":"Finish and Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/stovetop-goats-cheese-chicken-and-sun-dried-tomato-risotto-693ada31dce6a2dc39a7e8ba","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/stovetop-goats-cheese-chicken-and-sun-dried-tomato-risotto-693ada31dce6a2dc39a7e8ba","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"rice","shoppingIngredients":[["2","Garlic Clove"],["1","Onion"],["125 g","Baby Plum Tomatoes"],["20 g","Vegetable Stock Paste"],["175 g","Risotto Rice"],["25 g","Sun-Dried Tomato Paste"],["20 g","Grated Hard Italian Style Cheese"],["75 g","Goat's Cheese"],["20 g","Wild Rocket"],["12 g","Balsamic Glaze"],["240 g","Diced British Chicken Breast"],["1 tbsp","Honey"],["800 ml","Water for the Stock"],["30 g","Butter"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-693ada2f1101204cae74eb77","sourceId":"693ada2f1101204cae74eb77","title":"Creamy Curried Cauliflower Soup","subtitle":"with Roasted Chickpeas and Cheese","time":30,"cost":14.22,"servings":2,"scaleSafe":true,"tags":["calorie smart","veggie","south/southeastasian","soup-stew","low carb","indian","soup","quick"],"requiredEquipment":[],"sourceEquipment":["Bowl","Baking Tray","Sieve","Garlic Press","Large Saucepan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y23_R20_W33_UK_V13414-3_Main_3_high-644aae85.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/creamy-curried-cauliflower-soup-693ada2f1101204cae74eb77","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1 carton","Chickpeas"],["300 g","Cauliflower Florets"],["1 sachet","Curry Powder Mix"],["2","Garlic Clove"],["50 g","Korma Curry Paste"],["15 g","Ginger Puree"],["15 g","Vegetable Stock Paste"],["40 g","Baby Spinach"],["150 g","Creme Fraiche"],["50 g","Greek Style Salad Cheese"],["1 sachet","Chilli Flakes"],["1 tsp","Sugar for the Sauce"],["400 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1 carton","Chickpeas"],["300 g","Cauliflower Florets"],["1 sachet","Curry Powder Mix"],["2","Garlic Clove"],["50 g","Korma Curry Paste"],["15 g","Ginger Puree"],["15 g","Vegetable Stock Paste"],["40 g","Baby Spinach"],["150 g","Creme Fraiche"],["50 g","Greek Style Salad Cheese"],["1 sachet","Chilli Flakes"],["1 tsp","Sugar for the Sauce"],["400 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"554a6387fd2cb99c598b4568","name":"Chickpeas","type":"organic chickpeas","family":"canned chickpeas","amount":"1 carton","sourceAmount":1,"sourceUnit":"carton(s)","shipped":true,"shoppingName":"Chickpeas","marketLabel":"chickpeas 400g, 240g drained","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5a5395e12c3e0807d6076ae2","name":"Cauliflower Florets","type":"cauliflower-florets","family":"cauliflower","amount":"300 g","sourceAmount":300,"sourceUnit":"grams","shipped":true,"shoppingName":"Cauliflower Florets","marketLabel":"cauliflower","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556827b74dab71b6178b4567","name":"Curry Powder Mix","type":"curry-powder","family":"spice blend","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Curry Powder Mix","marketLabel":"curry spice blend equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5de10b3aa28b1766010e3f86","name":"Korma Curry Paste","type":"korma-curry-paste","family":"spice blend","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Korma Curry Paste","marketLabel":"curry paste jar","marketChecked":true,"priceMatchType":"source-identity"},{"id":"59f334f92c3e085ecd21b7f2","name":"Ginger Puree","type":"ginger-puree","family":"ginger","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Ginger Puree","marketLabel":"fresh ginger 100g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"641093570565a60137055ba9","name":"Vegetable Stock Paste","type":"vegetable-stock-paste","family":"stock concentrate","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Vegetable Stock Paste","marketLabel":"vegetable stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555c9dd5fd2cb92f6c8b4569","name":"Baby Spinach","type":"baby spinach","family":"spinach","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Spinach","marketLabel":"spinach 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555084f34dab718e128b4569","name":"Creme Fraiche","type":"creme-fraiche","family":"soured cream","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"Creme Fraiche","marketLabel":"creme fraiche 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6764b4a77de812ab26271141","name":"Greek Style Salad Cheese","type":"greek-style-cheese","family":"none","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Greek Style Salad Cheese","marketLabel":"feta 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5fe8f8b25e1e268b4579","name":"Chilli Flakes","type":"chilli flakes","family":"spice blend","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Chilli Flakes","marketLabel":"chilli flakes 45g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb612688281450b8bd07c","name":"Sugar for the Sauce","type":"sugar-for-the-sauce-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Sauce","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"400 ml","sourceAmount":400,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Drain and rinse the chickpeas in a sieve. Transfer half to a small bowl and crush with the back of a fork. Pop the remaining whole chickpeas onto a large baking tray. Halve any large cauliflower florets, then add them to the baking tray. Drizzle with oil, sprinkle over the curry powder, then season with salt and pepper. Toss to coat, then spread out in a single layer. When the oven is hot, roast on the top shelf until golden brown and tender, 15-20 mins. Turn halfway through.","Meanwhile, peel and grate the garlic (or use a garlic press).","Heat a drizzle of oil in a large saucepan on medium-high heat. Once hot, add the garlic, korma curry paste and ginger puree. Cook, stirring, until fragrant, 1 min.","Add the crushed chickpeas, vegetable stock paste, sugar and water for the sauce (use the quantities listed in the ingredients) to the saucepan. Stir until combined. Bring to the boil, then lower the heat and simmer until thickened, 6-8 mins.","When the soup has thickened, stir in the spinach a handful at a time until wilted and piping hot, 2-3 mins. Stir through the creme fraiche and half the roasted cauliflower. Taste and season with salt and pepper if needed. Bring the soup back to a simmer until piping hot, then remove from the heat to serve.","Share the creamy curried soup between your serving bowls. Top with the remaining roasted cauliflower and the roasted chickpeas. Crumble over the Greek style salad cheese and finish with a sprinkle of chilli flakes if you'd like."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada2f1101204cae74eb77/step-45bd1e00.jpg","caption":"Roast the Cauli and Chickpeas"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada2f1101204cae74eb77/step-8825a810.jpg","caption":"Garlic Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada2f1101204cae74eb77/step-013e5520.jpg","caption":"Build the Flavour"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada2f1101204cae74eb77/step-cb68c030.jpg","caption":"Simmer and Stir"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada2f1101204cae74eb77/step-5c510c40.jpg","caption":"Finish your Soup"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693ada2f1101204cae74eb77/step-83a64f50.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/creamy-curried-cauliflower-soup-693ada2f1101204cae74eb77","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/creamy-curried-cauliflower-soup-693ada2f1101204cae74eb77","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"soup","shoppingIngredients":[["1 carton","Chickpeas"],["300 g","Cauliflower Florets"],["1 sachet","Curry Powder Mix"],["2","Garlic Clove"],["50 g","Korma Curry Paste"],["15 g","Ginger Puree"],["15 g","Vegetable Stock Paste"],["40 g","Baby Spinach"],["150 g","Creme Fraiche"],["50 g","Greek Style Salad Cheese"],["1 sachet","Chilli Flakes"],["1 tsp","Sugar for the Sauce"],["400 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-6914a9a5623e0c85b6821fd0","sourceId":"6914a9a5623e0c85b6821fd0","title":"Chicken Milanese on Jerk Spiced Bacon Spaghetti","subtitle":"with Bell Pepper and Wild Rocket","time":30,"cost":31.14,"servings":2,"scaleSafe":true,"tags":["world-flavors","pasta-noodles","medium spice","high protein","fusion","poultry","pasta","quick"],"requiredEquipment":[],"sourceEquipment":["Bowl","Rolling Pin","Baking Paper","Pan","Large Saucepan","Colander"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R06_W33_UK_R43877-4_Main_high-90af386a.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/chicken-milanese-on-jerk-spiced-bacon-spaghetti-6914a9a5623e0c85b6821fd0","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["2","British Chicken Breasts"],["50 g","Breadcrumbs"],["1 sachet","Caribbean Style Jerk"],["1","Bell Pepper"],["180 g","Spaghetti"],["90 g","British Smoked Bacon Lardons"],["30 g","Tomato Puree"],["50 g","Jerk Paste"],["75 g","Creme Fraiche"],["10 g","Chicken Stock Paste"],["20 g","Wild Rocket"],["1","Egg"],["0.25 tsp","Salt for the Breadcrumbs"],["1 tsp","Sugar"],["100 ml","Water for the Sauce"],["20 g","Butter"],["as needed","cooking oil"],["to taste","black pepper"]],"sourceIngredients":[["2","British Chicken Breasts"],["50 g","Breadcrumbs"],["1 sachet","Caribbean Style Jerk"],["1","Bell Pepper"],["180 g","Spaghetti"],["90 g","British Smoked Bacon Lardons"],["30 g","Tomato Puree"],["50 g","Jerk Paste"],["75 g","Creme Fraiche"],["10 g","Chicken Stock Paste"],["20 g","Wild Rocket"],["1","Egg"],["0.25 tsp","Salt for the Breadcrumbs"],["1 tsp","Sugar"],["100 ml","Water for the Sauce"],["20 g","Butter"]],"ingredientMeta":[{"id":"554a5e56f8b25ed7288b4576","name":"British Chicken Breasts","type":"chicken-fillet","family":"chicken","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"British Chicken Breasts","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68371e2f42dc4b928197f136","name":"Breadcrumbs","type":"breadcrumbs","family":"breadcrumbs","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Breadcrumbs","marketLabel":"bread loaf","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58ada222043c3c07d63856e2","name":"Caribbean Style Jerk","type":"jerk-spice-mix","family":"spice blend","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Caribbean Style Jerk","marketLabel":"jerk seasoning equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632cf717b4f4bc890195c7d3","name":"Bell Pepper","type":"bell-pepper","family":"pepper","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Bell Pepper","marketLabel":"peppers pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68373082f7d5496ac4a65cf3","name":"Spaghetti","type":"spaghetti (wheat)","family":"other noodle","amount":"180 g","sourceAmount":180,"sourceUnit":"grams","shipped":true,"shoppingName":"Spaghetti","marketLabel":"pasta 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6061f8b25ed7288b4577","name":"British Smoked Bacon Lardons","type":"pancetta","family":"pork","amount":"90 g","sourceAmount":90,"sourceUnit":"grams","shipped":true,"shoppingName":"British Smoked Bacon Lardons","marketLabel":"prepared pork product equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a708af8b25ef93e8b4567","name":"Tomato Puree","type":"tomato-puree","family":"single ingredient paste","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Tomato Puree","marketLabel":"tomato puree 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"679b631d33196a355d1e51aa","name":"Jerk Paste","type":"jerk-paste","family":"none","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Jerk Paste","marketLabel":"cooking paste equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555084f34dab718e128b4569","name":"Creme Fraiche","type":"creme-fraiche","family":"soured cream","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Creme Fraiche","marketLabel":"creme fraiche 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60002d898c8c0a188200a96d","name":"Chicken Stock Paste","type":"chicken-stock-paste","family":"stock concentrate","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":true,"shoppingName":"Chicken Stock Paste","marketLabel":"chicken stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555092a4f8b25ed3468b4569","name":"Wild Rocket","type":"rocket","family":"salad mix","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Wild Rocket","marketLabel":"rocket 60g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fc0f772688281450b8bd085","name":"Egg","type":"egg","family":"egg","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":false,"shoppingName":"Egg","marketLabel":"medium eggs x12","marketChecked":true,"priceMatchType":"source-identity"},{"id":"627c173e7497c13c5c9b98a0","name":"Salt for the Breadcrumbs","type":"salt-for-the-breadcrumbs","family":"single spice","amount":"0.25 tsp","sourceAmount":0.25,"sourceUnit":"tsp","shipped":false,"shoppingName":"Salt for the Breadcrumbs","marketLabel":"table salt 750g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555093924dab71e7118b4568","name":"Sugar","type":"sugar-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"100 ml","sourceAmount":100,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"60c73507053f5e815cd52d5b","name":"Butter","type":"butter-100g","family":"butter","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":false,"shoppingName":"Butter","marketLabel":"butter 500g","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Sandwich each chicken breast between two pieces of baking paper. Pop onto a board, then give them a bash with a rolling pin or the bottom of a saucepan until they're 1-2cm thick. Season with salt and pepper. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Crack the egg (use the quantities listed in the ingredients) into a medium bowl and whisk. Put the breadcrumbs into another bowl, stir in the Caribbean style jerk and season with salt (use the quantities listed in the ingredients) and pepper.","Dip the chicken into the egg, then the breadcrumbs, ensuring it's completely coated. Transfer to a clean plate. Wash your hands and equipment after handling raw chicken and discard any excess egg. Pop a large frying pan on high heat and add enough oil to coat the bottom of the pan. You want the oil to be hot so the chicken fries properly - heat for 2-3 mins before you add the chicken.","Once the oil is hot, carefully lay the chicken into the pan and fry until golden brown, 2-3 mins on each side. Adjust the heat if necessary. Transfer the chicken to a baking tray and bake on the middle shelf of your oven until cooked through, 8-10 mins. The chicken is cooked when no longer pink in the middle. Meanwhile, bring a large saucepan of water to the boil with ½ tsp salt for the spaghetti. Halve the bell pepper and discard the core and seeds. Slice into thin strips.","When boiling, add the spaghetti to the water and bring back to the boil. Cook until tender, 8 mins. Once cooked, drain in a colander and pop back in the pan. Drizzle with oil and stir through to stop it sticking together. While the spaghetti boils, give the frying pan a quick clean. Return the pan to medium-high heat with a drizzle of oil. Once hot, add the bacon lardons and sliced pepper and fry until charred, 5-6 mins. Continue to stir while they cook. Wash your hands and equipment after handling raw meat. Cook bacon thoroughly.","Stir the tomato puree and jerk paste into the bacon and pepper. Fry until fragrant, 1-2 mins. Stir in the creme fraiche, chicken stock paste, sugar and water for the sauce (use the quantities listed in the ingredients). Bring to the boil, then reduce the heat and simmer until thickened, 3-4 mins. Once thickened, stir in the butter (use the quantities listed in the ingredients) and cooked spaghetti. Taste and season with salt and pepper if needed. Add a splash of water if you feel it needs it.","When everything's ready, slice the chicken widthways into 2cm thick slices. Share the spaghetti between your bowls. Scatter the rocket leaves on top and drizzle over some oil. Top with the sliced crispy chicken Milanese."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9a5623e0c85b6821fd0/step-9dd97d00.jpg","caption":"Get Started"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9a5623e0c85b6821fd0/step-378c5810.jpg","caption":"Bread the Chicken"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9a5623e0c85b6821fd0/step-23204a20.jpg","caption":"Bake the Chicken"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9a5623e0c85b6821fd0/step-1ecbfe30.jpg","caption":"Fry the Spice"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9a5623e0c85b6821fd0/step-e49b0240.jpg","caption":"Build the Sauce"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9a5623e0c85b6821fd0/step-cac73650.jpg","caption":"Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/chicken-milanese-on-jerk-spiced-bacon-spaghetti-6914a9a5623e0c85b6821fd0","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/chicken-milanese-on-jerk-spiced-bacon-spaghetti-6914a9a5623e0c85b6821fd0","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"pasta","shoppingIngredients":[["2","British Chicken Breasts"],["50 g","Breadcrumbs"],["1 sachet","Caribbean Style Jerk"],["1","Bell Pepper"],["180 g","Spaghetti"],["90 g","British Smoked Bacon Lardons"],["30 g","Tomato Puree"],["50 g","Jerk Paste"],["75 g","Creme Fraiche"],["10 g","Chicken Stock Paste"],["20 g","Wild Rocket"],["1","Egg"],["0.25 tsp","Salt for the Breadcrumbs"],["1 tsp","Sugar"],["100 ml","Water for the Sauce"],["20 g","Butter"],["as needed","cooking oil"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-6931b0f6dce6a2dc39a6eb7a","sourceId":"6931b0f6dce6a2dc39a6eb7a","title":"Thai Style Spiced Pork Tacos","subtitle":"with  Sweet Potato, Bell Pepper and Baby Gem Lettuce","time":20,"cost":12.09,"servings":2,"scaleSafe":true,"tags":["quick","south/southeastasian","handhelds","thai","pork","wrap"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Large Frying Pan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R35_W07_UK_QR12333-18_Main_high-6a29cda0.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/thai-style-spiced-pork-tacos-6931b0f6dce6a2dc39a6eb7a","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1","Sweet Potato"],["1","Bell Pepper"],["1","Baby Gem Lettuce"],["240 g","British Pork Mince"],["1 sachet","Thai Style Spice Mix"],["15 g","Ginger, Garlic & Lemongrass Puree"],["20 g","Ketjap Manis"],["6","Plain Taco Tortillas"],["25 ml","Water for the Pork"],["3 tbsp","Mayonnaise"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1","Sweet Potato"],["1","Bell Pepper"],["1","Baby Gem Lettuce"],["240 g","British Pork Mince"],["1 sachet","Thai Style Spice Mix"],["15 g","Ginger, Garlic & Lemongrass Puree"],["20 g","Ketjap Manis"],["6","Plain Taco Tortillas"],["25 ml","Water for the Pork"],["3 tbsp","Mayonnaise"]],"ingredientMeta":[{"id":"555082a2f8b25e56468b4568","name":"Sweet Potato","type":"sweet potato","family":"potato","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Sweet Potato","marketLabel":"sweet potatoes 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632cf717b4f4bc890195c7d3","name":"Bell Pepper","type":"bell-pepper","family":"pepper","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Bell Pepper","marketLabel":"peppers pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68ecc674fa624b85e8848c26","name":"Baby Gem Lettuce","type":"baby gem lettuce","family":"salad mix","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Baby Gem Lettuce","marketLabel":"lettuce or salad leaves","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5550e5664dab71c63e8b4567","name":"British Pork Mince","type":"pork-mince","family":"pork","amount":"240 g","sourceAmount":240,"sourceUnit":"grams","shipped":true,"shoppingName":"British Pork Mince","marketLabel":"pork mince 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632e48e82e3a699175a1b012","name":"Thai Style Spice Mix","type":"thai-spice-blend","family":"spice blend","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Thai Style Spice Mix","marketLabel":"seasoning blend equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6148c0c0371d0a48484f9adb","name":"Ginger, Garlic & Lemongrass Puree","type":"ginger-garlic-lemongrass-puree","family":"ginger","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Ginger, Garlic & Lemongrass Puree","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"574eff80f8b25eab0d8b4567","name":"Ketjap Manis","type":"ketjap-manis","family":"sauce","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Ketjap Manis","marketLabel":"Asian cooking sauce equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"683727bfd9848b9dac04fe03","name":"Plain Taco Tortillas","type":"plain-taco-tortilla","family":"none","amount":"6","sourceAmount":6,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Plain Taco Tortillas","marketLabel":"wraps or tortillas x8","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb18b688281450b8bd064","name":"Water for the Pork","type":"water-for-the-pork-100ml","family":"other drink","amount":"25 ml","sourceAmount":25,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Pork","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"5fbe487e8afb1b135f069bd2","name":"Mayonnaise","type":"mayonnaise-tbsp","family":"mayonnaise","amount":"3 tbsp","sourceAmount":3,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Mayonnaise","marketLabel":"mayonnaise 500ml","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 240°C/220°C fan/gas mark 7. Chop the sweet potato into 1cm chunks (no need to peel). Halve the bell pepper and discard the core and seeds. Chop into 1cm chunks. Pop the sweet potato and bell pepper onto a large baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Spread out in a single layer. Use two baking trays if necessary. When the oven is hot, roast on the top shelf until golden and tender, 18-20 mins. Turn halfway through.","Meanwhile, trim the baby gem, halve lengthways, then thinly slice.","When the veg is halfway through cooking, heat a large frying pan on medium-high heat (no oil). Once hot, add the pork mince. Fry until browned, 5-6 mins. Use a spoon to break it up as it cooks, then drain and discard any excess fat. Season with salt and pepper. Wash your hands and equipment after handling raw mince. It's cooked when no longer pink in the middle.","Once the mince is cooked, add the Thai style spice mix (add less if you'd prefer things milder) and the ginger, garlic & lemongrass puree. Stir-fry for 30 secs. Pour in the ketjap manis and water for the pork (use the quantities listed in the ingredients). Stir together until slightly thickened and nicely glazed, 1-2 min, then remove from the heat.","A couple of mins before you're ready to serve, lay the tortillas onto a baking tray. Place on the middle shelf to warm through, 1-2 mins.","When ready, transfer the tortillas to your plates and spread the mayo over each one (use the quantities listed in the ingredients). Top with the glazed pork, roasted veg and baby gem - as much as you'd like."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6931b0f6dce6a2dc39a6eb7a/step-4ec52200.jpg","caption":"Roast the Pepper"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6931b0f6dce6a2dc39a6eb7a/step-54e97a10.jpg","caption":"Finish the Prep"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6931b0f6dce6a2dc39a6eb7a/step-4cd80720.jpg","caption":"Time to Fry"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6931b0f6dce6a2dc39a6eb7a/step-a7a00a30.jpg","caption":"Add the Flavour"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6931b0f6dce6a2dc39a6eb7a/step-56529540.jpg","caption":"Warm your Tortillas"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6931b0f6dce6a2dc39a6eb7a/step-fb45aa50.jpg","caption":"Make your Tacos"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/thai-style-spiced-pork-tacos-6931b0f6dce6a2dc39a6eb7a","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/thai-style-spiced-pork-tacos-6931b0f6dce6a2dc39a6eb7a","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"wrap","shoppingIngredients":[["1","Sweet Potato"],["1","Bell Pepper"],["1","Baby Gem Lettuce"],["240 g","British Pork Mince"],["1 sachet","Thai Style Spice Mix"],["15 g","Ginger, Garlic & Lemongrass Puree"],["20 g","Ketjap Manis"],["6","Plain Taco Tortillas"],["25 ml","Water for the Pork"],["3 tbsp","Mayonnaise"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-6931b0ce42c50700f509e450","sourceId":"6931b0ce42c50700f509e450","title":"Korma Spiced Chicken Pilaf","subtitle":"with Garlicky Green Beans and Peas","time":35,"cost":21.54,"servings":2,"scaleSafe":true,"tags":["calorie smart","south/southeastasian","dinner-bowls","high protein","healthy options","indian","poultry","rice","cook"],"requiredEquipment":[],"sourceEquipment":["Garlic Press","Medium Saucepan","Lid","Zester","Pan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R24_W07_UK_MCB2791-43_Main_MCB2791-SP-1-43_var_high-538eed29.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/korma-spiced-chicken-pilaf-6931b0ce42c50700f509e450","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1","Onion"],["1","Garlic Clove"],["50 g","Korma Curry Paste"],["150 g","Basmati Rice"],["10 g","Vegetable Stock Paste"],["80 g","Green Beans"],["0.5","Lime"],["240 g","Diced British Chicken Breast"],["120 g","Peas"],["40 g","Mango Chutney"],["75 g","Low Fat Natural Yoghurt"],["300 ml","Water for the Rice"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1","Onion"],["1","Garlic Clove"],["50 g","Korma Curry Paste"],["150 g","Basmati Rice"],["10 g","Vegetable Stock Paste"],["80 g","Green Beans"],["0.5","Lime"],["240 g","Diced British Chicken Breast"],["120 g","Peas"],["40 g","Mango Chutney"],["75 g","Low Fat Natural Yoghurt"],["300 ml","Water for the Rice"]],"ingredientMeta":[{"id":"554a59324dab71626c8b4575","name":"Onion","type":"onion","family":"onion","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Onion","marketLabel":"brown onions 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5de10b3aa28b1766010e3f86","name":"Korma Curry Paste","type":"korma-curry-paste","family":"spice blend","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Korma Curry Paste","marketLabel":"curry paste jar","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55508011fd2cb96c628b456c","name":"Basmati Rice","type":"basmati rice","family":"rice","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"Basmati Rice","marketLabel":"basmati rice 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"641093570565a60137055ba9","name":"Vegetable Stock Paste","type":"vegetable-stock-paste","family":"stock concentrate","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":true,"shoppingName":"Vegetable Stock Paste","marketLabel":"vegetable stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555080c2f8b25e4d4c8b4568","name":"Green Beans","type":"green beans","family":"beans","amount":"80 g","sourceAmount":80,"sourceUnit":"grams","shipped":true,"shoppingName":"Green Beans","marketLabel":"green beans 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6e2a4dab71a9058b4569","name":"Lime","type":"lime","family":"lime","amount":"0.5","sourceAmount":0.5,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lime","marketLabel":"limes x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6390aea605fc26d5313f23d2","name":"Diced British Chicken Breast","type":"chicken-breast-diced","family":"none","amount":"240 g","sourceAmount":240,"sourceUnit":"grams","shipped":true,"shoppingName":"Diced British Chicken Breast","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556d6384fd2cb954078b4567","name":"Peas","type":"peas","family":"peas","amount":"120 g","sourceAmount":120,"sourceUnit":"grams","shipped":true,"shoppingName":"Peas","marketLabel":"garden peas 910g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55d366e84dab71542f8b4567","name":"Mango Chutney","type":"mango-chutney","family":"chutney","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Mango Chutney","marketLabel":"fresh fruit equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"61950263d30ccb01887a2025","name":"Low Fat Natural Yoghurt","type":"low-fat-natural-yoghurt","family":"yogurt","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Low Fat Natural Yoghurt","marketLabel":"yoghurts pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"57bec7a892eec9ca688b4568","name":"Water for the Rice","type":"water-for-the-rice-100ml","family":"other drink","amount":"300 ml","sourceAmount":300,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Rice","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Halve, peel and thinly slice the onion. Peel and grate the garlic (or use a garlic press). Heat a drizzle of oil in a medium saucepan (with a tight-fitting lid) on medium-high heat. Once hot, add the onion and cook, stirring occasionally, until softened, 5-6 mins. Stir in the korma curry paste and half the garlic, then cook for 1 min more.","Stir the rice, veg stock paste and water for the rice (use the quantities listed in the ingredients) into the onion pan and bring to the boil. Once boiling, turn the heat down to medium and cover with the lid. Leave to cook for 10 mins, then remove the pan from the heat (still covered) and leave to the side for another 10 mins or until ready to serve (the rice will continue to cook in its own steam).","While the rice cooks, trim the green beans and cut into thirds. Zest and halve the lime (use the amount listed in the ingredients).","When the rice has 10 mins left, heat a drizzle of oil in a large frying pan on medium-high heat. Once hot, add the green beans and diced chicken. Season with salt and pepper. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Wash your hands and equipment after handling raw chicken. Stir-fry until the beans are starting to char and the chicken is browned all over, 5-6 mins.","Once the beans are charred, add the peas to the pan and stir-fry for 3-4 mins more. Stir in the remaining garlic and cook for 1 min more, then remove from the heat. The chicken is cooked when pink on the outside and opaque in the middle. Once the rice is cooked, fluff it up with a fork and stir through the mango chutney.","Add the mango rice, lime zest and a good squeeze of lime juice to your pan of chicken and beans. Stir together until combined. Taste and add salt, pepper and more lime juice if needed. Spoon the chicken pilaf into bowls, then top with a dollop of yoghurt. Cut the remaining lime into wedges and serve alongside for squeezing over."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6931b0ce42c50700f509e450/step-290ca300.jpg","caption":"Spice the Onion"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6931b0ce42c50700f509e450/step-cfa0f310.jpg","caption":"Cook the Rice"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6931b0ce42c50700f509e450/step-49134920.jpg","caption":"Get Prepped"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6931b0ce42c50700f509e450/step-8e1c6630.jpg","caption":"Bring on the Beans"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6931b0ce42c50700f509e450/step-ac5a7140.jpg","caption":"Stir-Fry the Chicken"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6931b0ce42c50700f509e450/step-73ed4550.jpg","caption":"Combine and Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/korma-spiced-chicken-pilaf-6931b0ce42c50700f509e450","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/korma-spiced-chicken-pilaf-6931b0ce42c50700f509e450","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"rice","shoppingIngredients":[["1","Onion"],["1","Garlic Clove"],["50 g","Korma Curry Paste"],["150 g","Basmati Rice"],["10 g","Vegetable Stock Paste"],["80 g","Green Beans"],["0.5","Lime"],["240 g","Diced British Chicken Breast"],["120 g","Peas"],["40 g","Mango Chutney"],["75 g","Low Fat Natural Yoghurt"],["300 ml","Water for the Rice"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-690b7b819140c7b54ff23b47","sourceId":"690b7b819140c7b54ff23b47","title":"Creamy Mexican Fajita Inspired Tuna and Prawn Pasta Bake","subtitle":"with Bell Pepper, Caramelised Onion and Wild Rocket","time":45,"cost":21.38,"servings":2,"scaleSafe":true,"tags":["world-flavors","pasta-noodles","pescatarian","high protein","fusion","seafood","pasta","cook"],"requiredEquipment":[],"sourceEquipment":["Colander","Large Saucepan","Garlic Press","Grater","Large Frying Pan","Oven dish"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R23_W02_UK_R46854-3_MainR46854-AP-1-1_var_high-0cb64f71.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/creamy-mexican-fajita-inspired-tuna-and-prawn-pasta-bake-690b7b819140c7b54ff23b47","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1","Onion"],["1","Bell Pepper"],["180 g","Macaroni"],["30 g","Mature Cheddar Cheese"],["1 tin","Skipjack Tuna in Water"],["2","Garlic Clove"],["1 sachet","Mexican Style Spice Mix"],["10 g","Vegetable Stock Paste"],["75 g","Creme Fraiche"],["150 g","King Prawns"],["25 g","Sun-Dried Tomato Paste"],["20 g","Wild Rocket"],["20 g","Butter"],["1 tbsp","Plain Flour"],["250 ml","Water for the Sauce"],["1 tsp","Sugar for the Sauce"],["as needed","olive oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1","Onion"],["1","Bell Pepper"],["180 g","Macaroni"],["30 g","Mature Cheddar Cheese"],["1 tin","Skipjack Tuna in Water"],["2","Garlic Clove"],["1 sachet","Mexican Style Spice Mix"],["10 g","Vegetable Stock Paste"],["75 g","Creme Fraiche"],["150 g","King Prawns"],["25 g","Sun-Dried Tomato Paste"],["20 g","Wild Rocket"],["20 g","Butter"],["1 tbsp","Plain Flour"],["250 ml","Water for the Sauce"],["1 tsp","Sugar for the Sauce"]],"ingredientMeta":[{"id":"554a59324dab71626c8b4575","name":"Onion","type":"onion","family":"onion","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Onion","marketLabel":"brown onions 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632cf717b4f4bc890195c7d3","name":"Bell Pepper","type":"bell-pepper","family":"pepper","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Bell Pepper","marketLabel":"peppers pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68373081f7d5496ac4a65cee","name":"Macaroni","type":"macaroni","family":"other noodle","amount":"180 g","sourceAmount":180,"sourceUnit":"grams","shipped":true,"shoppingName":"Macaroni","marketLabel":"pasta 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"69146769623e0c85b6821082","name":"Mature Cheddar Cheese","type":"cheddar-cheese","family":"hard cheese","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Mature Cheddar Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"66e4649086402bd101d35b2e","name":"Skipjack Tuna in Water","type":"skipjack-tuna-in-water","family":"none","amount":"1 tin","sourceAmount":1,"sourceUnit":"tin(s)","shipped":true,"shoppingName":"Skipjack Tuna in Water","marketLabel":"tuna tin","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60c89afa8e1c4145a37bc75f","name":"Mexican Style Spice Mix","type":"mexican-style-spice-mix","family":"spice blend","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Mexican Style Spice Mix","marketLabel":"seasoning blend equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"641093570565a60137055ba9","name":"Vegetable Stock Paste","type":"vegetable-stock-paste","family":"stock concentrate","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":true,"shoppingName":"Vegetable Stock Paste","marketLabel":"vegetable stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555084f34dab718e128b4569","name":"Creme Fraiche","type":"creme-fraiche","family":"soured cream","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Creme Fraiche","marketLabel":"creme fraiche 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632c5abbb4f4bc890195c7a6","name":"King Prawns","type":"king prawns","family":"seafood preparation","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"King Prawns","marketLabel":"large king prawns 150g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5f327c6560efd3453038c2a8","name":"Sun-Dried Tomato Paste","type":"sundried-tomato-paste-duplicate","family":"single ingredient paste","amount":"25 g","sourceAmount":25,"sourceUnit":"grams","shipped":true,"shoppingName":"Sun-Dried Tomato Paste","marketLabel":"sun-dried tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555092a4f8b25ed3468b4569","name":"Wild Rocket","type":"rocket","family":"salad mix","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Wild Rocket","marketLabel":"rocket 60g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60c73507053f5e815cd52d5b","name":"Butter","type":"butter-100g","family":"butter","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":false,"shoppingName":"Butter","marketLabel":"butter 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60f9470be5a270ab7dbce1b8","name":"Plain Flour","type":"plain-flour-1-tbsp","family":"flour","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Plain Flour","marketLabel":"plain flour 1.5kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"250 ml","sourceAmount":250,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"5fbeb612688281450b8bd07c","name":"Sugar for the Sauce","type":"sugar-for-the-sauce-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Sauce","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Bring a large saucepan of water to the boil with ½ tsp salt for the macaroni. Meanwhile, halve, peel and thinly slice the onion. Halve the bell pepper and discard the core and seeds. Slice into thin strips. When boiling, stir the macaroni into the water and bring back to the boil. Cook until tender, 12 mins. Once the pasta is cooked, drain in a colander and pop back into the pan. Drizzle with oil and stir through to stop it sticking together.","While the pasta cooks, heat your grill to high. Heat a drizzle of oil in a large frying pan on medium heat. Once hot, add the sliced onion and pepper, season with salt and pepper and fry, stirring occasionally, until golden, 10-12 mins. Meanwhile, grate the cheese. Drain the tuna. Peel and grate the garlic (or use a garlic press). Once the veg is golden, add the garlic and Mexican style spice mix. Fry for another 30 secs.","Add the butter to the veg pan and allow it to melt (use the quantities listed in the ingredients). Next, stir in the flour (use the quantities listed in the ingredients). Cook until it forms a paste, 1-2 mins - you've made a roux! Stir in the water for the sauce (use the quantities listed in the ingredients) a little at a time, followed by the vegetable stock paste.","Bring the sauce to the boil, then stir in the creme fraiche and sugar for the sauce (use the quantities listed in the ingredients). Next, drain the prawns. Gently stir in the prawns and tuna. Simmer until piping hot, 1-2 mins. Wash your hands and equipment after handling raw prawns. Season with salt and pepper, then remove from the heat.","Once cooked, stir the cooked pasta and sun-dried tomato paste into the sauce. Add a splash more water if you feel it needs it. Transfer the tuna pasta to an appropriately sized ovenproof dish. Sprinkle the cheese on top of the pasta, then grill until the cheese has melted and is bubbling, 5-6 mins. The prawns are cooked when pink on the outside and opaque in the middle.","Once ready, share the pasta bake between your bowls. Serve the rocket alongside, drizzling a little olive oil over the leaves to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b819140c7b54ff23b47/step-eb53c900.jpg","caption":"Cook the Pasta"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b819140c7b54ff23b47/step-41120010.jpg","caption":"Fry the Veg"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b819140c7b54ff23b47/step-002ad020.jpg","caption":"Make a Roux"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b819140c7b54ff23b47/step-9717a930.jpg","caption":"Add the Tuna"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b819140c7b54ff23b47/step-49791e40.jpg","caption":"Get Cheesy"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b819140c7b54ff23b47/step-87493550.jpg","caption":"Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/creamy-mexican-fajita-inspired-tuna-and-prawn-pasta-bake-690b7b819140c7b54ff23b47","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/creamy-mexican-fajita-inspired-tuna-and-prawn-pasta-bake-690b7b819140c7b54ff23b47","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"pasta","shoppingIngredients":[["1","Onion"],["1","Bell Pepper"],["180 g","Macaroni"],["30 g","Mature Cheddar Cheese"],["1 tin","Skipjack Tuna in Water"],["2","Garlic Clove"],["1 sachet","Mexican Style Spice Mix"],["10 g","Vegetable Stock Paste"],["75 g","Creme Fraiche"],["150 g","King Prawns"],["25 g","Sun-Dried Tomato Paste"],["20 g","Wild Rocket"],["20 g","Butter"],["1 tbsp","Plain Flour"],["250 ml","Water for the Sauce"],["1 tsp","Sugar for the Sauce"],["as needed","olive oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-690b7b8d9140c7b54ff23b56","sourceId":"690b7b8d9140c7b54ff23b56","title":"Fig Jam, Spiced Chicken Breast and Cheddar Ciabatta","subtitle":"with Bacon Chips and Balsamic Tomato Salad","time":40,"cost":28.28,"servings":2,"scaleSafe":true,"tags":["family friendly","regional-specialty","handhelds","high protein","british","poultry","sandwich","cook"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Bowl","Grater","Rolling Pin","Large Saucepan","Baking Paper","Large Frying Pan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R18_W02_UK_R23647-4_Main_10_high-179e1c06.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/fig-jam-spiced-chicken-breast-and-cheddar-ciabatta-690b7b8d9140c7b54ff23b56","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["450 g","Potatoes"],["30 g","Mature Cheddar Cheese"],["125 g","Baby Plum Tomatoes"],["12 ml","Balsamic Vinegar"],["2","British Chicken Breasts"],["1 sachet","Roasted Spice and Herb Blend"],["40 g","Fig Jam"],["2","Ciabatta"],["50 g","Baby Leaf Mix"],["90 g","British Smoked Bacon Lardons"],["0.5 tsp","Sugar"],["1 tbsp","Olive Oil for the Dressing"],["1 tbsp","Plain Flour"],["2 tbsp","Mayonnaise"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["450 g","Potatoes"],["30 g","Mature Cheddar Cheese"],["125 g","Baby Plum Tomatoes"],["12 ml","Balsamic Vinegar"],["2","British Chicken Breasts"],["1 sachet","Roasted Spice and Herb Blend"],["40 g","Fig Jam"],["2","Ciabatta"],["50 g","Baby Leaf Mix"],["90 g","British Smoked Bacon Lardons"],["0.5 tsp","Sugar"],["1 tbsp","Olive Oil for the Dressing"],["1 tbsp","Plain Flour"],["2 tbsp","Mayonnaise"]],"ingredientMeta":[{"id":"5a39929ec9fd0814815939c2","name":"Potatoes","type":"potatoes","family":"potato","amount":"450 g","sourceAmount":450,"sourceUnit":"grams","shipped":true,"shoppingName":"Potatoes","marketLabel":"potatoes 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"69146769623e0c85b6821082","name":"Mature Cheddar Cheese","type":"cheddar-cheese","family":"hard cheese","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Mature Cheddar Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5a3cee59c2880024501f6622","name":"Baby Plum Tomatoes","type":"baby-plum-tomatoes","family":"tomato","amount":"125 g","sourceAmount":125,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Plum Tomatoes","marketLabel":"fresh fruit equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5550927ef8b25e4d4c8b456c","name":"Balsamic Vinegar","type":"balsamic vinegar","family":"vinegar","amount":"12 ml","sourceAmount":12,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Balsamic Vinegar","marketLabel":"balsamic vinegar 250ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5e56f8b25ed7288b4576","name":"British Chicken Breasts","type":"chicken-fillet","family":"chicken","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"British Chicken Breasts","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6304d66eff08c9e5b584e015","name":"Roasted Spice and Herb Blend","type":"roasted-spice-and-herb-blend","family":"none","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Roasted Spice and Herb Blend","marketLabel":"seasoning blend equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5e285e97dd6676655d5288b9","name":"Fig Jam","type":"fig jam","family":"fruit preserves","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Fig Jam","marketLabel":"fig jam jar","marketChecked":false,"priceMatchType":"source-identity"},{"id":"68371fec42dc4b928197f195","name":"Ciabatta","type":"ciabatta","family":"bread dough","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Ciabatta","marketLabel":"bread loaf","marketChecked":true,"priceMatchType":"source-identity"},{"id":"56b23e4ef8b25e4c2d8b4567","name":"Baby Leaf Mix","type":"premium baby leaf mix","family":"salad mix","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Leaf Mix","marketLabel":"lettuce or salad leaves","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6061f8b25ed7288b4577","name":"British Smoked Bacon Lardons","type":"pancetta","family":"pork","amount":"90 g","sourceAmount":90,"sourceUnit":"grams","shipped":true,"shoppingName":"British Smoked Bacon Lardons","marketLabel":"prepared pork product equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555093924dab71e7118b4568","name":"Sugar","type":"sugar-1-tsp","family":"single spice","amount":"0.5 tsp","sourceAmount":0.5,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb168688281450b8bd062","name":"Olive Oil for the Dressing","type":"olive-oil-for-the-dressing-1-tbsp","family":"oil","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Olive Oil for the Dressing","marketLabel":"cooking oil 1 litre","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60f9470be5a270ab7dbce1b8","name":"Plain Flour","type":"plain-flour-1-tbsp","family":"flour","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Plain Flour","marketLabel":"plain flour 1.5kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbe487e8afb1b135f069bd2","name":"Mayonnaise","type":"mayonnaise-tbsp","family":"mayonnaise","amount":"2 tbsp","sourceAmount":2,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Mayonnaise","marketLabel":"mayonnaise 500ml","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Chop the potatoes lengthways into 1cm slices, then chop into 1cm wide chips (no need to peel). Pop the chips onto a large baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Spread out in a single layer. Use two baking trays if necessary. When the oven is hot, bake on the top shelf until golden, 25-30 mins. Turn halfway through.","Meanwhile, grate the Cheddar cheese. Halve the baby plum tomatoes. In a medium bowl, combine the balsamic vinegar, sugar and olive oil for the dressing (use the quantities listed in the ingredients). Stir in the tomatoes and season with salt and pepper. Set your tomato salad aside.","When the chips have 15 mins remaining, sandwich each chicken breast between two pieces of baking paper or cling film. Pop onto a board, then give them a bash with a rolling pin or the bottom of a saucepan until they’re 1-2cm thick. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. In a medium bowl, combine the roasted spice and herb blend, plain flour (use the quantities listed in the ingredients) and ¼ tsp salt. Add the chicken and toss to coat. Wash your hands and equipment after handling raw chicken.","Heat a drizzle of oil in a large frying pan on medium-high heat. Once hot, lay in the chicken. Fry until golden brown and cooked through, 5-6 mins each side. The chicken is cooked when no longer pink in the middle. Once cooked, add the fig jam to the pan and turn the chicken to coat. Sprinkle the cheese over the chicken, pop a lid on the pan and remove from the heat until ready to serve.","When the chips have about 10 mins remaining, remove from the oven and scatter over the bacon lardons. Return to the oven for the remaining time, 8-10 mins. Wash your hands and equipment after handling raw meat. Cook bacon thoroughly. When the chips have a couple of mins remaining, halve the ciabattas, then pop them into the oven to warm through, 2-3 mins. When everything's ready, add the baby leaves to the tomato bowl. Toss to coat. Don't add the leaves too early or they'll go soggy.","When everything's ready, spread the mayo (use the quantities listed in the ingredients) over the ciabatta bases. Top the bases with the chicken and some salad leaves, then sandwich shut with the ciabatta lids. Share between your plates. Serve the bacon chips and remaining tomato salad alongside."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b8d9140c7b54ff23b56/step-81430700.jpg","caption":"Chip, Chip, Hooray"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b8d9140c7b54ff23b56/step-147f3510.jpg","caption":"Do the Prep"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b8d9140c7b54ff23b56/step-045b5320.jpg","caption":"Bash the Chicken"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b8d9140c7b54ff23b56/step-d7f17330.jpg","caption":"Fry the Chicken"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b8d9140c7b54ff23b56/step-de0f1b40.jpg","caption":"Finishing Touches"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b8d9140c7b54ff23b56/step-021d3d50.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/fig-jam-spiced-chicken-breast-and-cheddar-ciabatta-690b7b8d9140c7b54ff23b56","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/fig-jam-spiced-chicken-breast-and-cheddar-ciabatta-690b7b8d9140c7b54ff23b56","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"sandwich","shoppingIngredients":[["450 g","Potatoes"],["30 g","Mature Cheddar Cheese"],["125 g","Baby Plum Tomatoes"],["12 ml","Balsamic Vinegar"],["2","British Chicken Breasts"],["1 sachet","Roasted Spice and Herb Blend"],["40 g","Fig Jam"],["2","Ciabatta"],["50 g","Baby Leaf Mix"],["90 g","British Smoked Bacon Lardons"],["0.5 tsp","Sugar"],["1 tbsp","Olive Oil for the Dressing"],["1 tbsp","Plain Flour"],["2 tbsp","Mayonnaise"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-693073669351d52b5c263d2e","sourceId":"693073669351d52b5c263d2e","title":"Sticky Miso Aubergine Rice Bowl","subtitle":"with Peanuts, Garlic Pak Choi and Pickled Carrot","time":40,"cost":23.79,"servings":2,"scaleSafe":true,"tags":["veggie","pan-asian-plates","dinner-bowls","japanese","rice","cook"],"requiredEquipment":[],"sourceEquipment":["Garlic Press","Medium Saucepan","Lid","Baking Tray","Bowl","Peeler","Pan","Aluminum Foil"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R51_W06_UK_V14937-11_Main_3_high-c3c99c95.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/sticky-miso-aubergine-rice-bowl-693073669351d52b5c263d2e","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["3","Garlic Clove"],["150 g","Jasmine Rice"],["1","Aubergine"],["1","Carrot"],["15 ml","Rice Vinegar"],["2","Pak Choi"],["15 g","Miso Paste"],["15 g","Honey"],["20 ml","Sesame Oil"],["15 g","Sambal Paste"],["25 g","Salted Peanuts"],["20 g","Butter"],["300 ml","Water for the Rice"],["0.5 tsp","Sugar for the Pickle"],["2 tbsp","Mayonnaise"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["3","Garlic Clove"],["150 g","Jasmine Rice"],["1","Aubergine"],["1","Carrot"],["15 ml","Rice Vinegar"],["2","Pak Choi"],["15 g","Miso Paste"],["15 g","Honey"],["20 ml","Sesame Oil"],["15 g","Sambal Paste"],["25 g","Salted Peanuts"],["20 g","Butter"],["300 ml","Water for the Rice"],["0.5 tsp","Sugar for the Pickle"],["2 tbsp","Mayonnaise"]],"ingredientMeta":[{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"3","sourceAmount":3,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"59b020d9c2880076673eb222","name":"Jasmine Rice","type":"jasmine-rice","family":"rice","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"Jasmine Rice","marketLabel":"basmati rice 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6363fd2cb959598b4570","name":"Aubergine","type":"aubergine","family":"aubergine","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Aubergine","marketLabel":"aubergine","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5f284dab71a6058b4567","name":"Carrot","type":"carrot","family":"carrot","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Carrot","marketLabel":"carrots 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a68fa4dab71aa058b4568","name":"Rice Vinegar","type":"rice vinegar","family":"vinegar","amount":"15 ml","sourceAmount":15,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Rice Vinegar","marketLabel":"cooking vinegar equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556857adf8b25e5a408b4567","name":"Pak Choi","type":"bok-choy","family":"vegetable mix","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Pak Choi","marketLabel":"pak choi x2","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a63bffd2cb9ba4f8b4576","name":"Miso Paste","type":"miso-paste","family":"asian paste","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Miso Paste","marketLabel":"miso paste 150g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555363fff8b25e5e0c8b4567","name":"Honey","type":"honey","family":"honey","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6923f8b25ef53e8b4567","name":"Sesame Oil","type":"sesame oil","family":"oil","amount":"20 ml","sourceAmount":20,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Sesame Oil","marketLabel":"sesame oil 250ml","marketChecked":false,"priceMatchType":"source-identity"},{"id":"60accf96e728ee63dd0d01d2","name":"Sambal Paste","type":"sambal","family":"Chili sauce","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Sambal Paste","marketLabel":"cooking paste equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6877ced35a587f17f45951c6","name":"Salted Peanuts","type":"salted peanuts","family":"nut mix","amount":"25 g","sourceAmount":25,"sourceUnit":"grams","shipped":true,"shoppingName":"Salted Peanuts","marketLabel":"table salt 750g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60c73507053f5e815cd52d5b","name":"Butter","type":"butter-100g","family":"butter","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":false,"shoppingName":"Butter","marketLabel":"butter 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"57bec7a892eec9ca688b4568","name":"Water for the Rice","type":"water-for-the-rice-100ml","family":"other drink","amount":"300 ml","sourceAmount":300,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Rice","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"5e3416f081143769dd33ba49","name":"Sugar for the Pickle","type":"sugar-for-the-pickle-1-tsp","family":"single spice","amount":"0.5 tsp","sourceAmount":0.5,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Pickle","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbe487e8afb1b135f069bd2","name":"Mayonnaise","type":"mayonnaise-tbsp","family":"mayonnaise","amount":"2 tbsp","sourceAmount":2,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Mayonnaise","marketLabel":"mayonnaise 500ml","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Peel and grate the garlic (or use a garlic press). Pop a deep saucepan (with a tight-fitting lid) on medium heat. Melt in the butter (use the quantities listed in the ingredients). When hot, add half the garlic and stir-fry for 1 min. Stir in the rice until coated, 1 min. Add ¼ tsp salt and the water for the rice (use the quantities listed in the ingredients) and bring to the boil. Once boiling, turn the heat down to medium and cover with the lid. Leave to cook for 10 mins, then remove the pan from the heat (still covered) and leave to the side for another 10 mins or until ready to serve (the rice will continue to cook in its own steam).","Meanwhile, trim the aubergine, then cut into roughly 2cm pieces. Pop the aubergine onto a baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Spread out in a single layer. When the oven is hot, roast the aubergine on the top shelf until soft and golden, 25-30 mins. Turn halfway through.","While everything cooks, trim and peel the carrot. Use the peeler to peel long ribbons down the length of the carrot, stopping at the core. In a medium bowl, add the carrot, rice vinegar and sugar for the pickle (use the quantities listed in the ingredients). Season with salt and pepper, toss to coat, then set aside to pickle.","Next, trim the pak choi, then separate the leaves. Cut each leaf in half lengthways down the middle. Heat a drizzle of oil in a large frying pan on high heat. Once hot, add the pak choi and stir-fry until just soft, 3-4 mins.","Once the pak choi has softened, add the remaining garlic and cook for 1 min more. Season to taste, then remove from the heat and cover with foil to keep warm. When the aubergine has finished roasting, drizzle over the miso paste, honey and sesame oil. If your honey has hardened, pop it in a bowl of hot water for 1 min. In a small bowl, combine the sambal (add less if you'd prefer things milder) and mayo (use the quantities listed in the ingredients).","Pour the juice from the pickled carrot into the rice. Use a fork to combine and fluff up the grains, then share between your bowls. Top the rice with the miso aubergine, garlic pak choi and pickled carrot in separate sections. Drizzle over the sambal mayo and sprinkle over the peanuts to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693073669351d52b5c263d2e/step-dc270800.jpg","caption":"Cook the Rice"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693073669351d52b5c263d2e/step-b669b410.jpg","caption":"Roast the Aubergine"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693073669351d52b5c263d2e/step-2a92c920.jpg","caption":"Get in a Pickle"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693073669351d52b5c263d2e/step-d0d73230.jpg","caption":"Prep Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693073669351d52b5c263d2e/step-8da90140.jpg","caption":"Sauce Things Up"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693073669351d52b5c263d2e/step-c28e1350.jpg","caption":"Finish and Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/sticky-miso-aubergine-rice-bowl-693073669351d52b5c263d2e","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/sticky-miso-aubergine-rice-bowl-693073669351d52b5c263d2e","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"rice","shoppingIngredients":[["3","Garlic Clove"],["150 g","Jasmine Rice"],["1","Aubergine"],["1","Carrot"],["15 ml","Rice Vinegar"],["2","Pak Choi"],["15 g","Miso Paste"],["15 g","Honey"],["20 ml","Sesame Oil"],["15 g","Sambal Paste"],["25 g","Salted Peanuts"],["20 g","Butter"],["300 ml","Water for the Rice"],["0.5 tsp","Sugar for the Pickle"],["2 tbsp","Mayonnaise"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-693073649351d52b5c263d2b","sourceId":"693073649351d52b5c263d2b","title":"Bacon, Goat's Cheese, Roast Potato and Kale Salad","subtitle":"with Fig and Balsamic Dressing","time":40,"cost":16.57,"servings":2,"scaleSafe":true,"tags":["regional-specialty","dinner-bowls","british","pork","salad","cook"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Garlic Press","Small sauce pan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y23_R04_W52_UK_G2582-14122-10_Main_G2582-14122-AP-1-1_var_high-eb3efe1f.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/bacon-goats-cheese-roast-potato-and-kale-salad-693073649351d52b5c263d2b","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["450 g","Potatoes"],["1","Red Onion"],["2","Carrot"],["1","Garlic Clove"],["1 sachet","Ground Cumin"],["80 g","Fig Jam"],["24 g","Balsamic Glaze"],["100 g","Chopped Kale"],["75 g","Goat's Cheese"],["15 g","Toasted Flaked Almonds"],["90 g","British Smoked Bacon Lardons"],["2 tbsp","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["450 g","Potatoes"],["1","Red Onion"],["2","Carrot"],["1","Garlic Clove"],["1 sachet","Ground Cumin"],["80 g","Fig Jam"],["24 g","Balsamic Glaze"],["100 g","Chopped Kale"],["75 g","Goat's Cheese"],["15 g","Toasted Flaked Almonds"],["90 g","British Smoked Bacon Lardons"],["2 tbsp","Water for the Sauce"]],"ingredientMeta":[{"id":"5a39929ec9fd0814815939c2","name":"Potatoes","type":"potatoes","family":"potato","amount":"450 g","sourceAmount":450,"sourceUnit":"grams","shipped":true,"shoppingName":"Potatoes","marketLabel":"potatoes 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6fb4fd2cb95a598b456e","name":"Red Onion","type":"red onion","family":"onion","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Red Onion","marketLabel":"red onions x3","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5f284dab71a6058b4567","name":"Carrot","type":"carrot","family":"carrot","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Carrot","marketLabel":"carrots 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556827714dab71b7178b456c","name":"Ground Cumin","type":"ground cumin","family":"single spice","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Ground Cumin","marketLabel":"ground cumin jar","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5e285e97dd6676655d5288b9","name":"Fig Jam","type":"fig jam","family":"fruit preserves","amount":"80 g","sourceAmount":80,"sourceUnit":"grams","shipped":true,"shoppingName":"Fig Jam","marketLabel":"fig jam jar","marketChecked":false,"priceMatchType":"source-identity"},{"id":"6099506c9c6d58742c5645ca","name":"Balsamic Glaze","type":"balsamic-glaze","family":"vinegar","amount":"24 g","sourceAmount":24,"sourceUnit":"grams","shipped":true,"shoppingName":"Balsamic Glaze","marketLabel":"balsamic glaze equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6242043ddf35475d1660ada1","name":"Chopped Kale","type":"chopped-kale","family":"kale","amount":"100 g","sourceAmount":100,"sourceUnit":"grams","shipped":true,"shoppingName":"Chopped Kale","marketLabel":"curly kale 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"69008edb29be8924040c8492","name":"Goat's Cheese","type":"goat's cheese","family":"hard cheese","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Goat's Cheese","marketLabel":"porridge oats 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6837308042dc4b928197f3a9","name":"Toasted Flaked Almonds","type":"toasted-flaked-almonds","family":"none","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Toasted Flaked Almonds","marketLabel":"nuts and seeds equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6061f8b25ed7288b4577","name":"British Smoked Bacon Lardons","type":"pancetta","family":"pork","amount":"90 g","sourceAmount":90,"sourceUnit":"grams","shipped":true,"shoppingName":"British Smoked Bacon Lardons","marketLabel":"prepared pork product equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60b8a3c08b148d1530c49fb7","name":"Water for the Sauce","type":"water-for-the-sauce","family":"other drink","amount":"2 tbsp","sourceAmount":2,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Chop the potatoes into 2cm chunks (no need to peel). Pop the chunks onto a large baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Spread out in a single layer. Use two baking trays if necessary. When the oven is hot, roast on the top shelf until golden, 25-35 mins. Turn halfway through.","Meanwhile, halve and peel the red onion. Chop each half into 3 wedges. Trim the carrots (no need to peel). Chop into roughly 1cm wide, 5cm long batons. Peel and grate the garlic (or use a garlic press).","Pop the carrots and onion wedges onto another baking tray. Drizzle with oil, sprinkle over the ground cumin, then season with salt and pepper. Toss to coat, then spread out in a single layer. Roast on the middle shelf of your oven until tender, 20-25 mins. Turn halfway through. When the potatoes have 10 mins left, remove the tray from the oven and scatter over the bacon lardons. Return to the oven to roast for the remaining time. Wash your hands and equipment after handling raw meat. Cook bacon thoroughly.","Meanwhile, heat a drizzle of oil in a small saucepan on medium heat. Once hot, add the garlic, cook for 1 min, then stir in the fig jam, balsamic glaze and the water for the sauce (use the quantities listed in the ingredients). Bring to the boil, then remove from the heat and set aside.","Once the carrots and onion are cooked, remove them from the oven. Lay the kale on top, drizzle with oil and season with salt and pepper. Return the tray to the oven to roast until crispy, 4-6 mins.","When ready, toss together the bacon, potatoes, roasted veg and fig balsamic dressing on one baking tray until well coated. Share the roasted veg salad between your bowls. Crumble the goat's cheese on top. Finish by scattering over the flaked almonds."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693073649351d52b5c263d2b/step-ebdc5200.jpg","caption":"Roast the Potatoes"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693073649351d52b5c263d2b/step-d13bd310.jpg","caption":"Chop and Grate"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693073649351d52b5c263d2b/step-639bbf20.jpg","caption":"Roast the Veg"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693073649351d52b5c263d2b/step-b935ed30.jpg","caption":"Make the Dressing"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693073649351d52b5c263d2b/step-abd07c40.jpg","caption":"Kale Me Maybe"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/693073649351d52b5c263d2b/step-a829f450.jpg","caption":"Finish and Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/bacon-goats-cheese-roast-potato-and-kale-salad-693073649351d52b5c263d2b","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/bacon-goats-cheese-roast-potato-and-kale-salad-693073649351d52b5c263d2b","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"salad","shoppingIngredients":[["450 g","Potatoes"],["1","Red Onion"],["2","Carrot"],["1","Garlic Clove"],["1 sachet","Ground Cumin"],["80 g","Fig Jam"],["24 g","Balsamic Glaze"],["100 g","Chopped Kale"],["75 g","Goat's Cheese"],["15 g","Toasted Flaked Almonds"],["90 g","British Smoked Bacon Lardons"],["2 tbsp","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-6930733d114b735a0061b87a","sourceId":"6930733d114b735a0061b87a","title":"Tomato, Pesto and Caramelised Onion Orzo","subtitle":"with Roasted Tenderstem® and Italian Style Cheese","time":25,"cost":17.79,"servings":2,"scaleSafe":true,"tags":["quick","veggie","mediterranean","pasta-noodles","italian","pasta"],"requiredEquipment":[],"sourceEquipment":["Garlic Press","Medium Saucepan","Sieve","Baking Tray","Pan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R45_W44_UK_V18569-14_Main_high-b2324e80.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/tomato-pesto-and-caramelised-onion-orzo-6930733d114b735a0061b87a","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["160 g","Tenderstem® Broccoli"],["2","Garlic Clove"],["180 g","Orzo"],["1 carton","Tomato Passata"],["35 g","Caramelised Onion Paste"],["28 g","Red Wine Stock Paste"],["1","Lemon"],["40 g","Baby Spinach"],["30 g","Basil Pesto with Cashew Nuts"],["40 g","Grated Hard Italian Style Cheese"],["1 sachet","Chilli Flakes"],["1 tsp","Sugar for the Sauce"],["75 ml","Water for the Sauce"],["15 g","Butter"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["160 g","Tenderstem® Broccoli"],["2","Garlic Clove"],["180 g","Orzo"],["1 carton","Tomato Passata"],["35 g","Caramelised Onion Paste"],["28 g","Red Wine Stock Paste"],["1","Lemon"],["40 g","Baby Spinach"],["30 g","Basil Pesto with Cashew Nuts"],["40 g","Grated Hard Italian Style Cheese"],["1 sachet","Chilli Flakes"],["1 tsp","Sugar for the Sauce"],["75 ml","Water for the Sauce"],["15 g","Butter"]],"ingredientMeta":[{"id":"554a665afd2cb99c598b4569","name":"Tenderstem® Broccoli","type":"tenderstem-broccoli","family":"broccoli","amount":"160 g","sourceAmount":160,"sourceUnit":"grams","shipped":true,"shoppingName":"Tenderstem® Broccoli","marketLabel":"broccoli head","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6837308242dc4b928197f3bc","name":"Orzo","type":"orzo","family":"other noodle","amount":"180 g","sourceAmount":180,"sourceUnit":"grams","shipped":true,"shoppingName":"Orzo","marketLabel":"pasta 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55672166f8b25e412f8b4567","name":"Tomato Passata","type":"tomato passata","family":"single ingredient paste","amount":"1 carton","sourceAmount":1,"sourceUnit":"carton(s)","shipped":true,"shoppingName":"Tomato Passata","marketLabel":"passata 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"682ddc6ec4a648afcad0da76","name":"Caramelised Onion Paste","type":"caramelised-onion-paste","family":"none","amount":"35 g","sourceAmount":35,"sourceUnit":"grams","shipped":true,"shoppingName":"Caramelised Onion Paste","marketLabel":"onion preserve equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5a4fc599c288003649295c52","name":"Red Wine Stock Paste","type":"red-wine-stock-pot","family":"stock concentrate","amount":"28 g","sourceAmount":28,"sourceUnit":"grams","shipped":true,"shoppingName":"Red Wine Stock Paste","marketLabel":"beef cooking concentrate equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a72ebfd2cb95a598b4570","name":"Lemon","type":"lemon","family":"lemon","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lemon","marketLabel":"lemons x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555c9dd5fd2cb92f6c8b4569","name":"Baby Spinach","type":"baby spinach","family":"spinach","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Spinach","marketLabel":"spinach 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68c412723cfb117858763a9f","name":"Basil Pesto with Cashew Nuts","type":"basil-pesto-sauce","family":"none","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Basil Pesto with Cashew Nuts","marketLabel":"nuts and seeds equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5550865efd2cb974658b4568","name":"Grated Hard Italian Style Cheese","type":"grated-hard-italian-style-cheese-duplicate","family":"hard cheese","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Grated Hard Italian Style Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5fe8f8b25e1e268b4579","name":"Chilli Flakes","type":"chilli flakes","family":"spice blend","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Chilli Flakes","marketLabel":"chilli flakes 45g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb612688281450b8bd07c","name":"Sugar for the Sauce","type":"sugar-for-the-sauce-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Sauce","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"75 ml","sourceAmount":75,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"60c73507053f5e815cd52d5b","name":"Butter","type":"butter-100g","family":"butter","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":false,"shoppingName":"Butter","marketLabel":"butter 500g","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Bring a large saucepan of water to the boil with ½ tsp salt for the orzo. Halve any thick broccoli stems lengthways. Peel and grate the garlic (or use a garlic press). If you'd prefer to boil your broccoli, skip the oven.","When your pan of water is boiling, add the orzo and bring back to the boil. Cook until tender, 10 mins. Once cooked, drain in a sieve and pop back in the pan. Drizzle with oil and stir through to stop it sticking together.","Meanwhile, pop the Tenderstem® broccoli onto a large baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Spread out in a single layer. When the oven is hot, roast on the middle shelf until tender and crispy, 10-12 mins. If you'd prefer to boil your broccoli, boil it in step 4 while the sauce simmers for 3-5 mins, until tender.","Meanwhile, heat a drizzle of oil in a large frying pan on medium-high heat. Once hot, add the garlic and fry for 30 secs. Stir in the passata, caramelised onion paste, red wine stock paste, sugar and water for the sauce (use the quantities listed in the ingredients). Once boiling, reduce the heat and simmer, stirring occasionally, until the sauce has thickened, 5-6 mins. Meanwhile, quarter the lemon into wedges.","Once the sauce has thickened, add the spinach to the pan a handful at a time until wilted and piping hot, 1-2 mins. Stir in the pesto and butter (use the quantities listed in the ingredients) until melted. Stir through the cooked orzo and half the hard Italian style cheese. Stir in a good squeeze of lemon juice. Taste and season with salt, pepper and more lemon juice if needed. Add a splash of water if it's a little too thick.","Share the tomato orzo and its sauce between your bowls. Top with the roasted broccoli. Squeeze some lemon juice over the broccoli. Sprinkle over the remaining cheese and the chilli flakes (use less if you'd prefer things milder). Serve with any remaining lemon wedges alongside."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930733d114b735a0061b87a/step-f20bc400.jpg","caption":"Get Prepped"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930733d114b735a0061b87a/step-9563b110.jpg","caption":"Cook the Orzo"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930733d114b735a0061b87a/step-97fd9c20.jpg","caption":"Roast the Broccoli"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930733d114b735a0061b87a/step-185ca230.jpg","caption":"Sauce Things Up"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930733d114b735a0061b87a/step-1ad6ec40.jpg","caption":"Finishing Touches"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6930733d114b735a0061b87a/step-66754750.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/tomato-pesto-and-caramelised-onion-orzo-6930733d114b735a0061b87a","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/tomato-pesto-and-caramelised-onion-orzo-6930733d114b735a0061b87a","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"pasta","shoppingIngredients":[["160 g","Tenderstem® Broccoli"],["2","Garlic Clove"],["180 g","Orzo"],["1 carton","Tomato Passata"],["35 g","Caramelised Onion Paste"],["28 g","Red Wine Stock Paste"],["1","Lemon"],["40 g","Baby Spinach"],["30 g","Basil Pesto with Cashew Nuts"],["40 g","Grated Hard Italian Style Cheese"],["1 sachet","Chilli Flakes"],["1 tsp","Sugar for the Sauce"],["75 ml","Water for the Sauce"],["15 g","Butter"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-690b7ba39140c7b54ff23b7c","sourceId":"690b7ba39140c7b54ff23b7c","title":"Sticky Sambal Aubergine & Malaysian Style Spiced Chicken Fried Rice","subtitle":"with Stir-Fried Bell Pepper, Peas and Peanuts","time":40,"cost":25.13,"servings":2,"scaleSafe":true,"tags":["south/southeastasian","dinner-bowls","medium spice","high protein","malaysisk","poultry","rice","cook"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Kettle","Sieve","Large Saucepan","Bowl","Rolling Pin","Grater","Pan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R52_W02_UK_V47387-3_Mainhigh-3d5bd046.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/sticky-sambal-aubergine-and-malaysian-style-spiced-chicken-fried-rice-690b7ba39140c7b54ff23b7c","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1","Aubergine"],["150 g","Basmati Rice"],["2","Garlic Clove"],["1","Bell Pepper"],["1","Lime"],["15 g","Sambal Paste"],["20 ml","Soy Sauce"],["240 g","Diced British Chicken Breast"],["50 g","Malaysian Style Paste"],["25 g","Salted Peanuts"],["32 g","Sweet Chilli Sauce"],["120 g","Peas"],["1 tbsp","Honey"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1","Aubergine"],["150 g","Basmati Rice"],["2","Garlic Clove"],["1","Bell Pepper"],["1","Lime"],["15 g","Sambal Paste"],["20 ml","Soy Sauce"],["240 g","Diced British Chicken Breast"],["50 g","Malaysian Style Paste"],["25 g","Salted Peanuts"],["32 g","Sweet Chilli Sauce"],["120 g","Peas"],["1 tbsp","Honey"]],"ingredientMeta":[{"id":"554a6363fd2cb959598b4570","name":"Aubergine","type":"aubergine","family":"aubergine","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Aubergine","marketLabel":"aubergine","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55508011fd2cb96c628b456c","name":"Basmati Rice","type":"basmati rice","family":"rice","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"Basmati Rice","marketLabel":"basmati rice 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632cf717b4f4bc890195c7d3","name":"Bell Pepper","type":"bell-pepper","family":"pepper","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Bell Pepper","marketLabel":"peppers pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6e2a4dab71a9058b4569","name":"Lime","type":"lime","family":"lime","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lime","marketLabel":"limes x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60accf96e728ee63dd0d01d2","name":"Sambal Paste","type":"sambal","family":"Chili sauce","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Sambal Paste","marketLabel":"cooking paste equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"680b9d014a6668c89d92df5a","name":"Soy Sauce","type":"soy sauce","family":"sauce","amount":"20 ml","sourceAmount":20,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Soy Sauce","marketLabel":"soy sauce 150ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6390aea605fc26d5313f23d2","name":"Diced British Chicken Breast","type":"chicken-breast-diced","family":"none","amount":"240 g","sourceAmount":240,"sourceUnit":"grams","shipped":true,"shoppingName":"Diced British Chicken Breast","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"688ab7f21cc5cea71280d46f","name":"Malaysian Style Paste","type":"malaysian-style-paste","family":"none","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Malaysian Style Paste","marketLabel":"cooking paste equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6877ced35a587f17f45951c6","name":"Salted Peanuts","type":"salted peanuts","family":"nut mix","amount":"25 g","sourceAmount":25,"sourceUnit":"grams","shipped":true,"shoppingName":"Salted Peanuts","marketLabel":"table salt 750g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55683f84fd2cb985278b4568","name":"Sweet Chilli Sauce","type":"sweet chilli sauce","family":"Chili sauce","amount":"32 g","sourceAmount":32,"sourceUnit":"grams","shipped":true,"shoppingName":"Sweet Chilli Sauce","marketLabel":"sweet chilli sauce 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556d6384fd2cb954078b4567","name":"Peas","type":"peas","family":"peas","amount":"120 g","sourceAmount":120,"sourceUnit":"grams","shipped":true,"shoppingName":"Peas","marketLabel":"garden peas 910g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6172cb313021d49a7feafc84","name":"Honey","type":"honey-1-tbsp","family":"honey","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Boil a half-full kettle for the rice. Trim and halve the aubergine lengthways, then cut each half into 2cm wedges. Pop the aubergine onto a baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Spread out in a single layer. When the oven is hot, roast the aubergine on the top shelf until soft and golden, 25-30 mins. Turn halfway through.","Meanwhile, pour the boiled water into a large saucepan with ¼ tsp salt on high heat. Add the rice and cook for 10-12 mins. Once cooked, drain in a sieve, then pop it on top of the pan and allow to steam until ready to use.","While the aubergine and rice cook, peel and grate the garlic (or use a garlic press). Halve the bell pepper and discard the core and seeds. Slice into thin strips. Cut the lime into wedges. In a small bowl, combine the sambal paste, honey (use the quantities listed in the ingredients) and half the soy sauce - this is your sambal dressing. Crush the peanuts with a rolling pin or the base of a small saucepan.","Heat a drizzle of oil in a large frying pan on medium-high heat. Once hot, add the diced chicken and pepper and stir-fry, 8-10 mins. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Wash your hands and equipment after handling raw chicken. It's cooked when no longer pink in the middle. Next, add the garlic and Malaysian style paste. Fry for 30 secs. Stir in the cooked rice, along with the sweet chilli sauce and remaining soy sauce. Mix well so that the rice is coated in the spice paste.","Stir the peas into the rice and cook until piping hot, 1-2 mins, then remove from the heat. Squeeze in some lime juice and season with salt and pepper. Once the aubergine is ready, remove from the oven and drizzle over the sambal dressing. Gently toss together.","Share the rice between your bowls. Top the rice with the sambal aubergine and sprinkle over the peanuts. Serve any remaining lime wedges on the side for squeezing over."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7ba39140c7b54ff23b7c/step-48e16f00.jpg","caption":"Roast the Aubergine"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7ba39140c7b54ff23b7c/step-920e0b10.jpg","caption":"Cook the Rice"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7ba39140c7b54ff23b7c/step-7e192120.jpg","caption":"Prep the Rest"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7ba39140c7b54ff23b7c/step-a6be9130.jpg","caption":"Time to Fry"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7ba39140c7b54ff23b7c/step-136b8040.jpg","caption":"Finishing Touches"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7ba39140c7b54ff23b7c/step-7f4eda50.jpg","caption":"Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/sticky-sambal-aubergine-and-malaysian-style-spiced-chicken-fried-rice-690b7ba39140c7b54ff23b7c","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/sticky-sambal-aubergine-and-malaysian-style-spiced-chicken-fried-rice-690b7ba39140c7b54ff23b7c","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"rice","shoppingIngredients":[["1","Aubergine"],["150 g","Basmati Rice"],["2","Garlic Clove"],["1","Bell Pepper"],["1","Lime"],["15 g","Sambal Paste"],["20 ml","Soy Sauce"],["240 g","Diced British Chicken Breast"],["50 g","Malaysian Style Paste"],["25 g","Salted Peanuts"],["32 g","Sweet Chilli Sauce"],["120 g","Peas"],["1 tbsp","Honey"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-690b7b9d48e7b2ec1b114219","sourceId":"690b7b9d48e7b2ec1b114219","title":"Indonesian Style Chicken & Mango Salad and Peanut Dressing","subtitle":"with Roasted Sweet Potato and Pickled Onion","time":40,"cost":21.24,"servings":2,"scaleSafe":true,"tags":["south/southeastasian","dinner-bowls","high protein","indonesian","poultry","salad","cook"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Bowl"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R47_W02_UK_V32190-7_Main__12high-6143a379.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/indonesian-style-chicken-and-mango-salad-and-peanut-dressing-690b7b9d48e7b2ec1b114219","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1","Sweet Potato"],["1","Red Onion"],["240 g","Diced British Chicken Breast"],["22.5 ml","Rice Vinegar"],["125 g","Baby Plum Tomatoes"],["1","Baby Gem Lettuce"],["1","Mango"],["15 g","Sambal Paste"],["10 ml","Soy Sauce"],["30 g","Peanut Butter"],["120 g","Sliced Carrot and Cabbage Mix"],["1 tsp","Sugar for the Pickle"],["1 tsp","Sugar for the Dressing"],["2 tbsp","Olive Oil for the Dressing"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1","Sweet Potato"],["1","Red Onion"],["240 g","Diced British Chicken Breast"],["22.5 ml","Rice Vinegar"],["125 g","Baby Plum Tomatoes"],["1","Baby Gem Lettuce"],["1","Mango"],["15 g","Sambal Paste"],["10 ml","Soy Sauce"],["30 g","Peanut Butter"],["120 g","Sliced Carrot and Cabbage Mix"],["1 tsp","Sugar for the Pickle"],["1 tsp","Sugar for the Dressing"],["2 tbsp","Olive Oil for the Dressing"]],"ingredientMeta":[{"id":"555082a2f8b25e56468b4568","name":"Sweet Potato","type":"sweet potato","family":"potato","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Sweet Potato","marketLabel":"sweet potatoes 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6fb4fd2cb95a598b456e","name":"Red Onion","type":"red onion","family":"onion","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Red Onion","marketLabel":"red onions x3","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6390aea605fc26d5313f23d2","name":"Diced British Chicken Breast","type":"chicken-breast-diced","family":"none","amount":"240 g","sourceAmount":240,"sourceUnit":"grams","shipped":true,"shoppingName":"Diced British Chicken Breast","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a68fa4dab71aa058b4568","name":"Rice Vinegar","type":"rice vinegar","family":"vinegar","amount":"22.5 ml","sourceAmount":22.5,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Rice Vinegar","marketLabel":"cooking vinegar equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5a3cee59c2880024501f6622","name":"Baby Plum Tomatoes","type":"baby-plum-tomatoes","family":"tomato","amount":"125 g","sourceAmount":125,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Plum Tomatoes","marketLabel":"fresh fruit equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68ecc674fa624b85e8848c26","name":"Baby Gem Lettuce","type":"baby gem lettuce","family":"salad mix","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Baby Gem Lettuce","marketLabel":"lettuce or salad leaves","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5d0366906629a5000a05730d","name":"Mango","type":"mango","family":"mango","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Mango","marketLabel":"fresh fruit equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60accf96e728ee63dd0d01d2","name":"Sambal Paste","type":"sambal","family":"Chili sauce","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Sambal Paste","marketLabel":"cooking paste equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"680b9d014a6668c89d92df5a","name":"Soy Sauce","type":"soy sauce","family":"sauce","amount":"10 ml","sourceAmount":10,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Soy Sauce","marketLabel":"soy sauce 150ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"683739cb42dc4b928197f417","name":"Peanut Butter","type":"peanut-butter","family":"peanut","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Peanut Butter","marketLabel":"peanut butter 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5be4237630006c222055d042","name":"Sliced Carrot and Cabbage Mix","type":"coleslaw-mix","family":"salad mix","amount":"120 g","sourceAmount":120,"sourceUnit":"grams","shipped":true,"shoppingName":"Sliced Carrot and Cabbage Mix","marketLabel":"carrots 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5e3416f081143769dd33ba49","name":"Sugar for the Pickle","type":"sugar-for-the-pickle-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Pickle","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb425688281450b8bd079","name":"Sugar for the Dressing","type":"sugar-for-the-dressing-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Dressing","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb168688281450b8bd062","name":"Olive Oil for the Dressing","type":"olive-oil-for-the-dressing-1-tbsp","family":"oil","amount":"2 tbsp","sourceAmount":2,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Olive Oil for the Dressing","marketLabel":"cooking oil 1 litre","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Chop the sweet potato into 1cm chunks (no need to peel). Halve and peel the red onion. Cut one half into 4 wedges and thinly slice the other half.","Pop the sweet potato chunks and onion wedges onto a large baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Spread out in a single layer. Use two baking trays if necessary. When the oven is hot, roast on the top shelf until golden, 18-20 mins. Turn halfway through. When the sweet potato has 15 mins remaining, add the diced chicken to the same tray. Roast for the remaining time, 12-15 mins. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Wash your hands and equipment after handling raw chicken. It's cooked when no longer pink in the middle.","Meanwhile, add the sliced onion to a small bowl with the sugar for the pickle (use the quantities listed in the ingredients) and half the rice vinegar and toss to coat. Set aside. Halve the baby plum tomatoes. Trim the baby gem, separate the leaves, then tear into bite-sized pieces. Peel the mango. Slice down either side of the stone to make 2 'cheeks'. Cut any remaining flesh from the stone, then cut the mango into 1cm pieces (discard the stone). Don't worry if your mango isn't ripe yet - unripe mango is often used in savoury recipes to add a nice tang!","In a large bowl, combine the sambal, soy sauce, peanut butter and remaining rice vinegar with the sugar and olive oil for the dressing (use the quantities listed in the ingredients). If your peanut butter has hardened, put the sachet in a bowl of hot water for 1 min to loosen. Toss through the baby plum tomatoes and coleslaw mix, then set aside.","Once your sweet potato and onion is cooked, toss through the dressing with the baby gem lettuce and pickled onion.","Share your salad between your serving bowls. Top with the sliced mango."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b9d48e7b2ec1b114219/step-f2d35300.jpg","caption":"Prep Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b9d48e7b2ec1b114219/step-b1b5c010.jpg","caption":"Get Roasting"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b9d48e7b2ec1b114219/step-b9cf7d20.jpg","caption":"Finish the Prep"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b9d48e7b2ec1b114219/step-c8b43b30.jpg","caption":"Make your Peanut Dressing"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b9d48e7b2ec1b114219/step-64e9fc40.jpg","caption":"Toss the Salad"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b9d48e7b2ec1b114219/step-6d359d50.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/indonesian-style-chicken-and-mango-salad-and-peanut-dressing-690b7b9d48e7b2ec1b114219","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/indonesian-style-chicken-and-mango-salad-and-peanut-dressing-690b7b9d48e7b2ec1b114219","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"salad","shoppingIngredients":[["1","Sweet Potato"],["1","Red Onion"],["240 g","Diced British Chicken Breast"],["22.5 ml","Rice Vinegar"],["125 g","Baby Plum Tomatoes"],["1","Baby Gem Lettuce"],["1","Mango"],["15 g","Sambal Paste"],["10 ml","Soy Sauce"],["30 g","Peanut Butter"],["120 g","Sliced Carrot and Cabbage Mix"],["1 tsp","Sugar for the Pickle"],["1 tsp","Sugar for the Dressing"],["2 tbsp","Olive Oil for the Dressing"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-6927209656f60405d9112873","sourceId":"6927209656f60405d9112873","title":"Kung Pao Style Prawns and Jasmine Rice","subtitle":"with Pea Pods, Baby Corn, Spring Onion and Cashew Nuts","time":30,"cost":13.68,"servings":2,"scaleSafe":true,"tags":["medium spice","calorie smart","pan-asian-plates","dinner-bowls","pescatarian","new","chinese","seafood","rice","quick"],"requiredEquipment":[],"sourceEquipment":["Medium Saucepan","Lid","Large Frying Pan","Garlic Press"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R24_W05_UK_L31325-4_Main_F1_high-6190f5b2.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/kung-pao-style-prawns-and-jasmine-rice-6927209656f60405d9112873","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["150 g","Jasmine Rice"],["50 g","Cashew Nuts"],["80 g","Young Pea Pods"],["60 g","Baby Corn"],["150 g","King Prawns"],["2","Garlic Clove"],["1","Spring Onion"],["15 g","Ginger Puree"],["75 g","Szechuan Paste"],["15 g","Honey"],["300 ml","Water for the Rice"],["50 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["150 g","Jasmine Rice"],["50 g","Cashew Nuts"],["80 g","Young Pea Pods"],["60 g","Baby Corn"],["150 g","King Prawns"],["2","Garlic Clove"],["1","Spring Onion"],["15 g","Ginger Puree"],["75 g","Szechuan Paste"],["15 g","Honey"],["300 ml","Water for the Rice"],["50 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"59b020d9c2880076673eb222","name":"Jasmine Rice","type":"jasmine-rice","family":"rice","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"Jasmine Rice","marketLabel":"basmati rice 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6925af5d56f60405d9110689","name":"Cashew Nuts","type":"cashew nuts","family":"nut mix","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Cashew Nuts","marketLabel":"nuts and seeds equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"66d08ea0a3a9934710b37319","name":"Young Pea Pods","type":"young-pea-pods","family":"none","amount":"80 g","sourceAmount":80,"sourceUnit":"grams","shipped":true,"shoppingName":"Young Pea Pods","marketLabel":"fresh green vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556876f2fd2cb983298b4569","name":"Baby Corn","type":"baby corn","family":"corn","amount":"60 g","sourceAmount":60,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Corn","marketLabel":"fresh vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632c5abbb4f4bc890195c7a6","name":"King Prawns","type":"king prawns","family":"seafood preparation","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"King Prawns","marketLabel":"large king prawns 150g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6684fd2cb9ba598b4567","name":"Spring Onion","type":"spring onion","family":"onion","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Spring Onion","marketLabel":"spring onions bunch","marketChecked":true,"priceMatchType":"source-identity"},{"id":"59f334f92c3e085ecd21b7f2","name":"Ginger Puree","type":"ginger-puree","family":"ginger","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Ginger Puree","marketLabel":"fresh ginger 100g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5f88503749bf791e225cf9d8","name":"Szechuan Paste","type":"szechuan-paste-duplicate","family":"sauce","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Szechuan Paste","priceMatchType":"source-identity"},{"id":"555363fff8b25e5e0c8b4567","name":"Honey","type":"honey","family":"honey","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"57bec7a892eec9ca688b4568","name":"Water for the Rice","type":"water-for-the-rice-100ml","family":"other drink","amount":"300 ml","sourceAmount":300,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Rice","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"50 ml","sourceAmount":50,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Pour the water for the rice (use the quantities listed in the ingredients) into a medium saucepan with a tight-fitting lid. Stir in the rice and ¼ tsp salt and bring to the boil. Once boiling, turn the heat down to medium and cover with the lid. Leave to cook for 10 mins, then remove the pan from the heat (still covered) and leave to the side for another 10 mins or until ready to serve (the rice will continue to cook in its own steam).","Meanwhile, heat a large frying pan on medium heat (no oil). Once hot, add the cashews and dry-fry, stirring regularly, until lightly toasted, 2-3 mins. Watch them like a hawk as they can burn easily. Once toasted, remove from the pan and set aside for now. While the cashews toast, slice the young pea pods in half lengthways. Halve the baby corn lengthways.","Next, drain the prawns. Return the (now empty) frying pan to medium-high heat with a drizzle of oil. Once hot, add the prawns. Season with salt and pepper and stir-fry for 4-5 mins. Once cooked, remove the pan from the heat. Wash your hands and equipment after handling raw prawns. They're cooked when pink on the outside and opaque in the middle.","While the prawns fry, peel and grate the garlic (or use a garlic press). Trim and thinly slice the spring onion. Once the prawns are cooked, add the garlic, young pea pods, baby corn, ginger puree and half the spring onion to the pan. Fry until fragrant, 2 mins.","Stir the Szechuan paste and water for the sauce (use the quantities listed in the ingredients) into the pan. Bring to the boil, then reduce the heat and simmer until thickened, 3-4 mins. Once thickened, stir the honey and toasted cashews into the sauce. If your honey has hardened, pop in a bowl of hot water for 1 min. Taste and season with salt and pepper if needed. Add a splash of water if it's a little too thick.","Fluff up the rice with a fork, then share between your serving bowls. Spoon over your Kung Pao style prawns. Sprinkle over the remaining spring onion to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6927209656f60405d9112873/step-4127c700.jpg","caption":"Cook the Rice"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6927209656f60405d9112873/step-4a22e410.jpg","caption":"Toast the Cashews"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6927209656f60405d9112873/step-ca38a120.jpg","caption":"Bring on the Prawns"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6927209656f60405d9112873/step-2ace8430.jpg","caption":"Add your Aromatics"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6927209656f60405d9112873/step-87dc4940.jpg","caption":"Kung Pao Sauce Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6927209656f60405d9112873/step-f88e7850.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/kung-pao-style-prawns-and-jasmine-rice-6927209656f60405d9112873","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/kung-pao-style-prawns-and-jasmine-rice-6927209656f60405d9112873","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"rice","shoppingIngredients":[["150 g","Jasmine Rice"],["50 g","Cashew Nuts"],["80 g","Young Pea Pods"],["60 g","Baby Corn"],["150 g","King Prawns"],["2","Garlic Clove"],["1","Spring Onion"],["15 g","Ginger Puree"],["75 g","Szechuan Paste"],["15 g","Honey"],["300 ml","Water for the Rice"],["50 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-6914a9afeae0d18fb69c7155","sourceId":"6914a9afeae0d18fb69c7155","title":"Sabich Inspired Chicken, Aubergine & Houmous Sandwich","subtitle":"with Green Chilli Mayo, Pickled Shallot and Herby Salata Batata","time":25,"cost":24.28,"servings":2,"scaleSafe":true,"tags":["quick","high protein","middle eastern","poultry","sandwich"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Kettle","Rolling Pin","Pan","Aluminum Foil","Baking Paper","Bowl","Medium Saucepan","Colander"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R20_W03_UK_QV48900-3_Main_8_high-078b7b63.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/sabich-inspired-chicken-roasted-aubergine-and-houmous-sandwich-6914a9afeae0d18fb69c7155","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1","Aubergine"],["1 sachet","Roasted Spice and Herb Blend"],["2","British Chicken Breasts"],["350 g","Salad Potatoes"],["1","Lemon"],["1","Echalion Shallot"],["30 g","Green Chilli Paste"],["32 g","Mayonnaise"],["2","Ciabatta"],["1 sachet","Dried Mint"],["100 g","Houmous"],["40 g","Wild Rocket"],["0.5 tsp","Sugar for the Pickle"],["0.5 tsp","Sugar for the Dressing"],["1 tbsp","Olive Oil for the Dressing"],["1 tbsp","Honey"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1","Aubergine"],["1 sachet","Roasted Spice and Herb Blend"],["2","British Chicken Breasts"],["350 g","Salad Potatoes"],["1","Lemon"],["1","Echalion Shallot"],["30 g","Green Chilli Paste"],["32 g","Mayonnaise"],["2","Ciabatta"],["1 sachet","Dried Mint"],["100 g","Houmous"],["40 g","Wild Rocket"],["0.5 tsp","Sugar for the Pickle"],["0.5 tsp","Sugar for the Dressing"],["1 tbsp","Olive Oil for the Dressing"],["1 tbsp","Honey"]],"ingredientMeta":[{"id":"554a6363fd2cb959598b4570","name":"Aubergine","type":"aubergine","family":"aubergine","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Aubergine","marketLabel":"aubergine","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6304d66eff08c9e5b584e015","name":"Roasted Spice and Herb Blend","type":"roasted-spice-and-herb-blend","family":"none","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Roasted Spice and Herb Blend","marketLabel":"seasoning blend equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5e56f8b25ed7288b4576","name":"British Chicken Breasts","type":"chicken-fillet","family":"chicken","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"British Chicken Breasts","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5dbc6e87b96bdd752017bc59","name":"Salad Potatoes","type":"salad-potatoes","family":"potato","amount":"350 g","sourceAmount":350,"sourceUnit":"grams","shipped":true,"shoppingName":"Salad Potatoes","marketLabel":"baby potatoes 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a72ebfd2cb95a598b4570","name":"Lemon","type":"lemon","family":"lemon","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lemon","marketLabel":"lemons x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5568817d4dab71121f8b4568","name":"Echalion Shallot","type":"echalion shallot","family":"onion","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Echalion Shallot","marketLabel":"brown onions 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"682ddc547fe6dd267e2a76fc","name":"Green Chilli Paste","type":"green-chilli-paste","family":"none","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Green Chilli Paste","marketLabel":"cooking paste equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555c9d234dab7162138b4568","name":"Mayonnaise","type":"mayonnaise-tbsp","family":"mayonnaise","amount":"32 g","sourceAmount":32,"sourceUnit":"grams","shipped":true,"shoppingName":"Mayonnaise","marketLabel":"mayonnaise 500ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68371fec42dc4b928197f195","name":"Ciabatta","type":"ciabatta","family":"bread dough","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Ciabatta","marketLabel":"bread loaf","marketChecked":true,"priceMatchType":"source-identity"},{"id":"67dd4b80200ef299d97100b5","name":"Dried Mint","type":"dried-mint","family":"none","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Dried Mint","marketLabel":"fresh mint 30g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"64938f3cf855bec59c8fd364","name":"Houmous","type":"houmous","family":"hummus","amount":"100 g","sourceAmount":100,"sourceUnit":"grams","shipped":true,"shoppingName":"Houmous","marketLabel":"hummus 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555092a4f8b25ed3468b4569","name":"Wild Rocket","type":"rocket","family":"salad mix","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Wild Rocket","marketLabel":"rocket 60g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5e3416f081143769dd33ba49","name":"Sugar for the Pickle","type":"sugar-for-the-pickle-1-tsp","family":"single spice","amount":"0.5 tsp","sourceAmount":0.5,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Pickle","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb425688281450b8bd079","name":"Sugar for the Dressing","type":"sugar-for-the-dressing-1-tsp","family":"single spice","amount":"0.5 tsp","sourceAmount":0.5,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Dressing","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb168688281450b8bd062","name":"Olive Oil for the Dressing","type":"olive-oil-for-the-dressing-1-tbsp","family":"oil","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Olive Oil for the Dressing","marketLabel":"cooking oil 1 litre","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6172cb313021d49a7feafc84","name":"Honey","type":"honey-1-tbsp","family":"honey","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Boil a full kettle. Trim the aubergine, then slice into rounds approximately 1cm thick. Place the aubergine onto a baking tray. Drizzle with oil, sprinkle over the roasted spice and herb blend and season. Toss to coat. Spread out in a single layer. When the oven is hot, roast the aubergine on the top shelf until soft and golden, 20-25 mins. Turn halfway through cooking.","Sandwich each chicken breast between two pieces of baking paper or cling film. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Pop onto a board, then give it a bash with a rolling pin or the bottom of a saucepan until it’s 1-2cm thick. Heat a drizzle of oil in a large frying pan on medium-high heat. Season the chicken. Once hot, lay in the chicken. Fry, 5-6 mins each side. Wash your hands and equipment after handling raw chicken. It's cooked when no longer pink in the middle. Once cooked, transfer the chicken to a board, cover with foil and rest for a couple of mins.","Meanwhile, quarter the salad potatoes (no need to peel). Pour the boiled water into a medium saucepan with ½ tsp salt and bring back to the boil on high heat. Once boiling, add the potatoes, reduce the heat and simmer until just tender, 12-15 mins. Cut the lemon into wedges. Halve, peel and thinly slice the shallot. In a small bowl, mix the shallot with a good squeeze of lemon juice, sugar for the pickle (use the quantities listed in the ingredients) and a pinch of salt. Set aside.","In another small bowl, combine the green chilli paste and mayo. Set aside. Halve the ciabatta.","In a large bowl, combine the dried mint, sugar and olive oil for the dressing (use the quantities listed in the ingredients) and a squeeze of lemon juice. Season with salt and pepper, then set your dressing aside. Once the potatoes are cooked, drain in a colander and allow to cool for a few mins. Add to the dressing bowl along with half the pickled shallot. Toss together. Just before everything's ready, pop the ciabatta into the oven to warm through, 2-3 mins.","Once the aubergine is ready, drizzle over the honey (use the quantities listed in the ingredients). Turn to coat. Slice the chicken into 2cm thick slices. Transfer the ciabatta to your plates. Spread the houmous over the ciabatta bases, top with the sliced chicken, aubergine, the remaining pickled shallot and a handful of rocket. Spread the chilli mayo over the ciabatta lids and sandwich shut. Serve the salata batata and remaining rocket on the side. Drizzle a little oil over the leaves to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9afeae0d18fb69c7155/step-27761000.jpg","caption":"Roast the Aubergine"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9afeae0d18fb69c7155/step-decb5910.jpg","caption":"Cook the Chicken"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9afeae0d18fb69c7155/step-7da8a920.jpg","caption":"Boil the Potatoes"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9afeae0d18fb69c7155/step-dc251130.jpg","caption":"Chilli Yoghurt Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9afeae0d18fb69c7155/step-bd384340.jpg","caption":"Make the Salata Batata"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9afeae0d18fb69c7155/step-b0d6c950.jpg","caption":"Finish and Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/sabich-inspired-chicken-roasted-aubergine-and-houmous-sandwich-6914a9afeae0d18fb69c7155","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/sabich-inspired-chicken-roasted-aubergine-and-houmous-sandwich-6914a9afeae0d18fb69c7155","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"sandwich","shoppingIngredients":[["1","Aubergine"],["1 sachet","Roasted Spice and Herb Blend"],["2","British Chicken Breasts"],["350 g","Salad Potatoes"],["1","Lemon"],["1","Echalion Shallot"],["30 g","Green Chilli Paste"],["32 g","Mayonnaise"],["2","Ciabatta"],["1 sachet","Dried Mint"],["100 g","Houmous"],["40 g","Wild Rocket"],["0.5 tsp","Sugar for the Pickle"],["0.5 tsp","Sugar for the Dressing"],["1 tbsp","Olive Oil for the Dressing"],["1 tbsp","Honey"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-691df1e271644dd339c4300e","sourceId":"691df1e271644dd339c4300e","title":"Lemon and Herb Chicken Traybake","subtitle":"with Sticky Baked Veg, Roasted Kale and Sambal Mayo Drizzle","time":45,"cost":19.07,"servings":2,"scaleSafe":true,"tags":["high protein","regional-specialty","sheet pan","british","poultry","other","cook"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Bowl","Garlic Press","Pan","Aluminum Foil"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R13_W39_UK_R2681-46_Main_high-b73f2c0a.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/lemon-and-herb-chicken-traybake-691df1e271644dd339c4300e","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["450 g","Potatoes"],["2","Red Onion"],["1","Carrot"],["3","Garlic Clove"],["2 sachets","Lemon & Herb Seasoning"],["2","Skin-On British Chicken Breasts"],["30 g","Tomato Puree"],["40 g","Mango Chutney"],["32 g","Mayonnaise"],["15 g","Sambal Paste"],["100 g","Chopped Kale"],["2 tbsp","Olive Oil for the Marinade"],["2 tbsp","Water for the Sauce"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["450 g","Potatoes"],["2","Red Onion"],["1","Carrot"],["3","Garlic Clove"],["2 sachets","Lemon & Herb Seasoning"],["2","Skin-On British Chicken Breasts"],["30 g","Tomato Puree"],["40 g","Mango Chutney"],["32 g","Mayonnaise"],["15 g","Sambal Paste"],["100 g","Chopped Kale"],["2 tbsp","Olive Oil for the Marinade"],["2 tbsp","Water for the Sauce"]],"ingredientMeta":[{"id":"5a39929ec9fd0814815939c2","name":"Potatoes","type":"potatoes","family":"potato","amount":"450 g","sourceAmount":450,"sourceUnit":"grams","shipped":true,"shoppingName":"Potatoes","marketLabel":"potatoes 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6fb4fd2cb95a598b456e","name":"Red Onion","type":"red onion","family":"onion","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Red Onion","marketLabel":"red onions x3","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5f284dab71a6058b4567","name":"Carrot","type":"carrot","family":"carrot","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Carrot","marketLabel":"carrots 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"3","sourceAmount":3,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"630f86d76122aa2ac30074ba","name":"Lemon & Herb Seasoning","type":"lemon-and-herb","family":"none","amount":"2 sachets","sourceAmount":2,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Lemon & Herb Seasoning","marketLabel":"lemons x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5a4f771dc2880079a1305f22","name":"Skin-On British Chicken Breasts","type":"chicken-fillet-skin-on","family":"chicken","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Skin-On British Chicken Breasts","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a708af8b25ef93e8b4567","name":"Tomato Puree","type":"tomato-puree","family":"single ingredient paste","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Tomato Puree","marketLabel":"tomato puree 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55d366e84dab71542f8b4567","name":"Mango Chutney","type":"mango-chutney","family":"chutney","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Mango Chutney","marketLabel":"fresh fruit equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555c9d234dab7162138b4568","name":"Mayonnaise","type":"mayonnaise-tbsp","family":"mayonnaise","amount":"32 g","sourceAmount":32,"sourceUnit":"grams","shipped":true,"shoppingName":"Mayonnaise","marketLabel":"mayonnaise 500ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60accf96e728ee63dd0d01d2","name":"Sambal Paste","type":"sambal","family":"Chili sauce","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Sambal Paste","marketLabel":"cooking paste equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6242043ddf35475d1660ada1","name":"Chopped Kale","type":"chopped-kale","family":"kale","amount":"100 g","sourceAmount":100,"sourceUnit":"grams","shipped":true,"shoppingName":"Chopped Kale","marketLabel":"curly kale 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60758c1d7f2959836817fb38","name":"Olive Oil for the Marinade","type":"olive-oil-for-the-marinade-1-tbsp","family":"oil","amount":"2 tbsp","sourceAmount":2,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Olive Oil for the Marinade","marketLabel":"cooking oil 1 litre","marketChecked":true,"priceMatchType":"source-identity"},{"id":"602fb0d49c479d367f798aed","name":"Water for the Sauce","type":"water-for-the-sauce-1-tbsp","family":"other drink","amount":"2 tbsp","sourceAmount":2,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Chop the potatoes into 2cm chunks (no need to peel). Halve and peel the red onions, then quarter each half. Trim the carrot, then halve lengthways (no need to peel). Chop into roughly 1cm wide, 5cm long batons. Pop the veg onto a large baking tray. Drizzle with oil and season with salt and pepper, then toss to coat. Spread out in a single layer. When the oven is hot, roast the potatoes, carrot and onions on the middle shelf until golden, 30-40 mins. Turn halfway through.","Meanwhile, peel and grate the garlic (or use a garlic press). Pop half the garlic into a medium bowl with the lemon & herb seasoning and the olive oil for the marinade (use the quantities listed in the ingredients). Season with salt and pepper and mix together. Add the chicken to the bowl and mix to coat well. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Wash your hands and equipment after handling raw chicken.","In a small bowl, combine the remaining garlic, tomato puree, mango chutney and water for the sauce (use the quantities listed in the ingredients). Set aside. In another small bowl, mix together the mayonnaise and sambal. Set aside.","Heat a frying pan on medium-high heat (no oil). Once hot, lay the chicken into the pan, skin-side down. Fry until the skin is golden, 5-6 mins, then turn and cook for 1 min on the other side. Once seared, transfer the chicken to another baking tray, skin-side up, then roast on the top shelf until cooked, 12-15 mins. When the chicken is cooked, transfer to a board to rest for a couple of mins loosely covered in foil. The chicken is cooked when no longer pink in the middle.","Once the veg is tender, add the sticky sauce to the veg tray and mix together until well coated. Lay the kale on top of the sticky veg, drizzle with a little oil and season with salt and pepper. Remove any tough stalks from the kale. Return the tray to your oven and bake on the middle shelf until the kale is crispy, 7-8 mins.","When everything's ready, cut the chicken widthways into 2cm thick slices. Mix the potatoes, carrot, onions and kale together on the tray and share between your plates. Top with the lemon and herb chicken, then drizzle over the sambal mayo to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1e271644dd339c4300e/step-69417d00.jpg","caption":"Roast the Veg"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1e271644dd339c4300e/step-da2d9c10.jpg","caption":"Marinate the Chicken"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1e271644dd339c4300e/step-90820420.jpg","caption":"Finish the Prep"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1e271644dd339c4300e/step-0e308030.jpg","caption":"Fry Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1e271644dd339c4300e/step-be6fb740.jpg","caption":"Crisp up the Kale"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/691df1e271644dd339c4300e/step-fe6cf550.jpg","caption":"Finish and Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/lemon-and-herb-chicken-traybake-691df1e271644dd339c4300e","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/lemon-and-herb-chicken-traybake-691df1e271644dd339c4300e","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"other","shoppingIngredients":[["450 g","Potatoes"],["2","Red Onion"],["1","Carrot"],["3","Garlic Clove"],["2 sachets","Lemon & Herb Seasoning"],["2","Skin-On British Chicken Breasts"],["30 g","Tomato Puree"],["40 g","Mango Chutney"],["32 g","Mayonnaise"],["15 g","Sambal Paste"],["100 g","Chopped Kale"],["2 tbsp","Olive Oil for the Marinade"],["2 tbsp","Water for the Sauce"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-690b7b8479e2c370e491e828","sourceId":"690b7b8479e2c370e491e828","title":"Yakisoba Inspired Prawn Egg Noodles","subtitle":"with Hoisin Sauce, Young Pea Pods and Carrot","time":25,"cost":13.19,"servings":2,"scaleSafe":true,"tags":["calorie smart","quick","pescatarian","pan-asian-plates","noodle-stir-fry","high protein","healthy options","japanese","seafood","pasta"],"requiredEquipment":[],"sourceEquipment":["Garlic Press","Large Frying Pan","Sieve","Medium Saucepan","Kettle"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R11_W40_UK_L45308-3_Main_5_high-da29f7ce.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/yakisoba-inspired-prawn-egg-noodles-690b7b8479e2c370e491e828","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1","Red Onion"],["1","Carrot"],["80 g","Young Pea Pods"],["2","Garlic Clove"],["125 g","Egg Noodle Nest"],["150 g","King Prawns"],["15 g","Ginger Puree"],["90 g","Hoisin Sauce"],["20 ml","Soy Sauce"],["15 ml","Rice Vinegar"],["15 g","Worcester Sauce"],["50 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1","Red Onion"],["1","Carrot"],["80 g","Young Pea Pods"],["2","Garlic Clove"],["125 g","Egg Noodle Nest"],["150 g","King Prawns"],["15 g","Ginger Puree"],["90 g","Hoisin Sauce"],["20 ml","Soy Sauce"],["15 ml","Rice Vinegar"],["15 g","Worcester Sauce"],["50 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"554a6fb4fd2cb95a598b456e","name":"Red Onion","type":"red onion","family":"onion","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Red Onion","marketLabel":"red onions x3","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5f284dab71a6058b4567","name":"Carrot","type":"carrot","family":"carrot","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Carrot","marketLabel":"carrots 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"66d08ea0a3a9934710b37319","name":"Young Pea Pods","type":"young-pea-pods","family":"none","amount":"80 g","sourceAmount":80,"sourceUnit":"grams","shipped":true,"shoppingName":"Young Pea Pods","marketLabel":"fresh green vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68373080f7d5496ac4a65cdc","name":"Egg Noodle Nest","type":"egg-noodle-nest","family":"other noodle","amount":"125 g","sourceAmount":125,"sourceUnit":"grams","shipped":true,"shoppingName":"Egg Noodle Nest","marketLabel":"egg noodles 4 nests","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632c5abbb4f4bc890195c7a6","name":"King Prawns","type":"king prawns","family":"seafood preparation","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"King Prawns","marketLabel":"large king prawns 150g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"59f334f92c3e085ecd21b7f2","name":"Ginger Puree","type":"ginger-puree","family":"ginger","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Ginger Puree","marketLabel":"fresh ginger 100g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5568784e4dab71d51e8b4569","name":"Hoisin Sauce","type":"hoisin-sauce","family":"asian paste","amount":"90 g","sourceAmount":90,"sourceUnit":"grams","shipped":true,"shoppingName":"Hoisin Sauce","marketLabel":"Asian cooking sauce equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"680b9d014a6668c89d92df5a","name":"Soy Sauce","type":"soy sauce","family":"sauce","amount":"20 ml","sourceAmount":20,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Soy Sauce","marketLabel":"soy sauce 150ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a68fa4dab71aa058b4568","name":"Rice Vinegar","type":"rice vinegar","family":"vinegar","amount":"15 ml","sourceAmount":15,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Rice Vinegar","marketLabel":"cooking vinegar equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"67f6a20b596b6eeb0c6f979c","name":"Worcester Sauce","type":"vegetarian-worcestershire-sauce","family":"sauce","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Worcester Sauce","marketLabel":"Worcestershire sauce 150ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"50 ml","sourceAmount":50,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Halve, peel and chop the red onion into 2cm pieces. Trim and halve the carrot lengthways (no need to peel). Slice widthways into ½ cm thick half moons. Halve the young pea pods widthways. Peel and grate the garlic (or use a garlic press).","Heat a drizzle of oil in a large frying pan on high heat. Once hot, add the onion and carrot and stir-fry until tender, 5-6 mins.","Meanwhile, boil a full kettle. Pour the boiled water into a medium saucepan with ½ tsp salt and bring to the boil. Add the noodles and cook until tender, 4 mins. Once cooked, drain in a sieve and run under cold water to stop them sticking together.","Next, drain the prawns and add them to the veg pan. Wash your hands and equipment after handling raw prawns. Stir-fry, 2-3 mins more. Add the garlic, ginger puree, pea pods, hoisin sauce, soy sauce, rice vinegar, Worcester sauce and water for the sauce (use the quantities listed in the ingredients) to the prawns.","Stir and bring to the boil, then reduce the heat slightly and simmer for 3-4 mins. The prawns are cooked when pink on the outside and opaque in the middle. Once cooked, add the egg noodles to the prawn pan and toss to coat in the sauce. Taste and season with salt and pepper if you feel it needs it. Add a splash of water if it looks a little dry.","When everything's ready, share the prawn noodle stir-fry between your serving bowls."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b8479e2c370e491e828/step-e5e14b00.jpg","caption":"Get Started"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b8479e2c370e491e828/step-86743910.jpg","caption":"Fry the Veg"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b8479e2c370e491e828/step-27c05620.jpg","caption":"Boil the Noodles"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b8479e2c370e491e828/step-d5fbfd30.jpg","caption":"Simmer Simmer"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b8479e2c370e491e828/step-5fc4ff40.jpg","caption":"All Together Now"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b8479e2c370e491e828/step-94dcfa50.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/yakisoba-inspired-prawn-egg-noodles-690b7b8479e2c370e491e828","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/yakisoba-inspired-prawn-egg-noodles-690b7b8479e2c370e491e828","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"pasta","shoppingIngredients":[["1","Red Onion"],["1","Carrot"],["80 g","Young Pea Pods"],["2","Garlic Clove"],["125 g","Egg Noodle Nest"],["150 g","King Prawns"],["15 g","Ginger Puree"],["90 g","Hoisin Sauce"],["20 ml","Soy Sauce"],["15 ml","Rice Vinegar"],["15 g","Worcester Sauce"],["50 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-6914a9d9eae0d18fb69c71a6","sourceId":"6914a9d9eae0d18fb69c71a6","title":"Greek Inspired Lamb Ragu Jacket Potato","subtitle":"with Tomato and Baby Leaf Salad","time":40,"cost":19.28,"servings":2,"scaleSafe":true,"tags":["calorie smart","high protein","mediterranean","classic-plates","healthy options","greek","lamb","potato","cook"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Garlic Press","Pan","Bowl"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R61_W03_UK_L11140-16_RAN_TD_Main_Balance__Main_high-fbba7688.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/greek-inspired-lamb-ragu-jacket-potato-6914a9d9eae0d18fb69c71a6","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["2","Baking Potato"],["2","Garlic Clove"],["1","Medium Tomato"],["200 g","Lamb Mince"],["1 sachet","Ground Cinnamon"],["1 carton","Tomato Passata"],["10 g","Chicken Stock Paste"],["50 g","Greek Style Salad Cheese"],["12 ml","Red Wine Vinegar"],["50 g","Baby Leaf Mix"],["100 ml","Water for the Ragu"],["1 tbsp","Olive Oil for the Dressing"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["2","Baking Potato"],["2","Garlic Clove"],["1","Medium Tomato"],["200 g","Lamb Mince"],["1 sachet","Ground Cinnamon"],["1 carton","Tomato Passata"],["10 g","Chicken Stock Paste"],["50 g","Greek Style Salad Cheese"],["12 ml","Red Wine Vinegar"],["50 g","Baby Leaf Mix"],["100 ml","Water for the Ragu"],["1 tbsp","Olive Oil for the Dressing"]],"ingredientMeta":[{"id":"556857824dab717e1d8b4569","name":"Baking Potato","type":"baking-potato","family":"potato","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Baking Potato","marketLabel":"potatoes 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60070aba8e7046341a491fcb","name":"Medium Tomato","type":"medium-tomato","family":"tomato","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Medium Tomato","marketLabel":"tomatoes pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55508091f8b25ed3468b4567","name":"Lamb Mince","type":"lamb mince","family":"lamb","amount":"200 g","sourceAmount":200,"sourceUnit":"grams","shipped":true,"shoppingName":"Lamb Mince","marketLabel":"lamb mince 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5568645f4dab71e81d8b4568","name":"Ground Cinnamon","type":"cinnamon","family":"single spice","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Ground Cinnamon","marketLabel":"ground cinnamon jar","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55672166f8b25e412f8b4567","name":"Tomato Passata","type":"tomato passata","family":"single ingredient paste","amount":"1 carton","sourceAmount":1,"sourceUnit":"carton(s)","shipped":true,"shoppingName":"Tomato Passata","marketLabel":"passata 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60002d898c8c0a188200a96d","name":"Chicken Stock Paste","type":"chicken-stock-paste","family":"stock concentrate","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":true,"shoppingName":"Chicken Stock Paste","marketLabel":"chicken stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6764b4a77de812ab26271141","name":"Greek Style Salad Cheese","type":"greek-style-cheese","family":"none","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Greek Style Salad Cheese","marketLabel":"feta 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555ca1774dab7190138b4568","name":"Red Wine Vinegar","type":"red wine vinegar","family":"vinegar","amount":"12 ml","sourceAmount":12,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Red Wine Vinegar","marketLabel":"cooking vinegar equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"56b23e4ef8b25e4c2d8b4567","name":"Baby Leaf Mix","type":"premium baby leaf mix","family":"salad mix","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Leaf Mix","marketLabel":"lettuce or salad leaves","marketChecked":true,"priceMatchType":"source-identity"},{"id":"59fc78b82c3e080f4a24c112","name":"Water for the Ragu","type":"water-for-the-ragu-100ml","family":"other drink","amount":"100 ml","sourceAmount":100,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Ragu","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"5fbeb168688281450b8bd062","name":"Olive Oil for the Dressing","type":"olive-oil-for-the-dressing-1-tbsp","family":"oil","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Olive Oil for the Dressing","marketLabel":"cooking oil 1 litre","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 240°C/220°C fan/gas mark 9. Halve the potatoes lengthways and pop them onto a baking tray. Drizzle with oil and season with salt and pepper. Rub the oil over the potatoes, then lay them cut-side down on the baking tray. Roast on the top shelf of your oven until tender and a knife slips in easily, 30-40 mins. Alternatively, if you have a microwave, you can speed things up. Halve the potatoes lengthways, then prick all over with a knife. Rub with a little oil and season with salt. Place cut-side down onto a plate, then microwave on high until tender, 15-18 mins.","While the potatoes cook, peel and grate the garlic (or use a garlic press). Chop the tomato into 1cm pieces.","Heat a large frying pan on medium-high heat (no oil). Once hot, add the lamb mince and cook until browned, 4-5 mins. Use a spoon to break it up as it cooks, then drain and discard any excess fat. Season with salt and pepper. Wash your hands and equipment after handling raw mince.","Stir the garlic and cinnamon into the lamb mince and cook for 1 min. Pour in the passata, chicken stock paste and water for the ragu (use the quantities listed in the ingredients) and stir together until combined. Bring to the boil, then lower the heat and simmer until thickened, 10-12 mins, stirring occasionally. The mince is cooked when no longer pink in the middle.","Meanwhile, crumble the Greek style salad cheese. Put the tomato, red wine vinegar and olive oil for the dressing (use the quantities listed in the ingredients) into a medium bowl. Season with salt and pepper, mix, then set aside. Just before serving, add the baby leaves to the bowl of dressing and toss to coat. Don't add the leaves too early or they'll go soggy.","When everything's ready, taste the ragu and season if needed. Add a splash of water if it's a little thick. Share the potato halves between your plates. Mash the insides slightly with a fork and add a knob of butter if you'd like. Spoon the lamb ragu over the top (reheat first if needed) and sprinkle with the Greek style salad cheese. Serve the salad alongside."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9d9eae0d18fb69c71a6/step-520a7400.jpg","caption":"Bake the Potatoes"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9d9eae0d18fb69c71a6/step-af7a7710.jpg","caption":"Get Prepped"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9d9eae0d18fb69c71a6/step-feacbb20.jpg","caption":"Brown the Mince"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9d9eae0d18fb69c71a6/step-e4ecca30.jpg","caption":"Simmer your Ragu"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9d9eae0d18fb69c71a6/step-33187b40.jpg","caption":"Make the Salad"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9d9eae0d18fb69c71a6/step-ea96e750.jpg","caption":"Finish and Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/greek-inspired-lamb-ragu-jacket-potato-6914a9d9eae0d18fb69c71a6","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/greek-inspired-lamb-ragu-jacket-potato-6914a9d9eae0d18fb69c71a6","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"potato","shoppingIngredients":[["2","Baking Potato"],["2","Garlic Clove"],["1","Medium Tomato"],["200 g","Lamb Mince"],["1 sachet","Ground Cinnamon"],["1 carton","Tomato Passata"],["10 g","Chicken Stock Paste"],["50 g","Greek Style Salad Cheese"],["12 ml","Red Wine Vinegar"],["50 g","Baby Leaf Mix"],["100 ml","Water for the Ragu"],["1 tbsp","Olive Oil for the Dressing"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-6914a9d87071e7616aa86d41","sourceId":"6914a9d87071e7616aa86d41","title":"Crispy Sea Bream and Lime Coriander Rice","subtitle":"with Sweet Chilli Pea Pods and Baby Corn","time":35,"cost":21.21,"servings":2,"scaleSafe":true,"tags":["healthy options","high protein","pescatarian","calorie smart","pan-asian-plates","dinner-bowls","customer favourite","hellofresh specials","chinese","rice","cook"],"requiredEquipment":[],"sourceEquipment":["Zester","Medium Saucepan","Lid","Bowl","Pan","Aluminum Foil"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R77_W47_UK_R14090-13_Main_high-0ab1ab42.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/crispy-sea-bream-and-lime-coriander-rice-6914a9d87071e7616aa86d41","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["60 g","Baby Corn"],["1 bunch","Coriander"],["1","Lime"],["150 g","Basmati Rice"],["10 g","Vegetable Stock Paste"],["32 g","Sweet Chilli Sauce"],["20 ml","Soy Sauce"],["30 g","Honey"],["7.5 g","Roasted White Sesame Seeds"],["2","Sea Bream Fillets"],["80 g","Young Pea Pods"],["300 ml","Water for the Rice"],["1 tbsp","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["60 g","Baby Corn"],["1 bunch","Coriander"],["1","Lime"],["150 g","Basmati Rice"],["10 g","Vegetable Stock Paste"],["32 g","Sweet Chilli Sauce"],["20 ml","Soy Sauce"],["30 g","Honey"],["7.5 g","Roasted White Sesame Seeds"],["2","Sea Bream Fillets"],["80 g","Young Pea Pods"],["300 ml","Water for the Rice"],["1 tbsp","Water for the Sauce"]],"ingredientMeta":[{"id":"556876f2fd2cb983298b4569","name":"Baby Corn","type":"baby corn","family":"corn","amount":"60 g","sourceAmount":60,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Corn","marketLabel":"fresh vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5f54fd2cb99c598b4567","name":"Coriander","type":"coriander","family":"coriander","amount":"1 bunch","sourceAmount":1,"sourceUnit":"bunch(es)","shipped":true,"shoppingName":"Coriander","marketLabel":"fresh coriander 30g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6e2a4dab71a9058b4569","name":"Lime","type":"lime","family":"lime","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lime","marketLabel":"limes x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55508011fd2cb96c628b456c","name":"Basmati Rice","type":"basmati rice","family":"rice","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"Basmati Rice","marketLabel":"basmati rice 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"641093570565a60137055ba9","name":"Vegetable Stock Paste","type":"vegetable-stock-paste","family":"stock concentrate","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":true,"shoppingName":"Vegetable Stock Paste","marketLabel":"vegetable stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55683f84fd2cb985278b4568","name":"Sweet Chilli Sauce","type":"sweet chilli sauce","family":"Chili sauce","amount":"32 g","sourceAmount":32,"sourceUnit":"grams","shipped":true,"shoppingName":"Sweet Chilli Sauce","marketLabel":"sweet chilli sauce 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"680b9d014a6668c89d92df5a","name":"Soy Sauce","type":"soy sauce","family":"sauce","amount":"20 ml","sourceAmount":20,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Soy Sauce","marketLabel":"soy sauce 150ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555363fff8b25e5e0c8b4567","name":"Honey","type":"honey","family":"honey","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68371fa942dc4b928197f185","name":"Roasted White Sesame Seeds","type":"roasted-white-sesame-seeds","family":"sesame seed","amount":"7.5 g","sourceAmount":7.5,"sourceUnit":"grams","shipped":true,"shoppingName":"Roasted White Sesame Seeds","marketLabel":"sesame seeds 100g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555c961af8b25e44618b4568","name":"Sea Bream Fillets","type":"sea bream fillet","family":"Fish","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Sea Bream Fillets","marketLabel":"white fish equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"66d08ea0a3a9934710b37319","name":"Young Pea Pods","type":"young-pea-pods","family":"none","amount":"80 g","sourceAmount":80,"sourceUnit":"grams","shipped":true,"shoppingName":"Young Pea Pods","marketLabel":"fresh green vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"57bec7a892eec9ca688b4568","name":"Water for the Rice","type":"water-for-the-rice-100ml","family":"other drink","amount":"300 ml","sourceAmount":300,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Rice","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"60b8a3c08b148d1530c49fb7","name":"Water for the Sauce","type":"water-for-the-sauce","family":"other drink","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Halve the baby corn lengthways. Roughly chop the coriander (stalks and all). Zest and halve the lime.","Pour the water for the rice (use the quantities listed in the ingredients) into a medium saucepan with a tight-fitting lid. Stir in the rice, veg stock paste and half the coriander. Bring to the boil. Once boiling, turn the heat down to medium and cover with the lid. Leave to cook for 10 mins, then remove the pan from the heat (still covered) and leave to the side for another 10 mins or until ready to serve (the rice will continue to cook in its own steam).","Meanwhile, in a small bowl, mix together the sweet chilli sauce, soy sauce, honey, sesame seeds and water for the sauce (use the quantities listed in the ingredients). If the measured honey is very thick, warm it briefly so it pours easily. Squeeze in half the lime juice and stir together. Set aside your sticky sauce.","Heat a drizzle of oil in a large frying pan on medium-high heat. Pat the sea bream dry with kitchen paper, then season with salt and pepper. Once hot, carefully place your sea bream in the pan, skin-side down. To get crispy skin on the fish, don't move it around when it's cooking skin-side down. Cook for 3-4 mins before turning over and cooking for 2-3 mins on the other side. Wash your hands and equipment after handling raw fish. It's cooked when opaque in the middle. Once cooked, transfer to a plate and cover with foil to keep warm.","Return the (now empty) frying pan to medium-high heat with a drizzle of oil (no need to clean). Once hot, add the pea pods and baby corn. Stir-fry for 3-4 mins. Pour the sticky sauce into the pan and simmer until slightly thickened, 2-3 mins. Toss to coat in the sauce.","When everything's ready, fluff up the rice with a fork and stir through the lime zest. Share between your bowls and top with the sea bream. Spoon over the veg and sticky sauce from the pan, then sprinkle with the remaining coriander to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9d87071e7616aa86d41/step-56df0a00.jpg","caption":"Get Prepped"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9d87071e7616aa86d41/step-3bb4b510.jpg","caption":"Cook the Coriander Rice"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9d87071e7616aa86d41/step-525fef20.jpg","caption":"Make the Sticky Sauce"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9d87071e7616aa86d41/step-10d27230.jpg","caption":"Fish to Fry"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9d87071e7616aa86d41/step-7bdf0040.jpg","caption":"Bring on the Veg"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9d87071e7616aa86d41/step-8340fb50.jpg","caption":"Finish and Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/crispy-sea-bream-and-lime-coriander-rice-6914a9d87071e7616aa86d41","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/crispy-sea-bream-and-lime-coriander-rice-6914a9d87071e7616aa86d41","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"rice","shoppingIngredients":[["60 g","Baby Corn"],["1 bunch","Coriander"],["1","Lime"],["150 g","Basmati Rice"],["10 g","Vegetable Stock Paste"],["32 g","Sweet Chilli Sauce"],["20 ml","Soy Sauce"],["30 g","Honey"],["7.5 g","Roasted White Sesame Seeds"],["2","Sea Bream Fillets"],["80 g","Young Pea Pods"],["300 ml","Water for the Rice"],["1 tbsp","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-6914a9b17071e7616aa86d0e","sourceId":"6914a9b17071e7616aa86d0e","title":"Sweet Chilli Salmon and Vegetable Gyoza Noodle Bowl","subtitle":"with Stir-Fried Veg and Sesame Seeds","time":25,"cost":14.91,"servings":2,"scaleSafe":true,"tags":["quick","pescatarian","pan-asian-plates","noodle-stir-fry","high protein","asian","seafood","pasta"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Kettle","Baking Paper","Sieve","Medium Saucepan","Garlic Press","Large Frying Pan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF-Y24-R46-W41-UK-R23294-3-MAIN-highediy-06d2ffb0.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/sweet-chilli-salmon-and-vegetable-gyoza-noodle-bowl-6914a9b17071e7616aa86d0e","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["200 g","Salmon Fillets"],["125 g","Egg Noodle Nest"],["2","Garlic Clove"],["80 g","Young Pea Pods"],["120 g","Sliced Carrot and Cabbage Mix"],["60 g","Hoisin Sauce"],["10 ml","Soy Sauce"],["32 g","Sweet Chilli Sauce"],["5 g","Roasted White Sesame Seeds"],["10","Vegetable Gyozas"],["75 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["200 g","Salmon Fillets"],["125 g","Egg Noodle Nest"],["2","Garlic Clove"],["80 g","Young Pea Pods"],["120 g","Sliced Carrot and Cabbage Mix"],["60 g","Hoisin Sauce"],["10 ml","Soy Sauce"],["32 g","Sweet Chilli Sauce"],["5 g","Roasted White Sesame Seeds"],["10","Vegetable Gyozas"],["75 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"62fcaa09bd9a2478e193effe","name":"Salmon Fillets","type":"skin-on-salmon-fillet","family":"none","amount":"200 g","sourceAmount":200,"sourceUnit":"grams","shipped":true,"shoppingName":"Salmon Fillets","marketLabel":"Scottish salmon fillets x2 240g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68373080f7d5496ac4a65cdc","name":"Egg Noodle Nest","type":"egg-noodle-nest","family":"other noodle","amount":"125 g","sourceAmount":125,"sourceUnit":"grams","shipped":true,"shoppingName":"Egg Noodle Nest","marketLabel":"egg noodles 4 nests","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"66d08ea0a3a9934710b37319","name":"Young Pea Pods","type":"young-pea-pods","family":"none","amount":"80 g","sourceAmount":80,"sourceUnit":"grams","shipped":true,"shoppingName":"Young Pea Pods","marketLabel":"fresh green vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5be4237630006c222055d042","name":"Sliced Carrot and Cabbage Mix","type":"coleslaw-mix","family":"salad mix","amount":"120 g","sourceAmount":120,"sourceUnit":"grams","shipped":true,"shoppingName":"Sliced Carrot and Cabbage Mix","marketLabel":"carrots 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5568784e4dab71d51e8b4569","name":"Hoisin Sauce","type":"hoisin-sauce","family":"asian paste","amount":"60 g","sourceAmount":60,"sourceUnit":"grams","shipped":true,"shoppingName":"Hoisin Sauce","marketLabel":"Asian cooking sauce equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"680b9d014a6668c89d92df5a","name":"Soy Sauce","type":"soy sauce","family":"sauce","amount":"10 ml","sourceAmount":10,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Soy Sauce","marketLabel":"soy sauce 150ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55683f84fd2cb985278b4568","name":"Sweet Chilli Sauce","type":"sweet chilli sauce","family":"Chili sauce","amount":"32 g","sourceAmount":32,"sourceUnit":"grams","shipped":true,"shoppingName":"Sweet Chilli Sauce","marketLabel":"sweet chilli sauce 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68371fa942dc4b928197f185","name":"Roasted White Sesame Seeds","type":"roasted-white-sesame-seeds","family":"sesame seed","amount":"5 g","sourceAmount":5,"sourceUnit":"grams","shipped":true,"shoppingName":"Roasted White Sesame Seeds","marketLabel":"sesame seeds 100g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"687528faa5a49c635d8adecc","name":"Vegetable Gyozas","type":"vegetable-gyoza","family":"none","amount":"10","sourceAmount":10,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Vegetable Gyozas","marketLabel":"plant protein equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"75 ml","sourceAmount":75,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Boil a full kettle for the noodles. Lay the salmon fillets, skin-side down, onto a lined baking tray. Drizzle over a little oil, then season with salt and pepper. When the oven is hot, roast the salmon on the top shelf until cooked through, 10-15 mins. Wash your hands and equipment after handling raw fish. It's cooked when opaque in the middle. When the salmon has cooked for 3 mins, add the vegetable gyozas to the same tray. Drizzle with oil and toss to coat. Turn halfway through.","Pour the boiled water from your kettle into a medium saucepan with ½ tsp salt and bring to a boil. Add the noodles and cook until tender, 4 mins. Once cooked, drain in a sieve and run under cold water to stop them sticking together.","While the fish and noodles cook, peel and grate the garlic (or use a garlic press). Slice the young pea pods in half lengthways. Heat a drizzle of oil in a large frying pan on medium-high heat. Once hot, add the pea pods and stir-fry until tender, 3-4 mins.","Add the garlic and coleslaw mix to the pea pods. Stir-fry for 30 secs more. Stir in the hoisin sauce, soy and water for the sauce (use the quantities listed in the ingredients). Bring to the boil, then lower the heat and simmer for 2-3 mins.","Add the cooked noodles to the sauce and veg, mixing well so the noodles are coated in the sauce.","Share the noodles between your bowls and top with the salmon and vegetable gyozas. Drizzle the sweet chilli over the salmon, then finish by sprinkling the sesame seeds over everything."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9b17071e7616aa86d0e/step-059e9300.jpg","caption":"Bake the Salmon and Vegetable Gyozas"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9b17071e7616aa86d0e/step-b905a810.jpg","caption":"Cook the Noodles"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9b17071e7616aa86d0e/step-e5f64720.jpg","caption":"Stir-Fry Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9b17071e7616aa86d0e/step-ef784630.jpg","caption":"Add the Sauce"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9b17071e7616aa86d0e/step-1f91cb40.jpg","caption":"Finish Up"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6914a9b17071e7616aa86d0e/step-04ba6150.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/sweet-chilli-salmon-and-vegetable-gyoza-noodle-bowl-6914a9b17071e7616aa86d0e","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/sweet-chilli-salmon-and-vegetable-gyoza-noodle-bowl-6914a9b17071e7616aa86d0e","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"pasta","shoppingIngredients":[["200 g","Salmon Fillets"],["125 g","Egg Noodle Nest"],["2","Garlic Clove"],["80 g","Young Pea Pods"],["120 g","Sliced Carrot and Cabbage Mix"],["60 g","Hoisin Sauce"],["10 ml","Soy Sauce"],["32 g","Sweet Chilli Sauce"],["5 g","Roasted White Sesame Seeds"],["10","Vegetable Gyozas"],["75 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-690b7bc09140c7b54ff23b9f","sourceId":"690b7bc09140c7b54ff23b9f","title":"Spiced Chicken, Bacon & Avocado Caesar Style Salad","subtitle":"with Roasted Potatoes and Homemade Croutons","time":40,"cost":27.36,"servings":2,"scaleSafe":true,"tags":["north american","high protein","super quick","new","kickstart","hellofresh specials","american","poultry","salad","cook"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Baking Paper","Bowl","Rolling Pin","Pan","Aluminum Foil","Large Bowl","Spoon"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R78_W02_UK_SU48835-3_Mainhigh-e99301ea.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/spiced-chicken-bacon-and-avocado-caesar-style-salad-690b7bc09140c7b54ff23b9f","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["450 g","Potatoes"],["4 rashers","British Streaky Bacon"],["1","Ciabatta"],["2","British Chicken Breasts"],["1 sachet","Central American Style Spice Mix"],["1","Baby Gem Lettuce"],["1","Baby Cucumber"],["1","Avocado"],["1","Lemon"],["50 g","Aioli"],["10 g","Dijon Mustard"],["40 g","Grated Hard Italian Style Cheese"],["1 tbsp","Plain Flour"],["1 tbsp","Honey"],["2 tbsp","Olive Oil for the Dressing"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["450 g","Potatoes"],["4 rashers","British Streaky Bacon"],["1","Ciabatta"],["2","British Chicken Breasts"],["1 sachet","Central American Style Spice Mix"],["1","Baby Gem Lettuce"],["1","Baby Cucumber"],["1","Avocado"],["1","Lemon"],["50 g","Aioli"],["10 g","Dijon Mustard"],["40 g","Grated Hard Italian Style Cheese"],["1 tbsp","Plain Flour"],["1 tbsp","Honey"],["2 tbsp","Olive Oil for the Dressing"]],"ingredientMeta":[{"id":"5a39929ec9fd0814815939c2","name":"Potatoes","type":"potatoes","family":"potato","amount":"450 g","sourceAmount":450,"sourceUnit":"grams","shipped":true,"shoppingName":"Potatoes","marketLabel":"potatoes 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"57458ddaf8b25e187c8b4568","name":"British Streaky Bacon","type":"streaky-bacon-rasher","family":"pork","amount":"4 rashers","sourceAmount":4,"sourceUnit":"rasher(s)","shipped":true,"shoppingName":"British Streaky Bacon","marketLabel":"prepared pork product equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68371fec42dc4b928197f195","name":"Ciabatta","type":"ciabatta","family":"bread dough","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Ciabatta","marketLabel":"bread loaf","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5e56f8b25ed7288b4576","name":"British Chicken Breasts","type":"chicken-fillet","family":"chicken","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"British Chicken Breasts","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"59ad32ea2c3e08228606b422","name":"Central American Style Spice Mix","type":"central-american-style-spice-mix","family":"spice blend","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Central American Style Spice Mix","marketLabel":"seasoning blend equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68ecc674fa624b85e8848c26","name":"Baby Gem Lettuce","type":"baby gem lettuce","family":"salad mix","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Baby Gem Lettuce","marketLabel":"lettuce or salad leaves","marketChecked":true,"priceMatchType":"source-identity"},{"id":"62fcaa53bd9a2478e193f0b4","name":"Baby Cucumber","type":"baby-cucumber","family":"none","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Baby Cucumber","marketLabel":"cucumber","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5550e278f8b25e56468b456f","name":"Avocado","type":"avocado","family":"avocado","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Avocado","marketLabel":"avocado each","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a72ebfd2cb95a598b4570","name":"Lemon","type":"lemon","family":"lemon","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lemon","marketLabel":"lemons x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68a44d3d7e1f6c64ca674b57","name":"Aioli","type":"aioli","family":"none","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Aioli","marketLabel":"table sauce equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5550925ef8b25e56468b456b","name":"Dijon Mustard","type":"dijon-mustard","family":"mustard","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":true,"shoppingName":"Dijon Mustard","marketLabel":"mustard 185g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5550865efd2cb974658b4568","name":"Grated Hard Italian Style Cheese","type":"grated-hard-italian-style-cheese-duplicate","family":"hard cheese","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Grated Hard Italian Style Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60f9470be5a270ab7dbce1b8","name":"Plain Flour","type":"plain-flour-1-tbsp","family":"flour","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Plain Flour","marketLabel":"plain flour 1.5kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6172cb313021d49a7feafc84","name":"Honey","type":"honey-1-tbsp","family":"honey","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb168688281450b8bd062","name":"Olive Oil for the Dressing","type":"olive-oil-for-the-dressing-1-tbsp","family":"oil","amount":"2 tbsp","sourceAmount":2,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Olive Oil for the Dressing","marketLabel":"cooking oil 1 litre","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Chop the potatoes into 2cm chunks (no need to peel) and pop them onto a large baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Spread out in a single layer. Use two baking trays if necessary. When the oven is hot, roast on the top shelf until golden, 25-35 mins. Turn halfway through.","Meanwhile, lay the bacon in a single layer onto one side of a lined baking tray. Tear the ciabatta into roughly 2cm chunks and pop them onto the other side of the bacon tray. Drizzle the ciabatta with oil, season with salt and pepper and toss to coat. Bake the croutons and bacon on the middle shelf until golden and crispy,10-15 mins. Wash your hands and equipment after handling raw meat. Cook bacon thoroughly. Once cooked, remove from the oven and set aside.","Meanwhile, sandwich each chicken breast between two pieces of baking paper or cling film. Pop onto a board, then give it a bash with a rolling pin or the bottom of a saucepan until it’s 1-2cm thick. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Put the Central American style spice mix and flour (use the quantities listed in the ingredients) in a bowl with a good pinch of salt and some pepper and mix together. Lay your chicken breast in the bowl, then toss to ensure the chicken gets an even coating of flour. Repeat for the other breast(s). Wash your hands and equipment after handling raw chicken.","Heat a drizzle of oil in a large frying pan on medium-high heat. Once hot, lay in the chicken. Fry until golden brown and cooked through, 5-6 mins on each side. The chicken is cooked when no longer pink in the middle. Once cooked, drizzle over the honey (use the quantities listed in the ingredients), turn to coat then transfer the chicken to a clean board. Cover with foil and allow to rest.","Meanwhile, trim the baby gem, separate the leaves, then tear into bite-sized pieces. Trim the cucumber, then halve lengthways. Cut into 1cm thick half moons. Halve the avocado and remove the stone. Use a tablespoon to scoop the flesh out onto a board. Cut into 1cm chunks. Cut the lemon into wedges. In a large bowl, combine the aioli, Dijon mustard, hard Italian style cheese and olive oil for the dressing (use the quantities listed in the ingredients). Squeeze in the juice from half the lemon, season with salt and pepper, then mix together well.","When everything's ready, add the lettuce, cucumber, avocado, croutons and potatoes to the bowl of dressing and toss together. Taste and season with more lemon juice, salt and pepper if needed, then share the salad between your serving bowls. Slice the chicken widthways and lay it on top of the salad along with the crispy bacon. Serve any remaining lemon wedges on the side for squeezing over."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7bc09140c7b54ff23b9f/step-c18dbd00.jpg","caption":"Roast the Potatoes"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7bc09140c7b54ff23b9f/step-aa240a10.jpg","caption":"Bake the Croutons and Bacon"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7bc09140c7b54ff23b9f/step-2e540620.jpg","caption":"Bash the Chicken"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7bc09140c7b54ff23b9f/step-83ff9830.jpg","caption":"Time to Fry"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7bc09140c7b54ff23b9f/step-49257540.jpg","caption":"Prep the Rest"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7bc09140c7b54ff23b9f/step-e0a51e50.jpg","caption":"Dress and Serve"}],"sourceStepIngredientIds":[["554a5e56f8b25ed7288b4576"],[],["554a5e56f8b25ed7288b4576"],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/spiced-chicken-bacon-and-avocado-caesar-style-salad-690b7bc09140c7b54ff23b9f","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/spiced-chicken-bacon-and-avocado-caesar-style-salad-690b7bc09140c7b54ff23b9f","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"salad","shoppingIngredients":[["450 g","Potatoes"],["4 rashers","British Streaky Bacon"],["1","Ciabatta"],["2","British Chicken Breasts"],["1 sachet","Central American Style Spice Mix"],["1","Baby Gem Lettuce"],["1","Baby Cucumber"],["1","Avocado"],["1","Lemon"],["50 g","Aioli"],["10 g","Dijon Mustard"],["40 g","Grated Hard Italian Style Cheese"],["1 tbsp","Plain Flour"],["1 tbsp","Honey"],["2 tbsp","Olive Oil for the Dressing"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-690c862279e2c370e491fbeb","sourceId":"690c862279e2c370e491fbeb","title":"Easy Peasy Korean Style Beef Noodles","subtitle":"with Stir-Fried Veg","time":15,"cost":13.71,"servings":2,"scaleSafe":true,"tags":["calorie smart","medium spice","super quick","pan-asian-plates","noodle-stir-fry","healthy options","korean","beef","pasta","quick"],"requiredEquipment":[],"sourceEquipment":["Pan","Kettle","Sieve","Medium Saucepan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R04_W39_UK_UQ16391-10_Main_UQ16391-1_var_high-a5956580.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/easy-peasy-korean-style-beef-noodles-690c862279e2c370e491fbeb","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["240 g","British Beef Mince"],["80 g","Young Pea Pods"],["1","Lime"],["125 g","Egg Noodle Nest"],["120 g","Sliced Carrot and Cabbage Mix"],["50 g","Gochujang Paste"],["32 g","Sweet Chilli Sauce"],["10 ml","Soy Sauce"],["50 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["240 g","British Beef Mince"],["80 g","Young Pea Pods"],["1","Lime"],["125 g","Egg Noodle Nest"],["120 g","Sliced Carrot and Cabbage Mix"],["50 g","Gochujang Paste"],["32 g","Sweet Chilli Sauce"],["10 ml","Soy Sauce"],["50 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"556c1c67fd2cb99f468b4567","name":"British Beef Mince","type":"beef mince","family":"beef","amount":"240 g","sourceAmount":240,"sourceUnit":"grams","shipped":true,"shoppingName":"British Beef Mince","marketLabel":"5% fat beef mince 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"66d08ea0a3a9934710b37319","name":"Young Pea Pods","type":"young-pea-pods","family":"none","amount":"80 g","sourceAmount":80,"sourceUnit":"grams","shipped":true,"shoppingName":"Young Pea Pods","marketLabel":"fresh green vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6e2a4dab71a9058b4569","name":"Lime","type":"lime","family":"lime","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lime","marketLabel":"limes x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68373080f7d5496ac4a65cdc","name":"Egg Noodle Nest","type":"egg-noodle-nest","family":"other noodle","amount":"125 g","sourceAmount":125,"sourceUnit":"grams","shipped":true,"shoppingName":"Egg Noodle Nest","marketLabel":"egg noodles 4 nests","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5be4237630006c222055d042","name":"Sliced Carrot and Cabbage Mix","type":"coleslaw-mix","family":"salad mix","amount":"120 g","sourceAmount":120,"sourceUnit":"grams","shipped":true,"shoppingName":"Sliced Carrot and Cabbage Mix","marketLabel":"carrots 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"63e65a13838062841f0e7218","name":"Gochujang Paste","type":"gochujang-paste","family":"none","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Gochujang Paste","marketLabel":"cooking paste equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55683f84fd2cb985278b4568","name":"Sweet Chilli Sauce","type":"sweet chilli sauce","family":"Chili sauce","amount":"32 g","sourceAmount":32,"sourceUnit":"grams","shipped":true,"shoppingName":"Sweet Chilli Sauce","marketLabel":"sweet chilli sauce 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"680b9d014a6668c89d92df5a","name":"Soy Sauce","type":"soy sauce","family":"sauce","amount":"10 ml","sourceAmount":10,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Soy Sauce","marketLabel":"soy sauce 150ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"50 ml","sourceAmount":50,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Boil a full kettle. Heat a drizzle of oil in a frying pan on medium-high heat. Once hot, fry the beef mince and young pea pods, 5-6 mins. Break up the mince as it cooks, then drain the fat. Season with salt and pepper. Wash your hands and equipment after handling raw mince. Cook so there's no pink in the middle. Meanwhile, cut the lime into wedges.","Meanwhile, pour the boiled water into a saucepan with ½ tsp salt on high heat. Boil the noodles, 4 mins. When cooked, drain and run under cold water to stop them sticking together. Add the coleslaw mix to the beef. Fry until slightly softened, 1 min.","Stir in the gochujang, sweet chilli, soy and water (use the quantities listed in the ingredients). Simmer, 2-3 mins. Stir in the cooked noodles. Add a splash of water if it's a little too thick.","Share the noodles between your serving bowls. Serve with the remaining lime wedges for squeezing over."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690c862279e2c370e491fbeb/step-cda25200.jpg","caption":"Get Frying"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690c862279e2c370e491fbeb/step-30420c10.jpg","caption":"Noodle Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690c862279e2c370e491fbeb/step-45df2f20.jpg","caption":"Add Sauce"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690c862279e2c370e491fbeb/step-53606a30.jpg","caption":"Dinner's Ready!"}],"sourceStepIngredientIds":[[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/easy-peasy-korean-style-beef-noodles-690c862279e2c370e491fbeb","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/easy-peasy-korean-style-beef-noodles-690c862279e2c370e491fbeb","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"pasta","shoppingIngredients":[["240 g","British Beef Mince"],["80 g","Young Pea Pods"],["1","Lime"],["125 g","Egg Noodle Nest"],["120 g","Sliced Carrot and Cabbage Mix"],["50 g","Gochujang Paste"],["32 g","Sweet Chilli Sauce"],["10 ml","Soy Sauce"],["50 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-690b7b7448e7b2ec1b1141f0","sourceId":"690b7b7448e7b2ec1b1141f0","title":"Smoky Bacon Penne and Garlic Ciabatta","subtitle":"with Cheese, Spinach and Crispy Onions","time":30,"cost":18.78,"servings":2,"scaleSafe":true,"tags":["family friendly","mediterranean","pasta-noodles","italian","pork","sandwich","quick"],"requiredEquipment":[],"sourceEquipment":["Garlic Press","Large Saucepan","Pan","Baking Tray","Colander"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R04_W02_UK_FR1624-57_Main_2_high-149bbb9c.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/smoky-bacon-penne-and-garlic-ciabatta-690b7b7448e7b2ec1b1141f0","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1","Garlic Clove"],["90 g","British Smoked Bacon Lardons"],["180 g","Penne Pasta"],["1 carton","Tomato Passata"],["1 sachet","Smoked Paprika"],["28 g","Red Wine Stock Paste"],["1","Ciabatta"],["40 g","Baby Spinach"],["120 g","Peas"],["20 g","Grated Hard Italian Style Cheese"],["1 sachet","Crispy Onions"],["1 tsp","Sugar for the Sauce"],["100 ml","Water for the Sauce"],["1 tbsp","Olive Oil for the Garlic Bread"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1","Garlic Clove"],["90 g","British Smoked Bacon Lardons"],["180 g","Penne Pasta"],["1 carton","Tomato Passata"],["1 sachet","Smoked Paprika"],["28 g","Red Wine Stock Paste"],["1","Ciabatta"],["40 g","Baby Spinach"],["120 g","Peas"],["20 g","Grated Hard Italian Style Cheese"],["1 sachet","Crispy Onions"],["1 tsp","Sugar for the Sauce"],["100 ml","Water for the Sauce"],["1 tbsp","Olive Oil for the Garlic Bread"]],"ingredientMeta":[{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6061f8b25ed7288b4577","name":"British Smoked Bacon Lardons","type":"pancetta","family":"pork","amount":"90 g","sourceAmount":90,"sourceUnit":"grams","shipped":true,"shoppingName":"British Smoked Bacon Lardons","marketLabel":"prepared pork product equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6879961b7299475a5b057874","name":"Penne Pasta","type":"penne-wheat","family":"other noodle","amount":"180 g","sourceAmount":180,"sourceUnit":"grams","shipped":true,"shoppingName":"Penne Pasta","marketLabel":"pasta 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55672166f8b25e412f8b4567","name":"Tomato Passata","type":"tomato passata","family":"single ingredient paste","amount":"1 carton","sourceAmount":1,"sourceUnit":"carton(s)","shipped":true,"shoppingName":"Tomato Passata","marketLabel":"passata 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6390aea6da082ea161fce4e2","name":"Smoked Paprika","type":"smoked-paprika","family":"none","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Smoked Paprika","marketLabel":"paprika jar","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5a4fc599c288003649295c52","name":"Red Wine Stock Paste","type":"red-wine-stock-pot","family":"stock concentrate","amount":"28 g","sourceAmount":28,"sourceUnit":"grams","shipped":true,"shoppingName":"Red Wine Stock Paste","marketLabel":"beef cooking concentrate equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68371fec42dc4b928197f195","name":"Ciabatta","type":"ciabatta","family":"bread dough","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Ciabatta","marketLabel":"bread loaf","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555c9dd5fd2cb92f6c8b4569","name":"Baby Spinach","type":"baby spinach","family":"spinach","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Spinach","marketLabel":"spinach 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556d6384fd2cb954078b4567","name":"Peas","type":"peas","family":"peas","amount":"120 g","sourceAmount":120,"sourceUnit":"grams","shipped":true,"shoppingName":"Peas","marketLabel":"garden peas 910g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5550865efd2cb974658b4568","name":"Grated Hard Italian Style Cheese","type":"grated-hard-italian-style-cheese-duplicate","family":"hard cheese","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Grated Hard Italian Style Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6837308142dc4b928197f3b3","name":"Crispy Onions","type":"crispy-onions","family":"none","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Crispy Onions","marketLabel":"crispy onions 75g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb612688281450b8bd07c","name":"Sugar for the Sauce","type":"sugar-for-the-sauce-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Sauce","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"100 ml","sourceAmount":100,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"602fb8be9c479d367f798aee","name":"Olive Oil for the Garlic Bread","type":"olive-oil-for-the-garlic-bread-1-tbsp","family":"oil","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Olive Oil for the Garlic Bread","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Bring a large saucepan of water to the boil with ½ tsp salt for the pasta. Peel and grate the garlic (or use a garlic press)","Next, heat a drizzle of oil in a frying pan on medium-high heat. Once hot, add the bacon lardons. Stir-fry until golden, 4-5 mins. Wash your hands and equipment after handling raw meat. Cook lardons thoroughly. Meanwhile, add the penne to your pan of boiling water and bring back to the boil. Cook until tender, 12 mins.","Once the bacon is golden, add half the garlic and cook until fragrant, 1 min more. Next, stir in the passata, smoked paprika, red wine stock paste, sugar and water for the sauce (use the quantities listed in the ingredients). Bring to the boil, then lower the heat and simmer gently until thickened, 5-6 mins. Add a splash of water if it gets too thick.","Meanwhile, preheat your grill to high. Halve the ciabatta and lay onto a baking tray, cut-side up. Spread over the remaining garlic and drizzle with the olive oil for the garlic bread (use the quantities listed in the ingredients). Grill until golden, 5-6 mins.","Once the sauce has thickened, add the spinach to the pan a handful at a time until wilted and piping hot, 1-2 mins. Stir in the peas. Once the pasta is cooked, drain in a colander and stir through the sauce along with the cheese. Taste and season with salt and pepper if needed. Add a splash of water to loosen if needed.","Share the smoky pasta between your bowls. Slice the garlic ciabatta diagonally into triangles and serve alongside. Sprinkle with the crispy onions to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b7448e7b2ec1b1141f0/step-d0fb3700.jpg","caption":"Prep the Garlic"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b7448e7b2ec1b1141f0/step-d2cff510.jpg","caption":"Start the Sauce"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b7448e7b2ec1b1141f0/step-f1afdf20.jpg","caption":"Bubble Away"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b7448e7b2ec1b1141f0/step-f347aa30.jpg","caption":"Garlic Ciabatta Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b7448e7b2ec1b1141f0/step-e0c42b40.jpg","caption":"Combine and Stir"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b7448e7b2ec1b1141f0/step-d0805050.jpg","caption":"Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/smoky-bacon-penne-and-garlic-ciabatta-690b7b7448e7b2ec1b1141f0","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/smoky-bacon-penne-and-garlic-ciabatta-690b7b7448e7b2ec1b1141f0","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"sandwich","shoppingIngredients":[["1","Garlic Clove"],["90 g","British Smoked Bacon Lardons"],["180 g","Penne Pasta"],["1 carton","Tomato Passata"],["1 sachet","Smoked Paprika"],["28 g","Red Wine Stock Paste"],["1","Ciabatta"],["40 g","Baby Spinach"],["120 g","Peas"],["20 g","Grated Hard Italian Style Cheese"],["1 sachet","Crispy Onions"],["1 tsp","Sugar for the Sauce"],["100 ml","Water for the Sauce"],["1 tbsp","Olive Oil for the Garlic Bread"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-690b7b6579e2c370e491e809","sourceId":"690b7b6579e2c370e491e809","title":"Cajun Beef Chilli Jacket Potato and Cheese","subtitle":"with Lime Dressed Tomato and Baby Leaf Salad","time":45,"cost":18.45,"servings":2,"scaleSafe":true,"tags":["high protein","winter-warmers","latin-american-faves","dinner-bowls","medium spice","calorie smart","cajunsk","beef","potato","cook"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Garlic Press","Large Frying Pan","Large Bowl","Grater"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y23_R08_W23_UK_L12458-7_Main_low-a6acefea.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/cajun-beef-chilli-jacket-potato-and-cheese-690b7b6579e2c370e491e809","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["2","Baking Potato"],["240 g","British Beef Mince"],["2","Garlic Clove"],["0.5 cartons","Red Kidney Beans"],["1 sachet","Cajun Spice Mix"],["1 carton","Tomato Passata"],["10 g","Chicken Stock Paste"],["40 g","Mature Cheddar Cheese"],["2","Medium Tomato"],["1","Lime"],["20 g","Baby Leaf Mix"],["0.5 tsp","Sugar for the Sauce"],["150 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["2","Baking Potato"],["240 g","British Beef Mince"],["2","Garlic Clove"],["0.5 cartons","Red Kidney Beans"],["1 sachet","Cajun Spice Mix"],["1 carton","Tomato Passata"],["10 g","Chicken Stock Paste"],["40 g","Mature Cheddar Cheese"],["2","Medium Tomato"],["1","Lime"],["20 g","Baby Leaf Mix"],["0.5 tsp","Sugar for the Sauce"],["150 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"556857824dab717e1d8b4569","name":"Baking Potato","type":"baking-potato","family":"potato","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Baking Potato","marketLabel":"potatoes 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556c1c67fd2cb99f468b4567","name":"British Beef Mince","type":"beef mince","family":"beef","amount":"240 g","sourceAmount":240,"sourceUnit":"grams","shipped":true,"shoppingName":"British Beef Mince","marketLabel":"5% fat beef mince 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55508469fd2cb974658b4567","name":"Red Kidney Beans","type":"organic red kidney beans","family":"beans","amount":"0.5 cartons","sourceAmount":0.5,"sourceUnit":"carton(s)","shipped":true,"shoppingName":"Red Kidney Beans","marketLabel":"beans equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632c5aba35df7918d5096b2f","name":"Cajun Spice Mix","type":"cajun-style-spice","family":"spice blend","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Cajun Spice Mix","marketLabel":"seasoning blend equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55672166f8b25e412f8b4567","name":"Tomato Passata","type":"tomato passata","family":"single ingredient paste","amount":"1 carton","sourceAmount":1,"sourceUnit":"carton(s)","shipped":true,"shoppingName":"Tomato Passata","marketLabel":"passata 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60002d898c8c0a188200a96d","name":"Chicken Stock Paste","type":"chicken-stock-paste","family":"stock concentrate","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":true,"shoppingName":"Chicken Stock Paste","marketLabel":"chicken stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"69146769623e0c85b6821082","name":"Mature Cheddar Cheese","type":"cheddar-cheese","family":"hard cheese","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Mature Cheddar Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60070aba8e7046341a491fcb","name":"Medium Tomato","type":"medium-tomato","family":"tomato","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Medium Tomato","marketLabel":"tomatoes pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6e2a4dab71a9058b4569","name":"Lime","type":"lime","family":"lime","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lime","marketLabel":"limes x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"56b23e4ef8b25e4c2d8b4567","name":"Baby Leaf Mix","type":"premium baby leaf mix","family":"salad mix","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Leaf Mix","marketLabel":"lettuce or salad leaves","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb612688281450b8bd07c","name":"Sugar for the Sauce","type":"sugar-for-the-sauce-1-tsp","family":"single spice","amount":"0.5 tsp","sourceAmount":0.5,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Sauce","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"150 ml","sourceAmount":150,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 240°C/220°C fan/gas mark 9. Halve the potatoes lengthways and pop them onto a baking tray. Drizzle with oil and season with salt and pepper. Rub the oil over the potatoes, then lay them cut-side down on the baking tray. When the oven is hot, roast on the top shelf until tender and a knife slips in easily, 30-40 mins. Alternatively, if you have a microwave, you can speed things up. Halve the potatoes lengthways, then prick all over with a knife. Rub with a little oil and season with salt. Place cut-side down onto a plate, then microwave on high until tender, 15-18 mins.","Meanwhile, heat a large frying pan on medium-high heat (no oil). Once hot, add the beef mince and fry until browned, 5-6 mins. Use a spoon to break it up as it cooks. Wash your hands and equipment after handling raw mince. It's cooked when no longer pink in the middle. While the mince cooks, peel and grate the garlic (or use a garlic press). Drain and rinse the kidney beans in a sieve. Once the mince is cooked, drain and discard any excess fat. Season with salt and pepper.","Add the garlic and Cajun spice mix to the beef. Stir-fry for 1 min. Stir in the passata, chicken stock paste, sugar and water for the sauce (use the quantities listed in the ingredients), then stir through the kidney beans (use the amount listed in the ingredients). Bring to the boil, then lower the heat and simmer until thickened, 8-10 mins.","While the mince mixture simmers, grate the Cheddar cheese. Cut the tomatoes into 1cm chunks. Cut the lime into wedges. In a large bowl, combine a drizzle of oil with a good squeeze of lime juice. Season with salt, pepper and 0.25 tsp sugar, then add the tomatoes and mix well. Set aside for now.","Once the mince mixture is ready, season with salt, pepper and a squeeze of lime juice. Remove from the heat. When you're almost ready to serve, reheat the mince if needed. Add a splash of water if it's a little too thick. Add the baby leaves to the bowl of tomatoes and toss together.","Transfer the baked potatoes to your plates, cut-side up. Add a knob of butter to the potatoes if you'd like. Spoon the Cajun beef over the top and sprinkle with the cheese, then garnish with lime wedges for squeezing over. Serve the salad alongside to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b6579e2c370e491e809/step-246e4200.jpg","caption":"Bake the Potatoes"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b6579e2c370e491e809/step-12eeac10.jpg","caption":"Time to Fry"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b6579e2c370e491e809/step-3a019420.jpg","caption":"Bring on the Beans"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b6579e2c370e491e809/step-75f0bc30.jpg","caption":"Prep the Rest"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b6579e2c370e491e809/step-d8955640.jpg","caption":"Finishing Touches"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/690b7b6579e2c370e491e809/step-3a660d50.jpg","caption":"Stack up and Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/cajun-beef-chilli-jacket-potato-and-cheese-690b7b6579e2c370e491e809","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/cajun-beef-chilli-jacket-potato-and-cheese-690b7b6579e2c370e491e809","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"potato","shoppingIngredients":[["2","Baking Potato"],["240 g","British Beef Mince"],["2","Garlic Clove"],["0.5 cartons","Red Kidney Beans"],["1 sachet","Cajun Spice Mix"],["1 carton","Tomato Passata"],["10 g","Chicken Stock Paste"],["40 g","Mature Cheddar Cheese"],["2","Medium Tomato"],["1","Lime"],["20 g","Baby Leaf Mix"],["0.5 tsp","Sugar for the Sauce"],["150 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-68efcee106894ecf191615be","sourceId":"68efcee106894ecf191615be","title":"Umami Miso Baked Salmon Rice Bowl","subtitle":"with Ginger-Sesame Cucumber Salad, Honey-Soy Sweet Potato and Sriracha","time":35,"cost":21.66,"servings":2,"scaleSafe":true,"tags":["pescatarian","pan-asian-plates","dinner-bowls","japanese","seafood","rice","cook"],"requiredEquipment":[],"sourceEquipment":["Bowl","Baking Tray","Sieve","Kettle","Baking Paper","Medium Saucepan","Lid"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R12_W40_UK_R45299-3_edit_salmon_Main_4_high-7ac0fbe5.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/umami-miso-baked-salmon-rice-bowl-68efcee106894ecf191615be","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["15 g","Miso Paste"],["200 g","Salmon Fillets"],["150 g","Sushi Rice"],["1","Sweet Potato"],["1","Baby Cucumber"],["100 g","Radishes"],["15 g","Ginger Puree"],["20 ml","Soy Sauce"],["16 ml","Sriracha Sauce"],["5 g","Roasted White Sesame Seeds"],["300 ml","Water for the Rice"],["2 tbsp","Honey"],["1 tsp","Sugar for the Dressing"],["1 tbsp","Mayonnaise"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["15 g","Miso Paste"],["200 g","Salmon Fillets"],["150 g","Sushi Rice"],["1","Sweet Potato"],["1","Baby Cucumber"],["100 g","Radishes"],["15 g","Ginger Puree"],["20 ml","Soy Sauce"],["16 ml","Sriracha Sauce"],["5 g","Roasted White Sesame Seeds"],["300 ml","Water for the Rice"],["2 tbsp","Honey"],["1 tsp","Sugar for the Dressing"],["1 tbsp","Mayonnaise"]],"ingredientMeta":[{"id":"554a63bffd2cb9ba4f8b4576","name":"Miso Paste","type":"miso-paste","family":"asian paste","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Miso Paste","marketLabel":"miso paste 150g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"62fcaa09bd9a2478e193effe","name":"Salmon Fillets","type":"skin-on-salmon-fillet","family":"none","amount":"200 g","sourceAmount":200,"sourceUnit":"grams","shipped":true,"shoppingName":"Salmon Fillets","marketLabel":"Scottish salmon fillets x2 240g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"610cfdedaa24686fa96b6f52","name":"Sushi Rice","type":"sushi-rice","family":"rice","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"Sushi Rice","marketLabel":"rice equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555082a2f8b25e56468b4568","name":"Sweet Potato","type":"sweet potato","family":"potato","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Sweet Potato","marketLabel":"sweet potatoes 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"62fcaa53bd9a2478e193f0b4","name":"Baby Cucumber","type":"baby-cucumber","family":"none","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Baby Cucumber","marketLabel":"cucumber","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5e285e7fa395ab02d4687bc8","name":"Radishes","type":"radishes","family":"radish","amount":"100 g","sourceAmount":100,"sourceUnit":"grams","shipped":true,"shoppingName":"Radishes","marketLabel":"fresh vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"59f334f92c3e085ecd21b7f2","name":"Ginger Puree","type":"ginger-puree","family":"ginger","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Ginger Puree","marketLabel":"fresh ginger 100g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"680b9d014a6668c89d92df5a","name":"Soy Sauce","type":"soy sauce","family":"sauce","amount":"20 ml","sourceAmount":20,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Soy Sauce","marketLabel":"soy sauce 150ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5c3f3eadc445fa4233599443","name":"Sriracha Sauce","type":"sriracha (anchovy)","family":"Chili sauce","amount":"16 ml","sourceAmount":16,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Sriracha Sauce","marketLabel":"table sauce equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68371fa942dc4b928197f185","name":"Roasted White Sesame Seeds","type":"roasted-white-sesame-seeds","family":"sesame seed","amount":"5 g","sourceAmount":5,"sourceUnit":"grams","shipped":true,"shoppingName":"Roasted White Sesame Seeds","marketLabel":"sesame seeds 100g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"57bec7a892eec9ca688b4568","name":"Water for the Rice","type":"water-for-the-rice-100ml","family":"other drink","amount":"300 ml","sourceAmount":300,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Rice","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"6172cb313021d49a7feafc84","name":"Honey","type":"honey-1-tbsp","family":"honey","amount":"2 tbsp","sourceAmount":2,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb425688281450b8bd079","name":"Sugar for the Dressing","type":"sugar-for-the-dressing-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Dressing","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbe487e8afb1b135f069bd2","name":"Mayonnaise","type":"mayonnaise-tbsp","family":"mayonnaise","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Mayonnaise","marketLabel":"mayonnaise 500ml","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. In a small bowl, mix together the miso paste and half the honey (use the quantities listed in the ingredients). Lay the salmon, skin-side down, onto a lined baking tray. Use the back of a spoon to spread the marinade onto the fish and set aside for now to marinate. Wash your hands and equipment after handling raw fish. Meanwhile, boil a half-full kettle. Thoroughly rinse the sushi rice under cold water in a sieve until it runs clear.","Cut the sweet potato widthways into 1cm thick rounds (no need to peel). Put the sweet potato onto a large baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Spread out in a single layer. Bake on the middle shelf until golden and cooked through, 25-28 mins. Turn halfway through.","Meanwhile, pour the boiled water for the rice (use the quantities listed in the ingredients) into a medium saucepan, bring back to the boil on high heat. Stir in the sushi rice and turn the heat down to low. Cover with a tight-fitting lid and cook for 15 mins. Remove from the heat (still covered) and leave to the side for 5 mins or until ready to serve (the rice will continue to cook in its own steam).","Once the sweet potato has roasted for 15 mins, add the salmon to the top shelf of your oven and bake until the fish is cooked, 10-15 mins. The fish is cooked when opaque in the middle. Meanwhile, trim the cucumber, then cut into 2cm pieces. Trim and quarter the radishes.","In a medium bowl, combine the ginger puree, half the soy sauce and the sugar for the dressing (use the quantities listed in the ingredients). Add the radish and cucumber to the dressing, then toss together. When the sweet potato has 5 mins remaining, remove from the oven and pour over the remaining soy sauce and remaining honey (use the quantities listed in the ingredients). Toss to coat the pieces then return to the oven to roast for the remaining time, 5 mins.","Fluff up the rice with a fork and share between your serving bowls. Top with the miso salmon, cucumber and radish ginger salad and the soy-honey sweet potato. Drizzle over the sriracha and mayo (use the quantities listed in the ingredients). Finish by sprinkling over the sesame seeds."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/68efcee106894ecf191615be/step-90b9d700.jpg","caption":"Marinate the Salmon"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/68efcee106894ecf191615be/step-26a52610.jpg","caption":"Bake the Sweet Potato"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/68efcee106894ecf191615be/step-be41cb20.jpg","caption":"Boil the Rice"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/68efcee106894ecf191615be/step-0627c730.jpg","caption":"Bake the Salmon"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/68efcee106894ecf191615be/step-8f0e5540.jpg","caption":"Prep the Salad"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/68efcee106894ecf191615be/step-198f8d50.jpg","caption":"Serve"}],"sourceStepIngredientIds":[["6172cb313021d49a7feafc84","610cfdedaa24686fa96b6f52","62fcaa09bd9a2478e193effe","554a63bffd2cb9ba4f8b4576"],["555082a2f8b25e56468b4568"],["57bec7a892eec9ca688b4568","610cfdedaa24686fa96b6f52"],["5fbeb425688281450b8bd079","5e285e7fa395ab02d4687bc8","62fcaa53bd9a2478e193f0b4"],["5fbe487e8afb1b135f069bd2","6172cb313021d49a7feafc84","680b9d014a6668c89d92df5a","59f334f92c3e085ecd21b7f2","5e285e7fa395ab02d4687bc8","62fcaa53bd9a2478e193f0b4","555082a2f8b25e56468b4568"],["5fbe487e8afb1b135f069bd2","5fbeb425688281450b8bd079","6172cb313021d49a7feafc84","57bec7a892eec9ca688b4568","68371fa942dc4b928197f185","5c3f3eadc445fa4233599443","680b9d014a6668c89d92df5a","59f334f92c3e085ecd21b7f2","5e285e7fa395ab02d4687bc8","62fcaa53bd9a2478e193f0b4","555082a2f8b25e56468b4568","610cfdedaa24686fa96b6f52","62fcaa09bd9a2478e193effe","554a63bffd2cb9ba4f8b4576"]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/umami-miso-baked-salmon-rice-bowl-68efcee106894ecf191615be","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/umami-miso-baked-salmon-rice-bowl-68efcee106894ecf191615be","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"rice","shoppingIngredients":[["15 g","Miso Paste"],["200 g","Salmon Fillets"],["150 g","Sushi Rice"],["1","Sweet Potato"],["1","Baby Cucumber"],["100 g","Radishes"],["15 g","Ginger Puree"],["20 ml","Soy Sauce"],["16 ml","Sriracha Sauce"],["5 g","Roasted White Sesame Seeds"],["300 ml","Water for the Rice"],["2 tbsp","Honey"],["1 tsp","Sugar for the Dressing"],["1 tbsp","Mayonnaise"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-68fa0063ff3933d87e3fe26c","sourceId":"68fa0063ff3933d87e3fe26c","title":"Pulled Beef Ragu and Camembert & Rosemary Baguette","subtitle":"with Fresh Tagliatelle and Rocket Salad","time":25,"cost":24.52,"servings":2,"scaleSafe":true,"tags":["high protein","quick","family friendly","mediterranean","pasta-noodles","quick prep","festive-flavours","new","hellofresh specials","italian","beef","sandwich"],"requiredEquipment":[],"sourceEquipment":["Medium Saucepan","Lid","Baking Tray","Baking Paper"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R79_W52_UK_SPR46107-2_Main_low-3358e678.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/pulled-beef-ragu-and-camembert-and-rosemary-baguette-68fa0063ff3933d87e3fe26c","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1","SlooOW Stone Oven White Baguette"],["175 g","French Camembert"],["1 bunch","Rosemary"],["280 g","Slow Cooked Beef"],["1 carton","Tomato Passata"],["28 g","Red Wine Stock Paste"],["15 g","Worcester Sauce"],["250 g","Fresh Tagliatelle"],["40 g","Baby Spinach"],["40 g","Grated Hard Italian Style Cheese"],["20 g","Wild Rocket"],["40 g","Onion Marmalade"],["1 tsp","Sugar"],["250 ml","Water for the Sauce"],["20 g","Butter"],["as needed","olive oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1","SlooOW Stone Oven White Baguette"],["175 g","French Camembert"],["1 bunch","Rosemary"],["280 g","Slow Cooked Beef"],["1 carton","Tomato Passata"],["28 g","Red Wine Stock Paste"],["15 g","Worcester Sauce"],["250 g","Fresh Tagliatelle"],["40 g","Baby Spinach"],["40 g","Grated Hard Italian Style Cheese"],["20 g","Wild Rocket"],["40 g","Onion Marmalade"],["1 tsp","Sugar"],["250 ml","Water for the Sauce"],["20 g","Butter"]],"ingredientMeta":[{"id":"68371e2f42dc4b928197f137","name":"SlooOW Stone Oven White Baguette","type":"slooow-stone-oven-white-baguette","family":"none","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"SlooOW Stone Oven White Baguette","marketLabel":"bakery product equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5bcee5c9ae08b5419e33c772","name":"French Camembert","type":"french-camembert","family":"soft-ripened cheese","amount":"175 g","sourceAmount":175,"sourceUnit":"grams","shipped":true,"shoppingName":"French Camembert","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a773f4dab71aa058b456a","name":"Rosemary","type":"rosemary","family":"rosemary","amount":"1 bunch","sourceAmount":1,"sourceUnit":"bunch(es)","shipped":true,"shoppingName":"Rosemary","marketLabel":"dried herbs jar","marketChecked":true,"priceMatchType":"source-identity"},{"id":"637f7b0b1ef09fb45a483bb5","name":"Slow Cooked Beef","type":"slow-cooked-beef","family":"none","amount":"280 g","sourceAmount":280,"sourceUnit":"grams","shipped":true,"shoppingName":"Slow Cooked Beef","marketLabel":"prepared beef equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55672166f8b25e412f8b4567","name":"Tomato Passata","type":"tomato passata","family":"single ingredient paste","amount":"1 carton","sourceAmount":1,"sourceUnit":"carton(s)","shipped":true,"shoppingName":"Tomato Passata","marketLabel":"passata 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5a4fc599c288003649295c52","name":"Red Wine Stock Paste","type":"red-wine-stock-pot","family":"stock concentrate","amount":"28 g","sourceAmount":28,"sourceUnit":"grams","shipped":true,"shoppingName":"Red Wine Stock Paste","marketLabel":"beef cooking concentrate equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"67f6a20b596b6eeb0c6f979c","name":"Worcester Sauce","type":"vegetarian-worcestershire-sauce","family":"sauce","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Worcester Sauce","marketLabel":"Worcestershire sauce 150ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6864ee08b3c183c7dd037530","name":"Fresh Tagliatelle","type":"fresh-tagliatelle","family":"other noodle","amount":"250 g","sourceAmount":250,"sourceUnit":"grams","shipped":true,"shoppingName":"Fresh Tagliatelle","marketLabel":"prepared pasta or pastry equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555c9dd5fd2cb92f6c8b4569","name":"Baby Spinach","type":"baby spinach","family":"spinach","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Spinach","marketLabel":"spinach 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5550865efd2cb974658b4568","name":"Grated Hard Italian Style Cheese","type":"grated-hard-italian-style-cheese-duplicate","family":"hard cheese","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Grated Hard Italian Style Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555092a4f8b25ed3468b4569","name":"Wild Rocket","type":"rocket","family":"salad mix","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Wild Rocket","marketLabel":"rocket 60g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5852bce27d69bf2b3f5a65e1","name":"Onion Marmalade","type":"original-onion-marmalade","family":"fruit preserves","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Onion Marmalade","marketLabel":"onion preserve equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555093924dab71e7118b4568","name":"Sugar","type":"sugar-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"250 ml","sourceAmount":250,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"60c73507053f5e815cd52d5b","name":"Butter","type":"butter-100g","family":"butter","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":false,"shoppingName":"Butter","marketLabel":"butter 500g","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Halve the baguette lengthways. Cut the Camembert into 1cm thick slices. Halve any large pieces. Pick the rosemary leaves from their stalks and roughly chop (discard the stalks).","Heat a saucepan with a tight-fitting lid on medium-high heat (no oil). Add the beef and juices from the packet. Stir in the passata, red wine stock paste, Worcester sauce, sugar and water for the sauce (use the quantities listed in the ingredients). Simmer with the lid on until the beef is tender, 10-15 mins. Ensure the beef is piping hot throughout.","Meanwhile, pop the baguette halves onto a lined baking tray, cut-side up. Lay the Camembert slices evenly over both baguette halves. Sprinkle over the rosemary - as much as you'd like! Bake on the top shelf of your oven until the cheese is melted and lighlty golden, 10-15 mins.","Meanwhile, once the beef is tender, remove the lid. Use two forks to shred the beef. Season with salt and pepper. Stir in the tagliatelle. Simmer on low until the pasta is cooked and the sauce has thickened, 5-6 mins.","Stir in the spinach in handfuls, butter (use the quantities listed in the ingredients) and half the cheese, making sure it's piping hot, 1-2 mins. Season with salt and pepper. Add a splash of water if it's too thick.","Share the ragu and tagliatelle between your bowls. Sprinkle over the remaining cheese. Serve the loaded Camembert baguettes and rocket alongside. Spoon the onion marmalade over the cheesy baguettes and finish by drizzling some olive oil over the rocket leaves."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/68fa0063ff3933d87e3fe26c/step-498cbc00.jpg","caption":"Get Prepped"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/68fa0063ff3933d87e3fe26c/step-8f050f10.jpg","caption":"Ragu Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/68fa0063ff3933d87e3fe26c/step-f5861b20.jpg","caption":"Get Cheesy"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/68fa0063ff3933d87e3fe26c/step-2ba56230.jpg","caption":"Add Pasta"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/68fa0063ff3933d87e3fe26c/step-4ae83440.jpg","caption":"All Together Now"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/68fa0063ff3933d87e3fe26c/step-fd5d4a50.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/pulled-beef-ragu-and-camembert-and-rosemary-baguette-68fa0063ff3933d87e3fe26c","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/pulled-beef-ragu-and-camembert-and-rosemary-baguette-68fa0063ff3933d87e3fe26c","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"sandwich","shoppingIngredients":[["1","SlooOW Stone Oven White Baguette"],["175 g","French Camembert"],["1 bunch","Rosemary"],["280 g","Slow Cooked Beef"],["1 carton","Tomato Passata"],["28 g","Red Wine Stock Paste"],["15 g","Worcester Sauce"],["250 g","Fresh Tagliatelle"],["40 g","Baby Spinach"],["40 g","Grated Hard Italian Style Cheese"],["20 g","Wild Rocket"],["40 g","Onion Marmalade"],["1 tsp","Sugar"],["250 ml","Water for the Sauce"],["20 g","Butter"],["as needed","olive oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-hf-68fa03746c0a84b7da29ca9d","sourceId":"68fa03746c0a84b7da29ca9d","title":"Crispy Chorizo Topped Oven-Baked Tomato Risotto","subtitle":"with Garlicky Courgette and Ricotta","time":40,"cost":23.71,"servings":2,"scaleSafe":true,"tags":["mediterranean","pasta-noodles","new","pork","rice","cook"],"requiredEquipment":[],"sourceEquipment":["Large Oven-Proof Pan","Garlic Press","Kettle","Lid","Pan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R15_W52_UK_R41499-5_Main_high-a34e3fc6.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/crispy-chorizo-topped-oven-baked-tomato-risotto-68fa03746c0a84b7da29ca9d","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1","Bell Pepper"],["1","Courgette"],["4","Garlic Clove"],["50 g","Chorizo Slices"],["175 g","Risotto Rice"],["20 g","Chicken Stock Paste"],["40 g","Grated Hard Italian Style Cheese"],["25 g","Sun-Dried Tomato Paste"],["100 g","Ricotta Cheese"],["600 ml","Boiled Water for the Risotto"],["1 tbsp","Honey"],["20 g","Butter"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1","Bell Pepper"],["1","Courgette"],["4","Garlic Clove"],["50 g","Chorizo Slices"],["175 g","Risotto Rice"],["20 g","Chicken Stock Paste"],["40 g","Grated Hard Italian Style Cheese"],["25 g","Sun-Dried Tomato Paste"],["100 g","Ricotta Cheese"],["600 ml","Boiled Water for the Risotto"],["1 tbsp","Honey"],["20 g","Butter"]],"ingredientMeta":[{"id":"632cf717b4f4bc890195c7d3","name":"Bell Pepper","type":"bell-pepper","family":"pepper","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Bell Pepper","marketLabel":"peppers pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a727dfd2cb959598b4574","name":"Courgette","type":"courgette","family":"zucchini","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Courgette","marketLabel":"courgettes pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"4","sourceAmount":4,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"656e68f02db9273db6a42986","name":"Chorizo Slices","type":"sliced-chorizo","family":"pork","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Chorizo Slices","marketLabel":"prepared pork product equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5992fd2cb95a598b456a","name":"Risotto Rice","type":"risotto-rice","family":"rice","amount":"175 g","sourceAmount":175,"sourceUnit":"grams","shipped":true,"shoppingName":"Risotto Rice","marketLabel":"risotto rice 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60002d898c8c0a188200a96d","name":"Chicken Stock Paste","type":"chicken-stock-paste","family":"stock concentrate","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Chicken Stock Paste","marketLabel":"chicken stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5550865efd2cb974658b4568","name":"Grated Hard Italian Style Cheese","type":"grated-hard-italian-style-cheese-duplicate","family":"hard cheese","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Grated Hard Italian Style Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5f327c6560efd3453038c2a8","name":"Sun-Dried Tomato Paste","type":"sundried-tomato-paste-duplicate","family":"single ingredient paste","amount":"25 g","sourceAmount":25,"sourceUnit":"grams","shipped":true,"shoppingName":"Sun-Dried Tomato Paste","marketLabel":"sun-dried tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"id":"668804bb018283f1f4397266","name":"Ricotta Cheese","type":"ricotta cheese","family":"hard cheese","amount":"100 g","sourceAmount":100,"sourceUnit":"grams","shipped":true,"shoppingName":"Ricotta Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"61f968097f9b41760f4d2295","name":"Boiled Water for the Risotto","type":"boiled-water-for-the-risotto-100ml","family":"other drink","amount":"600 ml","sourceAmount":600,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Boiled Water for the Risotto","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"6172cb313021d49a7feafc84","name":"Honey","type":"honey-1-tbsp","family":"honey","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60c73507053f5e815cd52d5b","name":"Butter","type":"butter-100g","family":"butter","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":false,"shoppingName":"Butter","marketLabel":"butter 500g","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Boil a full kettle. Halve the bell pepper and discard the core and seeds. Chop into 1-2cm chunks. Trim the courgette and slice into 1cm thick rounds. Peel and grate the garlic (or use a garlic press). Heat a drizzle of oil in a large, wide-bottomed ovenproof pan on medium heat. If you don't have an ovenproof pan, use a normal pan and transfer to an ovenproof dish before baking. Once hot, lay the chorizo into the pan and fry until crispy, 2-3 mins each side. Once crispy, transfer to a plate covered in kitchen paper. If you prefer hob cooking your risotto, just use a normal pan.","Pop the (now empty) saucepan on medium-high heat. Once hot, add the pepper and fry until charred, 5-6 mins. Continue to stir while it cooks. Add half the garlic and fry for 1 minute. Add the risotto rice, stir and cook until the edges of the rice are translucent, 1-2 mins. Stir in the boiled water for the risotto and honey (use the quantities listed in the ingredients) and chicken stock paste. Bring back up to the boil, then pop a lid on the pan (or cover with foil). For hob cooking, pour in 2p: 800ml, 3p: 1200ml, 4p: 1600ml of boiled water a third at a time, stirring each time until the stock has been absorbed, 20-25 mins.","Bake on the middle shelf of your oven until the rice is cooked and the water has been absorbed, 25-30 mins.","Meanwhile, heat a drizzle of oil in a large frying pan on high heat. When hot, add the courgette and cook until charred, 3-4 mins each side. Once cooked, reduce the heat to medium. Add the remaining garlic and season with salt and pepper. Stir-fry for 1 minute. Remove from the heat.","When the risotto is cooked, remove it from the oven and stir through the hard Italian style cheese, sun-dried tomato paste and butter (use the quantities listed in the ingredients). Taste and season with salt and pepper if needed. Add a splash of water to loosen the risotto to your desired consistency.","Divide the risotto between bowls. Dot the ricotta over the risotto and top with the charred courgette. Crumble the crispy chorizo into shards over the top to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/68fa03746c0a84b7da29ca9d/step-cd9d0000.jpg","caption":"Fry the Chorizo"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/68fa03746c0a84b7da29ca9d/step-7d95b710.jpg","caption":"Cook the Pepper"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/68fa03746c0a84b7da29ca9d/step-102a9920.jpg","caption":"Bake the Risotto"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/68fa03746c0a84b7da29ca9d/step-87816330.jpg","caption":"Char the Courgette"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/68fa03746c0a84b7da29ca9d/step-f858f440.jpg","caption":"Add the Flavour"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/68fa03746c0a84b7da29ca9d/step-2cbe7650.jpg","caption":"Serve"}],"sourceStepIngredientIds":[["656e68f02db9273db6a42986","58f11054d56afa789e7f2b22","554a727dfd2cb959598b4574","632cf717b4f4bc890195c7d3"],["6172cb313021d49a7feafc84","61f968097f9b41760f4d2295","60002d898c8c0a188200a96d","554a5992fd2cb95a598b456a","58f11054d56afa789e7f2b22","632cf717b4f4bc890195c7d3"],[],["58f11054d56afa789e7f2b22","554a727dfd2cb959598b4574"],["60c73507053f5e815cd52d5b","5f327c6560efd3453038c2a8","5550865efd2cb974658b4568"],["60c73507053f5e815cd52d5b","6172cb313021d49a7feafc84","61f968097f9b41760f4d2295","668804bb018283f1f4397266","5f327c6560efd3453038c2a8","5550865efd2cb974658b4568","60002d898c8c0a188200a96d","554a5992fd2cb95a598b456a","656e68f02db9273db6a42986","58f11054d56afa789e7f2b22","554a727dfd2cb959598b4574","632cf717b4f4bc890195c7d3"]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/crispy-chorizo-topped-oven-baked-tomato-risotto-68fa03746c0a84b7da29ca9d","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/crispy-chorizo-topped-oven-baked-tomato-risotto-68fa03746c0a84b7da29ca9d","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"rice","shoppingIngredients":[["1","Bell Pepper"],["1","Courgette"],["4","Garlic Clove"],["50 g","Chorizo Slices"],["175 g","Risotto Rice"],["20 g","Chicken Stock Paste"],["40 g","Grated Hard Italian Style Cheese"],["25 g","Sun-Dried Tomato Paste"],["100 g","Ricotta Cheese"],["600 ml","Boiled Water for the Risotto"],["1 tbsp","Honey"],["20 g","Butter"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-722d8b42-31dd-47fc-824d-19ce7f9c30bb","sourceId":"722d8b42-31dd-47fc-824d-19ce7f9c30bb","title":"3 Cheese Veg-Packed Wholewheat Pasta Bake","subtitle":"Layer this wholewheat courgette pasta with not one, but three cheeses for a tasty midweek bake.","time":25,"cost":22.63,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","vegetarian","everyday favourites","italian","pasta","quick"],"requiredEquipment":[],"sourceEquipment":["Oven","Frying pan","Saucepan","Kettle","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/2852_3-Cheese-Veg-Packed-Wholegrain-Pasta-Bake-1010-1591280838041-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/3-cheese-veg-packed-wholewheat-pasta-bake","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["40 g","cheddar cheese"],["30 g","grated Italian hard cheese"],["200 g","finely chopped tomatoes"],["5.5 g","intense vegetable stock mix"],["2","garlic clove"],["1 tsp","dried basil"],["150 g","wholewheat tortiglioni"],["1","courgette"],["125 g","mozzarella"],["16 g","tomato paste"],["10 g","basil"],["125 g","cherry tomatoes"],["15 ml","balsamic vinegar"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"sourceIngredients":[["40 g","cheddar cheese"],["30 g","grated Italian hard cheese"],["200 g","finely chopped tomatoes"],["5.5 g","intense vegetable stock mix"],["2","garlic clove"],["1 tsp","dried basil"],["150 g","wholewheat tortiglioni"],["1","courgette"],["125 g","mozzarella"],["16 g","tomato paste"],["10 g","basil"],["125 g","cherry tomatoes"],["15 ml","balsamic vinegar"]],"ingredientMeta":[{"name":"cheddar cheese","amount":"40 g","shoppingName":"cheddar cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"grated Italian hard cheese","amount":"30 g","shoppingName":"grated Italian hard cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"finely chopped tomatoes","amount":"200 g","shoppingName":"finely chopped tomatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense vegetable stock mix","amount":"5.5 g","shoppingName":"intense vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"dried basil","amount":"1 tsp","shoppingName":"dried basil","marketChecked":true,"priceMatchType":"source-identity"},{"name":"wholewheat tortiglioni","amount":"150 g","shoppingName":"wholewheat tortiglioni","marketChecked":true,"priceMatchType":"source-identity"},{"name":"courgette","amount":"1","shoppingName":"courgette","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mozzarella","amount":"125 g","shoppingName":"mozzarella","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"16 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"basil","amount":"10 g","shoppingName":"basil","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cherry tomatoes","amount":"125 g","shoppingName":"cherry tomatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"balsamic vinegar","amount":"15 ml","shoppingName":"balsamic vinegar","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 240ºC/ 220ºC (fan)/ gas 9 Boil a kettle Peel and finely chop (or grate) your garlic","Add your wholewheat tortiglioni to a pot of boiled water with a pinch of salt , bring to the boil over a high heat and cook for 10-12 min or until cooked with a slight bite Once cooked, drain the wholewheat tortiglioni Reboil half a kettle","While the pasta is cooking, top, tail and chop your courgette[s] into quarters lengthways, then slice finely Heat a large, wide-based pan (preferably non-stick) with a drizzle of olive oil over a medium-high heat Once hot, add the sliced courgette and cook for 4 min or until beginning to soften","Meanwhile, dissolve your vegetable stock mix, dried basil , balsamic vinegar , tomato paste and 1 tsp sugar in 100ml boiled water – this is your stock Cut your cherry tomatoes in half","Once the courgette is beginning to soften, add the chopped garlic to the pan and cook for 30 secs Add the stock with the halved cherry tomatoes and chopped tomatoes and bring to the boil over a high heat Season with a pinch of salt and a generous grind of black pepper and cook for 3-4 min further - this is your veg-packed sauce","Grate your cheddar cheese Drain and tear your mozzarella into rough bite-sized pieces Chop your basil finely, including the stalks","Add the drained wholewheat tortiglioni to the veg-packed sauce with the chopped basil (save some for garnish!) and mix it up - this is your veg-packed pasta Add half the veg-packed pasta to an oven-proof dish , then top with the grated cheddar Top with the remaining veg-packed pasta , torn mozzarella and grated Italian hard cheese and put the tray in the oven for 5-10 min or until all the cheese has melted – this is your 3 cheese veg-packed pasta bake","Serve the 3 cheese veg-packed pasta bake topped with the reserved chopped basil and a grind of black pepper and enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1590577465245-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/wholewheat-tortiglioni-1731574755396-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1590577473925-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1590577479535-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1590577483808-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1590577487646-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1590577492416-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/3-cheese-veg-packed-wholewheat-pasta-bake","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/3-cheese-veg-packed-wholewheat-pasta-bake","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["40 g","cheddar cheese"],["30 g","grated Italian hard cheese"],["200 g","finely chopped tomatoes"],["5.5 g","intense vegetable stock mix"],["2","garlic clove"],["1 tsp","dried basil"],["150 g","wholewheat tortiglioni"],["1","courgette"],["125 g","mozzarella"],["16 g","tomato paste"],["10 g","basil"],["125 g","cherry tomatoes"],["15 ml","balsamic vinegar"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"lunchBucket":"pasta","isLunch":true,"prepStyle":"quick","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-2fd09ea2-aa1f-4717-b2ef-72334960bc73","sourceId":"2fd09ea2-aa1f-4717-b2ef-72334960bc73","title":"Smoky Cod, Sweet Potato & Pepper Traybake With Mojo Rojo Sauce","subtitle":"This easy traybake is an absolute smoke show.","time":40,"cost":26.76,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","spanish","other","cook"],"requiredEquipment":["food-processor"],"sourceEquipment":["Oven","Baking tray"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/6236---Smoky-Basa-Potato--Pepper-Traybake-With-Mojo-Rojo-Sauce2163-1697473343866-1729166365263-1756197926142-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/smoky-hake-sweet-potato-pepper-traybake-with-mojo-rojo-sauce","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","red pepper"],["1","yellow pepper"],["1","cod fillets"],["1 tsp","ground cumin"],["1 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["1","garlic clove"],["5.5 g","vegetable stock mix"],["80 g","fine green beans"],["15 ml","red wine vinegar"],["1","red onion"],["2","sweet potato"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"sourceIngredients":[["1","red pepper"],["1","yellow pepper"],["1","cod fillets"],["1 tsp","ground cumin"],["1 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["1","garlic clove"],["5.5 g","vegetable stock mix"],["80 g","fine green beans"],["15 ml","red wine vinegar"],["1","red onion"],["2","sweet potato"]],"ingredientMeta":[{"name":"red pepper","amount":"1","shoppingName":"red pepper","marketChecked":true,"priceMatchType":"source-identity"},{"name":"yellow pepper","amount":"1","shoppingName":"yellow pepper","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cod fillets","amount":"1","shoppingName":"cod fillets","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground cumin","amount":"1 tsp","shoppingName":"ground cumin","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground smoked paprika","amount":"1 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mayonnaise","amount":"25 ml","shoppingName":"mayonnaise","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"vegetable stock mix","amount":"5.5 g","shoppingName":"vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"fine green beans","amount":"80 g","shoppingName":"fine green beans","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red wine vinegar","amount":"15 ml","shoppingName":"red wine vinegar","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sweet potato","amount":"2","shoppingName":"sweet potato","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7, then chop your potato[es] (skins on) into large, bite-sized pieces Deseed your peppers (scrape the seeds and pith out with a teaspoon) and roughly chop Peel and chop your red onion[s] into wedges Crush your garlic open by squashing it with the side of a knife and discard the skin","Add the chopped potato and chopped yellow pepper to a baking tray (or two!) with the onion wedges , half your ground smoked paprika (save the rest for later!), a pinch of salt and a drizzle of olive oil Give everything a good mix up and put the tray[s] in the oven for an initial 20 min – these are your roasted veggies","While the vegetables are roasting, add the chopped red pepper to a separate, tin foil -lined baking tray, then scrunch the sides up to create a parcel (or two!) Add the peeled garlic , ground cumin , a drizzle of olive oil and a pinch of salt and pepper to the parcel[s] and give everything a good mix up Put the tray in the oven for 20 min or until the pepper is softened and golden – this is your roasted pepper mix","Meanwhile, trim your green beans , then cut them in half","Pat your fish fillet[s] dry with kitchen paper, then evenly sprinkle the remaining ground smoked paprika all over the fish – this is your smoky fish","After an initial 20 min, remove the tray[s] with the roasted veggies from the oven and add the chopped green beans and smoky fish with a drizzle of olive oil and a pinch of salt and pepper Return the tray[s] to the oven for a further 12-15 min or until the fish is cooked through – this is your smoky fish, potato & pepper traybake Tip: Your fish is cooked once it turns opaque and flakes easily","Transfer all the roasted pepper mix to a food processor with your red wine vinegar , 2 tsp sugar and your vegetable stock mix and blitz until smooth – this is your mojo rojo sauce","Serve the smoky fish, potato & pepper traybake Drizzle over the mojo rojo sauce and mayo Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1707139873041-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1707139878961-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1707139886928-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1707139892694-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1707139897970-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1707139903725-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1707139909569-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/smoky-hake-sweet-potato-pepper-traybake-with-mojo-rojo-sauce","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/smoky-hake-sweet-potato-pepper-traybake-with-mojo-rojo-sauce","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","red pepper"],["1","yellow pepper"],["1","cod fillets"],["1 tsp","ground cumin"],["1 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["1","garlic clove"],["5.5 g","vegetable stock mix"],["80 g","fine green beans"],["15 ml","red wine vinegar"],["1","red onion"],["2","sweet potato"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"lunchBucket":"other","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-d56e29a3-d9b8-4a62-bca2-15dc8aad48be","sourceId":"d56e29a3-d9b8-4a62-bca2-15dc8aad48be","title":"Green Tikka Masala Cod Curry With Almonds And Cauliflower Rice","subtitle":"This carb smart recipe replaces half the white rice for cauliflower rice.","time":25,"cost":28.52,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","indian","rice","quick"],"requiredEquipment":["food-processor"],"sourceEquipment":["Saucepan","Kettle","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/5404---Green-Tikka-Masala-Basa-Curry-With-Almonds--Rice0946-1678786194206-1737130661573-1756307102591-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/green-tikka-masala-cod-curry-with-almonds-and-cauliflower-rice","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["2","tomato"],["1","green chilli"],["65 g","white basmati rice"],["25 g","solid creamed coconut"],["160 g","cauliflower rice"],["1","cod fillets"],["5.5 g","intense vegetable stock mix"],["1 tbsp","curry powder"],["1","garlic clove"],["10 g","coriander"],["1","shallot"],["80 g","spinach"],["15 g","flaked almonds"],["as needed","Sugar"],["as needed","Salt"],["as needed","Butter"],["as needed","Olive oil"],["as needed","Water"]],"sourceIngredients":[["2","tomato"],["1","green chilli"],["65 g","white basmati rice"],["25 g","solid creamed coconut"],["160 g","cauliflower rice"],["1","cod fillets"],["5.5 g","intense vegetable stock mix"],["1 tbsp","curry powder"],["1","garlic clove"],["10 g","coriander"],["1","shallot"],["80 g","spinach"],["15 g","flaked almonds"]],"ingredientMeta":[{"name":"tomato","amount":"2","shoppingName":"tomato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"green chilli","amount":"1","shoppingName":"green chilli","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white basmati rice","amount":"65 g","shoppingName":"white basmati rice","marketChecked":true,"priceMatchType":"source-identity"},{"name":"solid creamed coconut","amount":"25 g","shoppingName":"solid creamed coconut","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cauliflower rice","amount":"160 g","shoppingName":"cauliflower rice","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cod fillets","amount":"1","shoppingName":"cod fillets","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense vegetable stock mix","amount":"5.5 g","shoppingName":"intense vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"curry powder","amount":"1 tbsp","shoppingName":"curry powder","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"coriander","amount":"10 g","shoppingName":"coriander","marketChecked":true,"priceMatchType":"source-identity"},{"name":"shallot","amount":"1","shoppingName":"shallot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"spinach","amount":"80 g","shoppingName":"spinach","marketChecked":true,"priceMatchType":"source-identity"},{"name":"flaked almonds","amount":"15 g","shoppingName":"flaked almonds","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Add your basmati rice and cauliflower rice to a pot with a lid with 160ml cold water and bring to the boil over a high heat Once boiling, reduce the heat to very low and cook, covered, for 10-12 min or until all the water has absorbed and the rice is cooked Once done, remove from the heat and set aside (lid on) to steam until serving","Heat a large, dry pan over a medium heat Once hot, add your flaked almonds and cook for 2-3 min or until toasted and lightly golden Tip: Watch them like a hawk to make sure they don’t burn! Once golden, transfer your toasted almonds to a plate and reserve the pan","Peel and quarter your shallot[s] Crush your garlic open by squashing with the side of a knife and discard the skin Chop your tomato[es] into wedges Cut your green chilli[es] in half lengthways and deseed (scrape the seeds out with a teaspoon)","Chop your creamed coconut roughly (if required!), then wash your spinach and pat it dry with kitchen paper Add your curry powder and chopped shallot to a food processor with the peeled garlic , tomato wedges , creamed coconut and the chopped chilli (can't handle the heat? Go easy!) Add most of your coriander (save some leaves for garnish!) with a small handful of spinach (you'll use the rest later!), 1 tsp sugar and a drizzle of olive oil and blitz until smooth – this is your green tikka sauce","Boil half a kettle Return the reserved pan to a medium-high heat with a drizzle of olive oil and a little knob of butter Once melted, add the green tikka sauce with a generous pinch of salt and cook for 2-3 min or until very fragrant","Once fragrant, add 150ml boiled water with your vegetable stock mix Chop your fish fillet[s] in half Add the chopped fish to the pan and bring to the boil over a high heat","Once boiling, reduce the heat to medium and cook for 6-7 min further or until the fish is cooked through and the sauce has thickened Tip: Your fish is cooked once it turns opaque and flakes easily Once the fish is cooked through, add the remaining spinach and a pinch of salt to the pan and give everything a good mix up – this is your green tikka masala fish curry","Serve the green tikka masala fish curry with the cauliflower rice to the side Tip: For fancy presentation, press the rice into a small bowl and turn out Top with the toasted almonds and reserved coriander leaves Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1678800913079-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1678800917328-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1678800921636-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1678800926298-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1678800931145-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1678800942392-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1678800947720-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/green-tikka-masala-cod-curry-with-almonds-and-cauliflower-rice","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/green-tikka-masala-cod-curry-with-almonds-and-cauliflower-rice","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["2","tomato"],["1","green chilli"],["65 g","white basmati rice"],["25 g","solid creamed coconut"],["160 g","cauliflower rice"],["1","cod fillets"],["5.5 g","intense vegetable stock mix"],["1 tbsp","curry powder"],["1","garlic clove"],["10 g","coriander"],["1","shallot"],["80 g","spinach"],["15 g","flaked almonds"],["as needed","Sugar"],["as needed","Salt"],["as needed","Butter"],["as needed","Olive oil"],["as needed","Water"]],"lunchBucket":"rice","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-d8fa7814-e562-4802-ac8c-f1c89747472f","sourceId":"d8fa7814-e562-4802-ac8c-f1c89747472f","title":"One Pot Cheesy Pollock, Sweet Potato & Leek Chowder","subtitle":"Enjoy a creamy, comforting chowder with sweet leeks, tender pollock and melty cheddar cheese.","time":25,"cost":26.37,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","british","soup","quick"],"requiredEquipment":[],"sourceEquipment":["Saucepan","Kettle","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/1454_One-Pot-Cheesy-Haddock--Leek-Chowder_004_0-1710347447576-1756205233664-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/one-pot-cheesy-pollock-leek-chowder","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["200 g","diced pollock"],["1","leek"],["5.5 g","intense vegetable stock mix"],["40 g","cheddar cheese"],["1","shallot"],["50 g","soft cheese"],["5 g","chives"],["2","sweet potato"],["as needed","Butter"],["as needed","Flour"],["as needed","Milk"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"sourceIngredients":[["200 g","diced pollock"],["1","leek"],["5.5 g","intense vegetable stock mix"],["40 g","cheddar cheese"],["1","shallot"],["50 g","soft cheese"],["5 g","chives"],["2","sweet potato"]],"ingredientMeta":[{"name":"diced pollock","amount":"200 g","shoppingName":"diced pollock","marketChecked":true,"priceMatchType":"source-identity"},{"name":"leek","amount":"1","shoppingName":"leek","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense vegetable stock mix","amount":"5.5 g","shoppingName":"intense vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cheddar cheese","amount":"40 g","shoppingName":"cheddar cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"shallot","amount":"1","shoppingName":"shallot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"soft cheese","amount":"50 g","shoppingName":"soft cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chives","amount":"5 g","shoppingName":"chives","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sweet potato","amount":"2","shoppingName":"sweet potato","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Boil a kettle Peel and chop your shallot[s] and chop your leek[s] in half lengthways, wash thoroughly then top, tail and slice finely","Heat a large, wide-based pot with a large knob of butter over a medium heat Once melted, add the chopped shallot and sliced leek with a pinch of salt and cook for 5-6 min or until softened","Meanwhile, chop your potato[es] (skins on) into small, bite-sized pieces","Dissolve your vegetable stock mix in 550ml boiled water and 100ml milk – this is your creamy vegetable stock","Once the leek has softened, add 1 tsp flour and cook for 30 secs or until fragrant Add the creamy vegetable stock and chopped potatoes and cook for 15-18 min or until the potatoes are almost fork-tender","Once the potatoes are almost fork-tender, add your diced pollock and soft cheese to the pot and cook, covered for 4-5 min or until the pollock is cooked through and the potatoes are fork-tender Tip: Unevenly sized pollock bites? Chop any larger ones into bite-sized pieces! Season to taste with a pinch of salt and pepper Tip: Your fish is cooked when it turns opaque and flakes easily","While the pollock and potatoes are cooking, chop your chives finely Grate your cheddar cheese Once everything is done, add the grated cheese to the pot and gently stir everything together – this is your one pot cheesy pollock & leek chowder","Serve the one pot cheesy pollock, sweet potato & leek chowder Garnish with the chopped chives and season with a good grind of pepper Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1454.-step-1-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1454.-step-2-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1454.-step-3-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1454.-step-4-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1454.-step-5-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1454.-step-6-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1454.-step-7-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/one-pot-cheesy-pollock-leek-chowder","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/one-pot-cheesy-pollock-leek-chowder","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["200 g","diced pollock"],["1","leek"],["5.5 g","intense vegetable stock mix"],["40 g","cheddar cheese"],["1","shallot"],["50 g","soft cheese"],["5 g","chives"],["2","sweet potato"],["as needed","Butter"],["as needed","Flour"],["as needed","Milk"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"lunchBucket":"soup","isLunch":true,"prepStyle":"quick","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-271a44dc-6697-467b-b0a6-0dfa9e5aaea5","sourceId":"271a44dc-6697-467b-b0a6-0dfa9e5aaea5","title":"Green Tikka Masala Chicken Breast With Tomato & Mint Salad","subtitle":"Tuck into this twist on the classic tikka masala.","time":20,"cost":25.99,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","indian","salad","quick"],"requiredEquipment":["food-processor"],"sourceEquipment":["Frying pan","Saucepan","Kettle","Mixing bowl","Colander"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/7273---Green-Tikka-Masala-Chicken-Thigh-With-Tomato--Mint-Salad-1789132586397-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/green-tikka-masala-chicken-breast-with-rice-tomato-mint-salad","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["2","tomato"],["5.5 g","intense chicken stock mix"],["130 g","white long grain rice"],["1","green chilli"],["20 g","mango chutney"],["25 g","solid creamed coconut"],["250 g","diced chicken breast"],["32 g","tomato paste"],["1 tsp","garam masala"],["0.5 tbsp","curry powder"],["2","garlic clove"],["80 g","natural yoghurt"],["80 g","spinach"],["10 g","coriander & mint"],["as needed","Water"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"sourceIngredients":[["2","tomato"],["5.5 g","intense chicken stock mix"],["130 g","white long grain rice"],["1","green chilli"],["20 g","mango chutney"],["25 g","solid creamed coconut"],["250 g","diced chicken breast"],["32 g","tomato paste"],["1 tsp","garam masala"],["0.5 tbsp","curry powder"],["2","garlic clove"],["80 g","natural yoghurt"],["80 g","spinach"],["10 g","coriander & mint"]],"ingredientMeta":[{"name":"tomato","amount":"2","shoppingName":"tomato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense chicken stock mix","amount":"5.5 g","shoppingName":"intense chicken stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white long grain rice","amount":"130 g","shoppingName":"white long grain rice","marketChecked":true,"priceMatchType":"source-identity"},{"name":"green chilli","amount":"1","shoppingName":"green chilli","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mango chutney","amount":"20 g","shoppingName":"mango chutney","marketChecked":true,"priceMatchType":"source-identity"},{"name":"solid creamed coconut","amount":"25 g","shoppingName":"solid creamed coconut","marketChecked":true,"priceMatchType":"source-identity"},{"name":"diced chicken breast","amount":"250 g","shoppingName":"diced chicken breast","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"32 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garam masala","amount":"1 tsp","shoppingName":"garam masala","marketChecked":true,"priceMatchType":"source-identity"},{"name":"curry powder","amount":"0.5 tbsp","shoppingName":"curry powder","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"natural yoghurt","amount":"80 g","shoppingName":"natural yoghurt","marketChecked":true,"priceMatchType":"source-identity"},{"name":"spinach","amount":"80 g","shoppingName":"spinach","marketChecked":true,"priceMatchType":"source-identity"},{"name":"coriander & mint","amount":"10 g","shoppingName":"coriander & mint","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you start cooking, take your chicken out of the fridge, open the packet and let it air Add your white long grain rice to a pot with a lid with 225ml cold water and bring to the boil over a high heat, once boiling, reduce the heat to very low and cook, covered, for 12-15 min or until all the water has absorbed and the rice is cooked Once done, remove from the heat and set aside (lid on) to steam until serving","Heat a large, wide-based pan (preferably non-stick) over a high heat with a drizzle of olive oil Once hot, add your diced chicken and cook for 3-4 min or until starting to brown","While the chicken is cooking, boil a kettle Crush your garlic open by squashing it with the side of a knife and discard the skin Slice half your green chilli[es] finely into rounds and set aside for a garnish Strip your mint leaves from their stems","Wash your spinach , then add to a colander and pour boiled water all over it so that it starts to wilt Rinse the wilted spinach under cold running water until it's cool Once cool, squeeze as much water out of the spinach as you can","Reboil half a kettle Transfer the blanched spinach to a food processor with the peeled garlic , your coriander , half the mint leaves (you'll use the rest later!) and the remaining chilli (can't handle the heat? Go easy?) Add your curry powder , garam masala and creamed coconut with a generous drizzle of olive oil and a generous pinch of salt and pepper Blitz until smooth – this is your green tikka paste","Once the chicken is starting to brown, reduce the heat to medium-high Add the green tikka paste with your tomato paste and cook for 1-2 min or until fragrant Once fragrant, add 150ml boiled water with your chicken stock mix and cook for 6-8 min or until the sauce has thickened and the chicken is cooked through (no pink meat!) – this is your green tikka masala chicken","While the sauce thickens, chop your tomato[es] finely Combine the chopped tomato and a drizzle of olive oil in a bowl and season with salt and pepper Tear the remaining mint leaves into the bowl and give everything a good mix up – this is your tomato & mint salad","Serve the green tikka masala chicken with the cooked rice and tomato & mint salad to the side Drizzle over your natural yoghurt and mango chutney Garnish with the sliced chilli (not a fan of spice? Just add a little!) Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1732545455756-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1732545458848-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1732545463624-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1732545466740-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1732545471085-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1732545474372-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1732545477104-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/green-tikka-masala-chicken-breast-with-rice-tomato-mint-salad","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/green-tikka-masala-chicken-breast-with-rice-tomato-mint-salad","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["2","tomato"],["5.5 g","intense chicken stock mix"],["130 g","white long grain rice"],["1","green chilli"],["20 g","mango chutney"],["25 g","solid creamed coconut"],["250 g","diced chicken breast"],["32 g","tomato paste"],["1 tsp","garam masala"],["0.5 tbsp","curry powder"],["2","garlic clove"],["80 g","natural yoghurt"],["80 g","spinach"],["10 g","coriander & mint"],["as needed","Water"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"lunchBucket":"salad","isLunch":true,"prepStyle":"quick","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-20b75c69-4fd1-4c77-bf43-4b9ba5df4757","sourceId":"20b75c69-4fd1-4c77-bf43-4b9ba5df4757","title":"Green Tikka Masala Chicken Thigh W. Cauli Rice And Tomato Salad","subtitle":"This carb smart recipe replaces half the white rice for cauliflower rice.","time":20,"cost":27.9,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","indian","salad","quick"],"requiredEquipment":["food-processor"],"sourceEquipment":["Frying pan","Saucepan","Kettle","Mixing bowl","Colander"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/7273---Green-Tikka-Masala-Chicken-With-Rice-And-Tomato--Mint-Salad3356-1765548472384-2-1786445014124-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/green-tikka-masala-chicken-with-cauliflower-rice-and-tomato-salad","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["2","tomato"],["5.5 g","intense chicken stock mix"],["1","green chilli"],["20 g","mango chutney"],["25 g","solid creamed coconut"],["160 g","cauliflower rice"],["250 g","diced chicken thigh"],["32 g","tomato paste"],["65 g","white long grain rice"],["1 tsp","garam masala"],["0.5 tbsp","curry powder"],["2","garlic clove"],["80 g","natural yoghurt"],["80 g","spinach"],["10 g","coriander & mint"],["as needed","Water"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"sourceIngredients":[["2","tomato"],["5.5 g","intense chicken stock mix"],["1","green chilli"],["20 g","mango chutney"],["25 g","solid creamed coconut"],["160 g","cauliflower rice"],["250 g","diced chicken thigh"],["32 g","tomato paste"],["65 g","white long grain rice"],["1 tsp","garam masala"],["0.5 tbsp","curry powder"],["2","garlic clove"],["80 g","natural yoghurt"],["80 g","spinach"],["10 g","coriander & mint"]],"ingredientMeta":[{"name":"tomato","amount":"2","shoppingName":"tomato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense chicken stock mix","amount":"5.5 g","shoppingName":"intense chicken stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"green chilli","amount":"1","shoppingName":"green chilli","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mango chutney","amount":"20 g","shoppingName":"mango chutney","marketChecked":true,"priceMatchType":"source-identity"},{"name":"solid creamed coconut","amount":"25 g","shoppingName":"solid creamed coconut","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cauliflower rice","amount":"160 g","shoppingName":"cauliflower rice","marketChecked":true,"priceMatchType":"source-identity"},{"name":"diced chicken thigh","amount":"250 g","shoppingName":"diced chicken thigh","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"32 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white long grain rice","amount":"65 g","shoppingName":"white long grain rice","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garam masala","amount":"1 tsp","shoppingName":"garam masala","marketChecked":true,"priceMatchType":"source-identity"},{"name":"curry powder","amount":"0.5 tbsp","shoppingName":"curry powder","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"natural yoghurt","amount":"80 g","shoppingName":"natural yoghurt","marketChecked":true,"priceMatchType":"source-identity"},{"name":"spinach","amount":"80 g","shoppingName":"spinach","marketChecked":true,"priceMatchType":"source-identity"},{"name":"coriander & mint","amount":"10 g","shoppingName":"coriander & mint","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you start cooking, take your chicken out of the fridge, open the packet and let it air Add your white long grain rice and cauliflower rice to a pot with a lid with 110ml cold water and bring to the boil over a high heat, once boiling, reduce the heat to very low and cook, covered, for 12-15 min or until all the water has absorbed and the rice is cooked, once done, remove from the heat and set aside (lid on) to steam until serving","Heat a large, wide-based pan (preferably non-stick) over a high heat with a drizzle of olive oil Once hot, add your diced chicken and cook for 3-4 min or until starting to brown","While the chicken is cooking, boil a kettle Crush your garlic open by squashing it with the side of a knife and discard the skin Slice half your green chilli[es] finely into rounds and set aside for a garnish Strip your mint leaves from their stems","Wash your spinach then add to a colander and pour boiled water all over it so that it starts to wilt Rinse the wilted spinach under cold running water until it's cool Once cool, squeeze as much water out of the spinach as you can","Reboil half a kettle Transfer the blanched spinach to a food processor with the peeled garlic , coriander , half the mint leaves (you'll use the rest later!) and remaining chilli (can't handle the heat? Go easy?) Add your curry powder , garam masala and creamed coconut with a generous drizzle of olive oil and a generous pinch of salt and pepper Blitz until smooth – this is your green tikka paste","Once the chicken is starting to brown, reduce the heat to medium-high Add the green tikka paste with your tomato paste and cook for 1-2 min or until fragrant Once fragrant, add 150ml boiled water with your chicken stock mix and cook for 6-8 min or until the sauce has thickened and the chicken is cooked through (no pink meat!) – this is your green tikka masala chicken","While the sauce thickens, chop your tomato[es] finely Combine the chopped tomato and a drizzle of olive oil in a bowl and season with salt and pepper Tear the remaining mint leaves into the bowl and give everything a good mix up – this is your tomato & mint salad","Serve the green tikka masala chicken with the cooked cauliflower rice and tomato & mint salad to the side Drizzle over your natural yoghurt and mango chutney Garnish with the sliced chilli (not a fan of spice? Just add a little!) Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1732545455756-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1732545458848-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1732545463624-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1732545466740-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1732545471085-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1732545474372-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1732545477104-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/green-tikka-masala-chicken-with-cauliflower-rice-and-tomato-salad","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/green-tikka-masala-chicken-with-cauliflower-rice-and-tomato-salad","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["2","tomato"],["5.5 g","intense chicken stock mix"],["1","green chilli"],["20 g","mango chutney"],["25 g","solid creamed coconut"],["160 g","cauliflower rice"],["250 g","diced chicken thigh"],["32 g","tomato paste"],["65 g","white long grain rice"],["1 tsp","garam masala"],["0.5 tbsp","curry powder"],["2","garlic clove"],["80 g","natural yoghurt"],["80 g","spinach"],["10 g","coriander & mint"],["as needed","Water"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"lunchBucket":"salad","isLunch":true,"prepStyle":"quick","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-e795e5e0-2a4e-4c77-a4f6-e310a35f7594","sourceId":"e795e5e0-2a4e-4c77-a4f6-e310a35f7594","title":"Tangy Stilton, Prosciutto & Tenderstem With Date Couscous","subtitle":"Toaster, microwave or kettle-friendly - this is dinner without the cooking.","time":10,"cost":19.22,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","british","grain","quick"],"requiredEquipment":[],"sourceEquipment":["Kettle","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/15479_Tangy-Stilton-Prosciutto--Tenderstem-With-Date-Couscous_001_0-1780064860353-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/tangy-stilton-prosciutto-tenderstem-with-date-couscous","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["50 g","blue stilton® cheese"],["50 ml","mayonnaise"],["52 g","sliced prosciutto"],["80 g","Tenderstem broccoli"],["120 g","couscous"],["5.5 g","chicken stock mix"],["30 g","chopped dates"],["1","gem lettuce"],["15 ml","white wine vinegar"],["5.5 g","Dijon mustard"],["as needed","Sugar"],["as needed","Olive oil"],["as needed","Salt"],["as needed","Pepper"],["as needed","Water"]],"sourceIngredients":[["50 g","blue stilton® cheese"],["50 ml","mayonnaise"],["52 g","sliced prosciutto"],["80 g","Tenderstem broccoli"],["120 g","couscous"],["5.5 g","chicken stock mix"],["30 g","chopped dates"],["1","gem lettuce"],["15 ml","white wine vinegar"],["5.5 g","Dijon mustard"]],"ingredientMeta":[{"name":"blue stilton® cheese","amount":"50 g","shoppingName":"blue stilton® cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mayonnaise","amount":"50 ml","shoppingName":"mayonnaise","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sliced prosciutto","amount":"52 g","shoppingName":"sliced prosciutto","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Tenderstem broccoli","amount":"80 g","shoppingName":"Tenderstem broccoli","marketChecked":true,"priceMatchType":"source-identity"},{"name":"couscous","amount":"120 g","shoppingName":"couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chicken stock mix","amount":"5.5 g","shoppingName":"chicken stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chopped dates","amount":"30 g","shoppingName":"chopped dates","marketChecked":true,"priceMatchType":"source-identity"},{"name":"gem lettuce","amount":"1","shoppingName":"gem lettuce","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white wine vinegar","amount":"15 ml","shoppingName":"white wine vinegar","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Dijon mustard","amount":"5.5 g","shoppingName":"Dijon mustard","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Spend less time cooking and make dinner work around you. Before you begin, get all your ingredients and equipment ready Skim through these steps, then wash your fruit and veg You can only heat your food once, then enjoy straight away Note: Microwave ovens vary. Make sure you heat food thoroughly (even if it takes you a little longer than 10 min)","Now, let's get started! Add your sliced prosciutto to a plate and put in the microwave for 4-5 min, then set aside until serving to dry and crisp up (reserve the plate!) – this is your crispy prosciutto Tip: Check your sliced prosciutto every 30 secs to prevent it from burning, as microwave temperatures vary!","While the prosciutto is cooking, boil half a kettle Chop your chopped dates roughly Chop your Tenderstem broccoli into thirds Wash your lettuce , then pat it dry with kitchen paper Tear the lettuce leaves into rough, bite-sized pieces","Add your couscous and the chopped dates to a large heatproof bowl with 200ml boiled water , cover and set aside until all of the liquid has been absorbed – this is your date couscous","Add the chopped Tenderstem to the reserved plate with a small splash of cold water , then cover with cling film and pierce a few holes in the top with a fork Put the plate in the microwave for 1-2 min or until the broccoli is cooked through","Meanwhile, combine your mayo with your Dijon mustard , white wine vinegar and 1 tsp sugar – this is your tangy dressing","Once everything is ready, stir your chicken stock mix through the date couscous with a generous drizzle of olive oil , a generous pinch of pepper and a pinch of salt Add the Tenderstem broccoli and torn lettuce to the bowl with most of the crispy prosciutto (save the rest for garnish!) Give everything a good mix together – this is your prosciutto & Tenderstem with date couscous","Serve the prosciutto & Tenderstem with date couscous , drizzled with the tangy dressing Crumble your Stilton cheese all over and garnish with the remaining crispy prosciutto Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1779368707392-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1779368715358-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1779368795050-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1779368848193-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1779368874705-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1779368900495-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1779368914083-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/tangy-stilton-prosciutto-tenderstem-with-date-couscous","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/tangy-stilton-prosciutto-tenderstem-with-date-couscous","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["50 g","blue stilton® cheese"],["50 ml","mayonnaise"],["52 g","sliced prosciutto"],["80 g","Tenderstem broccoli"],["120 g","couscous"],["5.5 g","chicken stock mix"],["30 g","chopped dates"],["1","gem lettuce"],["15 ml","white wine vinegar"],["5.5 g","Dijon mustard"],["as needed","Sugar"],["as needed","Olive oil"],["as needed","Salt"],["as needed","Pepper"],["as needed","Water"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-c6dc21e2-2baf-4a1c-961d-7d7e8eb9e48b","sourceId":"c6dc21e2-2baf-4a1c-961d-7d7e8eb9e48b","title":"Paprika Cod With Heritage Tomato Giant Couscous & Parsley Butter","subtitle":"Bursting with flavour, you'll roast heritage tomatoes, pan fry paprika-coated cod and serve it on top of a sun-dried tomato couscous with a drizzle of","time":25,"cost":24.84,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","italian","grain","quick"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Frying pan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-8434-2_Sun-dried-Tomato-Giant-Couscous-Paprika-Basa-Parsley-Butter0170-1750153443254-1-1780408608076-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/paprika-cod-with-sun-dried-tomato-giant-couscous-parsley-butter","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["160 g","heritage tomatoes"],["1","cod fillets"],["1 tsp","ground paprika"],["32 g","tomato paste"],["5.5 g","intense vegetable stock mix"],["45 g","sun-dried tomato pesto"],["2","garlic clove"],["5 g","parsley"],["130 g","giant couscous"],["1","red onion"],["as needed","Water"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Butter"],["as needed","Olive oil"]],"sourceIngredients":[["160 g","heritage tomatoes"],["1","cod fillets"],["1 tsp","ground paprika"],["32 g","tomato paste"],["5.5 g","intense vegetable stock mix"],["45 g","sun-dried tomato pesto"],["2","garlic clove"],["5 g","parsley"],["130 g","giant couscous"],["1","red onion"]],"ingredientMeta":[{"name":"heritage tomatoes","amount":"160 g","shoppingName":"heritage tomatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cod fillets","amount":"1","shoppingName":"cod fillets","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground paprika","amount":"1 tsp","shoppingName":"ground paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"32 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense vegetable stock mix","amount":"5.5 g","shoppingName":"intense vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sun-dried tomato pesto","amount":"45 g","shoppingName":"sun-dried tomato pesto","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"parsley","amount":"5 g","shoppingName":"parsley","marketChecked":true,"priceMatchType":"source-identity"},{"name":"giant couscous","amount":"130 g","shoppingName":"giant couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7 and boil a kettle Peel and finely slice your red onion[s] Heat a large, wide-based pan (preferably non-stick with a matching lid) with a drizzle of olive oil over a medium-high heat Once hot, add the sliced onion with a pinch of salt Cook for 5-6 min or until softened","Add your heritage tomatoes to a baking paper -lined baking tray with a drizzle of olive oil Put in the oven for 15 min or until lightly charred, then set aside","Meanwhile, chop your parsley finely, including the stalks Peel and finely chop (or grate) your garlic","Once the onion has softened, add your tomato paste and half the chopped garlic (save the rest for later!) to the pan with 1 tsp sugar Cook for 1 min or until fragrant","Once fragrant, add your giant couscous and vegetable stock mix with400ml boiled water Bring to the boil over a high heat and cook, covered, for 10-12 min or until the giant couscous is tender Tip: Stir the giant couscous occasionally to stop it from sticking Once cooked, stir through your sun-dried tomato pesto – this is your sun-dried tomato giant couscous","Pat your fish fillet[s] dry with kitchen paper Season both sides of the fish with your ground paprika and a pinch of salt and pepper Heat a separate large, wide-based pan (preferably non-stick) with a drizzle of olive oil over a medium-high heat Once hot, add the seasoned fish and cook for 4-5 min on each side or until cooked through Tip: Your fish is cooked once it turns opaque and flakes easily","Add a generous knob of butter to a heatproof bowl with the remaining chopped garlic and put it in the microwave for 30 secs or until melted Once melted, add the chopped parsley and a grind of black pepper – this is your garlic & parsley butter","Serve the paprika fish and roasted heritage tomatoes over the sun-dried tomato giant couscous Drizzle over the garlic & parsley butter Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1780495847313-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1780495851120-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1780495854806-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1780495858510-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1780495862782-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1780495866830-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1780495870950-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/paprika-cod-with-sun-dried-tomato-giant-couscous-parsley-butter","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/paprika-cod-with-sun-dried-tomato-giant-couscous-parsley-butter","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["160 g","heritage tomatoes"],["1","cod fillets"],["1 tsp","ground paprika"],["32 g","tomato paste"],["5.5 g","intense vegetable stock mix"],["45 g","sun-dried tomato pesto"],["2","garlic clove"],["5 g","parsley"],["130 g","giant couscous"],["1","red onion"],["as needed","Water"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Butter"],["as needed","Olive oil"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-bba1b45c-2aef-4025-922f-d56115ab65e5","sourceId":"bba1b45c-2aef-4025-922f-d56115ab65e5","title":"Pepperoni Pizza With Balsamic Salad & Dip","subtitle":"To tuck into this classic, you'll dollop your flame-baked pizza base with garlicky tomato sauce, layer with mozzarella and pepperoni, then bake 'til g","time":25,"cost":16.15,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","italian","salad","quick"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/1772_Pepperoni-Pizza-With-Rocket-Salad_001_0-1718268553711-1761224917071-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/pepperoni-pizza-with-balsamic-salad-dip","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["40 g","garlic & herb dip"],["1","flame-baked pizza bases"],["1 tsp","dried oregano"],["30 g","sliced pepperoni"],["64 g","tomato paste"],["1","garlic clove"],["125 g","mozzarella"],["50 g","rocket"],["250 g","cherry tomatoes"],["15 ml","balsamic vinegar"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"sourceIngredients":[["40 g","garlic & herb dip"],["1","flame-baked pizza bases"],["1 tsp","dried oregano"],["30 g","sliced pepperoni"],["64 g","tomato paste"],["1","garlic clove"],["125 g","mozzarella"],["50 g","rocket"],["250 g","cherry tomatoes"],["15 ml","balsamic vinegar"]],"ingredientMeta":[{"name":"garlic & herb dip","amount":"40 g","shoppingName":"garlic & herb dip","marketChecked":true,"priceMatchType":"source-identity"},{"name":"flame-baked pizza bases","amount":"1","shoppingName":"flame-baked pizza bases","marketChecked":true,"priceMatchType":"source-identity"},{"name":"dried oregano","amount":"1 tsp","shoppingName":"dried oregano","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sliced pepperoni","amount":"30 g","shoppingName":"sliced pepperoni","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"64 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mozzarella","amount":"125 g","shoppingName":"mozzarella","marketChecked":true,"priceMatchType":"source-identity"},{"name":"rocket","amount":"50 g","shoppingName":"rocket","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cherry tomatoes","amount":"250 g","shoppingName":"cherry tomatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"balsamic vinegar","amount":"15 ml","shoppingName":"balsamic vinegar","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 200°C/ 180°C (fan)/ gas 6 Put a large baking tray (or two!) in the oven to heat up (this will stop the pizza bottom from going soggy!) Peel and finely chop (or grate) your garlic","Add your tomato paste to a bowl with the chopped garlic and a generous pinch of salt , pepper and sugar Add 5 tbsp cold water and give everything a good mix up – this is your tomato sauce","Drain your mozzarella , then pat and squeeze as much liquid out as you can with kitchen paper Tear the drained mozzarella into rough, bite-sized pieces","Remove the heated tray[s] from the oven and add your pizza base[s] Spread the tomato sauce evenly over the pizza base[s] with the back of a spoon","Top the pizza[s] with the torn mozzarella and pepperoni Sprinkle over your dried oregano Put the tray in the oven for 13-15 min or until the cheese has melted and the base is crisp – this is your pepperoni pizza","Meanwhile, combine your balsamic vinegar with 2 tbsp olive oil in a small bowl with a pinch of salt and pepper – this is your balsamic dressing","Chop your cherry tomatoes in half Wash your salad , then pat it dry with kitchen paper Combine the salad and chopped tomatoes in a bowl and drizzle the balsamic dressing all over - this is your balsamic salad","Serve the pepperoni pizza with the balsamic salad to the side Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1772.-step-1-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1772.-step-2-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1772.-step-3-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1772.-step-4-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1772.-step-5-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1772.-step-6-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1772.-step-7-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/pepperoni-pizza-with-balsamic-salad-dip","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/pepperoni-pizza-with-balsamic-salad-dip","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["40 g","garlic & herb dip"],["1","flame-baked pizza bases"],["1 tsp","dried oregano"],["30 g","sliced pepperoni"],["64 g","tomato paste"],["1","garlic clove"],["125 g","mozzarella"],["50 g","rocket"],["250 g","cherry tomatoes"],["15 ml","balsamic vinegar"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"lunchBucket":"salad","isLunch":true,"prepStyle":"quick","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-71fa0325-9e80-4948-bd51-b4d60c3d183a","sourceId":"71fa0325-9e80-4948-bd51-b4d60c3d183a","title":"Spiced Salmon With Harissa & Sultana Giant Couscous","subtitle":"Time to give dinner a pop of colour.","time":25,"cost":20.86,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","middle eastern","grain","quick"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Saucepan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/5640_Spiced-Basa-with-Harissa--Apricot-Giant-Couscous_001_0-1678900895006-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/spiced-salmon-with-harissa-sultana-giant-couscous","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["40 g","harissa paste"],["1","skin on salmon fillets"],["2 tbsp","ras el hanout"],["1","garlic clove"],["1","lemon"],["30 g","sultanas"],["130 g","giant couscous"],["80 g","spinach"],["10 g","coriander & mint"],["15 g","flaked almonds"],["1","red onion"],["as needed","Olive oil"],["as needed","Salt"],["as needed","Sugar"]],"sourceIngredients":[["40 g","harissa paste"],["1","skin on salmon fillets"],["2 tbsp","ras el hanout"],["1","garlic clove"],["1","lemon"],["30 g","sultanas"],["130 g","giant couscous"],["80 g","spinach"],["10 g","coriander & mint"],["15 g","flaked almonds"],["1","red onion"]],"ingredientMeta":[{"name":"harissa paste","amount":"40 g","shoppingName":"harissa paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"skin on salmon fillets","amount":"1","shoppingName":"skin on salmon fillets","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ras el hanout","amount":"2 tbsp","shoppingName":"ras el hanout","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lemon","amount":"1","shoppingName":"lemon","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sultanas","amount":"30 g","shoppingName":"sultanas","marketChecked":true,"priceMatchType":"source-identity"},{"name":"giant couscous","amount":"130 g","shoppingName":"giant couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"spinach","amount":"80 g","shoppingName":"spinach","marketChecked":true,"priceMatchType":"source-identity"},{"name":"coriander & mint","amount":"10 g","shoppingName":"coriander & mint","marketChecked":true,"priceMatchType":"source-identity"},{"name":"flaked almonds","amount":"15 g","shoppingName":"flaked almonds","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Boil a kettle and heat a large, dry, wide-based pan (preferably non-stick) over a medium heat Once hot, add your flaked almonds and cook for 2-3 min or until toasted and lightly golden Tip: Watch them like a hawk to make sure they don’t burn! Once golden, set aside and reserve the pan","Peel and finely slice your red onion[s] Wash your spinach Return the reserved pan to a medium heat with a drizzle of olive oil Once hot, add the sliced onion with a pinch of salt and cook for 4-5 min or until softened Once softened, set aside and reserve the pan","While the onion is cooking, add your giant couscous and sultanas to a pot of boiled water with a pinch of salt and bring to the boil over a high heat Cook the giant couscous for 8-10 min or until tender with a slight bite and once done, drain the giant couscous over the spinach and return both to the pot Meanwhile, combine your ras el hanout with a generous pinch of salt on a plate – this is your spice mix","Add your fish fillet[s] to the spice mix and turn several times until it's fully coated in all the spices – this is your coated fish Return the reserved pan to a medium-high heat with a generous drizzle of olive oil , once hot, add the coated fish and cook for 9-10 min, turning once halfway, or until cooked through – this is your spiced fish Tip: Your fish is cooked once it turns opaque and flakes easily (Doubled your protein? Use 2 pans!)","Peel and finely chop (or grate) your garlic Strip your mint leaves from their stems and chop them roughly, discard the stems Chop your coriander finely, including the stalks","Combine the juice of half your lemon[s] in a bowl with your harissa paste (can't handle the heat? Go easy!) and chopped garlic Add 1 tsp sugar , 1 tbsp olive oil and a generous pinch of salt and mix it all together – this is your harissa dressing Cut the remaining lemon into 1 wedge per person","Add the caramelised onion and most of the chopped herbs (save some for garnish!) to the drained couscous and spinach and give everything a good mix up Stir through the harissa dressing – this is your harissa & sultanas giant couscous","Serve the spiced fish over the harissa & sultanas giant couscous Top with the toasted almonds and remaining chopped herbs Garnish with a lemon wedge Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1679396337260-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1679396341680-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1679396345316-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1679396348638-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-29-1734341050869-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1679396355713-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1679396359989-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/spiced-salmon-with-harissa-sultana-giant-couscous","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/spiced-salmon-with-harissa-sultana-giant-couscous","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["40 g","harissa paste"],["1","skin on salmon fillets"],["2 tbsp","ras el hanout"],["1","garlic clove"],["1","lemon"],["30 g","sultanas"],["130 g","giant couscous"],["80 g","spinach"],["10 g","coriander & mint"],["15 g","flaked almonds"],["1","red onion"],["as needed","Olive oil"],["as needed","Salt"],["as needed","Sugar"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-18663ed3-018c-46f8-91dd-19d0e50001cd","sourceId":"18663ed3-018c-46f8-91dd-19d0e50001cd","title":"Chorizo Pizza With Tomato & Salad","subtitle":"This pizza tastes like pepperoni, only better!","time":25,"cost":18.47,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","family classics","pork recipes","indulge","beef & pork","speedy","italian","salad","quick"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/1797_Chorizo-Pizza-With-Tomato--Salad_001_0-1752488076822-x1500.jpg","imageSource":"https://www.gousto.co.uk/pork-recipes/chorizo-pizza-with-tomato-rocket-salad","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","flame-baked pizza bases"],["1 tsp","dried oregano"],["32 g","tomato paste"],["100 g","diced chorizo"],["1","garlic clove"],["125 g","mozzarella"],["50 g","rocket"],["250 g","cherry tomatoes"],["15 ml","balsamic vinegar"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"sourceIngredients":[["1","flame-baked pizza bases"],["1 tsp","dried oregano"],["32 g","tomato paste"],["100 g","diced chorizo"],["1","garlic clove"],["125 g","mozzarella"],["50 g","rocket"],["250 g","cherry tomatoes"],["15 ml","balsamic vinegar"]],"ingredientMeta":[{"name":"flame-baked pizza bases","amount":"1","shoppingName":"flame-baked pizza bases","marketChecked":true,"priceMatchType":"source-identity"},{"name":"dried oregano","amount":"1 tsp","shoppingName":"dried oregano","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"32 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"diced chorizo","amount":"100 g","shoppingName":"diced chorizo","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mozzarella","amount":"125 g","shoppingName":"mozzarella","marketChecked":true,"priceMatchType":"source-identity"},{"name":"rocket","amount":"50 g","shoppingName":"rocket","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cherry tomatoes","amount":"250 g","shoppingName":"cherry tomatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"balsamic vinegar","amount":"15 ml","shoppingName":"balsamic vinegar","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 200°C/ 180°C (fan)/ gas 6 Put a large baking tray (or two!) in the oven to heat up (this will stop the pizza bottoms from going soggy!) Peel and finely chop (or grate) your garlic","Add your tomato paste to a bowl with the chopped garlic and a generous pinch of salt , pepper and sugar Add 5 tbsp [ cold water and give everything a good mix up – this is your tomato sauce","Drain your mozzarella , then pat and squeeze as much liquid out as you can with kitchen paper Tear the drained mozzarella into rough, bite-sized pieces","Chop your cherry tomatoes in half","Remove the heated tray[s] from the oven and add your pizza base[s] Divide the tomato sauce between the pizza base[s] and spread it evenly all over","Top with the torn mozzarella, diced chorizo and half of the halved tomatoes (save the rest for later!) Sprinkle over your dried oregano Put the tray[s] in the oven for 13-15 min or until the chorizo is cooked through – these are your chorizo pizzas","Whilst the pizza is cooking, combine your balsamic vinegar with 2 tbsp olive oil and a pinch of salt and pepper in a small bowl – this is your vinaigrette Wash your salad , then pat it dry with kitchen paper","Serve the chorizo pizza with a handful of salad and the remaining halved tomatoes to the side Drizzle the vinaigrette over the salad and cherry tomatoes Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1797.-step-1-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1797.-step-2-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1797.-step-3-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1655813293570-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1655813323058-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1655813325582-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1797.-step-7-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/pork-recipes/chorizo-pizza-with-tomato-rocket-salad","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/pork-recipes/chorizo-pizza-with-tomato-rocket-salad","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","flame-baked pizza bases"],["1 tsp","dried oregano"],["32 g","tomato paste"],["100 g","diced chorizo"],["1","garlic clove"],["125 g","mozzarella"],["50 g","rocket"],["250 g","cherry tomatoes"],["15 ml","balsamic vinegar"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"lunchBucket":"salad","isLunch":true,"prepStyle":"quick","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-194e5403-bbd0-4fa8-86e0-047d39de5d20","sourceId":"194e5403-bbd0-4fa8-86e0-047d39de5d20","title":"Smoked Mackerel And Pickled Red Cabbage Salad","subtitle":"For this quick, zingy salad, you'll pan-fry creamy butter beans and rich, smoky mackerel with lemon and parsley.","time":10,"cost":19.06,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fish","10-minute meals","healthy choices","british","salad","quick"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/2653---10-Min-Smoked-Mackerel-Red-Cabbage--Apple-Salad_04-1600774383503-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/10-min-smoked-mackerel-red-cabbage-apple-salad","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["390 g","butter beans"],["50 g","baby leaf salad"],["5 g","parsley"],["1","lemon"],["15 ml","gluten free soy sauce"],["1","smoked mackerel fillet"],["15 ml","cider vinegar"],["150 g","shredded red cabbage"],["1","apple"],["as needed","Pepper"],["as needed","Olive oil"],["as needed","Salt"],["as needed","Sugar"]],"sourceIngredients":[["390 g","butter beans"],["50 g","baby leaf salad"],["5 g","parsley"],["1","lemon"],["15 ml","gluten free soy sauce"],["1","smoked mackerel fillet"],["15 ml","cider vinegar"],["150 g","shredded red cabbage"],["1","apple"]],"ingredientMeta":[{"name":"butter beans","amount":"390 g","shoppingName":"butter beans","marketChecked":true,"priceMatchType":"source-identity"},{"name":"baby leaf salad","amount":"50 g","shoppingName":"baby leaf salad","marketChecked":true,"priceMatchType":"source-identity"},{"name":"parsley","amount":"5 g","shoppingName":"parsley","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lemon","amount":"1","shoppingName":"lemon","marketChecked":true,"priceMatchType":"source-identity"},{"name":"gluten free soy sauce","amount":"15 ml","shoppingName":"gluten free soy sauce","marketChecked":true,"priceMatchType":"source-identity"},{"name":"smoked mackerel fillet","amount":"1","shoppingName":"smoked mackerel fillet","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cider vinegar","amount":"15 ml","shoppingName":"cider vinegar","marketChecked":true,"priceMatchType":"source-identity"},{"name":"shredded red cabbage","amount":"150 g","shoppingName":"shredded red cabbage","marketChecked":true,"priceMatchType":"source-identity"},{"name":"apple","amount":"1","shoppingName":"apple","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you begin... Get all your ingredients and equipment ready Skim through these steps, then wash your fruit and veg Note: Equipment and pan sizes vary. Make sure you cook food thoroughly (even if it takes you a little longer than 10 min)","Now, let's get started! Heat a large, dry, wide-based pan (preferably non-stick) over a medium-high heat with a drizzle of olive oil Drain and rinse your butter beans Once hot, add the drained butter beans to the pan with a generous grind of pepper and cook for 1-2 min or until starting to crisp","Meanwhile, combine your shredded red cabbage in a bowl with your cider vinegar , 1 tsp sugar and a pinch of salt , then give everything a good mix up and set aside until later – this is your quick-pickled red cabbage Remove the skin from your smoked mackerel fillet[s] and discard Tear the mackerel into small, bite-sized pieces directly into the pan with the butter beans and cook for 1-2 min further or until warmed through Once done, remove from the heat and set aside","While the mackerel is cooking, cut your lemon[s] into quarters Add the juice of 1/4 of the lemon quarter[s] to a bowl along with your gluten free soy sauce and 2 tbsp olive oil – this is your soy dressing","Chop your parsley roughly, including the stalks Slice your apple[s] (no need to peel!) finely, discard the core[s]","Wash your salad , then pat it dry with kitchen paper Drain the quick-pickled red cabbage , discard the liquid Add the sliced apple to a bowl with the quick-pickled red cabbage and salad Pour in the soy dressing and give everything a good mix up – this is your quick-pickled red cabbage & apple salad","Add the chopped parsley and juice of 1/4 of the lemon quarter[s] to the pan with the mackerel and mix it all together – this is your lemony mackerel & butter beans","Serve the quick-pickled red cabbage & apple salad with the lemony mackerel & butter beans over the top – this is your smoked mackerel and pickled red cabbage salad Garnish with the remaining lemon quarters , season with a grind of black pepper and top with a drizzle of olive oil Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-Admin-1623407438473-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1601298135837-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1601298147253-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Vinaigrette-1614339305590-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1601298169843-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1601298201287-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1601298212214-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/10-min-smoked-mackerel-red-cabbage-apple-salad","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/10-min-smoked-mackerel-red-cabbage-apple-salad","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["390 g","butter beans"],["50 g","baby leaf salad"],["5 g","parsley"],["1","lemon"],["15 ml","gluten free soy sauce"],["1","smoked mackerel fillet"],["15 ml","cider vinegar"],["150 g","shredded red cabbage"],["1","apple"],["as needed","Pepper"],["as needed","Olive oil"],["as needed","Salt"],["as needed","Sugar"]],"lunchBucket":"salad","isLunch":true,"prepStyle":"quick","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-2ee0d6aa-44df-46fd-9a22-ed44d7d7a111","sourceId":"2ee0d6aa-44df-46fd-9a22-ed44d7d7a111","title":"Scandi-Style Mackerel And Potato Salad With Spinach","subtitle":"Tuck into a wholesome bowl filled with Scandi-inspired flavours.","time":20,"cost":19.64,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fish","fish recipes","healthy choices","speedy","gluten free recipes","600 calorie meals","low calorie recipes","classics","swedish","salad","quick"],"requiredEquipment":[],"sourceEquipment":["Saucepan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/1581_Scandi-Style-Mackerel-And-Potato-Salad-With-Spinach_002_0-1665660396674-x1500.jpg","imageSource":"https://www.gousto.co.uk/fish-recipes/scandi-style-mackerel-potato-salad-with-spinach","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["350 g","waxy potatoes"],["2","spring onion"],["1","garlic clove"],["80 g","natural yoghurt"],["1","lemon"],["1","smoked mackerel fillet"],["5 g","dill"],["80 g","spinach"],["15 g","flaked almonds"],["5.5 g","Dijon mustard"],["as needed","Olive oil"],["as needed","Salt"],["as needed","Pepper"]],"sourceIngredients":[["350 g","waxy potatoes"],["2","spring onion"],["1","garlic clove"],["80 g","natural yoghurt"],["1","lemon"],["1","smoked mackerel fillet"],["5 g","dill"],["80 g","spinach"],["15 g","flaked almonds"],["5.5 g","Dijon mustard"]],"ingredientMeta":[{"name":"waxy potatoes","amount":"350 g","shoppingName":"waxy potatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"spring onion","amount":"2","shoppingName":"spring onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"natural yoghurt","amount":"80 g","shoppingName":"natural yoghurt","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lemon","amount":"1","shoppingName":"lemon","marketChecked":true,"priceMatchType":"source-identity"},{"name":"smoked mackerel fillet","amount":"1","shoppingName":"smoked mackerel fillet","marketChecked":true,"priceMatchType":"source-identity"},{"name":"dill","amount":"5 g","shoppingName":"dill","marketChecked":true,"priceMatchType":"source-identity"},{"name":"spinach","amount":"80 g","shoppingName":"spinach","marketChecked":true,"priceMatchType":"source-identity"},{"name":"flaked almonds","amount":"15 g","shoppingName":"flaked almonds","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Dijon mustard","amount":"5.5 g","shoppingName":"Dijon mustard","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Boil a kettle Cut your waxy potatoes in half and add them to a pot of boiled water with a large pinch of salt Bring to the boil over a high heat and cook for 12-15 min or until fork-tender Once cooked, drain and return them to the pot","Meanwhile, wash your spinach , then pat it dry with kitchen paper and transfer it to a large bowl Drizzle over some olive oil and season with a pinch of salt and pepper Give it a good mix up and set aside – this is your dressed spinach","Chop your dill finely including the stalks Trim, then slice your spring onions finely Peel and finely chop (or grate) your garlic","Combine the chopped garlic , your natural yoghurt and Dijon mustard in a small bowl Add the juice of half your lemon[s] , season with salt and pepper and give everything a good mix up – this is your mustard dressing Slice the remaining lemon into 1 wedge per person","Transfer the drained potatoes to a large bowl, then add the mustard dressing and mix it all together – this is your potato salad","Heat a small, dry, pan over a medium heat Once hot, add your flaked almonds and cook for 2-3 min or until lightly browned and toasted Tip: Watch them like a hawk to make sure they don't burn! Once done, remove the pan from the heat and set aside","Meanwhile, remove the skin from your smoked mackerel fillet[s] and discard Tear the mackerel into rough bite-sized pieces","Serve the dressed spinach and top with the potato salad and torn mackerel pieces Garnish with your toasted almonds , sliced spring onions , chopped dill and a lemon wedge Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1581.-step-1-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1581.-step-2-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1581.-step-3-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1581.-step-4-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1581.-step-5-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1581.-step-6-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1581.-step-7-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/fish-recipes/scandi-style-mackerel-potato-salad-with-spinach","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/fish-recipes/scandi-style-mackerel-potato-salad-with-spinach","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["350 g","waxy potatoes"],["2","spring onion"],["1","garlic clove"],["80 g","natural yoghurt"],["1","lemon"],["1","smoked mackerel fillet"],["5 g","dill"],["80 g","spinach"],["15 g","flaked almonds"],["5.5 g","Dijon mustard"],["as needed","Olive oil"],["as needed","Salt"],["as needed","Pepper"]],"lunchBucket":"salad","isLunch":true,"prepStyle":"quick","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-3b04f60d-1290-4cf6-a7e4-9c079d0c8aa5","sourceId":"3b04f60d-1290-4cf6-a7e4-9c079d0c8aa5","title":"Simple Tuna & Olive Pizza With Salad","subtitle":"If you love tuna on your pizza, this one's for you.","time":25,"cost":15.23,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fish","family classics","fish recipes","indulge","classics","italian","salad","quick"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/1934_Simple-Tuna--Plive-PIzza-With-Salad_002_0-1780064382582-x1500.jpg","imageSource":"https://www.gousto.co.uk/fish-recipes/simple-tuna-olive-pizza-with-salad","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1 tsp","dried oregano"],["1","Wildfarmed pizza bases"],["64 g","tomato paste"],["145 g","tuna chunks in spring water"],["40 g","black olives"],["1","garlic clove"],["125 g","mozzarella"],["50 g","rocket"],["15 ml","balsamic vinegar"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"sourceIngredients":[["1 tsp","dried oregano"],["1","Wildfarmed pizza bases"],["64 g","tomato paste"],["145 g","tuna chunks in spring water"],["40 g","black olives"],["1","garlic clove"],["125 g","mozzarella"],["50 g","rocket"],["15 ml","balsamic vinegar"]],"ingredientMeta":[{"name":"dried oregano","amount":"1 tsp","shoppingName":"dried oregano","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Wildfarmed pizza bases","amount":"1","shoppingName":"Wildfarmed pizza bases","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"64 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tuna chunks in spring water","amount":"145 g","shoppingName":"tuna chunks in spring water","marketChecked":true,"priceMatchType":"source-identity"},{"name":"black olives","amount":"40 g","shoppingName":"black olives","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mozzarella","amount":"125 g","shoppingName":"mozzarella","marketChecked":true,"priceMatchType":"source-identity"},{"name":"rocket","amount":"50 g","shoppingName":"rocket","marketChecked":true,"priceMatchType":"source-identity"},{"name":"balsamic vinegar","amount":"15 ml","shoppingName":"balsamic vinegar","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 200°C/ 180°C (fan)/ gas 6 Put alarge baking tray[s] in the oven to heat up (this will stop the pizza bottom from going soggy!) Peel and finely chop (or grate) your garlic","Add your tomato paste to a bowl with the chopped garlic and a generous pinch of salt , pepper and sugar Add 4 tbsp cold water and stir it all together – this is your tomato sauce","Drain your mozzarella , then pat and squeeze as much liquid out as you can with kitchen paper Tear the drained mozzarella into rough, bite-sized pieces Drain your tuna","Slice your black olives in half","Remove the heated tray[s] from the oven and add your pizza base[s] Divide the tomato sauce between the pizza base[s] and spread it evenly all over them Top each pizza with the torn mozzarella , drained tuna , halved olives and dried oregano","Put the tray[s] in the oven for 15 min or until the cheese has melted and the pizza base is crispy – this is your tuna & olive pizza","Whilst the pizza is cooking, combine your balsamic vinegar with 2 tbsp olive oil and a pinch of salt and pepper in a small bowl – this is your dressing Wash your salad , then pat it dry with kitchen paper","Serve the tuna & olive pizza with the salad to the side Drizzle the dressing over the salad and season the pizza with a generous grind of black pepper Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1934.-step-1-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1934.-step-2-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1934.-step-3-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1934.-step-4-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1934.-step-5-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1934.-step-7-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1934.-step-6-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/fish-recipes/simple-tuna-olive-pizza-with-salad","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/fish-recipes/simple-tuna-olive-pizza-with-salad","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1 tsp","dried oregano"],["1","Wildfarmed pizza bases"],["64 g","tomato paste"],["145 g","tuna chunks in spring water"],["40 g","black olives"],["1","garlic clove"],["125 g","mozzarella"],["50 g","rocket"],["15 ml","balsamic vinegar"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"lunchBucket":"salad","isLunch":true,"prepStyle":"quick","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-40192bab-e5ae-41be-8091-c761753255ae","sourceId":"40192bab-e5ae-41be-8091-c761753255ae","title":"Chicken Thigh & Spinach Lasagne With Salad","subtitle":"For this easy twist on classic lasagne, you'll simmer chicken in tomato sauce and layer it with spinach, lasagne sheets and béchamel.","time":50,"cost":32.26,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","chicken","chicken recipes","chicken thigh recipes","italian","salad","cook"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Frying pan","Saucepan","Kettle","Colander","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-1946-2-Chicken--Spinach-Lasagne-With-Rocket-2_0-1698922028238-x1500.jpg","imageSource":"https://www.gousto.co.uk/chicken-recipes/chicken-spinach-lasagne-with-rocket","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["320 g","skinless chicken thighs"],["200 g","finely chopped tomatoes"],["1 tsp","dried oregano"],["5.5 g","intense chicken stock mix"],["40 g","cheddar cheese"],["2","garlic clove"],["120 g","lasagne sheets"],["1 tsp","dried basil"],["1","brown onion"],["16 g","tomato paste"],["15 ml","Henderson's Relish"],["80 g","spinach"],["20 g","rocket"],["as needed","Butter"],["as needed","Flour"],["as needed","Milk"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"sourceIngredients":[["320 g","skinless chicken thighs"],["200 g","finely chopped tomatoes"],["1 tsp","dried oregano"],["5.5 g","intense chicken stock mix"],["40 g","cheddar cheese"],["2","garlic clove"],["120 g","lasagne sheets"],["1 tsp","dried basil"],["1","brown onion"],["16 g","tomato paste"],["15 ml","Henderson's Relish"],["80 g","spinach"],["20 g","rocket"]],"ingredientMeta":[{"name":"skinless chicken thighs","amount":"320 g","shoppingName":"skinless chicken thighs","marketChecked":true,"priceMatchType":"source-identity"},{"name":"finely chopped tomatoes","amount":"200 g","shoppingName":"finely chopped tomatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"dried oregano","amount":"1 tsp","shoppingName":"dried oregano","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense chicken stock mix","amount":"5.5 g","shoppingName":"intense chicken stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cheddar cheese","amount":"40 g","shoppingName":"cheddar cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lasagne sheets","amount":"120 g","shoppingName":"lasagne sheets","marketChecked":true,"priceMatchType":"source-identity"},{"name":"dried basil","amount":"1 tsp","shoppingName":"dried basil","marketChecked":true,"priceMatchType":"source-identity"},{"name":"brown onion","amount":"1","shoppingName":"brown onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"16 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Henderson's Relish","amount":"15 ml","shoppingName":"Henderson's Relish","marketChecked":true,"priceMatchType":"source-identity"},{"name":"spinach","amount":"80 g","shoppingName":"spinach","marketChecked":true,"priceMatchType":"source-identity"},{"name":"rocket","amount":"20 g","shoppingName":"rocket","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Take your chicken out of the fridge, open the packet and let it air Preheat the oven to 220°C/ 200°C (fan)/ gas 7 Add your chicken thighs to a baking tray (or two!) with a small drizzle of olive oil and a pinch of salt and pepper Put the tray[s] in the oven for 17-18 min or until cooked through (no pink meat!)","Meanwhile, boil a full kettle Peel and finely chop your brown onion[s] Heat a large, wide-based pan (preferably non-stick) with a drizzle of olive oil over a medium heat Once hot, add the chopped onion with a pinch of salt and cook for 3-4 min or until beginning to soften","While the onion is softening, peel and finely chop (or grate) your garlic Dissolve your chicken stock mix , Henderson's Relish , dried oregano , dried basil and tomato paste in 200ml boiled water – this is your stock","Once the onion is beginning to soften, add the chopped garlic and cook for 30 secs Add your chopped tomatoes and stock with a pinch of sugar and bring to the boil over a high heat Once boiling, reduce the heat to low and cook for 10-15 min or until thickened slightly – this is your sauce Grate your cheddar cheese","Meanwhile, melt 25g butter in a pot over a medium heat Once melted, add 30g flour and stir with a wooden spoon for 1 min or until a sandy paste forms – this is your roux Add 350ml milk gradually & whisk for 5-8 min or until a smooth, thick sauce remains Remove from the heat and season generously with pepper – this is your béchamel","Wash your spinach , then add to a colander and pour the remaining boiled water all over it until bright green and wilted Run the wilted spinach under the cold tap and pat dry with kitchen paper Once cooked, transfer the chicken to a clean board and shred it apart, using two forks - this technique is known as ‘pulling’ Add the pulled chicken to the sauce – this is your chicken mixture","Add half the chicken mixture to an oven-proof dish , then top with some of your lasagne sheets Repeat this process again, then add a layer of the wilted spinach followed by the remaining lasagne sheets Tip: You may need to layer differently depending on the size of your dish! Cover with the béchamel and grated cheese and cook in the oven for 20-25 min or until the pasta is cooked","Once done, remove the lasagne from the oven and leave to stand for 5 min (this helps the flavours to develop and makes it easier to serve!) Wash your salad , then pat dry with kitchen paper Serve the chicken & spinach lasagne with a handful of salad to the side Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1946.-step-1-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1946.-step-2-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1946.-step-3-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1946.-step-4-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1946.-step-5-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1946.-step-6-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1946.-step-7-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/chicken-recipes/chicken-spinach-lasagne-with-rocket","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/chicken-recipes/chicken-spinach-lasagne-with-rocket","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["320 g","skinless chicken thighs"],["200 g","finely chopped tomatoes"],["1 tsp","dried oregano"],["5.5 g","intense chicken stock mix"],["40 g","cheddar cheese"],["2","garlic clove"],["120 g","lasagne sheets"],["1 tsp","dried basil"],["1","brown onion"],["16 g","tomato paste"],["15 ml","Henderson's Relish"],["80 g","spinach"],["20 g","rocket"],["as needed","Butter"],["as needed","Flour"],["as needed","Milk"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"lunchBucket":"salad","isLunch":true,"prepStyle":"cook","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-82b2ea84-0b60-4a62-8425-6101130f16cf","sourceId":"82b2ea84-0b60-4a62-8425-6101130f16cf","title":"Spanish-Style Sausage Salad With Crispy Paprika Potatoes","subtitle":"Sizzle up a Spanish-inspired salad with roasted pepper, sweet red onion and succulent sausages.","time":40,"cost":13.28,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","pork recipes","beef & pork","dairy free recipes","spanish","salad","cook"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Saucepan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/1720_Spanish-Sausage-Salad-With-Crispy-Paprika-Potatoes-4597-1629199631425-x1500.jpg","imageSource":"https://www.gousto.co.uk/pork-recipes/spanish-sausage-salad-with-crispy-potatoes","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["2 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["1","garlic clove"],["1","Proper Porker sausages"],["1","sweet pointed pepper"],["50 g","rocket"],["15 ml","white wine vinegar"],["1","red onion"],["3","white potato"],["as needed","Olive oil"],["as needed","Salt"]],"sourceIngredients":[["2 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["1","garlic clove"],["1","Proper Porker sausages"],["1","sweet pointed pepper"],["50 g","rocket"],["15 ml","white wine vinegar"],["1","red onion"],["3","white potato"]],"ingredientMeta":[{"name":"ground smoked paprika","amount":"2 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mayonnaise","amount":"25 ml","shoppingName":"mayonnaise","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Proper Porker sausages","amount":"1","shoppingName":"Proper Porker sausages","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sweet pointed pepper","amount":"1","shoppingName":"sweet pointed pepper","marketChecked":true,"priceMatchType":"source-identity"},{"name":"rocket","amount":"50 g","shoppingName":"rocket","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white wine vinegar","amount":"15 ml","shoppingName":"white wine vinegar","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white potato","amount":"3","shoppingName":"white potato","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7 Boil a kettle Chop your potatoes into small bite-sized pieces (skins on)","Add the chopped potatoes to a pot of boiled water and cook over a high heat for 10 min or until just fork-tender Once cooked, drain and return them to the pot","While the potatoes are cooking, deseed your sweet pointed pepper[s] (scrape the seeds and pith out with a teaspoon) and cut into thick strips Peel and cut your red onion[s] into wedges, leaving the skins and roots on (this helps them cook quicker)","Add the pepper strips , onion wedges and your sausages to a baking tray (or two!) Drizzle with olive oil and a pinch of salt Put the tray[s] in the oven and cook for 25-30 min or until the sausages are cooked through (no pink meat!)","Meanwhile, add the drained potatoes to another baking tray and crush them gently with a fork Add your ground smoked paprika , a drizzle of olive oil and a pinch of salt and give them a good mix up Put the tray in the oven and cook for 20-25 min or until crisp – these are your crispy paprika potatoes","While the potatoes are cooking, peel and finely chop (or grate) your garlic Combine your mayo with the chopped garlic (don't like raw garlic? Go easy!) and your white wine vinegar in a bowl Add 1 tbsp olive oil and a pinch of salt – this is your aioli","Once done, slice the cooked sausages diagonally into pieces Carefully cut off the roots and remove the skins from the roasted onion wedges Wash your salad , then pat it dry with kitchen paper","Serve the sliced sausages , charred pepper strips and roasted onion wedges over the salad Sprinkle over the crispy paprika potatoes – this is your Spanish-style sausage salad with crispy paprika potatoes Drizzle the aioli all over Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1720.-step-1.n-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1720.-step-2-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/1720.-step-3-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1656427397908-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1656427419608-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1656427423670-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1656427382908-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/pork-recipes/spanish-sausage-salad-with-crispy-potatoes","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/pork-recipes/spanish-sausage-salad-with-crispy-potatoes","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["2 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["1","garlic clove"],["1","Proper Porker sausages"],["1","sweet pointed pepper"],["50 g","rocket"],["15 ml","white wine vinegar"],["1","red onion"],["3","white potato"],["as needed","Olive oil"],["as needed","Salt"]],"lunchBucket":"salad","isLunch":true,"prepStyle":"cook","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-8a62fd51-a879-469f-80d7-ddb1dab9677a","sourceId":"8a62fd51-a879-469f-80d7-ddb1dab9677a","title":"Mozzarella-Topped Tomato Risotto With Basil Oil","subtitle":"Rich, creamy and vibrant, this tomato risotto is a stunning weeknight hero.","time":35,"cost":17.15,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","vegetarian recipes ","rice recipes","risotto recipes","italian recipes","vegetarian","gluten free recipes","italian","rice","cook"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/340_Mozzarella-Topped-Tomato-Risotto-with-Basil-Oil_002_0-1664183699511-x1500.jpg","imageSource":"https://www.gousto.co.uk/vegetarian-recipes/mozzarella-topped-tomato-risotto-with-basil-oil","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["390 g","finely chopped tomatoes"],["5.5 g","intense vegetable stock mix"],["3","garlic clove"],["160 g","arborio rice"],["125 g","mozzarella"],["10 g","basil"],["15 ml","red wine vinegar"],["1","red onion"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"sourceIngredients":[["390 g","finely chopped tomatoes"],["5.5 g","intense vegetable stock mix"],["3","garlic clove"],["160 g","arborio rice"],["125 g","mozzarella"],["10 g","basil"],["15 ml","red wine vinegar"],["1","red onion"]],"ingredientMeta":[{"name":"finely chopped tomatoes","amount":"390 g","shoppingName":"finely chopped tomatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense vegetable stock mix","amount":"5.5 g","shoppingName":"intense vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"3","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"arborio rice","amount":"160 g","shoppingName":"arborio rice","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mozzarella","amount":"125 g","shoppingName":"mozzarella","marketChecked":true,"priceMatchType":"source-identity"},{"name":"basil","amount":"10 g","shoppingName":"basil","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red wine vinegar","amount":"15 ml","shoppingName":"red wine vinegar","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Boil a kettle Dissolve your vegetable stock mix in 750ml boiled water","Peel and finely dice your red onion[s] Peel and finely chop (or grate) your garlic","Heat a large, wide-based pan (preferably non-stick) with 1 tbsp olive oil over a medium heat Once hot, add the diced onion with a pinch of salt and cook for 3 min until soft but not coloured","Add your arborio rice and chopped garlic to the softened onion Mix well to make sure the rice is evenly coated in the onion and oil Add your chopped tomatoes and stir continuously until the rice has absorbed most of the tomato juice","Add the vegetable stock a ladle at a time, stirring continuously for 25-30 min or until all the stock is absorbed and the rice is cooked Meanwhile, chop your basil finely, including the stalks","Grind the chopped basil with a pinch of salt in a pestle & mortar to form a paste Add 3-4 tbsp olive oil or enough to loosen and mix well – this is your basil oil Tip: If you don't have a pestle & mortar, chop the basil leaves very finely and mix with salt and olive oil","Once the risotto is nearly cooked, stir in your red wine vinegar and 1/2 tsp sugar and cook for a further 2 min – this is your tomato risotto Season the tomato risotto with salt and pepper Drain your mozzarella , then pat and squeeze as much liquid out as you can with kitchen paper","Serve the tomato risotto in a bowl Tear the mozzarella in half and nestle into the tomato risotto so that it melts nicely Drizzle the basil oil over the top Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/340.-step-1-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/340.-step-2-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/340.-step-3-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/340.-step-4-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/340.-step-5-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/340.-step-6-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1-1581009749873-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/vegetarian-recipes/mozzarella-topped-tomato-risotto-with-basil-oil","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/vegetarian-recipes/mozzarella-topped-tomato-risotto-with-basil-oil","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["390 g","finely chopped tomatoes"],["5.5 g","intense vegetable stock mix"],["3","garlic clove"],["160 g","arborio rice"],["125 g","mozzarella"],["10 g","basil"],["15 ml","red wine vinegar"],["1","red onion"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"lunchBucket":"rice","isLunch":true,"prepStyle":"cook","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-b1a6f1ef-8f7a-41b9-b980-885b4044229e","sourceId":"b1a6f1ef-8f7a-41b9-b980-885b4044229e","title":"Chilli Roasted Squash With Thai-Style Pesto Salad","subtitle":"This Thai-style pesto is full of vibrant flavours, and boosted with heart-healthy peanuts, herbs and antioxidant-rich ginger.","time":35,"cost":17.73,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","healthy choices","vegetarian","thai","salad","cook"],"requiredEquipment":["food-processor"],"sourceEquipment":["Oven","Baking tray","Saucepan","Kettle","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-2982-2-Chilli-Roasted-Squash-With-Thai-Style-Pesto-Salad-retouch-1_0-1725877258715-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/chilli-roasted-squash-thai-style-pesto-salad","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["0.5 tsp","dried chilli flakes"],["10 g","Thai basil"],["20 ml","toasted sesame oil"],["390 g","chickpeas"],["1","shallot"],["15 g","ginger paste"],["15 ml","rice vinegar"],["15 ml","soy sauce"],["320 g","butternut squash cubes"],["1","lime"],["10 g","coriander & mint"],["50 g","rocket"],["50 g","roasted peanuts"],["130 g","bulgur wheat"],["as needed","Salt"],["as needed","Olive oil"],["as needed","Water"]],"sourceIngredients":[["0.5 tsp","dried chilli flakes"],["10 g","Thai basil"],["20 ml","toasted sesame oil"],["390 g","chickpeas"],["1","shallot"],["15 g","ginger paste"],["15 ml","rice vinegar"],["15 ml","soy sauce"],["320 g","butternut squash cubes"],["1","lime"],["10 g","coriander & mint"],["50 g","rocket"],["50 g","roasted peanuts"],["130 g","bulgur wheat"]],"ingredientMeta":[{"name":"dried chilli flakes","amount":"0.5 tsp","shoppingName":"dried chilli flakes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Thai basil","amount":"10 g","shoppingName":"Thai basil","marketChecked":true,"priceMatchType":"source-identity"},{"name":"toasted sesame oil","amount":"20 ml","shoppingName":"toasted sesame oil","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chickpeas","amount":"390 g","shoppingName":"chickpeas","marketChecked":true,"priceMatchType":"source-identity"},{"name":"shallot","amount":"1","shoppingName":"shallot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ginger paste","amount":"15 g","shoppingName":"ginger paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"rice vinegar","amount":"15 ml","shoppingName":"rice vinegar","marketChecked":true,"priceMatchType":"source-identity"},{"name":"soy sauce","amount":"15 ml","shoppingName":"soy sauce","marketChecked":true,"priceMatchType":"source-identity"},{"name":"butternut squash cubes","amount":"320 g","shoppingName":"butternut squash cubes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lime","amount":"1","shoppingName":"lime","marketChecked":true,"priceMatchType":"source-identity"},{"name":"coriander & mint","amount":"10 g","shoppingName":"coriander & mint","marketChecked":true,"priceMatchType":"source-identity"},{"name":"rocket","amount":"50 g","shoppingName":"rocket","marketChecked":true,"priceMatchType":"source-identity"},{"name":"roasted peanuts","amount":"50 g","shoppingName":"roasted peanuts","marketChecked":true,"priceMatchType":"source-identity"},{"name":"bulgur wheat","amount":"130 g","shoppingName":"bulgur wheat","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 200°C/ 180°C (fan)/ gas 6 Boil a kettle Drain and rinse your chickpeas","Add your butternut squash cubes and drained chickpeas to a baking tray (or two!) Drizzle with olive oil and season with a pinch of salt Put the tray[s] in the oven and cook for an initial 15-20 min or until the squash is starting to soften","Add your bulgur wheat to a pot with plenty of boiled water and a pinch of salt (the same as you would for pasta) Bring to the boil over a high heat and cook for 7-9 min or until tender with a slight bite Once cooked, drain and return to the pot","Meanwhile, chop your Thai basil roughly, including the stalks Strip your mint leaves from their stems, then chop them finely and discard the stems Chop your coriander finely, including the stems","Add half your roasted peanuts to a pestle & mortar with your ginger paste , chopped Thai basil and half the chopped mint and chopped coriander (you’ll use the rest later!) Add a generous pinch of salt and grind to a thick paste Add your toasted sesame oil , rice vinegar and 1 tbsp water and mix it all together – this is your Thai-style pesto Tip: Alternatively, use a food processor!","Combine your chilli flakes (can't handle the heat? Go easy!) with the juice of your lime[s] and your soy sauce in a bowl – this is your chilli & lime marinade Once the squash has had 15-20 min, remove the tray[s] from the oven and drizzle the chilli & lime marinade all over Return the tray[s] to the oven for 10-15 min further or until the squash is cooked through and the chickpeas are crisp – this is your chilli roasted squash","While the squash is cooking, peel and finely slice your shallot[s] Wash your salad , then pat it dry with kitchen paper Add the sliced shallot , salad , remaining chopped mint and remaining chopped coriander to the cooked bulgur and give it a good mix up – this is your bulgur salad Roughly chop the remaining roasted peanuts","Serve the chilli roasted squash over the bulgur salad and drizzle the Thai-style pesto all over Garnish with the chopped roasted peanuts Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1713869005574-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1600363884496-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Bulgur-wheat-in-pan-copy-1684769593618-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1600363902857-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1600363908322-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1600363931365-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1600363942073-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/chilli-roasted-squash-thai-style-pesto-salad","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/chilli-roasted-squash-thai-style-pesto-salad","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["0.5 tsp","dried chilli flakes"],["10 g","Thai basil"],["20 ml","toasted sesame oil"],["390 g","chickpeas"],["1","shallot"],["15 g","ginger paste"],["15 ml","rice vinegar"],["15 ml","soy sauce"],["320 g","butternut squash cubes"],["1","lime"],["10 g","coriander & mint"],["50 g","rocket"],["50 g","roasted peanuts"],["130 g","bulgur wheat"],["as needed","Salt"],["as needed","Olive oil"],["as needed","Water"]],"lunchBucket":"salad","isLunch":true,"prepStyle":"cook","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-ca703d3d-2f23-40c7-843e-93d5d204aa6b","sourceId":"ca703d3d-2f23-40c7-843e-93d5d204aa6b","title":"Cheesy Pizza-Topped Chicken With Mixed Salad","subtitle":"Give lean chicken breast some cheesy pizza goodness with rich tomato sauce and melty mozzarella.","time":25,"cost":21.87,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","lean in 15","chicken","healthy choices","italian","salad","quick"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/2733_Cheesy-Pizza-Topped-Chicken-With-Mixed-Salad_003_0-1730718455354-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/cheesy-pizza-topped-chicken-with-mixed-salad","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1 tsp","dried oregano"],["1","chicken breast portions"],["32 g","tomato paste"],["25 ml","mayonnaise"],["50 g","baby leaf salad"],["1","shallot"],["5 g","basil"],["125 g","mozzarella"],["1","cucumber"],["125 g","baby plum tomatoes"],["15 ml","white wine vinegar"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"sourceIngredients":[["1 tsp","dried oregano"],["1","chicken breast portions"],["32 g","tomato paste"],["25 ml","mayonnaise"],["50 g","baby leaf salad"],["1","shallot"],["5 g","basil"],["125 g","mozzarella"],["1","cucumber"],["125 g","baby plum tomatoes"],["15 ml","white wine vinegar"]],"ingredientMeta":[{"name":"dried oregano","amount":"1 tsp","shoppingName":"dried oregano","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chicken breast portions","amount":"1","shoppingName":"chicken breast portions","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"32 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mayonnaise","amount":"25 ml","shoppingName":"mayonnaise","marketChecked":true,"priceMatchType":"source-identity"},{"name":"baby leaf salad","amount":"50 g","shoppingName":"baby leaf salad","marketChecked":true,"priceMatchType":"source-identity"},{"name":"shallot","amount":"1","shoppingName":"shallot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"basil","amount":"5 g","shoppingName":"basil","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mozzarella","amount":"125 g","shoppingName":"mozzarella","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cucumber","amount":"1","shoppingName":"cucumber","marketChecked":true,"priceMatchType":"source-identity"},{"name":"baby plum tomatoes","amount":"125 g","shoppingName":"baby plum tomatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white wine vinegar","amount":"15 ml","shoppingName":"white wine vinegar","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7, before you start cooking, take your chicken out of the fridge, open the packet and let it air Add your chicken to a tin foil -lined baking tray (or two!)","Combine your tomato paste and a pinch of your dried oregano (you'll use the rest later!) with 1 tbsp cold water and a pinch of salt in a bowl – this is your pizza sauce","Drain your mozzarella , then pat it dry with kitchen paper (squeeze as much liquid out as you can!) Tear the drained mozzarella into rough, bite-sized pieces Tear your basil leaves roughly","Spread the pizza sauce over the chicken Top with the torn mozzarella and torn basil leaves","Put the tray[s] in the oven for 18-20 min or until the chicken is cooked through (no pink meat!) and the mozzarella is melted and golden – this is your cheesy pizza-topped chicken Wash your salad , then pat it dry with kitchen paper","While the chicken is cooking, chop your baby plum tomatoes in half Slice your cucumber finely Peel and slice your shallot[s] as finely as you can Add the halved baby plum tomatoes , sliced cucumber and sliced shallot to a large bowl with the salad and give it a gentle mix up – this is your mixed salad","Combine your mayo with your white wine vinegar and remaining dried oregano with 1 tbsp olive oil and a pinch of salt and pepper in a separate bowl – this is your creamy dressing","Serve the cheesy pizza-topped chicken with the mixed salad to the side Drizzle the creamy dressing all over the salad Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1586949555860-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1586949560835-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1586949565802-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1586949572010-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1586949576768-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1586949581364-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1586949587679-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/cheesy-pizza-topped-chicken-with-mixed-salad","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/cheesy-pizza-topped-chicken-with-mixed-salad","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1 tsp","dried oregano"],["1","chicken breast portions"],["32 g","tomato paste"],["25 ml","mayonnaise"],["50 g","baby leaf salad"],["1","shallot"],["5 g","basil"],["125 g","mozzarella"],["1","cucumber"],["125 g","baby plum tomatoes"],["15 ml","white wine vinegar"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"lunchBucket":"salad","isLunch":true,"prepStyle":"quick","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-f5aa6d83-98c9-4076-a662-d53f64a113bf","sourceId":"f5aa6d83-98c9-4076-a662-d53f64a113bf","title":"Lemony Courgette & King Prawn Risotto","subtitle":"For a simple, sophisticated risotto, you'll combine creamy arborio rice with cheddar and a squeeze of lemon juice.","time":35,"cost":25.82,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fish","rice recipes","prawn recipes","fish recipes","risotto recipes","italian recipes","italian","rice","cook"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Kettle","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/8425_Lemony-Courgette--Jumbo-King-Prawn-Risotto_001_0-1752488406768-1767699822679-x1500.jpg","imageSource":"https://www.gousto.co.uk/fish-recipes/lemony-courgette-king-prawn-risotto","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","lemon"],["171 g","raw peeled king prawns"],["40 g","cheddar cheese"],["5.5 g","intense vegetable stock mix"],["2","garlic clove"],["5 g","parsley"],["1","courgette"],["1","brown onion"],["160 g","arborio rice"],["as needed","Butter"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"sourceIngredients":[["1","lemon"],["171 g","raw peeled king prawns"],["40 g","cheddar cheese"],["5.5 g","intense vegetable stock mix"],["2","garlic clove"],["5 g","parsley"],["1","courgette"],["1","brown onion"],["160 g","arborio rice"]],"ingredientMeta":[{"name":"lemon","amount":"1","shoppingName":"lemon","marketChecked":true,"priceMatchType":"source-identity"},{"name":"raw peeled king prawns","amount":"171 g","shoppingName":"raw peeled king prawns","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cheddar cheese","amount":"40 g","shoppingName":"cheddar cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense vegetable stock mix","amount":"5.5 g","shoppingName":"intense vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"parsley","amount":"5 g","shoppingName":"parsley","marketChecked":true,"priceMatchType":"source-identity"},{"name":"courgette","amount":"1","shoppingName":"courgette","marketChecked":true,"priceMatchType":"source-identity"},{"name":"brown onion","amount":"1","shoppingName":"brown onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"arborio rice","amount":"160 g","shoppingName":"arborio rice","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Boil a kettle Peel and finely dice your brown onion[s] Heat a large, wide-based pan (preferably non-stick) with a drizzle of olive oil over a medium heat Once hot, add the diced onion with a pinch of salt and cook for 4 min or until softened but not coloured","Meanwhile, dissolve your vegetable stock mix in700ml boiled water Peel and finely chop (or grate) your garlic","Add your arborio rice and half the chopped garlic (you'll use the rest later!) to the pan and cook for 1 min, stirring to coat the grains in the oil Tip: Add a drizzle more oil if your pan is looking a little dry Add your vegetable stock , a ladle at a time, stirring continuously for 25-30 min or until all the stock is absorbed and the rice is cooked","While the risotto is cooking, grate your cheddar cheese Chop your parsley finely, including the stalks Top, tail and chop your courgette[s] into bite-sized pieces","Zest half your lemon[s] (try to grate lightly with a micro-plane or sharp box grater and avoid grating the white pith, as this is very bitter!) and set aside for garnish","Once the rice is cooked, squeeze in the juice of half your lemon[s] Cut the remaining lemon into wedges Add a knob of butter and the grated cheese to the pan and stir to combine – this is your lemony risotto","Heat a separate, large, wide-based pan (preferably non-stick) with a knob of butter over a medium-high heat Once melted, drain your king prawns , then add to the pan with the remaining garlic , chopped courgette and a pinch of salt and cook for 4-5 min or until the prawns are cooked through – these are your garlic king prawns & courgette Once cooked, remove from the heat and stir through most of the chopped parsley (save some for garnish!)","Serve the garlic king prawns & courgette over the lemony risotto Garnish with a lemon wedge , lemon zest and the reserved chopped parsley Season with a generous grind of black pepper Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/931.-step-1-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/931.-step-2-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/931.-step-3-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/931.-step-4-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/931.-step-5-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/931.-step-6-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/931.-step-7-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/fish-recipes/lemony-courgette-king-prawn-risotto","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/fish-recipes/lemony-courgette-king-prawn-risotto","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","lemon"],["171 g","raw peeled king prawns"],["40 g","cheddar cheese"],["5.5 g","intense vegetable stock mix"],["2","garlic clove"],["5 g","parsley"],["1","courgette"],["1","brown onion"],["160 g","arborio rice"],["as needed","Butter"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"lunchBucket":"rice","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-b652a34a-8477-47be-a77c-2fee0ebdefdb","sourceId":"b652a34a-8477-47be-a77c-2fee0ebdefdb","title":"Roasted Sweet Potato Laksa With Spicy Cashew Sambal","subtitle":"Top this punchy laksa with roasted sweet potato and crispy broccoli.","time":45,"cost":18.54,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fusion","soup","cook"],"requiredEquipment":["food-processor"],"sourceEquipment":["Oven","Baking tray","Saucepan","Kettle","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/3332_Roasted-Sweet-Potato-Laksa-With-Spicy-Cashew-Sambal-V_001_0-1701853696052-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/roasted-squash-laksa-with-spicy-cashew-sambal","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","red chilli"],["8 ml","sriracha hot chilli sauce"],["150 g","rice noodles"],["2","garlic clove"],["15 g","fresh root ginger"],["10 g","coriander"],["2","shallot"],["30 ml","gluten free soy sauce"],["40 g","red Thai curry paste"],["15 ml","rice vinegar"],["160 g","Tenderstem broccoli"],["25 g","cashew nuts"],["1","sweet potato"],["25 g","solid creamed coconut"],["as needed","Olive oil"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"sourceIngredients":[["1","red chilli"],["8 ml","sriracha hot chilli sauce"],["150 g","rice noodles"],["2","garlic clove"],["15 g","fresh root ginger"],["10 g","coriander"],["2","shallot"],["30 ml","gluten free soy sauce"],["40 g","red Thai curry paste"],["15 ml","rice vinegar"],["160 g","Tenderstem broccoli"],["25 g","cashew nuts"],["1","sweet potato"],["25 g","solid creamed coconut"]],"ingredientMeta":[{"name":"red chilli","amount":"1","shoppingName":"red chilli","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sriracha hot chilli sauce","amount":"8 ml","shoppingName":"sriracha hot chilli sauce","marketChecked":true,"priceMatchType":"source-identity"},{"name":"rice noodles","amount":"150 g","shoppingName":"rice noodles","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"fresh root ginger","amount":"15 g","shoppingName":"fresh root ginger","marketChecked":true,"priceMatchType":"source-identity"},{"name":"coriander","amount":"10 g","shoppingName":"coriander","marketChecked":true,"priceMatchType":"source-identity"},{"name":"shallot","amount":"2","shoppingName":"shallot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"gluten free soy sauce","amount":"30 ml","shoppingName":"gluten free soy sauce","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red Thai curry paste","amount":"40 g","shoppingName":"red Thai curry paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"rice vinegar","amount":"15 ml","shoppingName":"rice vinegar","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Tenderstem broccoli","amount":"160 g","shoppingName":"Tenderstem broccoli","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cashew nuts","amount":"25 g","shoppingName":"cashew nuts","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sweet potato","amount":"1","shoppingName":"sweet potato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"solid creamed coconut","amount":"25 g","shoppingName":"solid creamed coconut","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7 Chop your Tenderstem broccoli in half","Dice your sweet potato[es] (skins on) into cubes Add the sweet potato cubes and halved Tenderstem broccoli to a large baking tray (or two!) with a drizzle of olive oil and half your gluten free soy sauce (you'll use the rest later!) Give it a good mix up and put the tray[s] in the oven for 15-20 min or until the sweet potato has softened Boil a kettle","Meanwhile, peel (scrape the skin off with a teaspoon) and roughly chop the ginger Peel and roughly chop your garlic Trim, then chop your red chilli[es] roughly Roughly chop your cashews","Add the chopped ginger , garlic and chilli (can't handle the heat? Go easy!) to a food processor with 1 tbsp olive oil and 1 tbsp cold water Tear in most your coriander (save some leaves for garnish!) and blitz – this is your laksa paste Remove half the laksa paste (save the rest for later!) and add it to a bowl with the chopped cashew nuts , rice vinegar and 1 tsp sugar and give it a good mix up – this is your spicy cashew sambal","Add your rice noodles to a bowl and cover with boiled water , then set aside for 10 min or until softened with a slight bite Once softened, drain the noodles and set aside then peel and finely slice your shallot[s] Heat a large, wide-based deep pan or pot (preferably non-stick) with a generous drizzle of olive oil over a medium heat Once hot, add the sliced shallot with a pinch of salt and cook for 4-5 min or until starting to caramelise","Reboil a kettle Chop your creamed coconut roughly (if required!) Dissolve the chopped creamed coconut in 800ml boiled water Add the remaining gluten free soy sauce – this is your coconut stock","Once the shallot has started to caramelise, add the laksa paste , sriracha (not a fan of spice? Just add a little!) and red Thai curry paste and cook for 1 min until fragrant Once fragrant, add the coconut stock and rice noodles and bring to the boil over a high heat Once boiling, reduce the heat to medium and cook for 2-5 min or until the noodles are tender – this is your laksa","Serve the laksa in a bowl and top with the roasted sweet potato and roasted Tenderstem broccoli Tear over the remaining coriander leaves and dollop over the spicy cashew sambal Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-10-1701872728499-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-11-1701872735320-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1632225839975-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1632225861911-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1632225868621-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1632225898710-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1632225937898-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/roasted-squash-laksa-with-spicy-cashew-sambal","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/roasted-squash-laksa-with-spicy-cashew-sambal","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","red chilli"],["8 ml","sriracha hot chilli sauce"],["150 g","rice noodles"],["2","garlic clove"],["15 g","fresh root ginger"],["10 g","coriander"],["2","shallot"],["30 ml","gluten free soy sauce"],["40 g","red Thai curry paste"],["15 ml","rice vinegar"],["160 g","Tenderstem broccoli"],["25 g","cashew nuts"],["1","sweet potato"],["25 g","solid creamed coconut"],["as needed","Olive oil"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"lunchBucket":"soup","isLunch":true,"prepStyle":"cook","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-8be5b758-ea88-4e9f-9c06-b1bd22bcbe10","sourceId":"8be5b758-ea88-4e9f-9c06-b1bd22bcbe10","title":"Harissa Smoked Mackerel & Pepper Hash","subtitle":"Smoky, spicy hash in a flash.","time":40,"cost":27.6,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fusion","other","cook"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Frying pan","Saucepan","Kettle","Colander","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/4986---Harissa-Smoked-Mackerel--Red-Pepper-Hash0835-1662380892873-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/harissa-smoked-mackerel-pepper-hash","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["2","free range egg"],["1","red pepper"],["1 tsp","ground cumin"],["2 tsp","ground smoked paprika"],["2","garlic clove"],["80 g","natural yoghurt"],["1","smoked mackerel fillet"],["40 g","harissa paste"],["80 g","spinach"],["1","red onion"],["4","white potato"],["as needed","Butter"],["as needed","Olive oil"],["as needed","Salt"]],"sourceIngredients":[["2","free range egg"],["1","red pepper"],["1 tsp","ground cumin"],["2 tsp","ground smoked paprika"],["2","garlic clove"],["80 g","natural yoghurt"],["1","smoked mackerel fillet"],["40 g","harissa paste"],["80 g","spinach"],["1","red onion"],["4","white potato"]],"ingredientMeta":[{"name":"free range egg","amount":"2","shoppingName":"free range egg","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red pepper","amount":"1","shoppingName":"red pepper","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground cumin","amount":"1 tsp","shoppingName":"ground cumin","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground smoked paprika","amount":"2 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"natural yoghurt","amount":"80 g","shoppingName":"natural yoghurt","marketChecked":true,"priceMatchType":"source-identity"},{"name":"smoked mackerel fillet","amount":"1","shoppingName":"smoked mackerel fillet","marketChecked":true,"priceMatchType":"source-identity"},{"name":"harissa paste","amount":"40 g","shoppingName":"harissa paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"spinach","amount":"80 g","shoppingName":"spinach","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white potato","amount":"4","shoppingName":"white potato","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7 and boil a kettle Cut your potato[es] (skins on) into small bite-sized pieces Add the chopped potatoes to a pot with plenty of boiled water and bring to the boil over a high heat Once boiling, reduce the heat to medium and cook for 8-10 min or until fork-tender, then drain and return to the pot to steam dry","Meanwhile, deseed your pepper[s] (scrape the seeds and pith out with a teaspoon) and cut into thin strips Peel and finely slice your red onion[s] Add the sliced pepper , sliced onion , a drizzle of olive oil and a pinch of salt to a baking tray (or two!) and put it in the oven for 10-15 min until softened and starting to brown","Peel and finely chop (or grate) your garlic Remove the skin from your smoked mackerel fillet[s] and tear into bite-sized pieces","Heat a large, wide-based pan (preferably non-stick with a matching lid) with a generous drizzle of olive oil and a knob of butter over a medium-high heat Once the butter has melted, add the cooked potatoes to the pan Cook the potatoes for 7-8 min or until they're starting to brown and crisp, crushing them lightly with a fork Boil half a kettle","While the potatoes are cooking, wash your spinach then add to a colander and pour boiled water all over it so that it starts to wilt Rinse the wilted spinach under cold running water until it’s cool Once cool, squeeze as much water out of the spinach as you can","Once the potatoes are golden, add the chopped garlic , ground cumin and ground smoked paprika Give everything a good mix up and cook for 1 min or until fragrant Once fragrant, add the wilted spinach , roasted pepper & onion , mackerel pieces , a generous drizzle of olive oil and a pinch of salt and mix it all together – this is your smoked mackerel & pepper hash","Make 1 well per person in the smoked mackerel & pepper hash and crack your egg[s] into them, then cook, covered for 5-6 min or until the egg[s] is cooked to your liking Tip: Give your egg[s] a little shake before you crack them for a perfectly centred yolk[s]!","Serve the smoked mackerel & pepper hash with your natural yoghurt and harissa paste dolloped over the top (can't handle the heat? Go easy!) Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1663691977161-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1663691982689-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1663691987699-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1663691992523-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1663691997589-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1663692001739-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1663692006774-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/harissa-smoked-mackerel-pepper-hash","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/harissa-smoked-mackerel-pepper-hash","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["2","free range egg"],["1","red pepper"],["1 tsp","ground cumin"],["2 tsp","ground smoked paprika"],["2","garlic clove"],["80 g","natural yoghurt"],["1","smoked mackerel fillet"],["40 g","harissa paste"],["80 g","spinach"],["1","red onion"],["4","white potato"],["as needed","Butter"],["as needed","Olive oil"],["as needed","Salt"]],"lunchBucket":"other","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-2552ea0e-cf7c-40d9-b9c8-8c60aaf0239b","sourceId":"2552ea0e-cf7c-40d9-b9c8-8c60aaf0239b","title":"Smoky Lean Pork Chilli With Herby Rice And Popped Beans","subtitle":"This easy pork and bean chilli is packed with flavour.","time":40,"cost":22.02,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","mexican","rice","cook"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Frying pan","Saucepan","Kettle","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/298--Smoky-Pork-Chilli-With-Popped-Beans6733-1631108937281-1677761064140-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/smoky-lean-pork-chilli-with-herby-rice-and-popped-beans","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["250 g","lean pork mince (<5% fat)"],["2","spring onion"],["5.5 g","intense beef stock mix"],["20 g","chipotle paste"],["40 g","cheddar cheese"],["390 g","black beans"],["0.5 tsp","ground cinnamon"],["130 g","brown long grain rice"],["16 g","tomato paste"],["5 g","coriander"],["1","red onion"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"sourceIngredients":[["250 g","lean pork mince (<5% fat)"],["2","spring onion"],["5.5 g","intense beef stock mix"],["20 g","chipotle paste"],["40 g","cheddar cheese"],["390 g","black beans"],["0.5 tsp","ground cinnamon"],["130 g","brown long grain rice"],["16 g","tomato paste"],["5 g","coriander"],["1","red onion"]],"ingredientMeta":[{"name":"lean pork mince (<5% fat)","amount":"250 g","shoppingName":"lean pork mince (<5% fat)","marketChecked":true,"priceMatchType":"source-identity"},{"name":"spring onion","amount":"2","shoppingName":"spring onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense beef stock mix","amount":"5.5 g","shoppingName":"intense beef stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chipotle paste","amount":"20 g","shoppingName":"chipotle paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cheddar cheese","amount":"40 g","shoppingName":"cheddar cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"black beans","amount":"390 g","shoppingName":"black beans","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground cinnamon","amount":"0.5 tsp","shoppingName":"ground cinnamon","marketChecked":true,"priceMatchType":"source-identity"},{"name":"brown long grain rice","amount":"130 g","shoppingName":"brown long grain rice","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"16 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"coriander","amount":"5 g","shoppingName":"coriander","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 240°C /220°C (fan) / gas 9 and boil a kettle Rinse your brown rice , add it to a pot with plenty of cold water and bring to the boil over a high heat Once boiling, reduce the heat to medium and cook for 20-25 min or until it's tender with a slight bite Once cooked, drain, return it to the pot and keep covered until serving","While the rice is cooking, peel and finely dice your red onion[s] Heat a large, wide-based pan (preferably non-stick) with a drizzle of olive oil over a low heat Once hot, add the diced onion with a pinch of salt and cook for 10 min or until slightly softened","While the onion softens, drain and rinse your black beans , reserving the liquid Add half the drained black beans to a baking tray (you'll use the rest later!) Drizzle them with olive oil and season with a pinch of salt and pepper Put the tray in the oven for 20-25 min or until the skins have burst and are crispy – these are your popped beans","While the black beans are in the oven, dissolve your beef stock mix in 350ml boiled water Add your ground cinnamon to the onion and cook for 1 min","Increase the heat to high, add the your mince (remove the paper if required!) to the pan and cook for 5-6 min or until beginning to brown, breaking it up with a wooden spoon as you go","Add your tomato paste and chipotle paste (can't handle the heat? Go easy!) to the pan Cook for 1 min, then add the beef stock and a large pinch of sugar Cook for 10 min or until slightly thickened in consistency Add the remaining black beans with the reserved black bean liquid and cook for a further 5 min or until the sauce has thickened to a chilli-like consistency and the meat is cooked through (no pink meat!) – this is your smoky chilli","While the chilli is cooking, trim, then slice your spring onion[s] finely Chop your coriander finely, including the stalks Grate your cheddar cheese Once the rice is cooked, mix through the sliced spring onion and chopped coriander and season with a pinch of salt – this is your herby rice","Serve the smoky chilli over the herby rice Garnish with the popped beans and grated cheese Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1677167548164-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1677167551688-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1677167556190-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1677167560503-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1677167564138-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1677167567611-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-copy-1719232516315-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/smoky-lean-pork-chilli-with-herby-rice-and-popped-beans","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/smoky-lean-pork-chilli-with-herby-rice-and-popped-beans","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["250 g","lean pork mince (<5% fat)"],["2","spring onion"],["5.5 g","intense beef stock mix"],["20 g","chipotle paste"],["40 g","cheddar cheese"],["390 g","black beans"],["0.5 tsp","ground cinnamon"],["130 g","brown long grain rice"],["16 g","tomato paste"],["5 g","coriander"],["1","red onion"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"lunchBucket":"rice","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-c77a0fdd-f715-44cc-a155-44a5c3af6e40","sourceId":"c77a0fdd-f715-44cc-a155-44a5c3af6e40","title":"Ras El Hanout Basa & Turmeric Giant Couscous Stew","subtitle":"Step up your stew game with aromatic ras el hanout.","time":10,"cost":24.15,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","north african","grain","quick"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Saucepan","Kettle"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-5260-2-Ras-El-Hanout-Basa-_-Saffron-Giant-Cous-Cous-Stew-1173-1678180229679-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/ras-el-hanout-basa-saffron-giant-cous-cous-stew","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1 tsp","ground sumac"],["0.5 tsp","ground turmeric"],["1","basa fillets"],["200 g","finely chopped tomatoes"],["32 g","tomato paste"],["5.5 g","intense vegetable stock mix"],["1 tbsp","ras el hanout"],["1","courgette"],["80 g","natural yoghurt"],["15 g","roasted garlic paste"],["30 g","sultanas"],["75 g","giant couscous"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"],["as needed","Water"]],"sourceIngredients":[["1 tsp","ground sumac"],["0.5 tsp","ground turmeric"],["1","basa fillets"],["200 g","finely chopped tomatoes"],["32 g","tomato paste"],["5.5 g","intense vegetable stock mix"],["1 tbsp","ras el hanout"],["1","courgette"],["80 g","natural yoghurt"],["15 g","roasted garlic paste"],["30 g","sultanas"],["75 g","giant couscous"]],"ingredientMeta":[{"name":"ground sumac","amount":"1 tsp","shoppingName":"ground sumac","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground turmeric","amount":"0.5 tsp","shoppingName":"ground turmeric","marketChecked":true,"priceMatchType":"source-identity"},{"name":"basa fillets","amount":"1","shoppingName":"basa fillets","marketChecked":true,"priceMatchType":"source-identity"},{"name":"finely chopped tomatoes","amount":"200 g","shoppingName":"finely chopped tomatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"32 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense vegetable stock mix","amount":"5.5 g","shoppingName":"intense vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ras el hanout","amount":"1 tbsp","shoppingName":"ras el hanout","marketChecked":true,"priceMatchType":"source-identity"},{"name":"courgette","amount":"1","shoppingName":"courgette","marketChecked":true,"priceMatchType":"source-identity"},{"name":"natural yoghurt","amount":"80 g","shoppingName":"natural yoghurt","marketChecked":true,"priceMatchType":"source-identity"},{"name":"roasted garlic paste","amount":"15 g","shoppingName":"roasted garlic paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sultanas","amount":"30 g","shoppingName":"sultanas","marketChecked":true,"priceMatchType":"source-identity"},{"name":"giant couscous","amount":"75 g","shoppingName":"giant couscous","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you begin... Get all your ingredients and equipment ready Skim through these steps, then wash your fruit and veg Note: Equipment and pan sizes vary. Make sure you cook food thoroughly (even if it takes you a little longer than 10 min)","Now, let's get started! Boil a kettle and heat a large, wide-based pan (preferably non-stick) with a drizzle of olive oil over a high heat Top, tail and chop your courgette[s] in half lengthways, then slice on the diagonal Once hot, add the sliced courgette and cook for 2 min or until slightly browned","Add your giant couscous and ground turmeric to a pot of boiled water with a pinch of salt and bring to the boil over a high heat Cook the giant couscous for 8 min or until tender with a slight bite, then drain and return to the pot – this is your ground turmeric giant couscous","Reboil half a kettle Once the courgette is slightly browned, add your ras el hanout and roasted garlic paste and cook for 30 secs or until fragrant","Once fragrant, add your tomato paste with your chopped tomatoes and sultanas","Add your vegetable stock mix and 200ml boiled water with a generous pinch of salt and pepper Top with your fish fillet[s] and cook for 5 min, turning once half way or until the fish is cooked through and the sauce has thickened – this is your ras el hanout fish stew Tip: Your fish is cooked once it turns opaque and flakes easily","Once everything is ready, add the fish giant couscous to the stew and gently stir it all together – this is your ras el hanout fish & ground turmeric giant couscous stew","Serve the ras el hanout fish & ground turmeric giant couscous stew and drizzle over your natural yoghurt Garnish with your ground sumac Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Admin10mm-Step-1-4-1716195902517-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1677587218608-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1677587227367-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1677587272986-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1677587282220-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1677587294311-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1677587305990-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/ras-el-hanout-basa-saffron-giant-cous-cous-stew","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/ras-el-hanout-basa-saffron-giant-cous-cous-stew","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1 tsp","ground sumac"],["0.5 tsp","ground turmeric"],["1","basa fillets"],["200 g","finely chopped tomatoes"],["32 g","tomato paste"],["5.5 g","intense vegetable stock mix"],["1 tbsp","ras el hanout"],["1","courgette"],["80 g","natural yoghurt"],["15 g","roasted garlic paste"],["30 g","sultanas"],["75 g","giant couscous"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"],["as needed","Water"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-982aa0bc-eca5-4134-89b1-2edc21054a82","sourceId":"982aa0bc-eca5-4134-89b1-2edc21054a82","title":"Creamy Chicken Breast & Sweetcorn Chowder","subtitle":"Enjoy a creamy, comforting chowder with sweet onion, tender chicken and creamy soft cheese.","time":25,"cost":27.55,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","british","soup","quick"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-5209-2-Creamy-Chicken-Thigh-and-Sweetcorn-Chowder-1309-1678180140679-1679332828100-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/creamy-chicken-breast-sweetcorn-chowder","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["5.5 g","intense chicken stock mix"],["250 g","diced chicken breast"],["1 tsp","ground smoked paprika"],["150 g","Sweetcorn"],["2","garlic clove"],["5 g","thyme"],["1","brown onion"],["50 g","soft cheese"],["15 ml","Chinese rice wine"],["80 g","spinach"],["3","white potato"],["as needed","Butter"],["as needed","Flour"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"sourceIngredients":[["5.5 g","intense chicken stock mix"],["250 g","diced chicken breast"],["1 tsp","ground smoked paprika"],["150 g","Sweetcorn"],["2","garlic clove"],["5 g","thyme"],["1","brown onion"],["50 g","soft cheese"],["15 ml","Chinese rice wine"],["80 g","spinach"],["3","white potato"]],"ingredientMeta":[{"name":"intense chicken stock mix","amount":"5.5 g","shoppingName":"intense chicken stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"diced chicken breast","amount":"250 g","shoppingName":"diced chicken breast","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground smoked paprika","amount":"1 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Sweetcorn","amount":"150 g","shoppingName":"Sweetcorn","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"thyme","amount":"5 g","shoppingName":"thyme","marketChecked":true,"priceMatchType":"source-identity"},{"name":"brown onion","amount":"1","shoppingName":"brown onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"soft cheese","amount":"50 g","shoppingName":"soft cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Chinese rice wine","amount":"15 ml","shoppingName":"Chinese rice wine","marketChecked":true,"priceMatchType":"source-identity"},{"name":"spinach","amount":"80 g","shoppingName":"spinach","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white potato","amount":"3","shoppingName":"white potato","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you start cooking, take your chicken out of the fridge, open the packet and let it air Heat a large, wide-based pan (preferably non-stick) over a high heat with a drizzle of olive oil , once hot, add your diced chicken and cook for 3 min on each side or until lightly browned, then remove from the heat and transfer the browned chicken to a plate and reserve the pan (Doubled your protein? Use 2 pans!)","While the chicken is browning, peel and finely dice your brown onion[s] Peel and finely chop (or grate) your garlic Chop your potatoes (skins on) into small, bite-sized pieces Boil a kettle","Return the reserved pan to a medium heat with a drizzle of olive oil Once hot, add a knob of butter with the chopped onion , half your ground smoked paprika (you'll use the rest later!) and a generous pinch of salt and cook for 3-5 min or until the onion has softened Once softened, add the chopped garlic and cook for a further 1 min","While the onion is softening, dissolve your chicken stock mix in 500ml boiled water Once the onion has softened, add the chopped potatoes , browned chicken , thyme (chuck it in, stalks and all!) and 1 tbsp flour to the pan Give everything a good mix up and cook for 1 min or until fragrant","Once fragrant, add your Chinese rice wine and cook for 1 min or until the Chinese rice wine has evaporated Add the chicken stock and a generous pinch of salt , and bring to the boil over a high heat Once boiling reduce to medium and cook for an initial 10 min covered with a lid or until the potatoes are fork-tender","Meanwhile, drain your sweetcorn Wash your spinach , then pat it dry with kitchen paper After an initial 10 min, add the drained sweetcorn and spinach to the pan for a final 5 min or until the spinach has wilted and the chicken is cooked through (no pink meat!)","Once the chicken is cooked through, stir through your soft cheese with a good grind of black pepper – this is your creamy chicken & sweetcorn chowder Discard the thyme stalks and shred any larger pieces of chicken apart, using two forks","Serve the creamy chicken & sweetcorn chowder in a bowl Garnish with the remaining ground smoked paprika Season with a generous grind of pepper and a drizzle of olive oil Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1678879056929-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1678879064239-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1678879070191-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1678879081148-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1678879195933-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1678879204073-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1774000009974-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/creamy-chicken-breast-sweetcorn-chowder","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/creamy-chicken-breast-sweetcorn-chowder","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["5.5 g","intense chicken stock mix"],["250 g","diced chicken breast"],["1 tsp","ground smoked paprika"],["150 g","Sweetcorn"],["2","garlic clove"],["5 g","thyme"],["1","brown onion"],["50 g","soft cheese"],["15 ml","Chinese rice wine"],["80 g","spinach"],["3","white potato"],["as needed","Butter"],["as needed","Flour"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"lunchBucket":"soup","isLunch":true,"prepStyle":"quick","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-4b9d5205-e906-4382-82db-7d6b41e96fc7","sourceId":"4b9d5205-e906-4382-82db-7d6b41e96fc7","title":"Chicken Thigh & Roasted Veg With Jewelled Couscous","subtitle":"Roast the rainbow with this simply spiced chicken thigh and veg.","time":45,"cost":28.9,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","moroccan","grain","cook"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Frying pan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-4911-2_Chicken-Thigh-_-Roasted-Veg-With-Jewelled-Couscous-1378-1678179856136-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/chicken-thigh-roasted-veg-with-jewelled-couscous","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","red pepper"],["1 tsp","ground turmeric"],["250 g","diced chicken thigh"],["30 ml","cider vinegar"],["1 tbsp","ras el hanout"],["5.5 g","intense chicken stock mix"],["1","garlic clove"],["1","courgette"],["120 g","couscous"],["1","carrot"],["15 g","flaked almonds"],["1","red onion"],["30 g","dried cranberries"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"sourceIngredients":[["1","red pepper"],["1 tsp","ground turmeric"],["250 g","diced chicken thigh"],["30 ml","cider vinegar"],["1 tbsp","ras el hanout"],["5.5 g","intense chicken stock mix"],["1","garlic clove"],["1","courgette"],["120 g","couscous"],["1","carrot"],["15 g","flaked almonds"],["1","red onion"],["30 g","dried cranberries"]],"ingredientMeta":[{"name":"red pepper","amount":"1","shoppingName":"red pepper","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground turmeric","amount":"1 tsp","shoppingName":"ground turmeric","marketChecked":true,"priceMatchType":"source-identity"},{"name":"diced chicken thigh","amount":"250 g","shoppingName":"diced chicken thigh","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cider vinegar","amount":"30 ml","shoppingName":"cider vinegar","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ras el hanout","amount":"1 tbsp","shoppingName":"ras el hanout","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense chicken stock mix","amount":"5.5 g","shoppingName":"intense chicken stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"courgette","amount":"1","shoppingName":"courgette","marketChecked":true,"priceMatchType":"source-identity"},{"name":"couscous","amount":"120 g","shoppingName":"couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"carrot","amount":"1","shoppingName":"carrot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"flaked almonds","amount":"15 g","shoppingName":"flaked almonds","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"dried cranberries","amount":"30 g","shoppingName":"dried cranberries","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7 Before you start cooking, take your chicken out of the fridge, open the packet and let it air Deseed your pepper[s] (scrape the seeds and pith out with a teaspoon) and cut into bite-sized pieces Peel and cut your red onion[s] into quarters","Top, tail and chop your courgette[s] into quarters lengthways, then into small, bite-sized pieces Top, tail, peel and chop your carrot[s] into quarters lengthways, then into small, bite-sized pieces Peel and grate (or very finely chop) your garlic","Add the chopped pepper , onion quarters , chopped courgette and chopped carrot to a large baking tray (or two!) Add a drizzle of olive oil and season with a generous pinch of salt and pepper and give everything a good mix up Put the tray[s] in the oven for 20-30 min or until the veg is tender and starting to colour – this is your chunky roast veg","Heat a large, wide-based pan (preferably non-stick) with a drizzle of olive oil over a high heat Once hot, add your diced chicken and grated garlic to the pan with half your ras el hanout (you'll use the rest later!) and a pinch of salt to the pan and cook for 5-6 min on each side or until golden and cooked through (no pink meat!) Once cooked, transfer to a plate and reserve the pan (Doubled your protein? Use 2 pans!)","Meanwhile, boil a kettle Chop your dried cranberries finely Dissolve your chicken stock mix in 200ml boiled water with your ground turmeric and remaining ras el hanout – this is your spiced stock","Add the chopped cranberries and your couscous to a bowl with the spiced stock and give everything a good mix up Cover the bowl, then set aside until all of the stock has been absorbed","Return the reserved pan to a medium heat, then once hot, add your flaked almonds and cook for 2-3 min or until toasted and lightly golden (watch them like a hawk to make sure they don't burn!) Once toasted, chop the toasted almonds roughly (be careful they may be hot!) Fluff the spiced couscous with a fork, then add your cider vinegar and 1 tbsp olive oil – this is your jewelled couscous","Add the chunky roast veg , spiced chicken and half the toasted almonds to the jewelled couscous and give everything a good mix – this is your chicken & roasted veg with jewelled couscous Serve the chicken & roasted veg with jewelled couscous topped with the remaining toasted flaked almonds and enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1679326506040-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1679326509312-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1679326513766-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1679326517234-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1679326520527-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1679326523518-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1679326526500-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/chicken-thigh-roasted-veg-with-jewelled-couscous","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/chicken-thigh-roasted-veg-with-jewelled-couscous","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","red pepper"],["1 tsp","ground turmeric"],["250 g","diced chicken thigh"],["30 ml","cider vinegar"],["1 tbsp","ras el hanout"],["5.5 g","intense chicken stock mix"],["1","garlic clove"],["1","courgette"],["120 g","couscous"],["1","carrot"],["15 g","flaked almonds"],["1","red onion"],["30 g","dried cranberries"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-aaf34f93-4708-43fd-982e-c9c7909739fc","sourceId":"aaf34f93-4708-43fd-982e-c9c7909739fc","title":"Baked Greek Cheese With Spiced Couscous","subtitle":"This Meditarenaean medley is quick and easy.","time":25,"cost":18.74,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","middle eastern","grain","quick"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Kettle","Mixing bowl","Colander"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-5681-2_Baked-Greek-Cheese-With-Spiced-Couscous-1438-1678786876634-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/baked-greek-cheese-with-spiced-couscous","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["100 g","Greek salad cheese"],["1 tsp","ground cumin"],["120 g","couscous"],["5.5 g","vegetable stock mix"],["30 g","chopped dates"],["80 g","spinach"],["1","red pepper"],["15 ml","red wine vinegar"],["25 g","honey"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"sourceIngredients":[["100 g","Greek salad cheese"],["1 tsp","ground cumin"],["120 g","couscous"],["5.5 g","vegetable stock mix"],["30 g","chopped dates"],["80 g","spinach"],["1","red pepper"],["15 ml","red wine vinegar"],["25 g","honey"]],"ingredientMeta":[{"name":"Greek salad cheese","amount":"100 g","shoppingName":"Greek salad cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground cumin","amount":"1 tsp","shoppingName":"ground cumin","marketChecked":true,"priceMatchType":"source-identity"},{"name":"couscous","amount":"120 g","shoppingName":"couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"vegetable stock mix","amount":"5.5 g","shoppingName":"vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chopped dates","amount":"30 g","shoppingName":"chopped dates","marketChecked":true,"priceMatchType":"source-identity"},{"name":"spinach","amount":"80 g","shoppingName":"spinach","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red pepper","amount":"1","shoppingName":"red pepper","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red wine vinegar","amount":"15 ml","shoppingName":"red wine vinegar","marketChecked":true,"priceMatchType":"source-identity"},{"name":"honey","amount":"25 g","shoppingName":"honey","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7 and boil a kettle Chop your pepper[s] into bite-sized pieces Transfer the chopped pepper to a tin foil -lined baking tray with a drizzle of olive oil and a pinch of salt and pepper Put the tray in the oven for an initial 15 min or until the pepper is beginning to char","Meanwhile, dissolve your vegetable stock mix in 200ml boiled water","Add your couscous and ground cumin to a heatproof bowl with the stock and a generous pinch of salt Cover with a tea towel and set aside until all of the stock has been absorbed","Once the pepper is beginning to char, remove the tray from the oven and add your Greek cheese with a drizzle of olive oil and a grind of black pepper Return the tray to the oven for 5-6 min further or until the Greek cheese has softened Once softened, remove the tray from the oven and let cool slightly – this is your baked Greek cheese & roasted pepper","While the Greek cheese is cooking, wash your spinach , then add to a colander and pour boiled water all over it so that it starts to wilt Rinse the wilted spinach under cold running water until it's cool Once cool, squeeze as much water out of the spinach as you can then roughly chop","Once the couscous is done, add the chopped spinach and chopped dates to the cooked couscous and mix it all together – this is your spiced couscous","Add your honey and red wine vinegar to a bowl with 2 tbsp olive oil and a pinch of salt – this is your honey dressing","Top the spiced couscous with the baked Greek cheese & roasted pepper Drizzle over the honey dressing Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1678375662843-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1678375665949-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1678375669264-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1678375674383-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1678375679182-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1678375686312-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1678375692221-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/baked-greek-cheese-with-spiced-couscous","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/baked-greek-cheese-with-spiced-couscous","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["100 g","Greek salad cheese"],["1 tsp","ground cumin"],["120 g","couscous"],["5.5 g","vegetable stock mix"],["30 g","chopped dates"],["80 g","spinach"],["1","red pepper"],["15 ml","red wine vinegar"],["25 g","honey"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-8c584cfd-2204-4c5a-a711-e87e636a84d2","sourceId":"8c584cfd-2204-4c5a-a711-e87e636a84d2","title":"Creamy Beetroot & Goats' Cheese Risotto","subtitle":"This creamy risotto is un-beetable.","time":45,"cost":27.24,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","italian","rice","cook"],"requiredEquipment":["food-processor"],"sourceEquipment":["Oven","Baking tray","Kettle","Mixing bowl","Colander","Grater","Blender"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-5065-2-Creamy-Beetroot-_-Goats-Cheese-Risotto-1531-1678786605722-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/creamy-beetroot-goats-cheese-risotto","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["30 g","grated Italian hard cheese"],["250 g","cooked beetroot"],["5.5 g","intense vegetable stock mix"],["75 g","soft goats' cheese"],["2","garlic clove"],["30 ml","Chinese rice wine"],["50 g","baby leaf salad"],["2","shallot"],["25 g","walnuts"],["160 g","arborio rice"],["5 g","basil"],["15 ml","cider vinegar"],["as needed","Butter"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"sourceIngredients":[["30 g","grated Italian hard cheese"],["250 g","cooked beetroot"],["5.5 g","intense vegetable stock mix"],["75 g","soft goats' cheese"],["2","garlic clove"],["30 ml","Chinese rice wine"],["50 g","baby leaf salad"],["2","shallot"],["25 g","walnuts"],["160 g","arborio rice"],["5 g","basil"],["15 ml","cider vinegar"]],"ingredientMeta":[{"name":"grated Italian hard cheese","amount":"30 g","shoppingName":"grated Italian hard cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cooked beetroot","amount":"250 g","shoppingName":"cooked beetroot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense vegetable stock mix","amount":"5.5 g","shoppingName":"intense vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"soft goats' cheese","amount":"75 g","shoppingName":"soft goats' cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Chinese rice wine","amount":"30 ml","shoppingName":"Chinese rice wine","marketChecked":true,"priceMatchType":"source-identity"},{"name":"baby leaf salad","amount":"50 g","shoppingName":"baby leaf salad","marketChecked":true,"priceMatchType":"source-identity"},{"name":"shallot","amount":"2","shoppingName":"shallot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"walnuts","amount":"25 g","shoppingName":"walnuts","marketChecked":true,"priceMatchType":"source-identity"},{"name":"arborio rice","amount":"160 g","shoppingName":"arborio rice","marketChecked":true,"priceMatchType":"source-identity"},{"name":"basil","amount":"5 g","shoppingName":"basil","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cider vinegar","amount":"15 ml","shoppingName":"cider vinegar","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Boil a kettle, then chop your walnuts roughly Heat a large, dry pan over a medium heat and once hot, add the walnuts and cook for 2-3 min or until toasted and lightly golden Once lightly golden, transfer them to a chopping board, reserving the pan Tip: Watch them like a hawk so they don't burn!","Peel and finely chop your shallot[s] Peel and finely chop (or grate) your garlic Return the reserved pan to a medium heat with a drizzle of olive oil and a knob of butter Once hot, add the chopped shallot , chopped garlic and a pinch of salt and cook for 3-4 min or until the shallot has softened","Dissolve your vegetable stock mix in 750ml boiled water Add your arborio rice and Chinese rice wine to the pan and cook for 1 min or until the Chinese rice wine has evaporated Add the vegetable stock a ladle at a time, stirring continuously, for 25-30 min or until all of the stock is absorbed and the rice is cooked","Once the rice is cooking, preheat the oven to 220°C/ 200°C (fan)/ gas 7 Drain your beetroot in a colander over the sink Chop half the beetroot into small bite-sized pieces Add the remaining beetroot to a food processor with 1 tbsp cold water and blend until a smooth purée forms","Add the chopped beetroot to a tin foil -lined baking tray (or two!) and drizzle with a little olive oil Put the tray[s] in the oven and cook for 10-15 min or until tender and starting to brown","Chop your basil finely, including the stalks Crumble your goats' cheese into rough bite-sized pieces Wash your salad and pat it dry with kitchen paper Add the salad to a bowl with half your cider vinegar , 2 tbsp olive oil and a pinch of pepper and toss – this is your dressed salad","Once the rice is cooked, remove it from the heat Add the beetroot purée to the pan with your grated Italian hard cheese , half the goats' cheese , the remaining cider vinegar and most of the chopped basil (you’ll use the rest later!) Season with a pinch of salt and pepper and give everything a good mix up – this is your creamy beetroot risotto Tip: Add a splash of water if the risotto is looking a little dry!","Top the creamy beetroot risotto with the remaining crumbled goats' cheese , roasted beetroot , toasted walnuts and remaining chopped basil Serve the dressed salad to the side Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1679399337504-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1679399343808-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1679399349416-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1679399355188-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1679399361925-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1679399367372-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1679399373298-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/creamy-beetroot-goats-cheese-risotto","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/creamy-beetroot-goats-cheese-risotto","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["30 g","grated Italian hard cheese"],["250 g","cooked beetroot"],["5.5 g","intense vegetable stock mix"],["75 g","soft goats' cheese"],["2","garlic clove"],["30 ml","Chinese rice wine"],["50 g","baby leaf salad"],["2","shallot"],["25 g","walnuts"],["160 g","arborio rice"],["5 g","basil"],["15 ml","cider vinegar"],["as needed","Butter"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"lunchBucket":"rice","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-3b4374b9-f9e2-461e-9d41-8b2ec698e359","sourceId":"3b4374b9-f9e2-461e-9d41-8b2ec698e359","title":"Tomato & Mozzarella Risotto","subtitle":"Tuck into a classic risotto, family style.","time":35,"cost":16.79,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","italian","rice","cook"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Kettle","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/5776---Tomato--Mozzarella-Risotto1474-1681208218331-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/tomato-mozzarella-risotto","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["32 g","tomato paste"],["1 tsp","dried oregano"],["5.5 g","intense vegetable stock mix"],["2","garlic clove"],["1","brown onion"],["160 g","arborio rice"],["125 g","mozzarella"],["250 g","cherry tomatoes"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"sourceIngredients":[["32 g","tomato paste"],["1 tsp","dried oregano"],["5.5 g","intense vegetable stock mix"],["2","garlic clove"],["1","brown onion"],["160 g","arborio rice"],["125 g","mozzarella"],["250 g","cherry tomatoes"]],"ingredientMeta":[{"name":"tomato paste","amount":"32 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"dried oregano","amount":"1 tsp","shoppingName":"dried oregano","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense vegetable stock mix","amount":"5.5 g","shoppingName":"intense vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"brown onion","amount":"1","shoppingName":"brown onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"arborio rice","amount":"160 g","shoppingName":"arborio rice","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mozzarella","amount":"125 g","shoppingName":"mozzarella","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cherry tomatoes","amount":"250 g","shoppingName":"cherry tomatoes","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Boil a full kettle Peel and finely chop your brown onion[s] Peel and finely chop (or grate) your garlic","Heat a large, wide-based pan (preferably non-stick) with a drizzle of olive oil over a medium heat Once hot, add the chopped onion with a generous pinch of salt and cook for 2 min or until beginning to soften Chop your cherry tomatoes roughly","Once the onion is beginning to soften, add the chopped cherry tomatoes and cook for 2-3 min or until the tomatoes start to blister","Meanwhile, dissolve your vegetable stock mix in 750ml boiled water – this is your vegetable stock","Once the tomato is starting to blister, add your tomato paste and chopped garlic to the pan with your dried oregano and 1 tsp [2 tsp] sugar Give everything a good mix up and cook for 1-2 min or until fragrant","Once fragrant, add your arborio rice and cook for 1 min, stirring to coat the grains in the oil Add the vegetable stock a ladle at a time, stirring continuously for 25-30 min or until all of the stock is absorbed and the rice is cooked","Drain your mozzarella , then pat and squeeze as much liquid out as you can with kitchen paper Tear the drained mozzarella into rough, bite-sized pieces Once the rice is cooked, top it with the torn mozzarella – this is your tomato & mozzarella risotto","Serve the tomato & mozzarella risotto Garnish with a drizzle of olive oil and a pinch of pepper Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1680278264719-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1680278268530-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1680278271834-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1680278276357-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1680278280663-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1680278290700-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1680278296562-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/tomato-mozzarella-risotto","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/tomato-mozzarella-risotto","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["32 g","tomato paste"],["1 tsp","dried oregano"],["5.5 g","intense vegetable stock mix"],["2","garlic clove"],["1","brown onion"],["160 g","arborio rice"],["125 g","mozzarella"],["250 g","cherry tomatoes"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"lunchBucket":"rice","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-c21f263e-384b-4075-8ecc-168d4e374404","sourceId":"c21f263e-384b-4075-8ecc-168d4e374404","title":"Chicken, Pepper & Chive Risotto","subtitle":"Roasted pepper and sweet tomato stock add comforting richness to this velvety chicken risotto.","time":50,"cost":32.05,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","italian","rice","cook"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Frying pan","Kettle","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/3945_Chicken-Yellow-Pepper--Chive-Risotto_011_0-1657723417698-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/chicken-pepper-chive-risotto","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["0.5 tsp","ground turmeric"],["1","yellow pepper"],["250 g","chicken breast strips"],["32 g","tomato paste"],["1 tsp","ground smoked paprika"],["5.5 g","intense chicken stock mix"],["40 g","cheddar cheese"],["3","garlic clove"],["160 g","arborio rice"],["25 g","red chilli relish"],["15 ml","Chinese rice wine"],["5 g","chives"],["1","red onion"],["as needed","Butter"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"sourceIngredients":[["0.5 tsp","ground turmeric"],["1","yellow pepper"],["250 g","chicken breast strips"],["32 g","tomato paste"],["1 tsp","ground smoked paprika"],["5.5 g","intense chicken stock mix"],["40 g","cheddar cheese"],["3","garlic clove"],["160 g","arborio rice"],["25 g","red chilli relish"],["15 ml","Chinese rice wine"],["5 g","chives"],["1","red onion"]],"ingredientMeta":[{"name":"ground turmeric","amount":"0.5 tsp","shoppingName":"ground turmeric","marketChecked":true,"priceMatchType":"source-identity"},{"name":"yellow pepper","amount":"1","shoppingName":"yellow pepper","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chicken breast strips","amount":"250 g","shoppingName":"chicken breast strips","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"32 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground smoked paprika","amount":"1 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense chicken stock mix","amount":"5.5 g","shoppingName":"intense chicken stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cheddar cheese","amount":"40 g","shoppingName":"cheddar cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"3","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"arborio rice","amount":"160 g","shoppingName":"arborio rice","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red chilli relish","amount":"25 g","shoppingName":"red chilli relish","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Chinese rice wine","amount":"15 ml","shoppingName":"Chinese rice wine","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chives","amount":"5 g","shoppingName":"chives","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7, then take your chicken out of the fridge, open the packet and let it air Heat a large, wide-based pan (preferably non-stick) over a medium-high heat Once hot, add your chicken and cook for 3 min on each side or until lightly browned, then remove from the heat","Deseed your pepper[s] (scrape the seeds and pith out with a teaspoon) and cut into thin strips Add the pepper strips to a tin foil lined-baking tray (or two!) with a drizzle of olive oil and a pinch of salt Transfer the browned chicken to the baking tray[s] Put the tray[s] in the oven for 16-20 min until the pepper has roasted and the chicken is cooked through (no pink meat!)","Meanwhile, boil a full kettle Peel and finely dice your red onion[s] Dissolve your chicken stock mix in 700ml boiled water , then add your tomato paste , Chinese rice wine and red chilli relish – this is your sweet tomato stock","Heat a large, wide-based pan (preferably non-stick) with a drizzle of olive oil and a knob of butter over a medium heat Once hot, add the diced onion with a pinch of salt and cook for 4 min until softened but not browned Meanwhile, peel and finely chop (or grate) your garlic","Add your arborio rice , chopped garlic , ground smoked paprika and ground turmeric to the pan and cook for 1 min further Add 1/3 of the sweet tomato stock and stir continuously until absorbed Continue to add the remaining sweet tomato stock , a ladle at a time, stirring continuously for 25-30 min, until all the stock is absorbed and the rice is cooked – this is your risotto","Meanwhile, chop your chives finely Grate your cheddar cheese","Once cooked, transfer the chicken to a clean board and shred it apart, using two forks - this technique is known as ‘pulling’ Return the pulled chicken and half the roasted pepper into the risotto (save the rest for garnish!) and give everything a good mix up Once the rice is cooked, remove the risotto from the heat and stir in half the grated cheese and half the chopped chives (save the rest for garnish!), then season with a grind of pepper - this is your chicken, pepper & chive risotto","To serve, top the chicken, pepper & chive risotto with the reserved roasted pepper and the remaining grated cheese Garnish with the remaining chopped chives and a drizzle of olive oil Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1679830107534-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1679830110350-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-copy-1679830137548-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1679830160122-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1679830162890-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-copy-1679830166369-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1679830169825-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/chicken-pepper-chive-risotto","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/chicken-pepper-chive-risotto","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["0.5 tsp","ground turmeric"],["1","yellow pepper"],["250 g","chicken breast strips"],["32 g","tomato paste"],["1 tsp","ground smoked paprika"],["5.5 g","intense chicken stock mix"],["40 g","cheddar cheese"],["3","garlic clove"],["160 g","arborio rice"],["25 g","red chilli relish"],["15 ml","Chinese rice wine"],["5 g","chives"],["1","red onion"],["as needed","Butter"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"lunchBucket":"rice","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-d8b3593b-857c-465c-b222-9ca9fdb36246","sourceId":"d8b3593b-857c-465c-b222-9ca9fdb36246","title":"One Tray Harissa Basa & Cherry Tomato Traybake","subtitle":"All hail the heady aroma of harissa.","time":35,"cost":19.99,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fusion","other","cook"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/4031_Harissa-Basa--Cherry-Tomato-Traybake_001-1681395167243-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/harissa-basa-cherry-tomato-traybake","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["20 g","harissa paste"],["1","basa fillets"],["2 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["160 g","fine green beans"],["125 g","cherry tomatoes"],["4","white potato"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"sourceIngredients":[["20 g","harissa paste"],["1","basa fillets"],["2 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["160 g","fine green beans"],["125 g","cherry tomatoes"],["4","white potato"]],"ingredientMeta":[{"name":"harissa paste","amount":"20 g","shoppingName":"harissa paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"basa fillets","amount":"1","shoppingName":"basa fillets","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground smoked paprika","amount":"2 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mayonnaise","amount":"25 ml","shoppingName":"mayonnaise","marketChecked":true,"priceMatchType":"source-identity"},{"name":"fine green beans","amount":"160 g","shoppingName":"fine green beans","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cherry tomatoes","amount":"125 g","shoppingName":"cherry tomatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white potato","amount":"4","shoppingName":"white potato","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7 Chop your potatoes (skins on) into bite-sized pieces Add the chopped potatoes to a baking tray (or two!) with a drizzle of olive oil and a pinch of salt and pepper Give everything a good mix up and put the tray[s] in the oven for an initial 18 min","Pat your fish fillet[s] dry with kitchen paper Add half your ground smoked paprika (save the rest for later!) to a plate with a pinch of salt and pepper and mix it together Add the fish fillet[s] to the plate and turn until fully coated, then set aside – this is your smoky fish fillet","Chop your cherry tomatoes in half","Trim, then chop your green beans in half","After the initial 18 min, remove the tray[s] from the oven Add the chopped tomatoes and chopped green beans to the tray[s] with a drizzle of olive oil Sprinkle over the remaining ground smoked paprika and give everything a good mix up","Add the smoky fish fillet[s] to the tray[s] with a drizzle of olive oil Return the tray[s] to the oven for a further 12-15 min or until the fish is cooked through, the potatoes are crisp and the vegetables have softened – this is your smoky fish tray bake Tip: Your fish is cooked once it turns opaque and flakes easily (Doubled your protein? Do this in batches!)","Meanwhile, combine your mayo and harissa paste (can't handle the heat? Go easy!) in a small bowl and mix it all together – this is your harissa mayo","Serve the smoky fish tray bake with the harissa mayo drizzled over the top Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1678289142017-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1678289186240-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1678289200884-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1678289205733-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1678290609117-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1678290618538-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1678290622989-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/harissa-basa-cherry-tomato-traybake","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/harissa-basa-cherry-tomato-traybake","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["20 g","harissa paste"],["1","basa fillets"],["2 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["160 g","fine green beans"],["125 g","cherry tomatoes"],["4","white potato"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"lunchBucket":"other","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-ed6690aa-b5c5-412a-aec4-17562bf970b2","sourceId":"ed6690aa-b5c5-412a-aec4-17562bf970b2","title":"Koshari-Style Rice With Roasted Aubergine & Tomato Sauce","subtitle":"This is Egypt’s answer to street food.","time":25,"cost":23.06,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","african","rice","quick"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Frying pan","Saucepan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-5646-2-Koshari-Style-Rice-With-Roasted-Aubergine--Tomato-Sauce-2_0-1753773756675-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/egyptian-style-rice-with-aubergine-koshari-sauce","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["130 g","brown long grain rice"],["0.5 tsp","cayenne pepper"],["2 tsp","ground coriander"],["200 g","finely chopped tomatoes"],["5.5 g","intense vegetable stock mix"],["2 tsp","ground cumin"],["2","garlic clove"],["2","tomato"],["1","shallot"],["15 g","crispy onions"],["1","cucumber"],["1","aubergine"],["185 g","green lentils"],["15 ml","white wine vinegar"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"sourceIngredients":[["130 g","brown long grain rice"],["0.5 tsp","cayenne pepper"],["2 tsp","ground coriander"],["200 g","finely chopped tomatoes"],["5.5 g","intense vegetable stock mix"],["2 tsp","ground cumin"],["2","garlic clove"],["2","tomato"],["1","shallot"],["15 g","crispy onions"],["1","cucumber"],["1","aubergine"],["185 g","green lentils"],["15 ml","white wine vinegar"]],"ingredientMeta":[{"name":"brown long grain rice","amount":"130 g","shoppingName":"brown long grain rice","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cayenne pepper","amount":"0.5 tsp","shoppingName":"cayenne pepper","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground coriander","amount":"2 tsp","shoppingName":"ground coriander","marketChecked":true,"priceMatchType":"source-identity"},{"name":"finely chopped tomatoes","amount":"200 g","shoppingName":"finely chopped tomatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense vegetable stock mix","amount":"5.5 g","shoppingName":"intense vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground cumin","amount":"2 tsp","shoppingName":"ground cumin","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato","amount":"2","shoppingName":"tomato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"shallot","amount":"1","shoppingName":"shallot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"crispy onions","amount":"15 g","shoppingName":"crispy onions","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cucumber","amount":"1","shoppingName":"cucumber","marketChecked":true,"priceMatchType":"source-identity"},{"name":"aubergine","amount":"1","shoppingName":"aubergine","marketChecked":true,"priceMatchType":"source-identity"},{"name":"green lentils","amount":"185 g","shoppingName":"green lentils","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white wine vinegar","amount":"15 ml","shoppingName":"white wine vinegar","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7 and boil half a kettle Rinse your brown rice , add it to a pot with a lid with plenty of cold water and bring to the boil over a high heat, once boiling, reduce the heat to medium and cook for 20-25 min or until it's tender with a slight bite Once cooked, drain, return it to the pot and keep covered until serving","Trim the green stalk[s] off your aubergine[s] and chop lengthways into wedges Add the aubergine wedges to a baking tray (or two!) with a generous drizzle of olive oil and a pinch of salt Give everything a good mix up and put the tray[s] in the oven in the oven for 15-20 min or until the wedges are tender and golden","Peel and finely slice your shallot[s] Peel and finely chop (or grate) your garlic","Heat a large, wide based pan (preferably non-stick) with a drizzle of olive oil over a medium heat Once hot, add the sliced shallot and a generous pinch of salt and cook for 2-3 min or until slightly softened Meanwhile, dissolve your vegetable stock mix in 150ml boiled water","Once the shallot has slightly softened, add the chopped garlic to the pan with your ground coriander , ground cumin and your cayenne pepper (can't handle the heat? Go easy!) Cook for 30 secs or until fragrant, then add the vegetable stock , chopped tomatoes and half your white wine vinegar (you'll use the rest later!) with a pinch of sugar Give everything a good mix up and cook for 8-10 min or until the sauce has thickened – this is your spicy tomato sauce","Meanwhile, dice your tomato[es] finely Dice your cucumber finely Add the diced tomato and diced cucumber to a bowl with the remaining white wine vinegar , a drizzle of olive oil and a pinch of salt and pepper Give everything a good mix up – this is your tomato cucumber salad","Drain and rinse your green lentils Add the drained lentils to the cooked brown rice with a pinch of salt Mix it all together and cook over a low heat for 1-2 min or until warmed through – this is your rice & lentils","Serve the aubergine wedges over the rice & lentils , topped with the spicy tomato sauce and the tomato cucumber salad to the side Top with your crispy onions and season generously with black pepper Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1678467370238-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1678467374105-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1678467378605-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1678467382694-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1678467386434-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1678467390657-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1678467395172-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/egyptian-style-rice-with-aubergine-koshari-sauce","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/egyptian-style-rice-with-aubergine-koshari-sauce","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["130 g","brown long grain rice"],["0.5 tsp","cayenne pepper"],["2 tsp","ground coriander"],["200 g","finely chopped tomatoes"],["5.5 g","intense vegetable stock mix"],["2 tsp","ground cumin"],["2","garlic clove"],["2","tomato"],["1","shallot"],["15 g","crispy onions"],["1","cucumber"],["1","aubergine"],["185 g","green lentils"],["15 ml","white wine vinegar"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"lunchBucket":"rice","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-7bb23b07-e7f4-4355-a92f-a2a3b5c240de","sourceId":"7bb23b07-e7f4-4355-a92f-a2a3b5c240de","title":"Honey & Harissa Baked Saganaki With Olive & Roast Tomato Couscous","subtitle":"This moreish twist on saganaki is sweet, spicy and punchy.","time":25,"cost":18.56,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fusion","grain","quick"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Kettle","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/5401-2_Honey-_-Harissa-Baked-Saganaki-With-Olive-_-Roast-Tomato-Couscous_001_0-1683618626229-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/honey-harissa-baked-saganaki-with-olive-roast-tomato-couscous","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["100 g","Greek salad cheese"],["1 tbsp","ras el hanout"],["40 g","black olives"],["5 g","parsley"],["80 g","natural yoghurt"],["1","lemon"],["120 g","couscous"],["40 g","harissa paste"],["250 g","cherry tomatoes"],["1","red onion"],["25 g","honey"],["as needed","Pepper"],["as needed","Olive oil"],["as needed","Water"]],"sourceIngredients":[["100 g","Greek salad cheese"],["1 tbsp","ras el hanout"],["40 g","black olives"],["5 g","parsley"],["80 g","natural yoghurt"],["1","lemon"],["120 g","couscous"],["40 g","harissa paste"],["250 g","cherry tomatoes"],["1","red onion"],["25 g","honey"]],"ingredientMeta":[{"name":"Greek salad cheese","amount":"100 g","shoppingName":"Greek salad cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ras el hanout","amount":"1 tbsp","shoppingName":"ras el hanout","marketChecked":true,"priceMatchType":"source-identity"},{"name":"black olives","amount":"40 g","shoppingName":"black olives","marketChecked":true,"priceMatchType":"source-identity"},{"name":"parsley","amount":"5 g","shoppingName":"parsley","marketChecked":true,"priceMatchType":"source-identity"},{"name":"natural yoghurt","amount":"80 g","shoppingName":"natural yoghurt","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lemon","amount":"1","shoppingName":"lemon","marketChecked":true,"priceMatchType":"source-identity"},{"name":"couscous","amount":"120 g","shoppingName":"couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"harissa paste","amount":"40 g","shoppingName":"harissa paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cherry tomatoes","amount":"250 g","shoppingName":"cherry tomatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"honey","amount":"25 g","shoppingName":"honey","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 200°C/ 180°C (fan)/ gas 6 Peel and cut your red onion[s] into quarters, then separate the wedges so you end up with a pile of onion petals Chop your cherry tomatoes in half","Add the onion petals and halved tomatoes to one side of a baking paper -lined baking tray with a drizzle of olive oil Sprinkle over 3/4 of your ras el hanout (save the rest for later!) with a grind of pepper Put the tray[s] in the oven for 15 min or until slightly charred – this is your roast veg","Meanwhile, chop your black olives in half Chop your parsley finely, including the stalks","Boil half a kettle Combine your natural yoghurt and half your harissa paste (can't handle the heat? Go easy!) in a bowl with half your honey and a squeeze of lemon juice – this is your yoghurt & harissa dressing","Combine your couscous with the remaining ras el hanout and a drizzle of olive oil in a large heatproof bowl Add 200ml boiled water , cover and set aside until all of the liquid has been absorbed","Top your Greek cheese with the remaining honey and the remaining harissa paste (not a fan of spice? Just add a little!) Once the roast veg is slightly charred, remove the tray[s] from the oven Add the Greek cheese to the other side of the baking tray and return the tray[s] to the oven Cook for 4-5 min or until the cheese is warmed through – this is your honey & harissa baked saganaki","Once the couscous is ready, fluff with a fork, then add the roast veg and chopped olives Add a squeeze of lemon juice and half your parsley (save the rest for garnish!) Give everything a good mix up – this is your olive & roast tomato couscous","Serve the honey & harissa baked saganaki over the olive & roast tomato couscous Drizzle over the yoghurt & harissa dressing Garnish with the remaining lemon and remaining parsley Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1683717161457-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1683717172040-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1683717186030-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1683717195545-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1683717201989-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1683717209134-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1683717219780-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/honey-harissa-baked-saganaki-with-olive-roast-tomato-couscous","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/honey-harissa-baked-saganaki-with-olive-roast-tomato-couscous","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["100 g","Greek salad cheese"],["1 tbsp","ras el hanout"],["40 g","black olives"],["5 g","parsley"],["80 g","natural yoghurt"],["1","lemon"],["120 g","couscous"],["40 g","harissa paste"],["250 g","cherry tomatoes"],["1","red onion"],["25 g","honey"],["as needed","Pepper"],["as needed","Olive oil"],["as needed","Water"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-53bdf749-1076-43c4-b266-64b53d4c2949","sourceId":"53bdf749-1076-43c4-b266-64b53d4c2949","title":"Plant-Based Sicilian-Style Aubergine Stew With Couscous","subtitle":"Whip up this stew like a real Sicilian.","time":25,"cost":20.56,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","grain","quick"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/5914---Sicilian-Style-Aubergine-Stew-With-Pine-Nut-Couscous-1686063289346-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/sicilian-style-aubergine-stew-with-pine-nut-couscous","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1 tsp","dried oregano"],["1","red pepper"],["20 g","capers"],["5.5 g","intense vegetable stock mix"],["2","garlic clove"],["2","tomato"],["15 g","pumpkin seeds"],["5 g","parsley"],["120 g","couscous"],["16 g","tomato paste"],["30 g","sultanas"],["1","aubergine"],["15 ml","red wine vinegar"],["1","red onion"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"sourceIngredients":[["1 tsp","dried oregano"],["1","red pepper"],["20 g","capers"],["5.5 g","intense vegetable stock mix"],["2","garlic clove"],["2","tomato"],["15 g","pumpkin seeds"],["5 g","parsley"],["120 g","couscous"],["16 g","tomato paste"],["30 g","sultanas"],["1","aubergine"],["15 ml","red wine vinegar"],["1","red onion"]],"ingredientMeta":[{"name":"dried oregano","amount":"1 tsp","shoppingName":"dried oregano","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red pepper","amount":"1","shoppingName":"red pepper","marketChecked":true,"priceMatchType":"source-identity"},{"name":"capers","amount":"20 g","shoppingName":"capers","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense vegetable stock mix","amount":"5.5 g","shoppingName":"intense vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato","amount":"2","shoppingName":"tomato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"pumpkin seeds","amount":"15 g","shoppingName":"pumpkin seeds","marketChecked":true,"priceMatchType":"source-identity"},{"name":"parsley","amount":"5 g","shoppingName":"parsley","marketChecked":true,"priceMatchType":"source-identity"},{"name":"couscous","amount":"120 g","shoppingName":"couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"16 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sultanas","amount":"30 g","shoppingName":"sultanas","marketChecked":true,"priceMatchType":"source-identity"},{"name":"aubergine","amount":"1","shoppingName":"aubergine","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red wine vinegar","amount":"15 ml","shoppingName":"red wine vinegar","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Boil a kettle Heat a large, dry, wide-based pan (preferably non-stick with a matching lid) over a medium heat Once hot, add your pumpkin seeds and cook for 2-3 min or until toasted and lightly golden, then set aside and reserve the pan Tip: Watch them like a hawk to make sure they don’t burn!","While the pumpkin seeds are toasting, trim the green stalk[s] off your aubergine[s] and chop into large bite-sized pieces Peel and chop your red onion[s] into wedges Chop your tomato[es] into wedges Deseed your pepper[s] (scrape the seeds and pith out with a teaspoon) and chop into large chunks","Heat the reserved pan with a generous drizzle of olive oil over a high heat Once hot, add the chopped aubergine and onion wedges with a generous pinch of salt and cook for 3-4 min or until the veg is starting to brown Meanwhile, peel and finely chop (or grate) your garlic Dissolve your vegetable stock mix and tomato paste in 200ml boiled water – this is your tomato stock","Once the veg is starting to brown, add the chopped pepper , tomato wedges and chopped garlic to the pan and cook for 30 secs or until fragrant Once fragrant, add your dried oregano , sultanas and red wine vinegar and cook for 1 min or until the vinegar has evaporated","Once the vinegar has evaporated, add the tomato stock and bring to the boil over a high heat Once boiling, reduce the heat to medium-high and cook, covered, for 10-12 min or until the veg is tender","While the veg is cooking, chop your parsley finely, including the stalks Add your couscous and a generous pinch of salt to a heatproof bowl with 200ml boiled water , cover and set aside until all of the liquid has been absorbed","Once the veg is tender, add your capers to the pan and cook, uncovered, for a final 2 min or until the sauce has slightly thickened – this is your Sicilian-style aubergine stew While the sauce is thickening, fluff the cooked couscous with a fork, then stir most of the chopped parsley (save some for garnish!) and the toasted pumpkin seeds through the couscous with a drizzle of olive oil and a generous grind of black pepper – this is your pumpkin seed couscous","Serve the Sicilian-style aubergine stew over the pumpkin seed couscous Garnish with the remaining chopped parsley Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1684234867537-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1684234871328-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1684234875935-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1684234879069-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1684234882740-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1684234886372-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1684234890413-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/sicilian-style-aubergine-stew-with-pine-nut-couscous","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/sicilian-style-aubergine-stew-with-pine-nut-couscous","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1 tsp","dried oregano"],["1","red pepper"],["20 g","capers"],["5.5 g","intense vegetable stock mix"],["2","garlic clove"],["2","tomato"],["15 g","pumpkin seeds"],["5 g","parsley"],["120 g","couscous"],["16 g","tomato paste"],["30 g","sultanas"],["1","aubergine"],["15 ml","red wine vinegar"],["1","red onion"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-90126cdd-ebcb-4bf6-bcae-4c92e6ff71f8","sourceId":"90126cdd-ebcb-4bf6-bcae-4c92e6ff71f8","title":"One Tray Harissa Chicken Thigh & Carrot Traybake With Paprika Yoghurt","subtitle":"Leave the cooking to the oven with this veg-packed traybake.","time":40,"cost":25.13,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fusion","other","cook"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-5445-2-Harissa-Chicken-Potato--Carrot-Traybake-With-Paprika-Yoghurt-2-1789719865789-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/harissa-chicken-carrot-traybake-with-paprika-yoghurt","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["2","white potato"],["1","carrot"],["40 g","harissa paste"],["320 g","skinless chicken thighs"],["1 tsp","ground smoked paprika"],["50 g","baby leaf salad"],["80 g","natural yoghurt"],["15 ml","cider vinegar"],["1","red onion"],["1","sweet potato"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"]],"sourceIngredients":[["2","white potato"],["1","carrot"],["40 g","harissa paste"],["320 g","skinless chicken thighs"],["1 tsp","ground smoked paprika"],["50 g","baby leaf salad"],["80 g","natural yoghurt"],["15 ml","cider vinegar"],["1","red onion"],["1","sweet potato"]],"ingredientMeta":[{"name":"white potato","amount":"2","shoppingName":"white potato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"carrot","amount":"1","shoppingName":"carrot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"harissa paste","amount":"40 g","shoppingName":"harissa paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"skinless chicken thighs","amount":"320 g","shoppingName":"skinless chicken thighs","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground smoked paprika","amount":"1 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"baby leaf salad","amount":"50 g","shoppingName":"baby leaf salad","marketChecked":true,"priceMatchType":"source-identity"},{"name":"natural yoghurt","amount":"80 g","shoppingName":"natural yoghurt","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cider vinegar","amount":"15 ml","shoppingName":"cider vinegar","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sweet potato","amount":"1","shoppingName":"sweet potato","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7 Take your chicken out of the fridge, open the packet and let it air Chop your potato[es] (skins on) into small bite-sized pieces Chop your sweet potato[es] (skins on) into small bite-sized pieces","Top, tail, and slice your carrot[s] into chunky discs on the diagonal Peel and chop your red onion[s] into thin wedges","Add the chopped potatoes , chopped carrot and onion wedges to a large tin foil -lined baking tray (or two!) Add a generous drizzle of olive oil , a generous pinch of salt and pepper and give everything a good mix up Put the tray[s] in the oven for an initial 15-17 min or until the potatoes are starting to soften","Meanwhile, add most of your ground smoked paprika (save some for later!), 1 tsp sugar , a generous drizzle of olive oil and half your cider vinegar (you'll use the rest later!) to a medium bowl Add a generous pinch of salt and pepper and give everything a good mix up – this is your marinade","Once the potatoes have slightly softened, remove the tray[s] from the oven and add your chicken, drizzle the marinade over the chicken then return the tray[s]to the oven and cook for a further 13-14 min or until almost cooked (reserve the bowl), then remove the tray[s] from the oven, spread your harissa paste (can't handle the heat? Go easy!) over the chicken and return to the oven for a final 5-6 min or until the chicken is cooked through (no pink meat!) – this is your harissa chicken & carrot traybake (Doubled your protein? Do this in batches!)","While the chicken is cooking, wipe the reserved bowl clean with kitchen paper Combine your natural yoghurt with the remaining ground smoked paprika and a pinch of salt in the reserved bowl Stir it all together – this is your paprika yoghurt","Wash your salad , then pat dry with kitchen paper","Serve the harissa chicken & carrot traybake with the salad to the side and drizzle over the paprika yoghurt Drizzle the salad with a little olive oil and the remaining cider vinegar and season with a pinch of salt and pepper Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1686665877955-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1686665882329-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1686665890186-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/03-01-24_09h19m53s-APIC-1704362303806-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1686665897414-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1686665901242-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1686665909959-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/harissa-chicken-carrot-traybake-with-paprika-yoghurt","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/harissa-chicken-carrot-traybake-with-paprika-yoghurt","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["2","white potato"],["1","carrot"],["40 g","harissa paste"],["320 g","skinless chicken thighs"],["1 tsp","ground smoked paprika"],["50 g","baby leaf salad"],["80 g","natural yoghurt"],["15 ml","cider vinegar"],["1","red onion"],["1","sweet potato"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"]],"lunchBucket":"other","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-07eb30c5-db4c-4651-9ed3-5ccbf3836e7b","sourceId":"07eb30c5-db4c-4651-9ed3-5ccbf3836e7b","title":"Butternut Squash & Cashew Saag With Pea & Mint Pilaf","subtitle":"This aromatic coconut curry takes veg to the next level.","time":25,"cost":24.12,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","indian","rice","quick"],"requiredEquipment":["food-processor"],"sourceEquipment":["Oven","Baking tray","Frying pan","Saucepan","Kettle","Colander"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/5716---Saag-Butternut-Squash--Cashew-Curry-With-Pea--Mint-Pilaf-1703078648196-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/butternut-squash-cashew-saag-with-pea-mint-pilaf","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["130 g","white basmati rice"],["25 g","solid creamed coconut"],["32 g","tomato paste"],["5.5 g","intense vegetable stock mix"],["1 tbsp","curry powder"],["2","garlic clove"],["15 g","fresh root ginger"],["1","brown onion"],["160 g","blanched peas"],["30 g","sultanas"],["160 g","butternut squash cubes"],["120 g","spinach"],["10 g","coriander & mint"],["25 g","cashew nuts"],["as needed","Salt"],["as needed","Olive oil"],["as needed","Water"],["as needed","Butter"]],"sourceIngredients":[["130 g","white basmati rice"],["25 g","solid creamed coconut"],["32 g","tomato paste"],["5.5 g","intense vegetable stock mix"],["1 tbsp","curry powder"],["2","garlic clove"],["15 g","fresh root ginger"],["1","brown onion"],["160 g","blanched peas"],["30 g","sultanas"],["160 g","butternut squash cubes"],["120 g","spinach"],["10 g","coriander & mint"],["25 g","cashew nuts"]],"ingredientMeta":[{"name":"white basmati rice","amount":"130 g","shoppingName":"white basmati rice","marketChecked":true,"priceMatchType":"source-identity"},{"name":"solid creamed coconut","amount":"25 g","shoppingName":"solid creamed coconut","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"32 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense vegetable stock mix","amount":"5.5 g","shoppingName":"intense vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"curry powder","amount":"1 tbsp","shoppingName":"curry powder","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"fresh root ginger","amount":"15 g","shoppingName":"fresh root ginger","marketChecked":true,"priceMatchType":"source-identity"},{"name":"brown onion","amount":"1","shoppingName":"brown onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"blanched peas","amount":"160 g","shoppingName":"blanched peas","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sultanas","amount":"30 g","shoppingName":"sultanas","marketChecked":true,"priceMatchType":"source-identity"},{"name":"butternut squash cubes","amount":"160 g","shoppingName":"butternut squash cubes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"spinach","amount":"120 g","shoppingName":"spinach","marketChecked":true,"priceMatchType":"source-identity"},{"name":"coriander & mint","amount":"10 g","shoppingName":"coriander & mint","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cashew nuts","amount":"25 g","shoppingName":"cashew nuts","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7 Add your butternut squash cubes to a baking paper -lined baking tray with a little drizzle of olive oil and a pinch of salt Give everything a good mix up and put the tray in the oven for 15-20 min or until tender and golden","Add your basmati rice and a generous pinch of your curry powder (you'll use the rest later!) with 300ml cold water to a pot with a lid and bring to the boil over a high heat Once boiling, reduce the heat to very low and cook, covered, for 10-12 min or until all the water has absorbed and the rice is cooked Once cooked, remove from the heat and keep covered until serving","Boil a kettle Peel and chop your brown onion[s] into wedges Crush your garlic open by squashing it with the side of a knife and discard the skin Peel (scrape the skin off with a teaspoon) your ginger","Wash your spinach , then add to a colander and pour boiled water all over it so that it starts to wilt Rinse the wilted spinach under cold running water until it's cool Once cool, squeeze as much water out of the spinach as you can","Add the wilted spinach and onion wedges to a food processor with the peeled ginger , garlic , a generous pinch of salt and a small drizzle of olive oil Add the remaining curry powder , creamed coconut and most of your coriander (reserve a few leaves for a garnish!), then blitz until smooth – this is your saag paste Tip: Add a splash of water if its looking a little dry!","Reboil a kettle Heat a large, wide-based pan (preferably non-stick) over a medium heat with a small knob of butter Once melted, add your tomato paste with the saag paste and cook for 3-4 min or until fragrant Once fragrant, add 250ml boiled water with your vegetable stock mix and cashews and cook for 5-6 min or until thickened","Once thickened, add the roast butternut squash – this is your saag butternut squash & cashew curry Strip your mint leaves from their stems and chop them roughly, discard the stems Once the rice is cooked, add your blanched peas with the chopped mint , sultanas and a pinch of salt Give everything a good mix up – this is your pea & mint pilaf","Serve the saag butternut squash & cashew curry with the pea & mint pilaf to the side Garnish with the reserved coriander leaves Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1684418748475-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1684418754270-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1684418757740-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1684418760771-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1684418763863-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1684418767003-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1684418769919-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/butternut-squash-cashew-saag-with-pea-mint-pilaf","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/butternut-squash-cashew-saag-with-pea-mint-pilaf","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["130 g","white basmati rice"],["25 g","solid creamed coconut"],["32 g","tomato paste"],["5.5 g","intense vegetable stock mix"],["1 tbsp","curry powder"],["2","garlic clove"],["15 g","fresh root ginger"],["1","brown onion"],["160 g","blanched peas"],["30 g","sultanas"],["160 g","butternut squash cubes"],["120 g","spinach"],["10 g","coriander & mint"],["25 g","cashew nuts"],["as needed","Salt"],["as needed","Olive oil"],["as needed","Water"],["as needed","Butter"]],"lunchBucket":"rice","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-a9f11ab9-d278-46c7-8860-54e51f29afb3","sourceId":"a9f11ab9-d278-46c7-8860-54e51f29afb3","title":"Japanese-Style Omurice & Shichimi Togarashi King Prawns","subtitle":"This easy omurice is a home cooking favourite across Japan.","time":25,"cost":30.5,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","japanese","rice","quick"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Saucepan","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/5962---Japanese-Style-Omurice-With-Garlic--Shichimi-Togarashi-King-Prawns1562-1686658018270-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/japanese-style-omurice-with-garlic-shichimi-togarashi-king-prawns","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["171 g","raw peeled king prawns"],["2","free range egg"],["150 g","sushi rice"],["30 ml","tomato ketchup"],["2","garlic clove"],["2 g","shichimi togarashi"],["160 g","blanched peas"],["15 g","crispy onions"],["5.5 g","vegetable stock mix"],["15 ml","soy sauce"],["as needed","Butter"],["as needed","Milk"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Sugar"],["as needed","Water"]],"sourceIngredients":[["171 g","raw peeled king prawns"],["2","free range egg"],["150 g","sushi rice"],["30 ml","tomato ketchup"],["2","garlic clove"],["2 g","shichimi togarashi"],["160 g","blanched peas"],["15 g","crispy onions"],["5.5 g","vegetable stock mix"],["15 ml","soy sauce"]],"ingredientMeta":[{"name":"raw peeled king prawns","amount":"171 g","shoppingName":"raw peeled king prawns","marketChecked":true,"priceMatchType":"source-identity"},{"name":"free range egg","amount":"2","shoppingName":"free range egg","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sushi rice","amount":"150 g","shoppingName":"sushi rice","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato ketchup","amount":"30 ml","shoppingName":"tomato ketchup","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"shichimi togarashi","amount":"2 g","shoppingName":"shichimi togarashi","marketChecked":true,"priceMatchType":"source-identity"},{"name":"blanched peas","amount":"160 g","shoppingName":"blanched peas","marketChecked":true,"priceMatchType":"source-identity"},{"name":"crispy onions","amount":"15 g","shoppingName":"crispy onions","marketChecked":true,"priceMatchType":"source-identity"},{"name":"vegetable stock mix","amount":"5.5 g","shoppingName":"vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"soy sauce","amount":"15 ml","shoppingName":"soy sauce","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Rinse your sushi rice in a sieve under cold running water for 30 secs (use your hands to really wash the grains!), then set aside to drain fully","Add the drained rice with 200ml cold water to a pot with a lid and bring to the boil over a high heat Once boiling, reduce the heat to low until very gently bubbling and cook, covered, for 15 min Once the rice has had 15 min, remove the pot from the heat and keep covered","While the rice is cooking, combine your tomato ketchup and soy sauce in a bowl with 1/2 tsp sugar – this is your soy ketchup Peel and finely slice (don't chop!) your garlic","Whisk your egg[s] and a splash of milk in a jug with a pinch of pepper – this is your omelette mix","Heat a large, wide-based pan (preferably non-stick) with a generous drizzle of olive oil and a knob of butter over a medium-high heat Once melted, drain then add your king prawns , sliced garlic and shichimi togarashi (can't handle the heat? Go easy!) and cook for 4-5 min or until cooked through – these are your garlic & shichimi togarashi king prawns","Once cooked through, transfer the garlic & shichimi togarashi king prawns (reserve the pan!) to the pot with the rice Add your vegetable stock mix and blanched peas and give everything a good mix up Cover and set aside – this is your king prawn rice","Return the reserved pan to a medium-high heat with a knob of butter Once melted, pour enough of the omelette mix into the pan in a rough circle to make 1 omelette blanket per person Cook for 20 secs or until the omelette mix is cooked all the way through, then transfer to a small plate – this is your omelette blanket","Press the king prawn rice into a bowl and turn out Top with an omelette blanket and drizzle over the soy ketchup Sprinkle over your crispy onions – this is your Japanese-style omurice with garlic & shichimi togarashi king prawns Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1681807072463-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1681807080333-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1681807085626-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1681807093392-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1681807099761-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1681807105091-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1681807110229-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/japanese-style-omurice-with-garlic-shichimi-togarashi-king-prawns","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/japanese-style-omurice-with-garlic-shichimi-togarashi-king-prawns","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["171 g","raw peeled king prawns"],["2","free range egg"],["150 g","sushi rice"],["30 ml","tomato ketchup"],["2","garlic clove"],["2 g","shichimi togarashi"],["160 g","blanched peas"],["15 g","crispy onions"],["5.5 g","vegetable stock mix"],["15 ml","soy sauce"],["as needed","Butter"],["as needed","Milk"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Sugar"],["as needed","Water"]],"lunchBucket":"rice","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-e2bba37d-c019-4c2d-a3d4-d78575090aec","sourceId":"e2bba37d-c019-4c2d-a3d4-d78575090aec","title":"Mediterranean-Style Chicken Gyros With Tzatziki Mayo","subtitle":"Embrace the flavours of the Aegean Islands with warmed naans and pan-fried chicken.","time":10,"cost":20.32,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","mediterranean","wrap","quick"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-4883-2-Mediterranean-Style-Chicken-Gyros-with-Tzatziki-Mayo-1289-1678179781409-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/mediterranean-style-chicken-gyros-with-tzatziki-mayo","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","plain naan"],["250 g","chicken breast strips"],["1 tsp","ground sumac"],["8 ml","soy sauce"],["50 ml","mayonnaise"],["2 tsp","ground smoked paprika"],["1","tomato"],["5 g","parsley"],["1","lemon"],["1","cucumber"],["1","gem lettuce"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"]],"sourceIngredients":[["1","plain naan"],["250 g","chicken breast strips"],["1 tsp","ground sumac"],["8 ml","soy sauce"],["50 ml","mayonnaise"],["2 tsp","ground smoked paprika"],["1","tomato"],["5 g","parsley"],["1","lemon"],["1","cucumber"],["1","gem lettuce"]],"ingredientMeta":[{"name":"plain naan","amount":"1","shoppingName":"plain naan","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chicken breast strips","amount":"250 g","shoppingName":"chicken breast strips","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground sumac","amount":"1 tsp","shoppingName":"ground sumac","marketChecked":true,"priceMatchType":"source-identity"},{"name":"soy sauce","amount":"8 ml","shoppingName":"soy sauce","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mayonnaise","amount":"50 ml","shoppingName":"mayonnaise","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground smoked paprika","amount":"2 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato","amount":"1","shoppingName":"tomato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"parsley","amount":"5 g","shoppingName":"parsley","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lemon","amount":"1","shoppingName":"lemon","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cucumber","amount":"1","shoppingName":"cucumber","marketChecked":true,"priceMatchType":"source-identity"},{"name":"gem lettuce","amount":"1","shoppingName":"gem lettuce","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you begin... Get all your ingredients and equipment ready Skim through these steps, then wash your fruit and veg Note: Equipment and pan sizes vary. Make sure you cook your food thoroughly (even if it takes you a little longer than 10 min)","Now, let's get started! Take your chicken out of the fridge, open the packet and let it air Heat a large, wide-based pan (preferably non-stick) with a drizzle of olive oil over a high heat Once hot, add your chicken with your soy sauce and the juice of half your lemon[s] (Doubled your protein? Use 2 pans!)","Sprinkle your ground smoked paprika over the chicken and cook for 5-6 min on each side or until cooked through (no pink meat!) – this is your Mediterranean-style chicken","While the chicken is cooking, roughly chop your tomato[es] Chop half your cucumber (you'll use the rest later!) into small, bite-sized pieces Chop your parsley roughly, including the stalks","Combine the diced tomato and chopped cucumber in a bowl with half the chopped parsley , half your ground sumac (save the rest for later!), a pinch of salt and pepper and a drizzle of olive oil and give everything a good mix up – this is your Greek-style salad Add your naan[s] to a toaster for 1-2 min or until warmed through","Meanwhile, cut the remaining cucumber in half lengthways, scrape out the inner seeds with a teaspoon and discard the inner seeds Grate the deseeded cucumber and squeeze out any excess water Combine your mayo and grated cucumber in a bowl with the juice of the remaining lemon , the remaining ground sumac and a pinch of salt and pepper – this is your tzatziki mayo","Wash your lettuce , then pat dry with kitchen paper and roughly shred Dress the shredded lettuce with a drizzle of olive oil","Load up the warmed naan with the Greek-style salad and Mediterranean-style chicken – this is your Mediterranean-style chicken gyros Dollop over the tzatziki mayo and garnish with the remaining chopped parsley Serve the dressed shredded lettuce to the side Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Admin10mm-Step-1-1678900717112-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-copy-2-1681210882213-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-copy-2-1681210890811-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-copy-2-1681210934297-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-copy-2-1681210942365-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-copy-2-1681210946811-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-17-1748340325077-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/mediterranean-style-chicken-gyros-with-tzatziki-mayo","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/mediterranean-style-chicken-gyros-with-tzatziki-mayo","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","plain naan"],["250 g","chicken breast strips"],["1 tsp","ground sumac"],["8 ml","soy sauce"],["50 ml","mayonnaise"],["2 tsp","ground smoked paprika"],["1","tomato"],["5 g","parsley"],["1","lemon"],["1","cucumber"],["1","gem lettuce"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"]],"lunchBucket":"wrap","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-05f2da7b-a15a-4d47-bd04-5c8c8fa314a8","sourceId":"05f2da7b-a15a-4d47-bd04-5c8c8fa314a8","title":"Sausage, Pepper & Potato Hash With Herby Chilli Dressing","subtitle":"This crowd-pleaser is a tasty addition to your weekly rotation.","time":30,"cost":15.72,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","british","potato","quick"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Saucepan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/6117_Sausage-Red-Pepper-_-Potato-Hash-With-Herby-Chilli-Dressing-8835-1687860896972-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/sausage-pepper-potato-hash-with-herby-chilli-dressing","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","green chilli"],["1","red pepper"],["1","Proper Porker sausages"],["2","garlic clove"],["5 g","parsley"],["160 g","blanched peas"],["30 g","balsamic sun-dried tomato paste"],["15 ml","white wine vinegar"],["1","red onion"],["3","white potato"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"]],"sourceIngredients":[["1","green chilli"],["1","red pepper"],["1","Proper Porker sausages"],["2","garlic clove"],["5 g","parsley"],["160 g","blanched peas"],["30 g","balsamic sun-dried tomato paste"],["15 ml","white wine vinegar"],["1","red onion"],["3","white potato"]],"ingredientMeta":[{"name":"green chilli","amount":"1","shoppingName":"green chilli","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red pepper","amount":"1","shoppingName":"red pepper","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Proper Porker sausages","amount":"1","shoppingName":"Proper Porker sausages","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"parsley","amount":"5 g","shoppingName":"parsley","marketChecked":true,"priceMatchType":"source-identity"},{"name":"blanched peas","amount":"160 g","shoppingName":"blanched peas","marketChecked":true,"priceMatchType":"source-identity"},{"name":"balsamic sun-dried tomato paste","amount":"30 g","shoppingName":"balsamic sun-dried tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white wine vinegar","amount":"15 ml","shoppingName":"white wine vinegar","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white potato","amount":"3","shoppingName":"white potato","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Boil a kettle Peel your potatoes and chop them into small, bite-sized pieces Add the chopped potatoes to a pot with plenty of boiled water and a pinch of salt and bring to the boil over a high heat Once boiling, reduce the heat to medium and cook for 10-12 min or until fork-tender, then drain and set aside to steam dry","Whilst the potatoes are cooking, chop your parsley finely, including the stalks Cut your green chilli[es] in half lengthways, deseed (scrape the seeds out with a teaspoon) and chop finely Peel and finely chop (or grate) your garlic","Peel and finely slice your red onion[s] Deseed your pepper[s] (scrape the seeds and pith out with a teaspoon) and dice","Heat a large, wide-based pan (preferably non-stick) over a high heat Squeeze your sausage meat from the skins into the pan (clean hands is the best way!) and discard the skins Break the sausage meat up into bite-sized pieces with a wooden spoon, add the sliced onion and cook for 5-7 min or until the sausage meat has browned and the onion has softened","Meanwhile, combine the chopped parsley and chopped chilli (can't handle the heat? Go easy!) in a small bowl with half the chopped garlic (you'll use the rest later!), your white wine vinegar , 2 tbsp olive oil and a pinch of salt Give everything a good mix up – this is your herby chilli dressing","Once the sausage meat has browned, add the diced pepper to the pan and cook for a further 2-3 min or until beginning to soften Once softened, add the drained potatoes and cook, stirring occasionally, for 5-6 min or until golden and the sausage meat has cooked through (no pink meat!)","Once the potatoes are golden, add the remaining chopped garlic with your balsamic sun-dried tomato paste , blanched peas and a grind of black pepper Cook for a further 1-2 min or until warmed through – this is your sausage , pepper & potato hash","Serve the sausage , pepper & potato hash with the herby chilli dressing drizzled all over Taste for seasoning, adding more salt and pepper if needed Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1688738557674-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1688738560477-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1688738563338-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1688738566494-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1688738569740-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1688738573003-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1688738576310-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/sausage-pepper-potato-hash-with-herby-chilli-dressing","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/sausage-pepper-potato-hash-with-herby-chilli-dressing","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","green chilli"],["1","red pepper"],["1","Proper Porker sausages"],["2","garlic clove"],["5 g","parsley"],["160 g","blanched peas"],["30 g","balsamic sun-dried tomato paste"],["15 ml","white wine vinegar"],["1","red onion"],["3","white potato"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"]],"lunchBucket":"potato","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-6e1d136f-75b0-47f0-88d5-e773a9262b87","sourceId":"6e1d136f-75b0-47f0-88d5-e773a9262b87","title":"Chermoula Free Range Chicken With Giant Couscous","subtitle":"Pump up the flavour of your free range chicken with chermoula, a smoky, parsley-packed paste from Algeria.","time":30,"cost":24.07,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","moroccan","grain","quick"],"requiredEquipment":["food-processor"],"sourceEquipment":["Frying pan","Saucepan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/4321_Chermoula-Chicken-with-Spiced-Giant-Couscous_001_0-1654533093493-1695033542285-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/chermoula-free-range-chicken-with-spiced-giant-couscous","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","free range chicken breast portions"],["1 tsp","ground paprika"],["1 tsp","ground cumin"],["0.5 tsp","cayenne pepper"],["20 g","chipotle paste"],["2","garlic clove"],["10 g","coriander"],["5 g","parsley"],["1","lemon"],["30 g","sultanas"],["130 g","giant couscous"],["1","carrot"],["1","red onion"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"sourceIngredients":[["1","free range chicken breast portions"],["1 tsp","ground paprika"],["1 tsp","ground cumin"],["0.5 tsp","cayenne pepper"],["20 g","chipotle paste"],["2","garlic clove"],["10 g","coriander"],["5 g","parsley"],["1","lemon"],["30 g","sultanas"],["130 g","giant couscous"],["1","carrot"],["1","red onion"]],"ingredientMeta":[{"name":"free range chicken breast portions","amount":"1","shoppingName":"free range chicken breast portions","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground paprika","amount":"1 tsp","shoppingName":"ground paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground cumin","amount":"1 tsp","shoppingName":"ground cumin","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cayenne pepper","amount":"0.5 tsp","shoppingName":"cayenne pepper","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chipotle paste","amount":"20 g","shoppingName":"chipotle paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"coriander","amount":"10 g","shoppingName":"coriander","marketChecked":true,"priceMatchType":"source-identity"},{"name":"parsley","amount":"5 g","shoppingName":"parsley","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lemon","amount":"1","shoppingName":"lemon","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sultanas","amount":"30 g","shoppingName":"sultanas","marketChecked":true,"priceMatchType":"source-identity"},{"name":"giant couscous","amount":"130 g","shoppingName":"giant couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"carrot","amount":"1","shoppingName":"carrot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you start cooking, take your chicken out of the fridge, open the packet and let it air Boil a kettle Peel your garlic Cut your free range chicken breast portion[s] into bite-sized pieces","Add your parsley and coriander (including the stalks!) with the peeled garlic and juice of half your lemon to a food processor Add your ground cumin , ground paprika , cayenne pepper (can't handle the heat? Go easy!) with 3 tbsp olive oil and a pinch of salt and pepper Blitz until smooth – this is your chermoula Tip: If you don’t have a food processor, use a pestle & mortar!","Add the chopped chicken to a bowl with the chermoula and give everything a good mix up, until the chicken is completely coated Set aside to marinate Chop your sultanas roughly Add the chopped sultanas to a bowl, cover them with boiled water and set them aside to soak","Add your giant couscous to a pot of boiled water with a pinch of salt and bring to the boil over a high heat Cook the giant couscous for 8 min or until tender with a slight bite, then drain and return to the pot","Meanwhile, peel and chop your red onion[s] into wedges and separate the wedges into petals Heat a large, wide-based pan (preferably non-stick) with a drizzle of olive oil over a medium-high heat Once hot, add the onion petals with a pinch of salt and cook for 5-8 min or until starting to caramelise","Top, tail, peel and grate your carrot[s] and cut the remaining lemon into wedges Drain the soaked sultanas Add the onion petals (reserve the pan), grated carrot , drained sultanas , chipotle paste (not a fan of spice? Just add a little!) and the juice of half the lemon wedges to the drained couscous Give everything a good mix up – this is your spiced giant couscous","Wipe the reserved pan clean and return it to a high heat with a drizzle of olive oil Once hot, add the marinated chicken with all of the chermoula and cook for 10-12 min or until cooked through (no pink meat!) – this is your chermoula chicken","Serve the chermoula free range chicken over the spiced giant couscous Drizzle over any remaining chermoula from the pan with the chicken and garnish with a lemon wedge Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1695645593913-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1695645598013-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1695645602348-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1695645607087-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1695645612094-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1695645615717-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1695645619500-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/chermoula-free-range-chicken-with-spiced-giant-couscous","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/chermoula-free-range-chicken-with-spiced-giant-couscous","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","free range chicken breast portions"],["1 tsp","ground paprika"],["1 tsp","ground cumin"],["0.5 tsp","cayenne pepper"],["20 g","chipotle paste"],["2","garlic clove"],["10 g","coriander"],["5 g","parsley"],["1","lemon"],["30 g","sultanas"],["130 g","giant couscous"],["1","carrot"],["1","red onion"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-aee23de2-8195-4b99-a103-da0c41f6dfcd","sourceId":"aee23de2-8195-4b99-a103-da0c41f6dfcd","title":"Moroccan-Style Chicken Breast Traybake With Garlic Yoghurt","subtitle":"This all-in-one traybake is easy peasy.","time":35,"cost":24.48,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","moroccan","other","cook"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/5228_Moroccan-Style-Chicken-Traybake-With-Garlic-Yoghurt_001_0-1672940393575-1695032983901-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/moroccan-style-chicken-breast-traybake-with-garlic-yoghurt","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["5.5 g","chicken stock mix"],["1","red pepper"],["1","chicken breast portions"],["80 g","couscous"],["1 tbsp","ras el hanout"],["2","garlic clove"],["5 g","parsley"],["80 g","natural yoghurt"],["15 ml","white wine vinegar"],["1","red onion"],["1","sweet potato"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"],["as needed","Water"]],"sourceIngredients":[["5.5 g","chicken stock mix"],["1","red pepper"],["1","chicken breast portions"],["80 g","couscous"],["1 tbsp","ras el hanout"],["2","garlic clove"],["5 g","parsley"],["80 g","natural yoghurt"],["15 ml","white wine vinegar"],["1","red onion"],["1","sweet potato"]],"ingredientMeta":[{"name":"chicken stock mix","amount":"5.5 g","shoppingName":"chicken stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red pepper","amount":"1","shoppingName":"red pepper","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chicken breast portions","amount":"1","shoppingName":"chicken breast portions","marketChecked":true,"priceMatchType":"source-identity"},{"name":"couscous","amount":"80 g","shoppingName":"couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ras el hanout","amount":"1 tbsp","shoppingName":"ras el hanout","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"parsley","amount":"5 g","shoppingName":"parsley","marketChecked":true,"priceMatchType":"source-identity"},{"name":"natural yoghurt","amount":"80 g","shoppingName":"natural yoghurt","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white wine vinegar","amount":"15 ml","shoppingName":"white wine vinegar","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sweet potato","amount":"1","shoppingName":"sweet potato","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7 Boil half a kettle Take your chicken out of the fridge and open the packet to let it air Peel and chop your sweet potato[es] into bite-sized pieces Deseed your pepper[s] (scrape the seeds and pith out with a teaspoon) and cut into bite-sized pieces","Peel and finely slice half your red onion[s] , then chop the remaining red onion into wedges Peel and finely grate (don't chop!) your garlic Add the sliced onion to a small bowl, cover with boiled water and set aside – this is your softened sliced onion","Add your chicken and chopped sweet potato to a baking tray (or two!) with the chopped pepper , onion wedges and 2/3 of the grated garlic (you'll use the rest later!) Add your ras el hanout and a drizzle of olive oil to the tray[s] with a generous pinch of salt and give everything a good mix up Put the tray[s] in the oven for 20-25 min or until the chicken is golden and cooked through (no pink meat!) and the veg is tender (Doubled your protein? Use 2 trays!)","While the chicken is cooking, combine your natural yoghurt with the remaining grated garlic (not a big garlic fan? Try using less!) in a bowl Season with a pinch of salt and pepper – this your garlic yoghurt","Add your couscous and chicken stock mix to a heatproof bowl with 130ml boiled water and a pinch of salt and mix it all together, then cover and set aside to soften Fluff with a fork before serving","Drain and rinse the softened sliced onion in a sieve under the cold running water until it's cool Once cooled, return it to the bowl and add your white wine vinegar and a pinch of salt and sugar Stir it all together and set aside for later – this is your quick-pickled onion Chop your parsley finely, including the stalks","Once the chicken and veg are done, remove the tray[s] from the oven and add the couscous Give everything a good mix up – this is your Moroccan-style chicken traybake","Serve the Moroccan-style chicken traybake with the garlic yoghurt dolloped over Garnish with the quick-pickled onion and chopped parsley Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1672853653394-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1672853656147-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1672853659881-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1672853663249-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1672853667095-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1672853670175-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1672853673793-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/moroccan-style-chicken-breast-traybake-with-garlic-yoghurt","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/moroccan-style-chicken-breast-traybake-with-garlic-yoghurt","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["5.5 g","chicken stock mix"],["1","red pepper"],["1","chicken breast portions"],["80 g","couscous"],["1 tbsp","ras el hanout"],["2","garlic clove"],["5 g","parsley"],["80 g","natural yoghurt"],["15 ml","white wine vinegar"],["1","red onion"],["1","sweet potato"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"],["as needed","Water"]],"lunchBucket":"other","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-fb3f6e5c-1d6b-467c-ad4b-5959f795ed0a","sourceId":"fb3f6e5c-1d6b-467c-ad4b-5959f795ed0a","title":"Smoky Basa, Potato & Pepper Traybake With Mojo Rojo Sauce","subtitle":"This easy traybake is an absolute smoke show.","time":40,"cost":27.36,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","spanish","other","cook"],"requiredEquipment":["food-processor"],"sourceEquipment":["Oven","Baking tray"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/6236---Smoky-Basa-Potato--Pepper-Traybake-With-Mojo-Rojo-Sauce2163-1697473343866-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/smoky-basa-potato-pepper-traybake-with-mojo-rojo-sauce","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","red pepper"],["1","yellow pepper"],["1","basa fillets"],["1 tsp","ground cumin"],["1 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["1","garlic clove"],["5.5 g","vegetable stock mix"],["80 g","fine green beans"],["15 ml","red wine vinegar"],["1","red onion"],["4","white potato"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"sourceIngredients":[["1","red pepper"],["1","yellow pepper"],["1","basa fillets"],["1 tsp","ground cumin"],["1 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["1","garlic clove"],["5.5 g","vegetable stock mix"],["80 g","fine green beans"],["15 ml","red wine vinegar"],["1","red onion"],["4","white potato"]],"ingredientMeta":[{"name":"red pepper","amount":"1","shoppingName":"red pepper","marketChecked":true,"priceMatchType":"source-identity"},{"name":"yellow pepper","amount":"1","shoppingName":"yellow pepper","marketChecked":true,"priceMatchType":"source-identity"},{"name":"basa fillets","amount":"1","shoppingName":"basa fillets","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground cumin","amount":"1 tsp","shoppingName":"ground cumin","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground smoked paprika","amount":"1 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mayonnaise","amount":"25 ml","shoppingName":"mayonnaise","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"vegetable stock mix","amount":"5.5 g","shoppingName":"vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"fine green beans","amount":"80 g","shoppingName":"fine green beans","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red wine vinegar","amount":"15 ml","shoppingName":"red wine vinegar","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white potato","amount":"4","shoppingName":"white potato","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7, then chop your potatoes (skins on) into large, bite-sized pieces Deseed your peppers (scrape the seeds and pith out with a teaspoon) and roughly chop (keep the colours separate!) Peel and chop your red onion[s] into wedges Crush your garlic open by squashing it with the side of a knife and discard the skin","Add the chopped potato and chopped yellow pepper to a baking tray (or two!) with the onion wedges , half your ground smoked paprika (save the rest for later!), a pinch of salt and a drizzle of olive oil Give everything a good mix up and put the tray[s] in the oven for an initial 20 min – these are your roasted veggies","While the vegetables are roasting, add the chopped red pepper to a separate, tin foil -lined baking tray, then scrunch the sides up to create a parcel Add the peeled garlic , ground cumin , a drizzle of olive oil and a pinch of salt and pepper to the parcel and give everything a good mix up Put the tray in the oven for 20 min or until the pepper is softened and golden – this is your roasted pepper mix","Meanwhile, trim your green beans Cut the trimmed green beans in half","Pat the fish fillet[s] dry with the kitchen paper, then evenly sprinkle the remaining ground smoked paprika over the fish – this is your smoky fish","After an initial 20 min, remove the tray[s] with the roasted veggies from the oven and add the chopped green beans and smoky fish with a drizzle of olive oil and a pinch of salt and pepper Return the tray[s] to the oven for a further 12-15 min or until the fish is cooked through – this is your smoky fish, potato & pepper traybake Tip: Your fish is cooked once it turns opaque and flakes easily (Doubled your protein? Do this in batches!)","Transfer the roasted pepper mix to a food processor with your red wine vinegar , 2 tsp sugar and your vegetable stock mix and blitz until smooth – this is your mojo rojo sauce","Serve the smoky fish, potato & pepper traybake Drizzle over the mojo rojo sauce and mayo Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1690280582468-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1690280612727-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1690280638100-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1690280651136-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1690280664059-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1690280674158-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1690280712229-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/smoky-basa-potato-pepper-traybake-with-mojo-rojo-sauce","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/smoky-basa-potato-pepper-traybake-with-mojo-rojo-sauce","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","red pepper"],["1","yellow pepper"],["1","basa fillets"],["1 tsp","ground cumin"],["1 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["1","garlic clove"],["5.5 g","vegetable stock mix"],["80 g","fine green beans"],["15 ml","red wine vinegar"],["1","red onion"],["4","white potato"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"lunchBucket":"other","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-22ce8ba8-85b3-4374-a0cb-8c483b9ce63c","sourceId":"22ce8ba8-85b3-4374-a0cb-8c483b9ce63c","title":"Free Range Chicken Grain Bowl With Zingy Cashew Sauce","subtitle":"Our punchy cashew sauce is the star of this super green grain bowl.","time":30,"cost":21.78,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fusion","grain","quick"],"requiredEquipment":["food-processor"],"sourceEquipment":["Frying pan","Saucepan","Kettle","Mixing bowl","Colander"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/4430_Chicken-Grain-Bowl-With-Zingy-Cashew-Sauce_003_0-1698241318412-1698669591677-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/free-range-chicken-grain-bowl-with-zingy-cashew-sauce","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","free range chicken breast portions"],["1","garlic clove"],["160 g","blanched peas"],["5.5 g","chicken stock mix"],["80 g","spinach"],["1","lime"],["10 g","coriander & mint"],["25 g","cashew nuts"],["130 g","bulgur wheat"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"],["as needed","Water"]],"sourceIngredients":[["1","free range chicken breast portions"],["1","garlic clove"],["160 g","blanched peas"],["5.5 g","chicken stock mix"],["80 g","spinach"],["1","lime"],["10 g","coriander & mint"],["25 g","cashew nuts"],["130 g","bulgur wheat"]],"ingredientMeta":[{"name":"free range chicken breast portions","amount":"1","shoppingName":"free range chicken breast portions","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"blanched peas","amount":"160 g","shoppingName":"blanched peas","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chicken stock mix","amount":"5.5 g","shoppingName":"chicken stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"spinach","amount":"80 g","shoppingName":"spinach","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lime","amount":"1","shoppingName":"lime","marketChecked":true,"priceMatchType":"source-identity"},{"name":"coriander & mint","amount":"10 g","shoppingName":"coriander & mint","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cashew nuts","amount":"25 g","shoppingName":"cashew nuts","marketChecked":true,"priceMatchType":"source-identity"},{"name":"bulgur wheat","amount":"130 g","shoppingName":"bulgur wheat","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you start cooking, take your chicken out of the fridge, open the packet and let it air Boil a kettle Strip your mint leaves from their stems, discard the stems Add your cashew nuts to a small bowl, cover them with boiled water and set aside to soften","Peel and finely chop half of your garlic (save the other half for later!) Cut your lime[s] in half","Season your free range chicken breast portion[s] on both sides with salt and pepper Heat a large, wide-based pan (preferably non-stick with a matching lid) over a medium-high heat","Once hot, add the chicken breast portion[s] and cook for 3 min on each side or until golden Once golden, reduce the heat to medium and add the chopped garlic and a couple of splashes of water to the pan Cover with a lid and cook for a further 12-15 min or until the chicken is cooked through (no pink meat!)","While the chicken is cooking, add your bulgur wheat , chicken stock mix and a pinch of salt to a pot with a lid with 200ml boiled water Bring to the boil over a high heat and once boiling, reduce the heat to medium then cook, covered, for 7-9 min or until almost all the water has absorbed Once done, remove the pot from the heat, fluff with a fork and set aside until later","Meanwhile, wash your spinach and pat it dry with kitchen paper Drain the soaked cashews and add them to a food processor with the mint leaves (save a few for garnish!), coriander , the juice of the lime[s] , a handful of spinach (you'll use the rest later!) and the remaining garlic Add 1 tbsp olive oil , 1 tbsp cold water , 1/2 tsp sugar and a generous pinch of salt and pepper and blitz until smooth – this is your zingy cashew sauce","Add your blanched peas to a colander and pour boiled water all over them to refresh them Stir the refreshed peas , remaining spinach and half of the zingy cashew sauce (save the rest for later!) through the cooked bulgur – this is your spinach & pea bulgur Slice the cooked chicken on a clean board","Serve the sliced chicken over the spinach & pea bulgur Drizzle over the remaining zingy cashew sauce Season with a grind of black pepper Garnish with the remaining mint leaves Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1655976694968-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1655976699844-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1655976704286-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1655976708779-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1655976713174-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1655976717746-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1655976721518-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/free-range-chicken-grain-bowl-with-zingy-cashew-sauce","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/free-range-chicken-grain-bowl-with-zingy-cashew-sauce","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","free range chicken breast portions"],["1","garlic clove"],["160 g","blanched peas"],["5.5 g","chicken stock mix"],["80 g","spinach"],["1","lime"],["10 g","coriander & mint"],["25 g","cashew nuts"],["130 g","bulgur wheat"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"],["as needed","Water"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-c5ca69db-856e-4bdc-8827-f7c92052f1c1","sourceId":"c5ca69db-856e-4bdc-8827-f7c92052f1c1","title":"Roasted Aubergine With Spiced Pepper Relish & Giant Couscous","subtitle":"Bring on the veg.","time":30,"cost":23.69,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fusion","grain","quick"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Frying pan","Saucepan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-6234-2-Roasted-Aubergine-With-Spiced-Pepper-Relish--Giant-Couscous-1_0-1699368488270-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/roast-aubergine-with-spiced-pepper-relish-giant-couscous","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","red pepper"],["1 tsp","cumin seeds"],["1 tbsp","ras el hanout"],["1","garlic clove"],["1","courgette"],["30 g","feta"],["5.5 g","vegetable stock mix"],["20 g","harissa paste"],["130 g","giant couscous"],["10 g","coriander & mint"],["1","aubergine"],["15 g","flaked almonds"],["20 g","sweet pepper relish"],["1","red onion"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"],["as needed","Water"]],"sourceIngredients":[["1","red pepper"],["1 tsp","cumin seeds"],["1 tbsp","ras el hanout"],["1","garlic clove"],["1","courgette"],["30 g","feta"],["5.5 g","vegetable stock mix"],["20 g","harissa paste"],["130 g","giant couscous"],["10 g","coriander & mint"],["1","aubergine"],["15 g","flaked almonds"],["20 g","sweet pepper relish"],["1","red onion"]],"ingredientMeta":[{"name":"red pepper","amount":"1","shoppingName":"red pepper","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cumin seeds","amount":"1 tsp","shoppingName":"cumin seeds","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ras el hanout","amount":"1 tbsp","shoppingName":"ras el hanout","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"courgette","amount":"1","shoppingName":"courgette","marketChecked":true,"priceMatchType":"source-identity"},{"name":"feta","amount":"30 g","shoppingName":"feta","marketChecked":true,"priceMatchType":"source-identity"},{"name":"vegetable stock mix","amount":"5.5 g","shoppingName":"vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"harissa paste","amount":"20 g","shoppingName":"harissa paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"giant couscous","amount":"130 g","shoppingName":"giant couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"coriander & mint","amount":"10 g","shoppingName":"coriander & mint","marketChecked":true,"priceMatchType":"source-identity"},{"name":"aubergine","amount":"1","shoppingName":"aubergine","marketChecked":true,"priceMatchType":"source-identity"},{"name":"flaked almonds","amount":"15 g","shoppingName":"flaked almonds","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sweet pepper relish","amount":"20 g","shoppingName":"sweet pepper relish","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 200°C/ 180°C (fan)/ gas 6, then trim the green stalk[s] off your aubergine[s] and cut in half lengthways Score the aubergine flesh with a knife in a criss-cross pattern, then rub the flesh with your ras el hanout , a generous drizzle of olive oil and a generous pinch of salt Add the aubergine halves to a tin foil -lined baking tray (or two!), cut-side up and put in the oven for 20-25 min or until slightly charred","While the aubergine is cooking, peel and finely chop (or grate) your garlic Peel and finely dice your red onion[s] Deseed your pepper[s] (scrape the seeds and pith out with a teaspoon) and finely dice Top, tail and chop your courgette[s] into quarters lengthways, then chop into small bite-sized pieces","Heat a large, wide-based pan (preferably non-stick) over a medium heat with a generous drizzle of olive oil and boil a kettle Once hot, add the diced onion , diced pepper , chopped courgette and chopped garlic with a pinch of salt and pepper and cook for 8-10 min, stirring frequently, or until beginning to soften Once softened, remove the pan from the heat and set aside – these are your softened vegetables","Heat a medium, dry pot over a medium heat, once hot, add your cumin seeds and toast for 1-2 min or until fragrant (watch them like a hawk to make sure they don’t burn!) Once fragrant, transfer the toasted cumin seeds to a small heat proof bowl (reserve the pot!) Add your sweet pepper relish and harissa paste (can’t handle the heat? Go easy!) to the bowl with 4 tbsp cold water and 1 tbsp olive oil and mix it all together – this is your spiced pepper relish","Add your giant couscous to the reserved pot with plenty of boiled water and bring to the boil over a high heat Cook for 8 min or until tender with a slight bite, then drain","While the couscous is cooking, chop your coriander finely, including the stalks Strip your mint leaves from their stems and chop them roughly, discard the stems Crumble your feta into rough bite-sized pieces","Add your flaked almonds to a baking tray and put the tray in the oven for 2-3 min or until toasted and lightly golden Tip: Watch them like a hawk to make sure they don’t burn! Add the drained couscous to the softened vegetables with half the chopped herbs (you'll use the rest later!) and vegetable stock mix and mix it all together – this is your veg-packed giant couscous","Serve the roasted aubergine on top of the veg-packed giant couscous Top with the remaining chopped herbs , crumbled feta , spiced pepper relish and toasted almonds Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1692973050610-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1692973054052-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1692973058207-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1692973061535-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1692973065360-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1692973068559-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1692973072319-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/roast-aubergine-with-spiced-pepper-relish-giant-couscous","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/roast-aubergine-with-spiced-pepper-relish-giant-couscous","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","red pepper"],["1 tsp","cumin seeds"],["1 tbsp","ras el hanout"],["1","garlic clove"],["1","courgette"],["30 g","feta"],["5.5 g","vegetable stock mix"],["20 g","harissa paste"],["130 g","giant couscous"],["10 g","coriander & mint"],["1","aubergine"],["15 g","flaked almonds"],["20 g","sweet pepper relish"],["1","red onion"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"],["as needed","Water"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-072c6f55-e692-4a0a-af99-f72851c55d69","sourceId":"072c6f55-e692-4a0a-af99-f72851c55d69","title":"Curried Lentil & Free Range Chicken Soup With Garlic Roti","subtitle":"Give your go-to chicken soup a bit of Indian flavour.","time":35,"cost":24.4,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fusion","soup","cook"],"requiredEquipment":["blender"],"sourceEquipment":["Oven","Baking tray","Saucepan","Kettle","Mixing bowl","Grater","Blender"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/5084_Curried-Lentil--Chicken-Soup-With-Garlic-Roti_002_0-1667321751227-1702990036771-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/curried-lentil-free-range-chicken-soup-with-garlic-roti","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","free range chicken breast portions"],["32 g","tomato paste"],["1","roti"],["5.5 g","intense chicken stock mix"],["1 tbsp","curry powder"],["3","garlic clove"],["1","brown onion"],["100 g","red lentils"],["2","carrot"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Butter"],["as needed","Olive oil"],["as needed","Water"]],"sourceIngredients":[["1","free range chicken breast portions"],["32 g","tomato paste"],["1","roti"],["5.5 g","intense chicken stock mix"],["1 tbsp","curry powder"],["3","garlic clove"],["1","brown onion"],["100 g","red lentils"],["2","carrot"]],"ingredientMeta":[{"name":"free range chicken breast portions","amount":"1","shoppingName":"free range chicken breast portions","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"32 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"roti","amount":"1","shoppingName":"roti","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense chicken stock mix","amount":"5.5 g","shoppingName":"intense chicken stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"curry powder","amount":"1 tbsp","shoppingName":"curry powder","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"3","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"brown onion","amount":"1","shoppingName":"brown onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red lentils","amount":"100 g","shoppingName":"red lentils","marketChecked":true,"priceMatchType":"source-identity"},{"name":"carrot","amount":"2","shoppingName":"carrot","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7 Take your chicken out of the fridge, open the packet and let it air Peel and finely dice half your brown onion[s] Cut the remaining onion into wedges Top, tail and slice your carrot[s] into discs","Heat a large, wide-based pot (with a matching lid) with a little drizzle of olive oil over a medium heat Once hot, add the diced onion and carrot discs and cook for 4-6 min or until the onion is softened and slightly golden Rinse your red lentils in a sieve under cold running water","Meanwhile, add the onion wedges to a tin foil -lined baking tray (or two!) and sprinkle over a pinch of your curry powder (you'll use the rest later) with 1 tsp sugar and a little drizzle of olive oil Add your free range chicken breast portion[s] to the other side of the tray[s] Put the tray[s] in the oven for 18-20 min or until the chicken is cooked through (no pink meat!) and the onion wedges are caramelised and slightly charred – this is your roasted chicken & onion","Boil a full kettle Peel and finely chop (or grate) your garlic Once the onion is softened, add a knob of butter to the pot with your tomato paste , the remaining curry powder and half your chopped garlic (you'll use the rest later!) Give everything a good mix up, season with a generous pinch of salt and pepper and cook for 1-2 min or until fragrant","Once fragrant, add your rinsed lentils with 650ml boiled water and your chicken stock mix to the pot and bring to the boil over a high heat Once boiling, reduce the heat to low and cook covered for 15-20 min or until the lentils and carrot[s] are softened Once softened, remove the pot from the heat and blitz with a (stick) blender until smooth, then return to a low heat to keep warm – this is your curried lentil soup","Once the chicken is cooked through, transfer the cooked chicken to a clean board, reserve the tray[s] and shred apart using two forks – this technique is known as 'pulling' Separate the roasted onion into petals – these are your tandoori-style onion petals","Combine 1 tbsp olive oil and the remaining chopped garlic in a small bowl with a small pinch of salt – this is your garlic oil Discard the tin foil then add your roti to the reserved baking tray[s] Spread the garlic oil over the roti until evenly coated Put the tray[s] in the oven for 3-4 min or until warmed through – this is your garlic roti","Serve the curried lentil soup and taste for seasoning, adding more salt and pepper if needed Top with the pulled chicken and tandoori-style onion petals – this is your curried lentil & free range chicken soup Serve the garlic roti to the side Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1702380015506-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1702380020523-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1702380025386-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1702380029919-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1702380034954-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1702380040043-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1702380045239-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/curried-lentil-free-range-chicken-soup-with-garlic-roti","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/curried-lentil-free-range-chicken-soup-with-garlic-roti","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","free range chicken breast portions"],["32 g","tomato paste"],["1","roti"],["5.5 g","intense chicken stock mix"],["1 tbsp","curry powder"],["3","garlic clove"],["1","brown onion"],["100 g","red lentils"],["2","carrot"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Butter"],["as needed","Olive oil"],["as needed","Water"]],"lunchBucket":"soup","isLunch":true,"prepStyle":"cook","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-4edbebed-d1ff-4c9a-8c11-08de4bcfdad9","sourceId":"4edbebed-d1ff-4c9a-8c11-08de4bcfdad9","title":"Oven Baked Moroccan-Style Chicken Breast With Couscous","subtitle":"This cinch of a chicken recipe will fill your home with the aromas and tastes of Morocco.","time":30,"cost":24.95,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fusion","grain","quick"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Frying pan","Kettle","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/6505_Oven-Baked-Moroccan-Style-Chicken-Breast-With-Creamy-Couscous_001_0-1707304593093-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/oven-baked-moroccan-style-chicken-breast-with-creamy-couscous","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1 tsp","ground turmeric"],["1","chicken breast portions"],["1 tbsp","ras el hanout"],["5.5 g","intense chicken stock mix"],["1","garlic clove"],["2","tomato"],["80 g","natural yoghurt"],["30 g","feta"],["130 g","giant couscous"],["5 g","mint"],["80 g","spinach"],["1","red onion"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"],["as needed","Water"]],"sourceIngredients":[["1 tsp","ground turmeric"],["1","chicken breast portions"],["1 tbsp","ras el hanout"],["5.5 g","intense chicken stock mix"],["1","garlic clove"],["2","tomato"],["80 g","natural yoghurt"],["30 g","feta"],["130 g","giant couscous"],["5 g","mint"],["80 g","spinach"],["1","red onion"]],"ingredientMeta":[{"name":"ground turmeric","amount":"1 tsp","shoppingName":"ground turmeric","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chicken breast portions","amount":"1","shoppingName":"chicken breast portions","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ras el hanout","amount":"1 tbsp","shoppingName":"ras el hanout","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense chicken stock mix","amount":"5.5 g","shoppingName":"intense chicken stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato","amount":"2","shoppingName":"tomato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"natural yoghurt","amount":"80 g","shoppingName":"natural yoghurt","marketChecked":true,"priceMatchType":"source-identity"},{"name":"feta","amount":"30 g","shoppingName":"feta","marketChecked":true,"priceMatchType":"source-identity"},{"name":"giant couscous","amount":"130 g","shoppingName":"giant couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mint","amount":"5 g","shoppingName":"mint","marketChecked":true,"priceMatchType":"source-identity"},{"name":"spinach","amount":"80 g","shoppingName":"spinach","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you begin... This recipe takes around 5-10 min to prep, so get your casserole dish and all your ingredients ready, then wash your fruit and veg Note: Make sure your dish is oven-proof and safe to use on the hob. Don't have one? Start cooking in a large, wide-based pan then transfer to an oven-proof dish and cover tightly with foil","Now let's get started! Preheat the oven to 220°C/ 200°C (fan)/ gas 7, then take your chicken out of the fridge, open the packet and let it air and boil a kettle Chop your tomato[es] into wedges Peel and cut your red onion[s] into wedges","Add your chicken breast portion[s] to a tin foil -lined baking tray (or two!) with the tomato wedges , onion wedges and half your natural yoghurt (you'll use the rest later!) Add your ras el hanout , half your ground turmeric (save the rest for later!), 1 tsp sugar , 2 tbsp olive oil and a generous pinch of salt Give everything a good mix up","Put the tray[s] in the oven for 20-22 min or until the chicken is cooked through (no pink meat!) and the veg is tender – this is your oven baked Moroccan-style chicken breast and roasted veg Meanwhile, peel and grate (don't chop!) your garlic Wash your spinach , then pat it dry with kitchen paper","Heat a large, wide-based, hob-safe oven-proof casserole dish with a matching lid over a high heat Once hot, add your giant couscous , chicken stock mix , remaining ground turmeric , spinach , grated garlic , a generous pinch of salt and 400ml boiled water Give everything a good mix up","Bring to the boil over a high heat, cover with a lid, then put the dish in the oven for 15-18 min or until the couscous is tender Use this time to clear up, set the table, have a cup of tea or simply chill!","Strip your mint leaves from their stems, discard the stems Once the couscous is tender, stir through the remaining natural yoghurt and tear over the mint leaves Crumble over half your feta (save the rest for garnish!), season with a very generous grind of black pepper and give it a good mix up – this is your creamy giant couscous","To serve, top the creamy giant couscous with the oven baked Moroccan-style chicken breast and roasted veg Drizzle over any remaining roasting juices from the tray[s] and crumble over the remaining feta Dig in!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1707823305080-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1707823308546-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1707823313760-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1707823317112-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1707823320623-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1707823323907-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1707823327562-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/oven-baked-moroccan-style-chicken-breast-with-creamy-couscous","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/oven-baked-moroccan-style-chicken-breast-with-creamy-couscous","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1 tsp","ground turmeric"],["1","chicken breast portions"],["1 tbsp","ras el hanout"],["5.5 g","intense chicken stock mix"],["1","garlic clove"],["2","tomato"],["80 g","natural yoghurt"],["30 g","feta"],["130 g","giant couscous"],["5 g","mint"],["80 g","spinach"],["1","red onion"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"],["as needed","Water"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-45b605cb-f2a6-4b81-84f5-0a02c1241fb5","sourceId":"45b605cb-f2a6-4b81-84f5-0a02c1241fb5","title":"Cheesy Muhammara Flatbread With Pomegranate Salad","subtitle":"This is smoky muhammara like you’ve never had before.","time":35,"cost":25.76,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","middle eastern","wrap","cook"],"requiredEquipment":["food-processor"],"sourceEquipment":["Oven","Baking tray","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-7011-2-Cheesy-Muhammara-Flatbread-With-Seeded-Pomegranate-Salad-1_0-1713365100315-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/cheesy-muhammara-flatbread-with-seeded-pomegranate-salad","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["40 g","cheddar cheese"],["1","flame-baked pizza bases"],["1","red pepper"],["0.5 tsp","dried chilli flakes"],["1 tsp","ground cumin"],["1 tsp","ground smoked paprika"],["1","garlic clove"],["5 g","toasted sesame seeds"],["25 g","walnuts"],["125 g","mozzarella"],["15 g","pomegranate molasses"],["50 g","rocket"],["15 ml","white wine vinegar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"sourceIngredients":[["40 g","cheddar cheese"],["1","flame-baked pizza bases"],["1","red pepper"],["0.5 tsp","dried chilli flakes"],["1 tsp","ground cumin"],["1 tsp","ground smoked paprika"],["1","garlic clove"],["5 g","toasted sesame seeds"],["25 g","walnuts"],["125 g","mozzarella"],["15 g","pomegranate molasses"],["50 g","rocket"],["15 ml","white wine vinegar"]],"ingredientMeta":[{"name":"cheddar cheese","amount":"40 g","shoppingName":"cheddar cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"flame-baked pizza bases","amount":"1","shoppingName":"flame-baked pizza bases","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red pepper","amount":"1","shoppingName":"red pepper","marketChecked":true,"priceMatchType":"source-identity"},{"name":"dried chilli flakes","amount":"0.5 tsp","shoppingName":"dried chilli flakes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground cumin","amount":"1 tsp","shoppingName":"ground cumin","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground smoked paprika","amount":"1 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"toasted sesame seeds","amount":"5 g","shoppingName":"toasted sesame seeds","marketChecked":true,"priceMatchType":"source-identity"},{"name":"walnuts","amount":"25 g","shoppingName":"walnuts","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mozzarella","amount":"125 g","shoppingName":"mozzarella","marketChecked":true,"priceMatchType":"source-identity"},{"name":"pomegranate molasses","amount":"15 g","shoppingName":"pomegranate molasses","marketChecked":true,"priceMatchType":"source-identity"},{"name":"rocket","amount":"50 g","shoppingName":"rocket","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white wine vinegar","amount":"15 ml","shoppingName":"white wine vinegar","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 240ºC/ 220ºC (fan)/ gas 9 and boil a kettle Cut your pepper[s] in half (scrape the seeds and pith out with a teaspoon) Add the halved pepper to a baking tray (or two!) with a drizzle of olive oil and a pinch of salt and pepper Put the tray[s] in the oven for 15 min or until the pepper has softened and browned","While the pepper is in the oven, grate your cheddar cheese Drain your mozzarella , then pat and squeeze as much liquid out as you can with kitchen paper Tear the drained mozzarella into rough, bite-sized pieces Peel your garlic","Wash your salad and pat it dry with kitchen paper Combine half your pomegranate molasses in a bowl with half your white wine vinegar (you'll use the rest later!) and a generous drizzle of olive oil – this is your pomegranate dressing","Add the peeled garlic , half your chilli flakes (can't handle the heat? Go easy!), walnuts , ground cumin and ground smoked paprika to a food processor with the remaining pomegranate molasses and white wine vinegar Add 1 tbsp olive oil with a pinch of salt and blitz – this is your muhammara base","Once ready, remove the tray[s] with the pepper from the oven Reduce the oven temperature to 200°C/ 180°C (fan)/ gas 6 Add the softened pepper to the muhammara base (reserve the tray[s]) and blitz until smooth – this is your muhammara","Add your pizza base[s] to the reserved tray[s] Spread the muhammara evenly over the pizza base[s] and top with the grated cheese , torn mozzarella and remaining chilli flakes (not a fan of spice? Just add a little!) Put the tray[s] in the oven for 18-20 min or until the cheese has melted – this is your cheesy muhammara flatbread","Meanwhile, add the salad and toasted sesame seeds to the dressing and toss – this is your pomegranate salad","Serve the cheesy muhammara flatbread topped with a little of the pomegranate salad Serve the remaining salad in a bowl Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1712844965443-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1712844974924-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1712844988780-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1712844998730-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1712845003194-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1712845006879-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1712845010340-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/cheesy-muhammara-flatbread-with-seeded-pomegranate-salad","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/cheesy-muhammara-flatbread-with-seeded-pomegranate-salad","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["40 g","cheddar cheese"],["1","flame-baked pizza bases"],["1","red pepper"],["0.5 tsp","dried chilli flakes"],["1 tsp","ground cumin"],["1 tsp","ground smoked paprika"],["1","garlic clove"],["5 g","toasted sesame seeds"],["25 g","walnuts"],["125 g","mozzarella"],["15 g","pomegranate molasses"],["50 g","rocket"],["15 ml","white wine vinegar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"lunchBucket":"wrap","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-b710052e-436b-4f68-ab66-ed947588af3d","sourceId":"b710052e-436b-4f68-ab66-ed947588af3d","title":"Crispy Ras El Hanout Chicken With Giant Couscous And Tahini Yoghurt","subtitle":"Let this aromatic chicken warm up your evening.","time":40,"cost":27.35,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","north african","grain","cook"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Frying pan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/7152_Crispy-Ras-El-Hanout-Chicken-With-Giant-COuscous-and-Tahini-Yoghurt_001_0-1717062431821-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/crispy-ras-el-hanout-chicken-with-giant-couscous-and-tahini-yoghurt","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","red pepper"],["320 g","skin-on chicken thighs"],["1 tbsp","ras el hanout"],["5.5 g","intense chicken stock mix"],["2","garlic clove"],["80 g","natural yoghurt"],["1","lemon"],["16 g","tomato paste"],["30 g","sultanas"],["130 g","giant couscous"],["1","red onion"],["15 g","tahini"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"sourceIngredients":[["1","red pepper"],["320 g","skin-on chicken thighs"],["1 tbsp","ras el hanout"],["5.5 g","intense chicken stock mix"],["2","garlic clove"],["80 g","natural yoghurt"],["1","lemon"],["16 g","tomato paste"],["30 g","sultanas"],["130 g","giant couscous"],["1","red onion"],["15 g","tahini"]],"ingredientMeta":[{"name":"red pepper","amount":"1","shoppingName":"red pepper","marketChecked":true,"priceMatchType":"source-identity"},{"name":"skin-on chicken thighs","amount":"320 g","shoppingName":"skin-on chicken thighs","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ras el hanout","amount":"1 tbsp","shoppingName":"ras el hanout","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense chicken stock mix","amount":"5.5 g","shoppingName":"intense chicken stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"natural yoghurt","amount":"80 g","shoppingName":"natural yoghurt","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lemon","amount":"1","shoppingName":"lemon","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"16 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sultanas","amount":"30 g","shoppingName":"sultanas","marketChecked":true,"priceMatchType":"source-identity"},{"name":"giant couscous","amount":"130 g","shoppingName":"giant couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tahini","amount":"15 g","shoppingName":"tahini","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Take your chicken out of the fridge, open the packet and let it air, then preheat the oven to 220°C/ 200°C (fan)/ gas 7 Pat your chicken thighs dry with kitchen paper and season generously with salt and your ras el hanout Heat a large, dry, wide-based pan (preferably non-stick with a matching lid) over medium-high heat, then once hot, add the seasoned chicken , skin-side down, and cook for 10 min or until the skins have browned and crisped","Transfer the crispy chicken to a baking tray (skin side up), reserve the pan Whilst the chicken is cooking, peel and finely slice your red onion[s] Deseed your pepper[s] (scrape the seeds and pith out with a teaspoon) and cut into thin strips, then peel and finely chop (or grate) your garlic","Boil a kettle Return the reserved pan to a medium-high heat Once hot, add the sliced onion and pepper strips with a pinch of sugar and cook for 8-10 min or until softened Meanwhile, dissolve your chicken stock mix in 450ml boiled water","Once the veg has softened, add the chopped garlic with your tomato paste and cook for 1 min or until fragrant Once fragrant, add your giant couscous and the chicken stock and bring to the boil over a high heat Once boiling, reduce the heat to medium and cook, covered, stirring occasionally, for 12-14 min or until all the water has absorbed and the giant couscous is tender","While the couscous is cooking, put the tray with the chicken in the oven for 12-15 min or until cooked through (no pink meat!) – this is your crispy ras el hanout chicken","Whilst everything is cooking, add your tahini to a small bowl with 1 tbsp warm water and mix until fully combined and smooth Add your natural yoghurt with a pinch of salt , then stir it all together – this is your tahini yoghurt Roll your lemon[s] with your hand on a hard surface (to release more juice) and cut in half","Once the giant couscous is tender, add your sultanas and the juice of half your lemon[s] with a pinch of salt and pepper and give everything a good mix up Cut the remaining lemon into 1 wedge per person","Serve the crispy ras el hanout chicken over the giant couscous Drizzle over the tahini yoghurt , season with a grind of black pepper and garnish with a lemon wedge Tip: Drizzle over all the juices and caramelised bits from the chicken tray! Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1715956988366-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1715956991325-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1715956994333-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1715956997476-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1715957001967-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1715957005097-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1715957009743-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/crispy-ras-el-hanout-chicken-with-giant-couscous-and-tahini-yoghurt","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/crispy-ras-el-hanout-chicken-with-giant-couscous-and-tahini-yoghurt","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","red pepper"],["320 g","skin-on chicken thighs"],["1 tbsp","ras el hanout"],["5.5 g","intense chicken stock mix"],["2","garlic clove"],["80 g","natural yoghurt"],["1","lemon"],["16 g","tomato paste"],["30 g","sultanas"],["130 g","giant couscous"],["1","red onion"],["15 g","tahini"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-b587ab8d-b9d0-46cb-a99c-6c9915a5dc4e","sourceId":"b587ab8d-b9d0-46cb-a99c-6c9915a5dc4e","title":"One Pot Beef Lasagne Soup","subtitle":"Running out of soup ideas?","time":20,"cost":23.98,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","italian","soup","quick"],"requiredEquipment":[],"sourceEquipment":["Saucepan","Kettle","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/7247-1788859508559-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/one-pot-beef-lasagne-soup","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","carrot"],["30 g","grated Italian hard cheese"],["5.5 g","intense beef stock mix"],["1 tsp","dried oregano"],["250 g","beef mince"],["8 ml","soy sauce"],["200 g","finely chopped tomatoes"],["2","garlic clove"],["120 g","lasagne sheets"],["5 g","parsley"],["1","brown onion"],["50 g","soft cheese"],["as needed","Salt"],["as needed","Pepper"],["as needed","Olive oil"],["as needed","Sugar"],["as needed","Water"],["as needed","Milk"]],"sourceIngredients":[["1","carrot"],["30 g","grated Italian hard cheese"],["5.5 g","intense beef stock mix"],["1 tsp","dried oregano"],["250 g","beef mince"],["8 ml","soy sauce"],["200 g","finely chopped tomatoes"],["2","garlic clove"],["120 g","lasagne sheets"],["5 g","parsley"],["1","brown onion"],["50 g","soft cheese"]],"ingredientMeta":[{"name":"carrot","amount":"1","shoppingName":"carrot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"grated Italian hard cheese","amount":"30 g","shoppingName":"grated Italian hard cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense beef stock mix","amount":"5.5 g","shoppingName":"intense beef stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"dried oregano","amount":"1 tsp","shoppingName":"dried oregano","marketChecked":true,"priceMatchType":"source-identity"},{"name":"beef mince","amount":"250 g","shoppingName":"beef mince","marketChecked":true,"priceMatchType":"source-identity"},{"name":"soy sauce","amount":"8 ml","shoppingName":"soy sauce","marketChecked":true,"priceMatchType":"source-identity"},{"name":"finely chopped tomatoes","amount":"200 g","shoppingName":"finely chopped tomatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lasagne sheets","amount":"120 g","shoppingName":"lasagne sheets","marketChecked":true,"priceMatchType":"source-identity"},{"name":"parsley","amount":"5 g","shoppingName":"parsley","marketChecked":true,"priceMatchType":"source-identity"},{"name":"brown onion","amount":"1","shoppingName":"brown onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"soft cheese","amount":"50 g","shoppingName":"soft cheese","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Boil a kettle Heat a pot with a drizzle of olive oil over a high heat Once hot, add your mince and a pinch of salt and pepper Cook for 4-5 min or until beginning to brown, breaking it up with a wooden spoon as you go","Meanwhile, peel and finely dice your brown onion[s] Top, tail, peel and dice your carrot[s] finely Peel and finely chop (or grate) your garlic","Break your lasagne sheets into medium-sized pieces","Once the mince has browned, add the diced onion and diced carrot with a pinch of salt and sugar Cook for 4-5 min or until softened and the mince is cooked through (no pink meat!)","Once softened, add your dried oregano and the chopped garlic and cook for 30 secs or until fragrant Once fragrant, add your chopped tomatoes , beef stock mix and soy sauce with 400ml boiled water","Bring the pot to a boil then add the broken lasagne sheets to the pot one at a time (this prevents them from sticking together!) Cook for 6-7 min or until the pasta is cooked, stirring from time to time to prevent the pasta from sticking – this is your one pot lasagne soup","Meanwhile, combine your soft cheese with half of your grated Italian hard cheese (save some for garnish!) and season with a pinch of pepper and a splash of milk – this is your cheesy cream mixture Chop your parsley finely, including the stalks","Top the one pot lasagne soup with the cheesy cream mixture Garnish with the chopped parsley , the remaining grated Italian hard cheese and a good grind of black pepper Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1725447851919-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1725447855474-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1725447860563-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1725447865988-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1725447870572-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1725447873685-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1725447877628-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/one-pot-beef-lasagne-soup","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/one-pot-beef-lasagne-soup","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","carrot"],["30 g","grated Italian hard cheese"],["5.5 g","intense beef stock mix"],["1 tsp","dried oregano"],["250 g","beef mince"],["8 ml","soy sauce"],["200 g","finely chopped tomatoes"],["2","garlic clove"],["120 g","lasagne sheets"],["5 g","parsley"],["1","brown onion"],["50 g","soft cheese"],["as needed","Salt"],["as needed","Pepper"],["as needed","Olive oil"],["as needed","Sugar"],["as needed","Water"],["as needed","Milk"]],"lunchBucket":"soup","isLunch":true,"prepStyle":"quick","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-78b2b883-d981-4504-822c-d6741e0d94ff","sourceId":"78b2b883-d981-4504-822c-d6741e0d94ff","title":"Lean Pork Meatball Marinara Flatbreads","subtitle":"Fake your own takeaway with the ultimate meatball marinara flatbreads.","time":35,"cost":18.25,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","italian","wrap","cook"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Frying pan","Saucepan","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-4717-2-Pork-Meatball-Marinara-Flatbreads_0-1722592525812-1723538149593-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/lean-pork-meatball-marinara-flatbreads","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","carrot"],["1","plain naan"],["1 tsp","dried oregano"],["250 g","lean pork mince (<5% fat)"],["0.5 tsp","dried chilli flakes"],["200 g","finely chopped tomatoes"],["5.5 g","beef stock mix"],["1","garlic clove"],["125 g","mozzarella"],["50 g","rocket"],["15 ml","balsamic vinegar"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"sourceIngredients":[["1","carrot"],["1","plain naan"],["1 tsp","dried oregano"],["250 g","lean pork mince (<5% fat)"],["0.5 tsp","dried chilli flakes"],["200 g","finely chopped tomatoes"],["5.5 g","beef stock mix"],["1","garlic clove"],["125 g","mozzarella"],["50 g","rocket"],["15 ml","balsamic vinegar"]],"ingredientMeta":[{"name":"carrot","amount":"1","shoppingName":"carrot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"plain naan","amount":"1","shoppingName":"plain naan","marketChecked":true,"priceMatchType":"source-identity"},{"name":"dried oregano","amount":"1 tsp","shoppingName":"dried oregano","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lean pork mince (<5% fat)","amount":"250 g","shoppingName":"lean pork mince (<5% fat)","marketChecked":true,"priceMatchType":"source-identity"},{"name":"dried chilli flakes","amount":"0.5 tsp","shoppingName":"dried chilli flakes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"finely chopped tomatoes","amount":"200 g","shoppingName":"finely chopped tomatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"beef stock mix","amount":"5.5 g","shoppingName":"beef stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mozzarella","amount":"125 g","shoppingName":"mozzarella","marketChecked":true,"priceMatchType":"source-identity"},{"name":"rocket","amount":"50 g","shoppingName":"rocket","marketChecked":true,"priceMatchType":"source-identity"},{"name":"balsamic vinegar","amount":"15 ml","shoppingName":"balsamic vinegar","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7 Add your mince (remove the paper if required!) to a bowl with a pinch of salt and pepper and mix thoroughly until fully combined (clean hands is the best way!) Divide and shape them into 6 meatballs per person","Peel and finely chop (or grate) your garlic Dissolve your beef stock mix and a pinch of sugar in 1 tbsp warm water Add your dried oregano , chilli flakes (can't handle the heat? Go easy!), chopped garlic and your chopped tomatoes and give everything a good mix up – this is your marinara sauce","Drain your mozzarella , then pat and squeeze as much liquid out as you can with kitchen paper Tear the drained mozzarella into rough, bite-sized pieces","Add your naan[s] to a baking tray Spread 1/3 of the marinara sauce over each naan in a thin layer and top with the meatballs and torn mozzarella Put the loaded naan[s] in the oven for 15 min or until the meatballs are cooked through (no pink meat!) and the mozzarella is melted and golden – these are your meatball marinara flatbreads","Heat a large, wide-based pan (preferably non-stick) over a medium-high heat Add the remaining marinara sauce and cook for 2-3 min or until thickened – this is your marinara dip","Top, tail, peel and grate your carrot[s] Wash your salad , then pat dry with kitchen paper","Combine your balsamic vinegar with 1 tbsp olive oil and a pinch of salt and pepper – this is your balsamic dressing Toss the salad and grated carrot with the balsamic dressing – this is your salad","Serve the meatball marinara flatbread alongside the salad and a pot of the marinara dip Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1723118116491-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1723118119390-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-33-copy-2-1740048465139-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1723118125890-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1723118129160-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-copy-1780674405531-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-copy-1780674408613-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/lean-pork-meatball-marinara-flatbreads","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/lean-pork-meatball-marinara-flatbreads","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","carrot"],["1","plain naan"],["1 tsp","dried oregano"],["250 g","lean pork mince (<5% fat)"],["0.5 tsp","dried chilli flakes"],["200 g","finely chopped tomatoes"],["5.5 g","beef stock mix"],["1","garlic clove"],["125 g","mozzarella"],["50 g","rocket"],["15 ml","balsamic vinegar"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"lunchBucket":"wrap","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-a7690e0e-d3cb-4b48-b939-1beadf253d2d","sourceId":"a7690e0e-d3cb-4b48-b939-1beadf253d2d","title":"Halloumi Souvlaki-Style Sandwich & Extra Chicken","subtitle":"All hail halloumi.","time":35,"cost":25.89,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","greek","sandwich","cook"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Frying pan","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/5240---Halloumi-Souvlaki-Sandwich-with-Tzatziki-And-Herby-Fries1275-1678786031457-1730471451524-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/halloumi-souvlaki-style-sandwich-with-tzatziki-extra-chicken","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","chicken breast portion"],["1 tsp","ground cumin"],["1 tsp","ground smoked paprika"],["1 tsp","dried oregano"],["1","garlic clove"],["2","bread roll"],["2","tomato"],["80 g","natural yoghurt"],["200 g","halloumi"],["1","cucumber"],["5 g","mint"],["15 ml","red wine vinegar"],["3","white potato"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"sourceIngredients":[["1","chicken breast portion"],["1 tsp","ground cumin"],["1 tsp","ground smoked paprika"],["1 tsp","dried oregano"],["1","garlic clove"],["2","bread roll"],["2","tomato"],["80 g","natural yoghurt"],["200 g","halloumi"],["1","cucumber"],["5 g","mint"],["15 ml","red wine vinegar"],["3","white potato"]],"ingredientMeta":[{"name":"chicken breast portion","amount":"1","shoppingName":"chicken breast portion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground cumin","amount":"1 tsp","shoppingName":"ground cumin","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground smoked paprika","amount":"1 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"dried oregano","amount":"1 tsp","shoppingName":"dried oregano","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"bread roll","amount":"2","shoppingName":"bread roll","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato","amount":"2","shoppingName":"tomato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"natural yoghurt","amount":"80 g","shoppingName":"natural yoghurt","marketChecked":true,"priceMatchType":"source-identity"},{"name":"halloumi","amount":"200 g","shoppingName":"halloumi","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cucumber","amount":"1","shoppingName":"cucumber","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mint","amount":"5 g","shoppingName":"mint","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red wine vinegar","amount":"15 ml","shoppingName":"red wine vinegar","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white potato","amount":"3","shoppingName":"white potato","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7, then then take your chicken out of the fridge, open the packet and let it air Cut your potatoes (skins on) into fries Add the fries to a baking tray (or two!) with a drizzle of olive oil and your dried oregano , give everything a good mix up and put the tray[s] in the oven for 20-25 min or until crisp – these are your herby fries","Meanwhile, slice half your cucumber[s] into discs, cut the remaining cucumber in half lengthways, scrape out the inner seeds with a teaspoon and discard, then grate the deseeded cucumber and squeeze out any excess water Add your chicken breast portion to a baking paper -lined tray with a drizzle of olive oil and a pinch of salt and pepper , then put the tray in the oven for 18-20 min or until cooked through (no pink meat!)","Strip your mint leaves from their stems and chop them roughly, discard the stems Peel and finely chop (or grate) your garlic Add the grated cucumber to a bowl with half the chopped garlic (not a big garlic fan? Try using less!), half the chopped mint (save the rest for garnish!), your natural yoghurt and a drizzle of olive oil Give everything a good mix up – this is your tzatziki","Slice your tomato[es] into rounds Slice your halloumi into 2 strips per person lengthways","Combine the sliced halloumi and your ground cumin in a bowl with your ground smoked paprika , remaining chopped garlic and a drizzle of olive oil Give everything a good mix up and season with a generous grind of black pepper – this is your marinated halloumi","Heat a large, dry, wide-based pan (preferably non-stick) over a medium-high heat Once hot, add the marinated halloumi and cook for 1-2 min on each side or until crispy and golden brown on both sides – this is your crispy halloumi","Put your bread roll[s] in the oven for 5 min or until hot and crusty, then carefully slice in half before serving Combine the sliced tomato and cucumber discs in a bowl with the remaining chopped mint , red wine vinegar and 2 tbsp olive oil Give everything a good mix up – this is your cucumber & tomato salad","To assemble, top your crusty bread roll base with the crispy halloumi , a dollop of tzatziki , a handful of herby fries and the crusty bread roll lid – this is your halloumi Souvlaki-style sandwich Serve the remaining herby fries , cucumber & tomato salad and any remaining tzatziki with the cooked chicken breast to the side Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1730995073024-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1730995081040-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1730995086031-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1730995090004-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1730995094326-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1730995099308-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1730995103090-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/halloumi-souvlaki-style-sandwich-with-tzatziki-extra-chicken","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/halloumi-souvlaki-style-sandwich-with-tzatziki-extra-chicken","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","chicken breast portion"],["1 tsp","ground cumin"],["1 tsp","ground smoked paprika"],["1 tsp","dried oregano"],["1","garlic clove"],["2","bread roll"],["2","tomato"],["80 g","natural yoghurt"],["200 g","halloumi"],["1","cucumber"],["5 g","mint"],["15 ml","red wine vinegar"],["3","white potato"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"lunchBucket":"sandwich","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-3881f45d-a636-43c5-811e-95fd7a642505","sourceId":"3881f45d-a636-43c5-811e-95fd7a642505","title":"One Tray Harissa Chicken Breast & Carrot Traybake With Paprika Yoghurt","subtitle":"Leave the cooking to the oven with this veg-packed traybake.","time":40,"cost":24.4,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fusion","other","cook"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-5445-2-Harissa-Chicken-Potato--Carrot-Traybake-With-Paprika-Yoghurt-2-1789720000451-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/harissa-chicken-breast-carrot-traybake-with-paprika-yoghurt","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["2","white potato"],["1","carrot"],["40 g","harissa paste"],["1","chicken breast portions"],["1 tsp","ground smoked paprika"],["50 g","baby leaf salad"],["80 g","natural yoghurt"],["15 ml","cider vinegar"],["1","red onion"],["1","sweet potato"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"sourceIngredients":[["2","white potato"],["1","carrot"],["40 g","harissa paste"],["1","chicken breast portions"],["1 tsp","ground smoked paprika"],["50 g","baby leaf salad"],["80 g","natural yoghurt"],["15 ml","cider vinegar"],["1","red onion"],["1","sweet potato"]],"ingredientMeta":[{"name":"white potato","amount":"2","shoppingName":"white potato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"carrot","amount":"1","shoppingName":"carrot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"harissa paste","amount":"40 g","shoppingName":"harissa paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chicken breast portions","amount":"1","shoppingName":"chicken breast portions","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground smoked paprika","amount":"1 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"baby leaf salad","amount":"50 g","shoppingName":"baby leaf salad","marketChecked":true,"priceMatchType":"source-identity"},{"name":"natural yoghurt","amount":"80 g","shoppingName":"natural yoghurt","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cider vinegar","amount":"15 ml","shoppingName":"cider vinegar","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sweet potato","amount":"1","shoppingName":"sweet potato","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7 Take your chicken out of the fridge, open the packet and let it air Chop your potatoes (skins on) into small bite-sized pieces Chop your sweet potato[es] (skins on) into small bite-sized pieces","Top, tail, and slice your carrot[s] into chunky discs on the diagonal Peel and chop your red onion[s] into wedges","Add the chopped potatoes , sliced carrot and onion wedges to a large tin foil -lined baking tray (or two!) Add a generous drizzle of olive oil , a generous pinch of salt and pepper and give everything a good mix up Put the tray[s] in the oven for an initial 15-17 min or until the potatoes are starting to soften","Meanwhile, add most of your ground smoked paprika (save some for later!), 1 tsp sugar , a generous drizzle of olive oil and half your cider vinegar (you'll use the rest later!) to a medium bowl Add a generous pinch of salt and pepper and give everything a good mix up – this is your marinade Add your chicken and mix it all together until fully coated – this is your marinated chicken","Once the potatoes have slightly softened, remove the tray[s] from the oven and add the marinated chicken , return the tray[s]to the oven and cook for a further 13-15 min or until the chicken is almost cooked (Doubled your protein? Do this in batches!) Once almost cooked, remove the tray[s] from the oven, carefully spread your harissa paste (can't handle the heat? Go easy!) over the chicken, then return to the oven for a final 5-6 min or until the chicken is cooked through (no pink meat!) – this is your harissa chicken & carrot traybake","While the chicken is cooking, combine your natural yoghurt with the remaining ground smoked paprika and a pinch of salt in a bowl Stir it all together – this is your paprika yoghurt","Wash your salad then pat dry with kitchen paper","Serve the harissa chicken & carrot traybake with the salad to the side and drizzle over the paprika yoghurt Drizzle the salad with a little olive oil and the remaining cider vinegar and season with a pinch of salt and pepper Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1686665877955-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1686665882329-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1686665890186-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1686665892904-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1686665897414-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1686665901242-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1686665909959-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/harissa-chicken-breast-carrot-traybake-with-paprika-yoghurt","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/harissa-chicken-breast-carrot-traybake-with-paprika-yoghurt","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["2","white potato"],["1","carrot"],["40 g","harissa paste"],["1","chicken breast portions"],["1 tsp","ground smoked paprika"],["50 g","baby leaf salad"],["80 g","natural yoghurt"],["15 ml","cider vinegar"],["1","red onion"],["1","sweet potato"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"lunchBucket":"other","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-66c327da-5c4b-4703-80b3-5ae5e9fdb934","sourceId":"66c327da-5c4b-4703-80b3-5ae5e9fdb934","title":"One Pot Spiced Lean Beef With Couscous","subtitle":"For this wholesome one pot, you'll cook beef mince, red onion and butter beans in flavours inspired by a spiced North African sausage called 'merguez'","time":20,"cost":16.6,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","north african","grain","quick"],"requiredEquipment":[],"sourceEquipment":["Saucepan","Kettle","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/2869_One-Pot-Spiced-Beef-With-Couscous-1787306518019-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/one-pot-spiced-lean-beef-with-couscous","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","tomato"],["5.5 g","intense beef stock mix"],["250 g","lean beef mince (<5% fat)"],["32 g","tomato paste"],["1 tbsp","ras el hanout"],["185 g","butter beans"],["80 g","natural yoghurt"],["120 g","couscous"],["15 g","flaked almonds"],["1","red onion"],["as needed","Water"],["as needed","Salt"],["as needed","Olive oil"]],"sourceIngredients":[["1","tomato"],["5.5 g","intense beef stock mix"],["250 g","lean beef mince (<5% fat)"],["32 g","tomato paste"],["1 tbsp","ras el hanout"],["185 g","butter beans"],["80 g","natural yoghurt"],["120 g","couscous"],["15 g","flaked almonds"],["1","red onion"]],"ingredientMeta":[{"name":"tomato","amount":"1","shoppingName":"tomato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense beef stock mix","amount":"5.5 g","shoppingName":"intense beef stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lean beef mince (<5% fat)","amount":"250 g","shoppingName":"lean beef mince (<5% fat)","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"32 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ras el hanout","amount":"1 tbsp","shoppingName":"ras el hanout","marketChecked":true,"priceMatchType":"source-identity"},{"name":"butter beans","amount":"185 g","shoppingName":"butter beans","marketChecked":true,"priceMatchType":"source-identity"},{"name":"natural yoghurt","amount":"80 g","shoppingName":"natural yoghurt","marketChecked":true,"priceMatchType":"source-identity"},{"name":"couscous","amount":"120 g","shoppingName":"couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"flaked almonds","amount":"15 g","shoppingName":"flaked almonds","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Boil a kettle, then heat a large, wide-based dry pan (preferably non-stick) over a medium heat Once hot, add your flaked almonds and cook for 2-3 min or until toasted and lightly golden Tip: Watch them like a hawk to make sure they don’t burn! Transfer the toasted almonds to a plate, reserve the pan","Peel and finely slice your red onion[s] Chop your tomato[es] roughly Drain and rinse your butter beans","Return the reserved pan to a high heat with a drizzle of olive oil Once hot, add your mince with a pinch of salt and cook for 3-4 min or until beginning to brown, breaking it up with a wooden spoon as you go Once browned, add the sliced onion and chopped tomato and cook for 2-3 min or until starting to soften","Dissolve your beef stock mix in 200ml boiled water","Once softened, add your ras el hanout and tomato paste and cook for 1 min or until fragrant","Once fragrant, add the drained butter beans and beef stock Cook for a further 3-4 min or until cooked through (no pink meat!) and the sauce has slightly thickened – this is your one pot spiced mince","Meanwhile, add your couscous to a heatproof bowl with a pinch of salt and 200ml boiled water Cover with a tea towel and set aside until all of the liquid has been absorbed Fluff with a fork before serving","Serve the one pot spiced mince with the cooked couscous to the side Top with a dollop of your natural yoghurt and garnish with the toasted almonds Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1738763702140-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1738763705828-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1738763709493-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1738763713437-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1738763717360-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1738763721839-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1738763725944-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/one-pot-spiced-lean-beef-with-couscous","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/one-pot-spiced-lean-beef-with-couscous","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","tomato"],["5.5 g","intense beef stock mix"],["250 g","lean beef mince (<5% fat)"],["32 g","tomato paste"],["1 tbsp","ras el hanout"],["185 g","butter beans"],["80 g","natural yoghurt"],["120 g","couscous"],["15 g","flaked almonds"],["1","red onion"],["as needed","Water"],["as needed","Salt"],["as needed","Olive oil"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-70e69c52-f18f-4cb8-98f4-14a19f546877","sourceId":"70e69c52-f18f-4cb8-98f4-14a19f546877","title":"Prosciutto Caprese Baguette With Buttery Basil Potatoes","subtitle":"Plate up the flavours of Italy with this hearty Mediterranean-style sarnie.","time":10,"cost":18.38,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","italian","sandwich","quick"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/7349_Prosciutto-Caprese-Baguette-With-Buttery-Basil-Potatoes-1786973630314-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/prosciutto-caprese-baguette-with-buttery-basil-potatoes","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["2","tomato"],["1","baguettes"],["350 g","waxy potatoes"],["52 g","sliced prosciutto"],["125 g","mozzarella"],["10 g","basil"],["20 g","rocket"],["15 ml","balsamic vinegar"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Butter"]],"sourceIngredients":[["2","tomato"],["1","baguettes"],["350 g","waxy potatoes"],["52 g","sliced prosciutto"],["125 g","mozzarella"],["10 g","basil"],["20 g","rocket"],["15 ml","balsamic vinegar"]],"ingredientMeta":[{"name":"tomato","amount":"2","shoppingName":"tomato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"baguettes","amount":"1","shoppingName":"baguettes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"waxy potatoes","amount":"350 g","shoppingName":"waxy potatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sliced prosciutto","amount":"52 g","shoppingName":"sliced prosciutto","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mozzarella","amount":"125 g","shoppingName":"mozzarella","marketChecked":true,"priceMatchType":"source-identity"},{"name":"basil","amount":"10 g","shoppingName":"basil","marketChecked":true,"priceMatchType":"source-identity"},{"name":"rocket","amount":"20 g","shoppingName":"rocket","marketChecked":true,"priceMatchType":"source-identity"},{"name":"balsamic vinegar","amount":"15 ml","shoppingName":"balsamic vinegar","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you begin... Get all your ingredients and equipment ready Skim through these steps, then wash your fruit and veg Note: Equipment and pan sizes vary. Make sure you cook food thoroughly (even if it takes you a little longer than 10 min)","Now, let's get started! Preheat the oven to 200°C/ 180°C (fan)/ gas 6 Add your waxy potatoes to a heatproof bowl, then cover the bowl with cling film and pierce a few holes in the top with a fork Put the bowl in the microwave for 6-8 min or until the potatoes are fork-tender","Slice your tomato[es] into rounds","Drain your mozzarella and tear it into rough, bite-sized pieces","Chop your basil roughly, including the stalks Wash your salad then pat dry with kitchen paper Combine half the chopped basil (you'll use the rest later!) and salad in a small bowl Add a drizzle of olive oil and your balsamic vinegar and toss – this is your dressed salad","Add your baguette[s] to a baking tray in the oven for 2-3 min or until warmed through and crusty Slice each warmed baguette in half (without cutting all the way through) and open it out like a book","Once the potatoes are fork-tender, add a generous knob of butter and the remaining chopped basil with pinch of salt and pepper and crush lightly with a fork – these are your crushed buttery basil potatoes Tip: Just crush them gently, or they'll turn to mash!","To assemble, divide your sliced prosciutto , sliced tomato , mozzarella and dressed salad evenly between the baguette[s] Finish with a drizzle of olive oil and a generous pinch of salt and pepper Serve the buttery basil potatoes to the side Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Admin10mm-Step-1-1755527981004-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1731328139080-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1731328143672-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1731328149604-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1731328154036-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1731328157689-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1731328161979-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/prosciutto-caprese-baguette-with-buttery-basil-potatoes","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/prosciutto-caprese-baguette-with-buttery-basil-potatoes","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["2","tomato"],["1","baguettes"],["350 g","waxy potatoes"],["52 g","sliced prosciutto"],["125 g","mozzarella"],["10 g","basil"],["20 g","rocket"],["15 ml","balsamic vinegar"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Butter"]],"lunchBucket":"sandwich","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-e2fdf11d-1e0e-49a8-87df-149b682983e3","sourceId":"e2fdf11d-1e0e-49a8-87df-149b682983e3","title":"One Tray Harissa Salmon & Cherry Tomato Traybake","subtitle":"All hail the heady aroma of harissa.","time":35,"cost":17.18,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fusion","other","cook"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-7398-2-Harissa-Salmon--Cherry-Tomato-Traybake-2_0-1727443186724-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/harissa-salmon-cherry-tomato-traybake","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["20 g","harissa paste"],["2 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["1","skin-on salmon fillets"],["160 g","fine green beans"],["125 g","cherry tomatoes"],["4","white potato"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"sourceIngredients":[["20 g","harissa paste"],["2 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["1","skin-on salmon fillets"],["160 g","fine green beans"],["125 g","cherry tomatoes"],["4","white potato"]],"ingredientMeta":[{"name":"harissa paste","amount":"20 g","shoppingName":"harissa paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground smoked paprika","amount":"2 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mayonnaise","amount":"25 ml","shoppingName":"mayonnaise","marketChecked":true,"priceMatchType":"source-identity"},{"name":"skin-on salmon fillets","amount":"1","shoppingName":"skin-on salmon fillets","marketChecked":true,"priceMatchType":"source-identity"},{"name":"fine green beans","amount":"160 g","shoppingName":"fine green beans","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cherry tomatoes","amount":"125 g","shoppingName":"cherry tomatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white potato","amount":"4","shoppingName":"white potato","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7 Chop your potatoes (skins on) into bite-sized pieces Add the chopped potatoes to a baking tray (or two!) with a drizzle of olive oil and a pinch of salt and pepper Give everything a good mix up and put the tray[s] in the oven for an initial 18 min","Pat your salmon fillet[s] dry with kitchen paper Add half your ground smoked paprika (save the rest for later!) to a plate with a pinch of salt and pepper and mix it together Add the salmon fillet[s] to the plate and turn until fully coated, then set aside – these are your smoky salmon fillet[s]","Chop your cherry tomatoes in half","Trim, then chop your green beans in half","After the initial 18 min, remove the tray[s] from the oven Add the chopped tomatoes and chopped green beans to the tray[s] with a drizzle of olive oil Sprinkle over the remaining ground smoked paprika and give everything a good mix up","Add the smoky salmon fillet[s] to the tray[s] with a drizzle of olive oil Return the tray[s] to the oven for a further 14-15 min or until the fish is cooked through, the potatoes are crisp and the vegetables have softened – this is your smoky salmon tray bake Tip: Your fish is cooked once it turns opaque and flakes easily","Meanwhile, combine your mayo and harissa paste (can't handle the heat? Go easy!) in a small bowl and mix it all together – this is your harissa mayo","Serve the smoky salmon tray bake with the harissa mayo drizzled over the top Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-3-1725448527420-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-3-1725448570318-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-3-1725448576316-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-3-1725448583819-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-3-1725448590747-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-3-1725448606584-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-3-1725448560384-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/harissa-salmon-cherry-tomato-traybake","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/harissa-salmon-cherry-tomato-traybake","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["20 g","harissa paste"],["2 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["1","skin-on salmon fillets"],["160 g","fine green beans"],["125 g","cherry tomatoes"],["4","white potato"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"lunchBucket":"other","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-b503acce-665a-4b74-97d2-ebda9af17e85","sourceId":"b503acce-665a-4b74-97d2-ebda9af17e85","title":"Slow Cooker Coconut & Lime Basa Chowder","subtitle":"Bring the zing with this easy one pot.","time":180,"cost":23.85,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fusion","soup","cook"],"requiredEquipment":["slow-cooker"],"sourceEquipment":["Kettle"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-7904-2-Slow-Cooker-Coconut--Lime-Basa-Chowder_0-1742572580929-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/slow-cooker-coconut-lime-basa-chowder","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["80 g","cultured coconut"],["8 ml","fish sauce"],["25 g","solid creamed coconut"],["0.5 tsp","dried chilli flakes"],["1 tsp","ground turmeric"],["1","leek"],["1","basa fillets"],["1 tbsp","cornflour"],["0.5 tbsp","curry powder"],["1","fresh lemongrass stalk"],["1","shallot"],["15 g","crispy onions"],["1","lime"],["1","sweet potato"],["as needed","Water"],["as needed","Pepper"],["as needed","Salt"]],"sourceIngredients":[["80 g","cultured coconut"],["8 ml","fish sauce"],["25 g","solid creamed coconut"],["0.5 tsp","dried chilli flakes"],["1 tsp","ground turmeric"],["1","leek"],["1","basa fillets"],["1 tbsp","cornflour"],["0.5 tbsp","curry powder"],["1","fresh lemongrass stalk"],["1","shallot"],["15 g","crispy onions"],["1","lime"],["1","sweet potato"]],"ingredientMeta":[{"name":"cultured coconut","amount":"80 g","shoppingName":"cultured coconut","marketChecked":true,"priceMatchType":"source-identity"},{"name":"fish sauce","amount":"8 ml","shoppingName":"fish sauce","marketChecked":true,"priceMatchType":"source-identity"},{"name":"solid creamed coconut","amount":"25 g","shoppingName":"solid creamed coconut","marketChecked":true,"priceMatchType":"source-identity"},{"name":"dried chilli flakes","amount":"0.5 tsp","shoppingName":"dried chilli flakes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground turmeric","amount":"1 tsp","shoppingName":"ground turmeric","marketChecked":true,"priceMatchType":"source-identity"},{"name":"leek","amount":"1","shoppingName":"leek","marketChecked":true,"priceMatchType":"source-identity"},{"name":"basa fillets","amount":"1","shoppingName":"basa fillets","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cornflour","amount":"1 tbsp","shoppingName":"cornflour","marketChecked":true,"priceMatchType":"source-identity"},{"name":"curry powder","amount":"0.5 tbsp","shoppingName":"curry powder","marketChecked":true,"priceMatchType":"source-identity"},{"name":"fresh lemongrass stalk","amount":"1","shoppingName":"fresh lemongrass stalk","marketChecked":true,"priceMatchType":"source-identity"},{"name":"shallot","amount":"1","shoppingName":"shallot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"crispy onions","amount":"15 g","shoppingName":"crispy onions","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lime","amount":"1","shoppingName":"lime","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sweet potato","amount":"1","shoppingName":"sweet potato","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you begin... This recipe takes around 5-10 min to prep, so get your slow cooker and all your ingredients ready, then wash your fruit and veg Turn on your slow cooker to high","Now, let's get started! Boil a full kettle Peel and chop your shallot[s] into wedges Chop your leek[s] in half lengthways, wash thoroughly to remove any grit from between the leaves then top, tail and slice roughly","Bash your lemongrass with a rolling pin Chop your sweet potato[es] (skin on) into large, bite-sized pieces Roughly chop your creamed coconut (if required!)","Add the shallot wedges and sliced leek to the slow cooker","Add the chopped creamed coconut to the slow cooker with your cornflour , ground turmeric , curry powder , bashed lemongrass , fish sauce and chilli flakes (can't handle the heat? Go easy!) and give everything a good mix up Add 350ml boiled water with a pinch of salt and cook on high for an initial 2 hours – this is your chowder base","After 2 hours, add the chopped sweet potato to the chowder base with a pinch of salt and pepper then top with your fish fillet[s] Cook for a further 1 hour or until the fish is cooked through and the sweet potato is fork tender – this is your coconut & fish chowder Tip: Your fish is cooked once it turns opaque and flakes easily","Meanwhile, roll your lime[s] with your hand on a hard surface (to release more juice), then cut in half Use this time to clear up, set the table, have a cup of tea or simply chill! Once cooked, flake the cooked fish with a fork, then stir your cultured coconut and the juice of half the lime[s] through the coconut & fish chowder – this is your slow cooker coconut & lime fish chowder","Cut the remaining lime into 1 wedge per person Serve the slow cooker coconut & lime fish chowder (discard the lemongrass) and garnish with your crispy onions and a lime wedge Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1740070858379-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1740070863546-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1740070868702-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1740070874105-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1740070879328-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1740070884267-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1740070890267-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/slow-cooker-coconut-lime-basa-chowder","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/slow-cooker-coconut-lime-basa-chowder","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["80 g","cultured coconut"],["8 ml","fish sauce"],["25 g","solid creamed coconut"],["0.5 tsp","dried chilli flakes"],["1 tsp","ground turmeric"],["1","leek"],["1","basa fillets"],["1 tbsp","cornflour"],["0.5 tbsp","curry powder"],["1","fresh lemongrass stalk"],["1","shallot"],["15 g","crispy onions"],["1","lime"],["1","sweet potato"],["as needed","Water"],["as needed","Pepper"],["as needed","Salt"]],"lunchBucket":"soup","isLunch":true,"prepStyle":"cook","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-01d60125-6ddf-44a9-ae9d-0979ea625588","sourceId":"01d60125-6ddf-44a9-ae9d-0979ea625588","title":"Warm Lemony Lean Beef Tabbouleh","subtitle":"This Middle-Eastern style tabbouleh is perfect on cold evenings.","time":20,"cost":16.57,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","middle eastern","grain","quick"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Saucepan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/512_Warm-Lemony-Beef-Tabbouleh_001_0-1674040314826-1747312498918-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/warm-lemony-lean-beef-tabbouleh","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["250 g","lean beef mince (<5% fat)"],["1 tbsp","ras el hanout"],["5.5 g","beef stock mix"],["1","garlic clove"],["2","tomato"],["1","lemon"],["10 g","parsley"],["130 g","bulgur wheat"],["25 g","honey"],["as needed","Salt"],["as needed","Olive oil"]],"sourceIngredients":[["250 g","lean beef mince (<5% fat)"],["1 tbsp","ras el hanout"],["5.5 g","beef stock mix"],["1","garlic clove"],["2","tomato"],["1","lemon"],["10 g","parsley"],["130 g","bulgur wheat"],["25 g","honey"]],"ingredientMeta":[{"name":"lean beef mince (<5% fat)","amount":"250 g","shoppingName":"lean beef mince (<5% fat)","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ras el hanout","amount":"1 tbsp","shoppingName":"ras el hanout","marketChecked":true,"priceMatchType":"source-identity"},{"name":"beef stock mix","amount":"5.5 g","shoppingName":"beef stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato","amount":"2","shoppingName":"tomato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lemon","amount":"1","shoppingName":"lemon","marketChecked":true,"priceMatchType":"source-identity"},{"name":"parsley","amount":"10 g","shoppingName":"parsley","marketChecked":true,"priceMatchType":"source-identity"},{"name":"bulgur wheat","amount":"130 g","shoppingName":"bulgur wheat","marketChecked":true,"priceMatchType":"source-identity"},{"name":"honey","amount":"25 g","shoppingName":"honey","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Boil a kettle Heat a large, wide-based pan (preferably non-stick) with a drizzle of olive oil over a high heat Once hot, add your mince and cook for 3 min or until it's starting to brown, breaking it up with a wooden spoon as you go Peel and finely chop (or grate) your garlic","Discard any excess oil from the pan, then stir in the chopped garlic , ras el hanout and beef stock mix Reduce the heat to medium-low and cook for 9-10 min or until the mince is cooked through (no pink meat!)","While the mince is cooking, add your bulgur wheat to a pot with plenty of boiled water and a pinch of salt (the same as you would for pasta) Bring to the boil over a high heat and cook for 7-9 min or until tender with a slight bite Once cooked, drain and return to the pot","Meanwhile, dice your tomato[es] finely Chop your parsley finely, including the stalks","Add your honey to the mince and continue to cook for 1 min further before removing the pan from the heat to cool slightly – this is your honey mince","Add the drained bulgur wheat to a mixing bowl with the diced tomato , the juice of half your lemon[s] and a drizzle of olive oil","Add the honey mince and most of the chopped parsley (save some for garnish!) and give everything a good mix up Taste for seasoning, adding more salt and pepper if needed – this is your warm lemony mince tabbouleh Cut the remaining lemon into 1 wedge per person","Serve the warm lemony mince tabbouleh and garnish with the remaining chopped parsley and a lemon wedge Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1747230532043-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1747230544503-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1747230552511-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1747230560007-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1747230569540-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1747230581200-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1747230587882-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/warm-lemony-lean-beef-tabbouleh","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/warm-lemony-lean-beef-tabbouleh","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["250 g","lean beef mince (<5% fat)"],["1 tbsp","ras el hanout"],["5.5 g","beef stock mix"],["1","garlic clove"],["2","tomato"],["1","lemon"],["10 g","parsley"],["130 g","bulgur wheat"],["25 g","honey"],["as needed","Salt"],["as needed","Olive oil"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-1d490309-c612-4d4a-a67b-bac4cf7a7a1a","sourceId":"1d490309-c612-4d4a-a67b-bac4cf7a7a1a","title":"Oven-Baked Sardinian-Style King Prawn Fregola W. Pesto Garlic Baguette","subtitle":"Give dinner some Sardinian style with this easy, oven-baked fregola-style giant couscous.","time":30,"cost":23.5,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","italian","sandwich","quick"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Frying pan","Kettle"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-7963-2-Oven-Baked-Sardinian-Style-Gamberi-con-Fregola-With-Pesto-Garlic-Bread-1747133641005-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/oven-baked-sardinian-style-king-prawn-fregola-w-pesto-garlic-baguette","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","red pepper"],["171 g","raw peeled king prawns"],["200 g","finely chopped tomatoes"],["1","2 cheese, garlic and basil baguettes"],["5.5 g","intense vegetable stock mix"],["2","garlic clove"],["30 g","balsamic sun-dried tomato paste"],["45 g","traditional Italian pesto"],["130 g","giant couscous"],["20 g","rocket"],["as needed","Butter"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"sourceIngredients":[["1","red pepper"],["171 g","raw peeled king prawns"],["200 g","finely chopped tomatoes"],["1","2 cheese, garlic and basil baguettes"],["5.5 g","intense vegetable stock mix"],["2","garlic clove"],["30 g","balsamic sun-dried tomato paste"],["45 g","traditional Italian pesto"],["130 g","giant couscous"],["20 g","rocket"]],"ingredientMeta":[{"name":"red pepper","amount":"1","shoppingName":"red pepper","marketChecked":true,"priceMatchType":"source-identity"},{"name":"raw peeled king prawns","amount":"171 g","shoppingName":"raw peeled king prawns","marketChecked":true,"priceMatchType":"source-identity"},{"name":"finely chopped tomatoes","amount":"200 g","shoppingName":"finely chopped tomatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"2 cheese, garlic and basil baguettes","amount":"1","shoppingName":"2 cheese, garlic and basil baguettes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense vegetable stock mix","amount":"5.5 g","shoppingName":"intense vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"balsamic sun-dried tomato paste","amount":"30 g","shoppingName":"balsamic sun-dried tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"traditional Italian pesto","amount":"45 g","shoppingName":"traditional Italian pesto","marketChecked":true,"priceMatchType":"source-identity"},{"name":"giant couscous","amount":"130 g","shoppingName":"giant couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"rocket","amount":"20 g","shoppingName":"rocket","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you begin... This recipe takes around 5-10 min to prep, so get your casserole dish and all your ingredients ready, then wash your fruit and veg Note: Make sure your dish is oven-proof and safe to use on the hob. Don't have one? Start cooking in a large, wide-based pan then transfer to an oven-proof dish and cover tightly with foil","Now let's get started! Preheat the oven to 220°C/ 200°C (fan)/ gas 7 and boil a kettle Heat a hob-safe oven-proof casserole dish with a drizzle of olive oil over a high heat Once hot, add your giant couscous and cook for 1-2 min or until lightly toasted","Meanwhile, deseed your pepper[s] (scrape the seeds and pith out with a teaspoon) and cut into thin strips Peel and thinly slice (don't chop!) your garlic","Once the giant couscous is lightly toasted, add the sliced pepper and garlic to the dish and cook for 30 secs or until fragrant","Once fragrant, add your chopped tomatoes , vegetable stock mix and 450ml boiled water with a generous pinch of pepper and sugar Give everything a good mix up and put in the oven, uncovered for 20 min, stirring halfway, or until the giant couscous is tender Wash your salad and pat it dry with kitchen paper","Add your garlic baguette[s] to a baking tray When the couscous has had 10 min, put the tray with the garlic baguette[s] in the oven and cook for 10-15 min or until golden brown and piping hot throughout Once the couscous is tender, remove the dish from the oven, drain your king prawns and add to the dish with a knob of butter and a pinch of salt and stir it all together","Cover with a lid and return the dish to the oven for a final 6-7 min or until the prawns are cooked through – this is your oven-baked Sardinian-style king prawn fregola Once the prawns are cooked, remove the dish from the oven and leave to stand for 2 min before serving (this helps the flavours to develop) Tip: Add a splash of water if the mixture is looking a little dry","To serve, drizzle your balsamic sun-dried tomato paste over the oven-baked Sardinian-style king prawn fregola Garnish with the salad , a drizzle of olive oil and a generous pinch of pepper Serve the garlic baguette to the side with your traditional Italian pesto for dipping Dig in!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1748343635985-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1748343641812-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1748343647259-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1748343655616-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1748343661498-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1748343666863-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1748343671912-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/oven-baked-sardinian-style-king-prawn-fregola-w-pesto-garlic-baguette","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/oven-baked-sardinian-style-king-prawn-fregola-w-pesto-garlic-baguette","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","red pepper"],["171 g","raw peeled king prawns"],["200 g","finely chopped tomatoes"],["1","2 cheese, garlic and basil baguettes"],["5.5 g","intense vegetable stock mix"],["2","garlic clove"],["30 g","balsamic sun-dried tomato paste"],["45 g","traditional Italian pesto"],["130 g","giant couscous"],["20 g","rocket"],["as needed","Butter"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"],["as needed","Water"]],"lunchBucket":"sandwich","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-3620b89c-1e6e-4962-81a8-10384bdc00a9","sourceId":"3620b89c-1e6e-4962-81a8-10384bdc00a9","title":"Coronation Chicken Couscous","subtitle":"Toaster, microwave or kettle-friendly – this is dinner without the cooking.","time":10,"cost":24.09,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","british","grain","quick"],"requiredEquipment":[],"sourceEquipment":["Kettle","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-8135-2_Coronation-Chicken-Couscous0188-1750153325165-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/no-cook-coronation-chicken-couscous","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["160 g","cooked shredded chicken thighs"],["5.5 g","intense chicken stock mix"],["50 ml","mayonnaise"],["1 tbsp","curry powder"],["50 g","baby leaf salad"],["120 g","couscous"],["15 g","ginger & garlic paste"],["30 g","sultanas"],["1","gem lettuce"],["15 g","flaked almonds"],["as needed","Water"],["as needed","Butter"],["as needed","Pepper"]],"sourceIngredients":[["160 g","cooked shredded chicken thighs"],["5.5 g","intense chicken stock mix"],["50 ml","mayonnaise"],["1 tbsp","curry powder"],["50 g","baby leaf salad"],["120 g","couscous"],["15 g","ginger & garlic paste"],["30 g","sultanas"],["1","gem lettuce"],["15 g","flaked almonds"]],"ingredientMeta":[{"name":"cooked shredded chicken thighs","amount":"160 g","shoppingName":"cooked shredded chicken thighs","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense chicken stock mix","amount":"5.5 g","shoppingName":"intense chicken stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mayonnaise","amount":"50 ml","shoppingName":"mayonnaise","marketChecked":true,"priceMatchType":"source-identity"},{"name":"curry powder","amount":"1 tbsp","shoppingName":"curry powder","marketChecked":true,"priceMatchType":"source-identity"},{"name":"baby leaf salad","amount":"50 g","shoppingName":"baby leaf salad","marketChecked":true,"priceMatchType":"source-identity"},{"name":"couscous","amount":"120 g","shoppingName":"couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ginger & garlic paste","amount":"15 g","shoppingName":"ginger & garlic paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sultanas","amount":"30 g","shoppingName":"sultanas","marketChecked":true,"priceMatchType":"source-identity"},{"name":"gem lettuce","amount":"1","shoppingName":"gem lettuce","marketChecked":true,"priceMatchType":"source-identity"},{"name":"flaked almonds","amount":"15 g","shoppingName":"flaked almonds","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Spend less time cooking and make dinner work around you. Before you begin, get all your ingredients and equipment ready Skim through these steps, then wash your fruit and veg You can only heat your food once, then enjoy straight away Note: Microwave ovens vary. Make sure you heat food thoroughly (even if it takes you a little longer than 10 min)","Now, let's get started! Boil half a kettle Add your couscous , sultanas and chicken stock mix to a large heatproof bowl with 200ml boiled water Cover and set aside until all of the liquid has been absorbed","Wash your salad , then pat dry with kitchen paper","Wash your lettuce , then pat it dry with kitchen paper and roughly shred","Combine your curry powder and ginger & garlic paste in a small heatproof bowl with a knob of butter Put the bowl in the microwave and cook for 30 secs or until the butter is melted","Once the butter has melted, add your mayo with 1 tbsp cold water and stir it all together – this is your coronation dressing","Once everything is ready, add the cooked shredded chicken , salad and shredded lettuce to the couscous with most of your coronation dressing (save some for garnish!) Give everything a good mix up – this is your coronation chicken couscous salad","Serve the coronation chicken couscous salad and drizzle with the remaining coronation dressing Sprinkle with your flaked almonds and finish with a grind of black pepper Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Admin10mm-Step-1-1785399073296-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1750455980247-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1750455989314-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1750455998091-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1750456008686-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1750456016170-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1750456024490-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/no-cook-coronation-chicken-couscous","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/no-cook-coronation-chicken-couscous","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["160 g","cooked shredded chicken thighs"],["5.5 g","intense chicken stock mix"],["50 ml","mayonnaise"],["1 tbsp","curry powder"],["50 g","baby leaf salad"],["120 g","couscous"],["15 g","ginger & garlic paste"],["30 g","sultanas"],["1","gem lettuce"],["15 g","flaked almonds"],["as needed","Water"],["as needed","Butter"],["as needed","Pepper"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-4ddc12f3-80b3-464f-8b2e-99f6426076bc","sourceId":"4ddc12f3-80b3-464f-8b2e-99f6426076bc","title":"Lean Beef Polpette With Tomato & Basil Broth","subtitle":"This hearty soup is big on flavour and perfect for cold nights.","time":40,"cost":20.99,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","italian","soup","cook"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/883_Beef-Polpette-With-Tomato--Basil-Broth_001_0-1714725276619-1750687870103-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/lean-beef-polpette-with-tomato-basil-broth","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["20 g","Italian hard cheese"],["5.5 g","intense beef stock mix"],["250 g","lean beef mince (<5% fat)"],["390 g","finely chopped tomatoes"],["2","garlic clove"],["1 tsp","dried basil"],["1","shallot"],["10 g","basil"],["75 g","giant couscous"],["15 ml","balsamic vinegar"],["as needed","Water"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"sourceIngredients":[["20 g","Italian hard cheese"],["5.5 g","intense beef stock mix"],["250 g","lean beef mince (<5% fat)"],["390 g","finely chopped tomatoes"],["2","garlic clove"],["1 tsp","dried basil"],["1","shallot"],["10 g","basil"],["75 g","giant couscous"],["15 ml","balsamic vinegar"]],"ingredientMeta":[{"name":"Italian hard cheese","amount":"20 g","shoppingName":"Italian hard cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense beef stock mix","amount":"5.5 g","shoppingName":"intense beef stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lean beef mince (<5% fat)","amount":"250 g","shoppingName":"lean beef mince (<5% fat)","marketChecked":true,"priceMatchType":"source-identity"},{"name":"finely chopped tomatoes","amount":"390 g","shoppingName":"finely chopped tomatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"dried basil","amount":"1 tsp","shoppingName":"dried basil","marketChecked":true,"priceMatchType":"source-identity"},{"name":"shallot","amount":"1","shoppingName":"shallot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"basil","amount":"10 g","shoppingName":"basil","marketChecked":true,"priceMatchType":"source-identity"},{"name":"giant couscous","amount":"75 g","shoppingName":"giant couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"balsamic vinegar","amount":"15 ml","shoppingName":"balsamic vinegar","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Boil a kettle Peel and finely slice your shallot[s] Peel and finely chop (or grate) your garlic Pick your basil leaves from their stalks and chop the stalks finely","Combine your mince with the chopped basil stalks (save the leaves for later!) and a generous pinch of salt and pepper Mix until combined (clean hands is the best way), then roll into 3 meatballs per person","Heat a large, wide-based pan (preferably non-stick with a matching lid) with a drizzle of olive oil over a medium-high heat Once hot, add the meatballs and cook for 4 min, turning occasionally with tongs until browned on all sides Once browned, set aside on a plate (reserve the pan) – these are your polpette (Doubled your protein? Use 2 pans!)","Return the reserved pan to a medium-low heat Once hot, add the chopped shallot with a pinch of salt and cook for 3 min or until softened Add the chopped garlic and cook for a further 1 min","Add your chopped tomatoes , balsamic vinegar , dried basil , beef stock mix , 1 tsp sugar and 600ml boiled water Stir until combined, then bring to the boil over a high heat Once boiling, add your giant couscous and cook for 5 min or until beginning to soften – this is your tomato & basil broth","Chop the basil leaves roughly (save some for garnish!) Grate your Italian hard cheese","Add the polpette to the tomato & basil broth and cook, covered, for 12-15 min or until cooked through (no pink meat!) Season with a generous pinch of salt and pepper","Remove the pan from the heat and stir the chopped basil through Serve the tomato & basil broth in a bowl topped with the polpette Garnish with the reserved basil leaves and sprinkle with the grated Italian hard cheese Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1749551267721-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1749551271216-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1749551275808-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1749551281784-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1749551294512-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1749551301885-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1749551304453-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/lean-beef-polpette-with-tomato-basil-broth","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/lean-beef-polpette-with-tomato-basil-broth","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["20 g","Italian hard cheese"],["5.5 g","intense beef stock mix"],["250 g","lean beef mince (<5% fat)"],["390 g","finely chopped tomatoes"],["2","garlic clove"],["1 tsp","dried basil"],["1","shallot"],["10 g","basil"],["75 g","giant couscous"],["15 ml","balsamic vinegar"],["as needed","Water"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"lunchBucket":"soup","isLunch":true,"prepStyle":"cook","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-58a7218f-05c1-49fc-89ac-303678489fcf","sourceId":"58a7218f-05c1-49fc-89ac-303678489fcf","title":"Creamy Harissa Chicken Pitta With Paprika Potatoes & Salad","subtitle":"Toaster, microwave or kettle-friendly – this is dinner without the cooking.","time":10,"cost":26.63,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fusion","wrap","quick"],"requiredEquipment":[],"sourceEquipment":["Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/8130_Creamy-Harissa-Chicken-Pitta-With-Paprika-Potatoes--Salad-1787909576788-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/creamy-harissa-chicken-pitta-with-paprika-potatoes-salad","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","sourdough pittas"],["20 g","harissa paste"],["1","tomato"],["1 tsp","ground smoked paprika"],["50 ml","mayonnaise"],["200 g","cooked chicken breast"],["50 g","baby leaf salad"],["15 ml","cider vinegar"],["3","white potato"],["as needed","Salt"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Butter"],["as needed","Water"],["as needed","Olive oil"]],"sourceIngredients":[["1","sourdough pittas"],["20 g","harissa paste"],["1","tomato"],["1 tsp","ground smoked paprika"],["50 ml","mayonnaise"],["200 g","cooked chicken breast"],["50 g","baby leaf salad"],["15 ml","cider vinegar"],["3","white potato"]],"ingredientMeta":[{"name":"sourdough pittas","amount":"1","shoppingName":"sourdough pittas","marketChecked":true,"priceMatchType":"source-identity"},{"name":"harissa paste","amount":"20 g","shoppingName":"harissa paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato","amount":"1","shoppingName":"tomato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground smoked paprika","amount":"1 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mayonnaise","amount":"50 ml","shoppingName":"mayonnaise","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cooked chicken breast","amount":"200 g","shoppingName":"cooked chicken breast","marketChecked":true,"priceMatchType":"source-identity"},{"name":"baby leaf salad","amount":"50 g","shoppingName":"baby leaf salad","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cider vinegar","amount":"15 ml","shoppingName":"cider vinegar","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white potato","amount":"3","shoppingName":"white potato","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Spend less time cooking and make dinner work around you. Before you begin, get all your ingredients and equipment ready Skim through these steps, then wash your fruit and veg You can only heat your food once, then enjoy straight away Note: Microwave ovens vary. Make sure you heat food thoroughly (even if it takes you a little longer than 10 min)","Now, let's get started! Chop your potatoes (skins on) into small, bite-sized pieces","Add your chopped potatoes to a heatproof bowl, then cover the bowl with cling film and pierce a few holes in the top with a fork Put the bowl in the microwave for 6-8 min or until the potatoes are fork-tender then set aside with the cling film on to keep warm","While the potatoes are cooking, chop your tomato[es] into wedges Wash your salad , then pat dry with kitchen paper Shred your cooked chicken","Add a knob of butter to a separate medium heatproof bowl with half your ground smoked paprika (you'll use the rest later!) and 1 tbsp cold water Add the cooked shredded chicken and put in the microwave for 1-2 min, stirring halfway, or until the butter has melted and the chicken is warmed through Add your mayo and harissa paste (can't handle the heat? Go easy!) with a pinch of salt , pepper and sugar and stir it all together – this is your creamy harissa chicken","Add your pitta[s] to a toaster for 1-2 min or until warmed through","Add a knob of butter and the remaining ground smoked paprika to the cooked potatoes Add a pinch of salt and pepper and give everything a good mix up until the butter has melted and is coating the potatoes – these are your paprika potatoes","To build your pitta, carefully slice the warmed pitta open like a book, then add a handful of salad , creamy harissa chicken and some tomato wedges – this is your creamy harissa chicken pitta then serve the creamy harissa chicken pitta with the paprika potatoes , remaining salad and tomato wedges to the side and dress the salad with a little olive oil , your cider vinegar and a pinch of salt and pepper Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Admin-10mm-Step-1-1750851257760-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-94-1750851262353-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-96-1750851264890-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-99-1750851269040-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-91-1750851273379-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-91-1750851277529-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-92-1750851281403-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/creamy-harissa-chicken-pitta-with-paprika-potatoes-salad","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/creamy-harissa-chicken-pitta-with-paprika-potatoes-salad","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","sourdough pittas"],["20 g","harissa paste"],["1","tomato"],["1 tsp","ground smoked paprika"],["50 ml","mayonnaise"],["200 g","cooked chicken breast"],["50 g","baby leaf salad"],["15 ml","cider vinegar"],["3","white potato"],["as needed","Salt"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Butter"],["as needed","Water"],["as needed","Olive oil"]],"lunchBucket":"wrap","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-faa9aeda-d5a6-4340-bbab-0c6a987dba43","sourceId":"faa9aeda-d5a6-4340-bbab-0c6a987dba43","title":"RE:NOURISH Broccoli Soup With Cheesy Garlic & Herb Pitta Chips","subtitle":"Heat up your RE:NOURISH Broccoli Soup and pair it with crunchy pitta pizzazz.","time":10,"cost":13.6,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","british","wrap","quick"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-11126-2-Re-Nourish-Broccoli-Cheese-Soup-With-Cheesy-Garlic--Herb-Pitta-Chips-1762511295244-1766048470881-1767368330184-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/re-nourish-broccoli-soup-with-cheesy-garlic-herb-pitta-chips","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1000 g","RENOURISH broccoli & cheddar soup"],["1 tsp","dried oregano"],["30 g","pine kernel & seed mix"],["1","sourdough pittas"],["15 g","crispy onions"],["15 g","roasted garlic paste"],["30 g","grated Italian hard cheese"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"sourceIngredients":[["1000 g","RENOURISH broccoli & cheddar soup"],["1 tsp","dried oregano"],["30 g","pine kernel & seed mix"],["1","sourdough pittas"],["15 g","crispy onions"],["15 g","roasted garlic paste"],["30 g","grated Italian hard cheese"]],"ingredientMeta":[{"name":"RENOURISH broccoli & cheddar soup","amount":"1000 g","shoppingName":"RENOURISH broccoli & cheddar soup","marketChecked":true,"priceMatchType":"source-identity"},{"name":"dried oregano","amount":"1 tsp","shoppingName":"dried oregano","marketChecked":true,"priceMatchType":"source-identity"},{"name":"pine kernel & seed mix","amount":"30 g","shoppingName":"pine kernel & seed mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sourdough pittas","amount":"1","shoppingName":"sourdough pittas","marketChecked":true,"priceMatchType":"source-identity"},{"name":"crispy onions","amount":"15 g","shoppingName":"crispy onions","marketChecked":true,"priceMatchType":"source-identity"},{"name":"roasted garlic paste","amount":"15 g","shoppingName":"roasted garlic paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"grated Italian hard cheese","amount":"30 g","shoppingName":"grated Italian hard cheese","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you begin... Get all your ingredients and equipment ready Skim through these steps, then wash your fruit and veg Note: Equipment and pan sizes vary. Make sure you cook food thoroughly (even if it takes you a little longer than 10 min)","Cut your sourdough pitta[s] into small pieces","Heat a large, wide-based pan (preferably non-stick) over a medium-high heat with enough olive oil to cover the base","Once hot, add the pitta chips and cook for 3-4 min or until golden and crisp","Once golden, add your dried oregano and pine kernel & seed mix to the pan and cook for 30 secs or until fragrant","Once fragrant, transfer the crispy pitta pieces and toasted seeds to a large bowl with your grated Italian hard cheese , roasted garlic paste and crispy onions Season with a generous pinch of salt and pepper and stir it all together – this is your cheesy garlic & herb pitta chips","Meanwhile, heat your RE:NOURISH broccoli soup according to the pack instructions","Serve the heated RE:NOURISH broccoli soup and top with the cheesy garlic & herb pitta chips Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-66-1767012392841-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-63-1767012395656-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-65-1767012399759-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-63-1767012402176-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-63-1767012405649-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-64-1767012409331-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1762945617946-x1500.jpeg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/re-nourish-broccoli-soup-with-cheesy-garlic-herb-pitta-chips","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/re-nourish-broccoli-soup-with-cheesy-garlic-herb-pitta-chips","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1000 g","RENOURISH broccoli & cheddar soup"],["1 tsp","dried oregano"],["30 g","pine kernel & seed mix"],["1","sourdough pittas"],["15 g","crispy onions"],["15 g","roasted garlic paste"],["30 g","grated Italian hard cheese"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"lunchBucket":"wrap","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-3106448b-afa6-46c6-9017-bead96bacc86","sourceId":"3106448b-afa6-46c6-9017-bead96bacc86","title":"Creamy Chicken Thigh, Sweet Potato & Sweetcorn Chowder","subtitle":"Enjoy a creamy, comforting chowder with sweet onion, tender chicken and creamy soft cheese.","time":25,"cost":27.68,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","british","soup","quick"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-5209-2-Creamy-Chicken-Thigh-and-Sweetcorn-Chowder-1309-1678180140679-1755866310323-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/creamy-chicken-thigh-sweet-potato-sweetcorn-chowder","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["250 g","diced chicken thigh"],["1 tsp","ground smoked paprika"],["150 g","Sweetcorn"],["5.5 g","intense chicken stock mix"],["2","garlic clove"],["5 g","thyme"],["1","brown onion"],["50 g","soft cheese"],["15 ml","Chinese rice wine"],["80 g","spinach"],["2","sweet potato"],["as needed","Butter"],["as needed","Flour"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"sourceIngredients":[["250 g","diced chicken thigh"],["1 tsp","ground smoked paprika"],["150 g","Sweetcorn"],["5.5 g","intense chicken stock mix"],["2","garlic clove"],["5 g","thyme"],["1","brown onion"],["50 g","soft cheese"],["15 ml","Chinese rice wine"],["80 g","spinach"],["2","sweet potato"]],"ingredientMeta":[{"name":"diced chicken thigh","amount":"250 g","shoppingName":"diced chicken thigh","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground smoked paprika","amount":"1 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Sweetcorn","amount":"150 g","shoppingName":"Sweetcorn","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense chicken stock mix","amount":"5.5 g","shoppingName":"intense chicken stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"thyme","amount":"5 g","shoppingName":"thyme","marketChecked":true,"priceMatchType":"source-identity"},{"name":"brown onion","amount":"1","shoppingName":"brown onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"soft cheese","amount":"50 g","shoppingName":"soft cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Chinese rice wine","amount":"15 ml","shoppingName":"Chinese rice wine","marketChecked":true,"priceMatchType":"source-identity"},{"name":"spinach","amount":"80 g","shoppingName":"spinach","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sweet potato","amount":"2","shoppingName":"sweet potato","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you start cooking, take your chicken out of the fridge, open the packet and let it air Heat a large, wide-based pan (preferably non-stick) over a high heat with a drizzle of olive oil Once hot, add your diced chicken and cook for 3 min on each side or until lightly browned, then remove from the heat Transfer the browned chicken to a plate and reserve the pan","While the chicken is browning, peel and finely dice your brown onion[s] Peel and finely chop (or grate) your garlic Chop your potato[es] (skins on) into small, bite-sized pieces Boil a kettle","Return the reserved pan to a medium heat with a drizzle of olive oil Once hot, add a knob of butter with the chopped onion , half your ground smoked paprika (you'll use the rest later!) and a generous pinch of salt and cook for 3-5 min or until the onion has softened Once softened, add the chopped garlic and cook for a further 1 min","While the onion is softening, dissolve your chicken stock mix in 500ml boiled water Once the onion has softened, add the chopped potatoes , browned chicken , thyme (chuck it in, stalks and all!) and 1 tbsp flour to the pan Give everything a good mix up and cook for 1 min or until fragrant","Once fragrant, add your Chinese rice wine and cook for 1 min or until the Chinese rice wine has evaporated Add the chicken stock and a generous pinch of salt , and bring to the boil over a high heat Once boiling reduce to medium-high and cook for an initial 10 min or until the potatoes are fork-tender","Meanwhile, drain your sweetcorn Wash your spinach , then pat it dry with kitchen paper After an initial 10 min, add the drained sweetcorn and spinach to the pan for a final 5 min or until the spinach has wilted and the chicken is cooked through (no pink meat!)","Once the chicken is cooked through, stir through your soft cheese with a good grind of black pepper – this is your creamy chicken & sweetcorn chowder Discard the thyme stalks and shred any larger pieces of chicken apart, using two forks","Serve the creamy chicken & sweetcorn chowder in a bowl Garnish with the remaining ground smoked paprika Season with a generous grind of pepper and a drizzle of olive oil Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1678879520086-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1678879525525-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1678879532721-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1678879545455-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1678879548970-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1678879562611-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1678879570828-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/creamy-chicken-thigh-sweet-potato-sweetcorn-chowder","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/creamy-chicken-thigh-sweet-potato-sweetcorn-chowder","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["250 g","diced chicken thigh"],["1 tsp","ground smoked paprika"],["150 g","Sweetcorn"],["5.5 g","intense chicken stock mix"],["2","garlic clove"],["5 g","thyme"],["1","brown onion"],["50 g","soft cheese"],["15 ml","Chinese rice wine"],["80 g","spinach"],["2","sweet potato"],["as needed","Butter"],["as needed","Flour"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"lunchBucket":"soup","isLunch":true,"prepStyle":"quick","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-f4638d97-4567-4279-9678-abbb52a39d17","sourceId":"f4638d97-4567-4279-9678-abbb52a39d17","title":"One Pot Fragrant Coconut & Cauliflower Soup With Chilli Butter","subtitle":"This fragrant soup is packed with vibrant flavours.","time":30,"cost":25.39,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","indian","soup","quick"],"requiredEquipment":["blender"],"sourceEquipment":["Saucepan","Kettle","Mixing bowl","Blender"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-7810-2-One-Pot-Fragrant-Coconut--Cauliflower-Soup-With-Chilli-Butter_0-1769087316798-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/one-pot-fragrant-coconut-cauliflower-soup-with-chilli-butter","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","mini garlic & coriander naans"],["80 g","cultured coconut"],["1 tsp","ground turmeric"],["8 ml","soy sauce"],["8 ml","sriracha hot chilli sauce"],["5.5 g","intense vegetable stock mix"],["3","garlic clove"],["15 g","fresh root ginger"],["160 g","cauliflower florets"],["30 g","pine kernel & seed mix"],["1","brown onion"],["1","carrot"],["1","lime"],["2","white potato"],["15 g","tamarind paste"],["as needed","Olive oil"],["as needed","Water"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Butter"]],"sourceIngredients":[["1","mini garlic & coriander naans"],["80 g","cultured coconut"],["1 tsp","ground turmeric"],["8 ml","soy sauce"],["8 ml","sriracha hot chilli sauce"],["5.5 g","intense vegetable stock mix"],["3","garlic clove"],["15 g","fresh root ginger"],["160 g","cauliflower florets"],["30 g","pine kernel & seed mix"],["1","brown onion"],["1","carrot"],["1","lime"],["2","white potato"],["15 g","tamarind paste"]],"ingredientMeta":[{"name":"mini garlic & coriander naans","amount":"1","shoppingName":"mini garlic & coriander naans","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cultured coconut","amount":"80 g","shoppingName":"cultured coconut","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground turmeric","amount":"1 tsp","shoppingName":"ground turmeric","marketChecked":true,"priceMatchType":"source-identity"},{"name":"soy sauce","amount":"8 ml","shoppingName":"soy sauce","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sriracha hot chilli sauce","amount":"8 ml","shoppingName":"sriracha hot chilli sauce","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense vegetable stock mix","amount":"5.5 g","shoppingName":"intense vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"3","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"fresh root ginger","amount":"15 g","shoppingName":"fresh root ginger","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cauliflower florets","amount":"160 g","shoppingName":"cauliflower florets","marketChecked":true,"priceMatchType":"source-identity"},{"name":"pine kernel & seed mix","amount":"30 g","shoppingName":"pine kernel & seed mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"brown onion","amount":"1","shoppingName":"brown onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"carrot","amount":"1","shoppingName":"carrot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lime","amount":"1","shoppingName":"lime","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white potato","amount":"2","shoppingName":"white potato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tamarind paste","amount":"15 g","shoppingName":"tamarind paste","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Boil a full kettle Peel and chop your brown onion[s] into wedges Crush your garlic open by squashing it with the side of a knife and discard the skin Peel (scrape the skin off with a teaspoon) and roughly slice your ginger","Top, tail and slice your carrot[s] into discs Slice your potato[es] (skins on) into discs Cut your cauliflower[s] into small florets","Heat a large, wide-based pot with a lid, with a drizzle of olive oil over a medium-high heat Once hot, add the chopped onion , sliced ginger and crushed garlic and cook for 2-3 mins or until starting to soften Once starting to soften, add your ground turmeric and cook for 30 secs or until fragrant","Once fragrant, reduce the heat to medium and add your tamarind paste and your soy sauce Add your chopped carrot , sliced potato and cauliflower florets and give everything a good mix up Add your vegetable stock mix with 700ml boiled water and bring to the boil over a high heat Once boiling, reduce the heat to medium and cook for 20-22 min or until the veg and potato is softened – this is your soup base","Meanwhile, add a generous knob of butter to a small heatproof bowl Put the bowl in the microwave and cook for 20-30 secs or until the butter is melted Once the butter is melted, add your sriracha (can't handle the heat? Go easy!) and give a good mix up – this is your chilli butter","Once the soup base is ready, remove the pot from the heat and add your cultured coconut , a generous squeeze of lime juice and 1 tsp sugar Add a generous pinch of pepper and blitz with a (stick) blender until smooth Taste for seasoning, adding more salt and pepper if needed – this is your coconut & cauliflower soup Cut the remaining lime into 1 wedge per person","Add your garlic & coriander naan[s] to a toaster for 1-2 min or until warmed through","Serve the coconut & cauliflower soup and top with your pine kernel & seed mix Drizzle over the chilli butter and garnish with a lime wedge Serve the warmed naan[s] to the side Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1741869421289-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1741869425308-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1741869427101-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1741869430051-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1741869433249-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1741869436401-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1741869439792-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/one-pot-fragrant-coconut-cauliflower-soup-with-chilli-butter","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/one-pot-fragrant-coconut-cauliflower-soup-with-chilli-butter","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","mini garlic & coriander naans"],["80 g","cultured coconut"],["1 tsp","ground turmeric"],["8 ml","soy sauce"],["8 ml","sriracha hot chilli sauce"],["5.5 g","intense vegetable stock mix"],["3","garlic clove"],["15 g","fresh root ginger"],["160 g","cauliflower florets"],["30 g","pine kernel & seed mix"],["1","brown onion"],["1","carrot"],["1","lime"],["2","white potato"],["15 g","tamarind paste"],["as needed","Olive oil"],["as needed","Water"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Butter"]],"lunchBucket":"soup","isLunch":true,"prepStyle":"quick","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-4d33fe55-08cc-475f-baf1-64f2cd7190b7","sourceId":"4d33fe55-08cc-475f-baf1-64f2cd7190b7","title":"One Pan Alpine-Style Sausage & Waxy Potato Hash","subtitle":"Go all in for this alpine-inspired one pan.","time":10,"cost":29.47,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","french","potato","quick"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/6210_One-Pan-Alpine-Style-Sausage--Waxy-Potato-Hash-1787304195400-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/one-pan-alpine-style-sausage-waxy-potato-hash","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["40 g","cheddar cheese"],["150 g","Jolly Hog pork sausagemeat"],["350 g","waxy potatoes"],["0.5 tsp","dried thyme"],["50 g","baby leaf salad"],["1","brown onion"],["15 g","roasted garlic paste"],["21 g","wholegrain mustard"],["15 ml","red wine vinegar"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Butter"],["as needed","Olive oil"]],"sourceIngredients":[["40 g","cheddar cheese"],["150 g","Jolly Hog pork sausagemeat"],["350 g","waxy potatoes"],["0.5 tsp","dried thyme"],["50 g","baby leaf salad"],["1","brown onion"],["15 g","roasted garlic paste"],["21 g","wholegrain mustard"],["15 ml","red wine vinegar"]],"ingredientMeta":[{"name":"cheddar cheese","amount":"40 g","shoppingName":"cheddar cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Jolly Hog pork sausagemeat","amount":"150 g","shoppingName":"Jolly Hog pork sausagemeat","marketChecked":true,"priceMatchType":"source-identity"},{"name":"waxy potatoes","amount":"350 g","shoppingName":"waxy potatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"dried thyme","amount":"0.5 tsp","shoppingName":"dried thyme","marketChecked":true,"priceMatchType":"source-identity"},{"name":"baby leaf salad","amount":"50 g","shoppingName":"baby leaf salad","marketChecked":true,"priceMatchType":"source-identity"},{"name":"brown onion","amount":"1","shoppingName":"brown onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"roasted garlic paste","amount":"15 g","shoppingName":"roasted garlic paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"wholegrain mustard","amount":"21 g","shoppingName":"wholegrain mustard","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red wine vinegar","amount":"15 ml","shoppingName":"red wine vinegar","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you begin... Get all your ingredients and equipment ready Skim through these steps, then wash your fruit and veg Note: Equipment and pan sizes vary. Make sure you cook food thoroughly (even if it takes you a little longer than 10 min)","Now let's get started! Add your waxy potatoes to a heatproof bowl, then cover the bowl with cling film and pierce a few holes in the top with a fork Put the bowl in the microwave for 6-8 minor until the potatoes are fork-tender Chop your brown onion[s] into thin wedges","Heat a large, wide-based pan (preferably non-stick with a matching lid) with a drizzle of olive oil over a high heat Add your sausage meat (remove the paper if required!) and onion wedges to the pan and cook for 5 min or until beginning to brown and cooked through (no pink meat!), breaking it up with a wooden spoon as you go Tip: Cooking for 3 or more? Use 2 pans!","Grate your cheddar cheese finely Wash your salad and pat dry with kitchen paper","Combine your red wine vinegar and wholegrain mustard with 1 tsp sugar and a drizzle of olive oil in a large bowl – this is your mustard dressing","Once the potatoes are fork-tender, crush them lightly with a fork in the bowl – these are your crushed potatoes Add the crushed potatoes to the pan with your roasted garlic paste , a small knob of butter and your dried thyme and give everything a good mix up Season with a pinch of salt and cook for 1 min or until the butter has melted","Top with the grated cheese and cook, covered, for 2 min or until the cheese has melted – this is your one pan Alpine-style sausage & waxy potato hash Add the salad to the mustard dressing and toss – this is your dressed salad","Serve the one pan Alpine-style sausage & waxy potato hash with the dressed salad to the side Season with a grind of black pepper Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1693826039920-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1693826042988-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1693826045403-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1693826048071-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1693826050669-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1693826053238-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1693826056733-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/one-pan-alpine-style-sausage-waxy-potato-hash","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/one-pan-alpine-style-sausage-waxy-potato-hash","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["40 g","cheddar cheese"],["150 g","Jolly Hog pork sausagemeat"],["350 g","waxy potatoes"],["0.5 tsp","dried thyme"],["50 g","baby leaf salad"],["1","brown onion"],["15 g","roasted garlic paste"],["21 g","wholegrain mustard"],["15 ml","red wine vinegar"],["as needed","Sugar"],["as needed","Pepper"],["as needed","Salt"],["as needed","Butter"],["as needed","Olive oil"]],"lunchBucket":"potato","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-c570b788-6631-455a-89f7-718b99ee04b5","sourceId":"c570b788-6631-455a-89f7-718b99ee04b5","title":"Meat-Free Chick'n & Lentil Tagine With Herby Couscous","subtitle":"This effortless showstopper is packed with aromatic flavour.","time":20,"cost":16.64,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","moroccan","grain","quick"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-7752-2-Meat-Free-Chicken--Lentil-Tagine-With-Herby-Couscous-2_0-1760024559589-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/meat-free-chicken-lentil-tagine-with-herby-couscous","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["25 g","solid creamed coconut"],["100 g","red lentils"],["160 g","meat-free chick'n"],["200 g","finely chopped tomatoes"],["80 g","couscous"],["5.5 g","intense vegetable stock mix"],["1 tbsp","ras el hanout"],["2","garlic clove"],["5 g","parsley"],["2","carrot"],["5 g","black sesame seeds"],["as needed","Olive oil"],["as needed","Water"],["as needed","Sugar"],["as needed","Pepper"]],"sourceIngredients":[["25 g","solid creamed coconut"],["100 g","red lentils"],["160 g","meat-free chick'n"],["200 g","finely chopped tomatoes"],["80 g","couscous"],["5.5 g","intense vegetable stock mix"],["1 tbsp","ras el hanout"],["2","garlic clove"],["5 g","parsley"],["2","carrot"],["5 g","black sesame seeds"]],"ingredientMeta":[{"name":"solid creamed coconut","amount":"25 g","shoppingName":"solid creamed coconut","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red lentils","amount":"100 g","shoppingName":"red lentils","marketChecked":true,"priceMatchType":"source-identity"},{"name":"meat-free chick'n","amount":"160 g","shoppingName":"meat-free chick'n","marketChecked":true,"priceMatchType":"source-identity"},{"name":"finely chopped tomatoes","amount":"200 g","shoppingName":"finely chopped tomatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"couscous","amount":"80 g","shoppingName":"couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense vegetable stock mix","amount":"5.5 g","shoppingName":"intense vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ras el hanout","amount":"1 tbsp","shoppingName":"ras el hanout","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"parsley","amount":"5 g","shoppingName":"parsley","marketChecked":true,"priceMatchType":"source-identity"},{"name":"carrot","amount":"2","shoppingName":"carrot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"black sesame seeds","amount":"5 g","shoppingName":"black sesame seeds","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Heat a large, wide-based pan (preferably non-stick with a matching lid) with a generous drizzle of olive oil over a medium-high heat Once hot, add the meat-free chick'n and cook for 3-4 min or until starting to brown","Boil a kettle Top, tail and dice your carrot[s] finely Peel and finely chop (or grate) your garlic Rinse your red lentils in a sieve under cold running water","Add the diced carrot and most of the chopped garlic (save the rest for later!) to the pan and cook for 30 secs or until fragrant","Chop your creamed coconut roughly (if required!) Dissolve the chopped creamed coconut and vegetable stock mix in 400ml boiled water – this is your coconut stock","Re-boil half a kettle Once fragrant, add the rinsed lentils and ras el hanout (can't handle the heat? Go easy!) and cook for 30 secs, stirring to coat the grains Add the coconut stock and chopped tomatoes with 1 tsp sugar and cook, covered, for 14-16 min or until the lentils are almost cooked","Add your couscous to a heatproof bowl with 130ml boiled water and the remaining garlic , cover with cling film and set aside until all of the liquid has been absorbed Meanwhile, chop your parsley finely, including the stalks Add half the chopped parsley (save the rest for garnish!) to the couscous with a drizzle of olive oil and a generous grind of pepper and fluff with a fork – this is your herby couscous","Once the lentils are tender, remove the lid and cook for a further 1-2 min or until the sauce has thickened – this is your meat-free chick'n & lentil tagine","Serve the meat-free chick'n & lentil tagine to the side of the herby couscous Sprinkle with the remaining chopped parsley and your black sesame seeds Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-copy-1739794770652-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-copy-1739794774006-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-copy-1739794778083-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-copy-1739794781941-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-copy-1739794785703-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-copy-1739794790121-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-copy-1739794794713-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/meat-free-chicken-lentil-tagine-with-herby-couscous","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/meat-free-chicken-lentil-tagine-with-herby-couscous","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["25 g","solid creamed coconut"],["100 g","red lentils"],["160 g","meat-free chick'n"],["200 g","finely chopped tomatoes"],["80 g","couscous"],["5.5 g","intense vegetable stock mix"],["1 tbsp","ras el hanout"],["2","garlic clove"],["5 g","parsley"],["2","carrot"],["5 g","black sesame seeds"],["as needed","Olive oil"],["as needed","Water"],["as needed","Sugar"],["as needed","Pepper"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-fdb305c9-1d2f-4b2b-8339-e1049dc14c34","sourceId":"fdb305c9-1d2f-4b2b-8339-e1049dc14c34","title":"Harissa Chicken Stuffed Sourdough Pitta & Tomato Bulgur","subtitle":"Welcome to high protein pitta perfection.","time":20,"cost":27.62,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fusion","wrap","quick"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Saucepan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/7251---Harissa-Chicken-Stuffed-Sourdough-Pitta--Tomato-Bulgur-1789132210250-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/harissa-chicken-stuffed-sourdough-pitta-tomato-bulgur","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1","sourdough pittas"],["40 g","harissa paste"],["1","tomato"],["5.5 g","chicken stock mix"],["250 g","diced chicken breast"],["25 ml","mayonnaise"],["1","garlic clove"],["50 g","baby leaf salad"],["16 g","tomato paste"],["15 ml","white wine vinegar"],["130 g","bulgur wheat"],["as needed","Pepper"],["as needed","Salt"],["as needed","Butter"],["as needed","Olive oil"]],"sourceIngredients":[["1","sourdough pittas"],["40 g","harissa paste"],["1","tomato"],["5.5 g","chicken stock mix"],["250 g","diced chicken breast"],["25 ml","mayonnaise"],["1","garlic clove"],["50 g","baby leaf salad"],["16 g","tomato paste"],["15 ml","white wine vinegar"],["130 g","bulgur wheat"]],"ingredientMeta":[{"name":"sourdough pittas","amount":"1","shoppingName":"sourdough pittas","marketChecked":true,"priceMatchType":"source-identity"},{"name":"harissa paste","amount":"40 g","shoppingName":"harissa paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato","amount":"1","shoppingName":"tomato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chicken stock mix","amount":"5.5 g","shoppingName":"chicken stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"diced chicken breast","amount":"250 g","shoppingName":"diced chicken breast","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mayonnaise","amount":"25 ml","shoppingName":"mayonnaise","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"baby leaf salad","amount":"50 g","shoppingName":"baby leaf salad","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"16 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white wine vinegar","amount":"15 ml","shoppingName":"white wine vinegar","marketChecked":true,"priceMatchType":"source-identity"},{"name":"bulgur wheat","amount":"130 g","shoppingName":"bulgur wheat","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you start cooking, take your chicken out of the fridge, open the packet and let it air Boil a kettle and heat a large, wide-based pan (preferably non-stick) with a small drizzle of olive oil over a high heat Once hot, add your diced chicken and cook for 10-12 min or until cooked through (no pink meat!) (Doubled your protein? Use 2 pans!)","While the chicken is cooking, add your bulgur wheat to a pot with plenty of boiled water and a pinch of salt (the same as you would for pasta) Bring to the boil over a high heat and cook for 7-9 min or until tender with a slight bite","Peel and finely chop (or grate) your garlic","Wash your salad then pat dry with kitchen paper","Slice your tomato[es] into rounds","Once the bulgur is tender, drain and return to the pot Return the pot to a low heat with a small knob of butter , the chopped garlic, your tomato paste and chicken stock mix Season with a pinch of salt and pepper and cook for 1-2 min, or until fragrant and well coated, stirring constantly – this is your tomatoey bulgur","Add your pitta[s] to a toaster for 1-2 min or until warmed through Once the chicken is cooked through, remove the pan from the heat and add your harissa paste (can't handle the heat? Go easy!) and a small splash of your white wine vinegar (save the rest for later!) with a generous pinch of salt and pepper Give everything a good mix up – this is your harissa chicken","Slice open the top of the warmed pitta and fill it with your mayo , some of your salad , a few tomato slices and the harissa chicken Serve the tomatoey bulgur to the side Tip: For fancy presentation, press the bulgur into a small bowl and turn out Serve the remaining salad with the remaining white wine vinegar and a small drizzle of olive oil and enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1723816259212-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1723816273314-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1723818586174-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Washed-baby-leaf-salad-3-1790085381223-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1723818601982-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1723818610141-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-42-1741084772718-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/harissa-chicken-stuffed-sourdough-pitta-tomato-bulgur","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/harissa-chicken-stuffed-sourdough-pitta-tomato-bulgur","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1","sourdough pittas"],["40 g","harissa paste"],["1","tomato"],["5.5 g","chicken stock mix"],["250 g","diced chicken breast"],["25 ml","mayonnaise"],["1","garlic clove"],["50 g","baby leaf salad"],["16 g","tomato paste"],["15 ml","white wine vinegar"],["130 g","bulgur wheat"],["as needed","Pepper"],["as needed","Salt"],["as needed","Butter"],["as needed","Olive oil"]],"lunchBucket":"wrap","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-59bf8477-446d-4c5b-9bbc-6d8938b35aac","sourceId":"59bf8477-446d-4c5b-9bbc-6d8938b35aac","title":"One Tray Harissa Hake & Cherry Tomato Traybake","subtitle":"All hail the heady aroma of harissa.","time":35,"cost":19.99,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fusion","other","cook"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/4031_Harissa-Basa--Cherry-Tomato-Traybake_001-1681395167243-1758552840650-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/harissa-hake-cherry-tomato-traybake","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["20 g","harissa paste"],["1","hake fillets"],["2 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["160 g","fine green beans"],["125 g","cherry tomatoes"],["4","white potato"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"sourceIngredients":[["20 g","harissa paste"],["1","hake fillets"],["2 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["160 g","fine green beans"],["125 g","cherry tomatoes"],["4","white potato"]],"ingredientMeta":[{"name":"harissa paste","amount":"20 g","shoppingName":"harissa paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"hake fillets","amount":"1","shoppingName":"hake fillets","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground smoked paprika","amount":"2 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mayonnaise","amount":"25 ml","shoppingName":"mayonnaise","marketChecked":true,"priceMatchType":"source-identity"},{"name":"fine green beans","amount":"160 g","shoppingName":"fine green beans","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cherry tomatoes","amount":"125 g","shoppingName":"cherry tomatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"white potato","amount":"4","shoppingName":"white potato","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7 Chop your potatoes (skins on) into bite-sized pieces Add the chopped potatoes to a baking tray with a drizzle of olive oil and a pinch of salt and pepper Give everything a good mix up and put the tray in the oven for an initial 18 min","Pat your fish fillet[s] dry with kitchen paper Add half your ground smoked paprika (save the rest for later!) to a plate with a pinch of salt and pepper and mix it together Add the fish fillet[s] to the plate and turn until fully coated, then set aside – this is your smoky fish fillet","Chop your cherry tomatoes in half","Trim, then chop your green beans in half","After the initial 18 min, remove the tray[s] from the oven Add the chopped tomatoes and chopped green beans to the tray[s] with a drizzle of olive oil Sprinkle over the remaining ground smoked paprika and give everything a good mix up","Add the smoky fish fillet[s] to the tray[s] with a drizzle of olive oil Return the tray[s] to the oven for a further 12-15 min or until the fish is cooked through, the potatoes are crisp and the vegetables have softened – this is your smoky fish tray bake Tip: Your fish is cooked once it turns opaque and flakes easily","Meanwhile, combine your mayo and harissa paste (can't handle the heat? Go easy!) in a small bowl and mix it all together – this is your harissa mayo","Serve the smoky fish tray bake with the harissa mayo drizzled over the top Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-copy-1775127266998-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-copy-1775127272236-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-copy-1775127277474-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-copy-1775127283040-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-copy-1775127288202-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1775127293641-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-copy-1775127298267-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/harissa-hake-cherry-tomato-traybake","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/harissa-hake-cherry-tomato-traybake","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["20 g","harissa paste"],["1","hake fillets"],["2 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["160 g","fine green beans"],["125 g","cherry tomatoes"],["4","white potato"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"lunchBucket":"other","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-a4263409-2452-4e09-b1a8-021f259363e3","sourceId":"a4263409-2452-4e09-b1a8-021f259363e3","title":"Golden Halloumi With Tzatziki, Fruity Couscous & A Chicken Breast","subtitle":"Bring some sunshine to your table with couscous tossed with almonds, sultanas and dried chopped dates.","time":20,"cost":24.4,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","greek","grain","quick"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/2271_Golden-Halloumi-With-Tzatziki-And-Fruity-Couscous-1786693771506-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/golden-halloumi-with-tzatziki-and-fruity-couscous-a-chicken-breast","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["200 g","halloumi"],["2","tomato"],["1","chicken breast portions"],["80 g","natural yoghurt"],["1","lemon"],["120 g","couscous"],["5.5 g","vegetable stock mix"],["1","cucumber"],["30 g","sultanas"],["30 g","chopped dates"],["5 g","mint"],["5 g","dill"],["15 g","flaked almonds"],["as needed","Olive oil"],["as needed","Water"]],"sourceIngredients":[["200 g","halloumi"],["2","tomato"],["1","chicken breast portions"],["80 g","natural yoghurt"],["1","lemon"],["120 g","couscous"],["5.5 g","vegetable stock mix"],["1","cucumber"],["30 g","sultanas"],["30 g","chopped dates"],["5 g","mint"],["5 g","dill"],["15 g","flaked almonds"]],"ingredientMeta":[{"name":"halloumi","amount":"200 g","shoppingName":"halloumi","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato","amount":"2","shoppingName":"tomato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chicken breast portions","amount":"1","shoppingName":"chicken breast portions","marketChecked":true,"priceMatchType":"source-identity"},{"name":"natural yoghurt","amount":"80 g","shoppingName":"natural yoghurt","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lemon","amount":"1","shoppingName":"lemon","marketChecked":true,"priceMatchType":"source-identity"},{"name":"couscous","amount":"120 g","shoppingName":"couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"vegetable stock mix","amount":"5.5 g","shoppingName":"vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cucumber","amount":"1","shoppingName":"cucumber","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sultanas","amount":"30 g","shoppingName":"sultanas","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chopped dates","amount":"30 g","shoppingName":"chopped dates","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mint","amount":"5 g","shoppingName":"mint","marketChecked":true,"priceMatchType":"source-identity"},{"name":"dill","amount":"5 g","shoppingName":"dill","marketChecked":true,"priceMatchType":"source-identity"},{"name":"flaked almonds","amount":"15 g","shoppingName":"flaked almonds","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you begin... Get all your ingredients and equipment ready Skim through these steps, then wash your fruit and veg Note: Equipment and pan sizes vary. Make sure you cook food thoroughly (even if it takes you a little longer than 10 min)","Now, let's get started! Boil a kettle, then grate your cucumber Strip your mint leaves from their stems and chop them roughly, discard the stems Cut your lemon[s] into wedges","Add your vegetable stock mix to a heatproof bowl with your sultanas , chopped dates and couscous Add 250ml boiled water , give everything a good mix up, cover and set aside for later – this is your fruity couscous","Add your natural yoghurt to a bowl with the grated cucumber and chopped mint Add a drizzle of olive oil and the juice of half the lemon wedges and stir it all together – this is your tzatziki","Heat a large, wide-based pan (preferably non-stick) with a drizzle of olive oil over a high heat Cut your halloumi into 3 slices per person Once hot, add the halloumi slices and cook for 1-2 min on each side or until golden","Whilst the halloumi is cooking, dice your tomato[es] finely Chop your dill roughly, including the stalks","Add your flaked almonds and diced tomato to the fruity couscous with a generous drizzle of olive oil and a big squeeze of lemon juice and fluff everything up with a fork","Serve the golden halloumi with the tzatziki and fruity couscous to the side Garnish with the chopped dill and a lemon wedge Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Admin10mm-Step-1-1611657897524-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/2271.-step-2-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/2271.-step-3-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/2271.-step-4-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/2271.-step-5-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1738687946692-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1779789304025-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/golden-halloumi-with-tzatziki-and-fruity-couscous-a-chicken-breast","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/golden-halloumi-with-tzatziki-and-fruity-couscous-a-chicken-breast","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["200 g","halloumi"],["2","tomato"],["1","chicken breast portions"],["80 g","natural yoghurt"],["1","lemon"],["120 g","couscous"],["5.5 g","vegetable stock mix"],["1","cucumber"],["30 g","sultanas"],["30 g","chopped dates"],["5 g","mint"],["5 g","dill"],["15 g","flaked almonds"],["as needed","Olive oil"],["as needed","Water"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-f6e070ed-9ea6-4103-8576-390ea4651570","sourceId":"f6e070ed-9ea6-4103-8576-390ea4651570","title":"One Tray Chicken Thigh Alfredo Garlic Flatbread","subtitle":"The ultimate crossover for a night in.","time":25,"cost":25.74,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","american","wrap","quick"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/14124---Garlic-Chicken-Alfredo-Flatbread9327-1779440241568-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/chicken-thigh-alfredo-garlic-flatbread","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["30 g","grated Italian hard cheese"],["5.5 g","chicken stock mix"],["1","Wildfarmed pizza bases"],["40 g","Cornish clotted cream"],["250 g","diced chicken thigh"],["2","garlic clove"],["1","tomato"],["5 g","parsley"],["1","shallot"],["20 g","rocket"],["as needed","Olive oil"],["as needed","Butter"],["as needed","Salt"],["as needed","Pepper"],["as needed","Water"]],"sourceIngredients":[["30 g","grated Italian hard cheese"],["5.5 g","chicken stock mix"],["1","Wildfarmed pizza bases"],["40 g","Cornish clotted cream"],["250 g","diced chicken thigh"],["2","garlic clove"],["1","tomato"],["5 g","parsley"],["1","shallot"],["20 g","rocket"]],"ingredientMeta":[{"name":"grated Italian hard cheese","amount":"30 g","shoppingName":"grated Italian hard cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chicken stock mix","amount":"5.5 g","shoppingName":"chicken stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Wildfarmed pizza bases","amount":"1","shoppingName":"Wildfarmed pizza bases","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Cornish clotted cream","amount":"40 g","shoppingName":"Cornish clotted cream","marketChecked":true,"priceMatchType":"source-identity"},{"name":"diced chicken thigh","amount":"250 g","shoppingName":"diced chicken thigh","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato","amount":"1","shoppingName":"tomato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"parsley","amount":"5 g","shoppingName":"parsley","marketChecked":true,"priceMatchType":"source-identity"},{"name":"shallot","amount":"1","shoppingName":"shallot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"rocket","amount":"20 g","shoppingName":"rocket","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7, then take your chicken out of the fridge, open the packet and let it air Peel and finely chop (or grate) your garlic Peel and chop your shallot[s] into wedges Chop your parsley finely, including the stalks","Add a knob of butter and a drizzle of olive oil to a heatproof bowl with the chopped garlic and put it in the microwave for 30 sec or until melted Once melted, add half the chopped parsley (you'll use the rest later!) with a pinch of salt and pepper – this is your garlic butter","Add your pizza base[s] to a baking paper -lined baking tray Top your flatbread with your diced chicken and shallot wedges and pour over the garlic butter (reserve the bowl!) with a generous pinch of salt and pepper Tip: Doubled your protein? Do this in batches!","Put the tray in the oven for an initial 20-25 min or until the chicken is cooked through (no pink meat!) – this is your chicken garlic flatbread","While the flatbread is cooking, boil a little water in the kettle Wash your salad , then pat dry with kitchen paper Chop your tomato[es] finely","Combine your clotted cream and chicken stock mix in the reserved bowl (no need to wipe clean!) with 1 tsp boiled water and half your grated Italian hard cheese (you'll use the rest later!) Give everything a good mix up until it is a paste-like consistency – this is your Alfredo sauce","Once the chicken garlic flatbread is ready, remove the tray from the oven and dollop on the Alfredo sauce and remaining chopped parsley Return the tray to the oven for a final 2-3 min or until the Alfredo sauce has melted – this is your chicken Alfredo garlic flatbread","Serve the chicken Alfredo garlic flatbread and top with the salad , chopped tomatoes and the remaining grated Italian hard cheese Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1781105325274-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1781105328071-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1781105331120-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1781105334386-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1781105336845-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1781105340425-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1781105342907-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/chicken-thigh-alfredo-garlic-flatbread","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/chicken-thigh-alfredo-garlic-flatbread","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["30 g","grated Italian hard cheese"],["5.5 g","chicken stock mix"],["1","Wildfarmed pizza bases"],["40 g","Cornish clotted cream"],["250 g","diced chicken thigh"],["2","garlic clove"],["1","tomato"],["5 g","parsley"],["1","shallot"],["20 g","rocket"],["as needed","Olive oil"],["as needed","Butter"],["as needed","Salt"],["as needed","Pepper"],["as needed","Water"]],"lunchBucket":"wrap","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-bc454ef0-1ba9-485a-92be-eb7ba6c0577c","sourceId":"bc454ef0-1ba9-485a-92be-eb7ba6c0577c","title":"Harissa & Tomato Halloumi With Couscous & A Chicken Breast","subtitle":"Chunky halloumi bites are the perfect match for punchy North African harissa.","time":20,"cost":22.29,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","moroccan","grain","quick"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Kettle","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/3883_Harissa--Tomato-Halloumi-With-Couscous-1788783657001-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/harissa-tomato-halloumi-with-a-chicken-breast","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["200 g","halloumi"],["20 g","harissa paste"],["1","chicken breast portions"],["32 g","tomato paste"],["15 g","pumpkin seeds"],["80 g","natural yoghurt"],["120 g","couscous"],["160 g","fine green beans"],["125 g","baby plum tomatoes"],["as needed","Pepper"],["as needed","Olive oil"],["as needed","Salt"],["as needed","Water"]],"sourceIngredients":[["200 g","halloumi"],["20 g","harissa paste"],["1","chicken breast portions"],["32 g","tomato paste"],["15 g","pumpkin seeds"],["80 g","natural yoghurt"],["120 g","couscous"],["160 g","fine green beans"],["125 g","baby plum tomatoes"]],"ingredientMeta":[{"name":"halloumi","amount":"200 g","shoppingName":"halloumi","marketChecked":true,"priceMatchType":"source-identity"},{"name":"harissa paste","amount":"20 g","shoppingName":"harissa paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chicken breast portions","amount":"1","shoppingName":"chicken breast portions","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"32 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"pumpkin seeds","amount":"15 g","shoppingName":"pumpkin seeds","marketChecked":true,"priceMatchType":"source-identity"},{"name":"natural yoghurt","amount":"80 g","shoppingName":"natural yoghurt","marketChecked":true,"priceMatchType":"source-identity"},{"name":"couscous","amount":"120 g","shoppingName":"couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"fine green beans","amount":"160 g","shoppingName":"fine green beans","marketChecked":true,"priceMatchType":"source-identity"},{"name":"baby plum tomatoes","amount":"125 g","shoppingName":"baby plum tomatoes","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Boil half a kettle Cut your halloumi into slices","Trim, then chop your green beans in half Roughly chop your baby plum tomatoes","Heat a large, wide-based pan (preferably non-stick with a matching lid) with a drizzle of olive oil over a medium-high heat Once hot, add the halved green beans and cook for 2-3 min or until beginning to soften Once slightly softened, add the sliced halloumi and cook for 1-2 min or until starting to brown","Whilst the halloumi is browning, add your couscous to a heatproof bowl Add 200ml boiled water and a pinch of salt , give everything a good mix up then cover and set aside","Combine your tomato paste and harissa paste (can’t handle the heat? Go easy!) with 80ml boiled water and mix everything together – this is your harissa stock","Once the halloumi is browned, add the chopped baby plum tomatoes and harissa stock to the pan","Cook, covered, for 3-4 min or until the sauce has thickened and the tomatoes are starting to break down Season with a grind of black pepper – this is your harissa & tomato halloumi Fluff the couscous with a fork","Serve the harissa & tomato halloumi with the couscous to the side Dollop with your natural yoghurt and sprinkle over your pumpkin seeds Taste for seasoning, adding more salt and pepper if needed Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1677575457153-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1677575461246-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1677575465107-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1677575468778-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1677575472097-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1677575475691-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1677575479553-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/harissa-tomato-halloumi-with-a-chicken-breast","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/harissa-tomato-halloumi-with-a-chicken-breast","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["200 g","halloumi"],["20 g","harissa paste"],["1","chicken breast portions"],["32 g","tomato paste"],["15 g","pumpkin seeds"],["80 g","natural yoghurt"],["120 g","couscous"],["160 g","fine green beans"],["125 g","baby plum tomatoes"],["as needed","Pepper"],["as needed","Olive oil"],["as needed","Salt"],["as needed","Water"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-11bd9554-b4f5-4d70-9724-a8b9a4949b5e","sourceId":"11bd9554-b4f5-4d70-9724-a8b9a4949b5e","title":"One Pan Balsamic & Tomato Chicken Breast With Giant Couscous & Feta","subtitle":"Polish off your favourite pan, this delicious dinner is done in one.","time":25,"cost":20.33,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fusion","grain","quick"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Kettle","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-7745-2-One-Pot-Balsamic--Tomato-Chicken-With-Giant-Couscous--Feta-1_0-1786014224558-1786714414011-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/one-pan-balsamic-tomato-chicken-breast-with-giant-couscous-feta","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["5.5 g","intense chicken stock mix"],["1","chicken breast portions"],["32 g","tomato paste"],["1","garlic clove"],["30 g","balsamic sun-dried tomato paste"],["30 g","feta"],["130 g","giant couscous"],["120 g","spinach"],["as needed","Salt"],["as needed","Olive oil"],["as needed","Water"],["as needed","Sugar"],["as needed","Pepper"]],"sourceIngredients":[["5.5 g","intense chicken stock mix"],["1","chicken breast portions"],["32 g","tomato paste"],["1","garlic clove"],["30 g","balsamic sun-dried tomato paste"],["30 g","feta"],["130 g","giant couscous"],["120 g","spinach"]],"ingredientMeta":[{"name":"intense chicken stock mix","amount":"5.5 g","shoppingName":"intense chicken stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chicken breast portions","amount":"1","shoppingName":"chicken breast portions","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"32 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"balsamic sun-dried tomato paste","amount":"30 g","shoppingName":"balsamic sun-dried tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"feta","amount":"30 g","shoppingName":"feta","marketChecked":true,"priceMatchType":"source-identity"},{"name":"giant couscous","amount":"130 g","shoppingName":"giant couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"spinach","amount":"120 g","shoppingName":"spinach","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you start, take your chicken out of the fridge, open the packet and let it air Heat a large, wide-based pan (preferably non-stick with a matching lid), with a drizzle of olive oil over a medium-high heat Season your chicken with generous pinch of salt and pepper Once hot, add the chicken (cooking for 3 or more? Use 2 pans!) and cook for 4 min on each side or until lightly browned, once done, transfer to a plate and reserve the pan","Boil a kettle Wash your spinach and pat dry with kitchen paper Peel and finely chop (or grate) your garlic","Return the reserved pan to a medium heat Add your tomato paste and chopped garlic cook for 2-3 min or until fragrant","Once fragrant, add your giant couscous with a pinch of salt and cook for 1 min, stirring to coat the grains Add your chicken stock mix , half your balsamic sun-dried tomato paste (save the rest for later!) and 1 tsp sugar with 400ml boiled water Give everything a good mix up","Add the spinach and stir it all together Cover with a lid and cook for 1-2 min or until the spinach is wilted","Nestle the browned chicken into the giant couscous and bring to the boil over a high heat Once boiling, reduce the heat to medium-high and cook, covered, for 10-12 min or until the chicken is cooked through (no pink meat!) – this is your one pan balsamic & tomato chicken with giant couscous","Meanwhile, combine your remaining balsamic sun-dried tomato paste with a drizzle of olive oil and a splash of cold water – this is your balsamic tomato drizzle","Serve the one pan balsamic & tomato chicken breast with giant couscous with a drizzle of balsamic tomato dressing To finish crumble your feta all over and add a generous grind of pepper Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1732282821818-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1732282826767-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1732282835349-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1732282840397-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1732282844671-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1732282849080-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1732282853435-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/one-pan-balsamic-tomato-chicken-breast-with-giant-couscous-feta","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/one-pan-balsamic-tomato-chicken-breast-with-giant-couscous-feta","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["5.5 g","intense chicken stock mix"],["1","chicken breast portions"],["32 g","tomato paste"],["1","garlic clove"],["30 g","balsamic sun-dried tomato paste"],["30 g","feta"],["130 g","giant couscous"],["120 g","spinach"],["as needed","Salt"],["as needed","Olive oil"],["as needed","Water"],["as needed","Sugar"],["as needed","Pepper"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-8c70ba4b-e9b1-4bcd-96d2-ef003e44cef3","sourceId":"8c70ba4b-e9b1-4bcd-96d2-ef003e44cef3","title":"One Pan Balsamic & Tomato Chicken Thigh With Giant Couscous & Feta","subtitle":"Polish off your favourite pan, this delicious dinner is done in one.","time":25,"cost":21.06,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fusion","grain","quick"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Kettle","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-7745-2-One-Pot-Balsamic--Tomato-Chicken-With-Giant-Couscous--Feta-1_0-1786014224558-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/one-pan-balsamic-tomato-chicken-thigh-with-giant-couscous-feta","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["5.5 g","intense chicken stock mix"],["320 g","skinless chicken thighs"],["32 g","tomato paste"],["1","garlic clove"],["30 g","balsamic sun-dried tomato paste"],["30 g","feta"],["130 g","giant couscous"],["120 g","spinach"],["as needed","Salt"],["as needed","Olive oil"],["as needed","Water"],["as needed","Sugar"],["as needed","Pepper"]],"sourceIngredients":[["5.5 g","intense chicken stock mix"],["320 g","skinless chicken thighs"],["32 g","tomato paste"],["1","garlic clove"],["30 g","balsamic sun-dried tomato paste"],["30 g","feta"],["130 g","giant couscous"],["120 g","spinach"]],"ingredientMeta":[{"name":"intense chicken stock mix","amount":"5.5 g","shoppingName":"intense chicken stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"skinless chicken thighs","amount":"320 g","shoppingName":"skinless chicken thighs","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"32 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"balsamic sun-dried tomato paste","amount":"30 g","shoppingName":"balsamic sun-dried tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"feta","amount":"30 g","shoppingName":"feta","marketChecked":true,"priceMatchType":"source-identity"},{"name":"giant couscous","amount":"130 g","shoppingName":"giant couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"spinach","amount":"120 g","shoppingName":"spinach","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you start, take your chicken out of the fridge, open the packet and let it air Heat a large, wide-based pan (preferably non-stick with a matching lid), with a drizzle of olive oil over a medium-high heat Season your chicken with generous pinch of salt and pepper , once hot, add the chicken (cooking for 3 or more? Use 2 pans!) and cook for 4 min on each side or until lightly browned, once done, transfer to a plate and reserve the pan","Boil a kettle Wash your spinach and pat dry with kitchen paper Peel and finely chop (or grate) your garlic","Return the reserved pan to a medium heat Add your tomato paste and chopped garlic cook for 2-3 min or until fragrant","Once fragrant, add your giant couscous with a pinch of salt and cook for 1 min, stirring to coat the grains Add your chicken stock mix , half your balsamic sun-dried tomato paste (save the rest for later!) and 1 tsp sugar with 400ml boiled water Give everything a good mix up","Add the spinach and stir it all together Cover with a lid and cook for 1-2 min or until the spinach is wilted","Nestle the browned chicken into the giant couscous and bring to the boil over a high heat Once boiling, reduce the heat to medium and cook, covered, for 10 min or until the chicken is cooked through (no pink meat!) – this is your one pan balsamic & tomato chicken with giant couscous","Meanwhile, combine your remaining balsamic sun-dried tomato paste with a drizzle of olive oil and a splash of cold water – this is your balsamic tomato drizzle","Serve the one pan balsamic & tomato chicken with giant couscous with a drizzle of balsamic tomato dressing To finish crumble your feta all over and add a generous grind of pepper Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1732282821818-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1732282826767-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1732282835349-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1732282840397-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1732282844671-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1732282849080-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1732282853435-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/one-pan-balsamic-tomato-chicken-thigh-with-giant-couscous-feta","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/one-pan-balsamic-tomato-chicken-thigh-with-giant-couscous-feta","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["5.5 g","intense chicken stock mix"],["320 g","skinless chicken thighs"],["32 g","tomato paste"],["1","garlic clove"],["30 g","balsamic sun-dried tomato paste"],["30 g","feta"],["130 g","giant couscous"],["120 g","spinach"],["as needed","Salt"],["as needed","Olive oil"],["as needed","Water"],["as needed","Sugar"],["as needed","Pepper"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-eee3e8cf-c8b7-4022-bc67-844052cb00a9","sourceId":"eee3e8cf-c8b7-4022-bc67-844052cb00a9","title":"One Pot Chicken Thigh Shawarma Couscous With Harissa Yoghurt","subtitle":"One pan, endless flavour.","time":25,"cost":29.53,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fusion","grain","quick"],"requiredEquipment":[],"sourceEquipment":["Saucepan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/16478_One-Pot-Chicken-Thigh-Shawarma-Couscous-With-Harissa-Yoghurt_003_0-1787219141754-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/one-pot-chicken-thigh-shawarma-couscous-with-harissa-yoghurt","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["20 g","harissa paste"],["5.5 g","intense chicken stock mix"],["1","red pepper"],["3 g","Mediterranean-style seasoning"],["8 ml","soy sauce"],["250 g","diced chicken thigh"],["1 tsp","ground smoked paprika"],["1 g","smoked sea salt flakes"],["3","garlic clove"],["50 g","baby leaf salad"],["80 g","natural yoghurt"],["120 g","couscous"],["15 ml","red wine vinegar"],["1","red onion"],["as needed","Olive oil"],["as needed","Sugar"],["as needed","Water"],["as needed","Pepper"],["as needed","Salt"]],"sourceIngredients":[["20 g","harissa paste"],["5.5 g","intense chicken stock mix"],["1","red pepper"],["3 g","Mediterranean-style seasoning"],["8 ml","soy sauce"],["250 g","diced chicken thigh"],["1 tsp","ground smoked paprika"],["1 g","smoked sea salt flakes"],["3","garlic clove"],["50 g","baby leaf salad"],["80 g","natural yoghurt"],["120 g","couscous"],["15 ml","red wine vinegar"],["1","red onion"]],"ingredientMeta":[{"name":"harissa paste","amount":"20 g","shoppingName":"harissa paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense chicken stock mix","amount":"5.5 g","shoppingName":"intense chicken stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red pepper","amount":"1","shoppingName":"red pepper","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Mediterranean-style seasoning","amount":"3 g","shoppingName":"Mediterranean-style seasoning","marketChecked":true,"priceMatchType":"source-identity"},{"name":"soy sauce","amount":"8 ml","shoppingName":"soy sauce","marketChecked":true,"priceMatchType":"source-identity"},{"name":"diced chicken thigh","amount":"250 g","shoppingName":"diced chicken thigh","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground smoked paprika","amount":"1 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"smoked sea salt flakes","amount":"1 g","shoppingName":"smoked sea salt flakes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"3","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"baby leaf salad","amount":"50 g","shoppingName":"baby leaf salad","marketChecked":true,"priceMatchType":"source-identity"},{"name":"natural yoghurt","amount":"80 g","shoppingName":"natural yoghurt","marketChecked":true,"priceMatchType":"source-identity"},{"name":"couscous","amount":"120 g","shoppingName":"couscous","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red wine vinegar","amount":"15 ml","shoppingName":"red wine vinegar","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you start cooking, take your chicken out of the fridge, open the packet and let it air Boil a kettle Heat a pot (with a matching lid) with a drizzle of olive oil over a high heat Once hot, add your diced chicken and cook for 3-4 min or until lightly browned (Doubled your protein? Use 2 pans!)","Meanwhile, deseed your pepper[s] (scrape the seeds and pith out with a teaspoon) and roughly dice Peel and finely chop (or grate) your garlic Peel and slice your red onion[s] finely Add a little of the sliced onion (you'll use the rest later!) to a small to a bowl with your red wine vinegar , a pinch of sugar and a small pinch of salt , then set aside to pickle – this is your quick-pickled onion","Once the chicken has browned, add the sliced onion and diced pepper to pan with a pinch of salt Cook for 4-5 min or until starting to soften","Once the veg has softened, add the chopped garlic , your Mediterranean style seasoning and ground smoked paprika and cook for 30 secs or until fragrant","Once fragrant, add your soy sauce with 1/2 tsp sugar and 200ml boiled water Reduce the heat to medium-high and cook, covered, for 6-8 min or until the chicken is cooked through (no pink meat!)","Once the chicken is cooked through, add your chicken stock mix and smoked sea salt flakes and give everything a good mix up","Add your couscous to the pot, stir it all together and cover with a lid and set aside (off the heat!) for 3-4 min or until all of the stock has been absorbed, then fluff with a fork – this is your one pot chicken shawarma couscous Wash your salad , then pat dry with kitchen paper Drain the quick-pickled onion , reserve the pickling liquid","Serve the one pot chicken shawarma couscous with the salad to the side Dress the salad with a little reserved pickling liquid and a drizzle of olive oil then drizzle your natural yoghurt and harissa paste (cant handle the heat go easy!) all over the couscous Garnish with your quick-pickled onion , a drizzle of olive oil and a grind of pepper Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1781180185643-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1781180189178-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1781180193464-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1781180196789-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1781180200510-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1781180204200-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1781180208046-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/one-pot-chicken-thigh-shawarma-couscous-with-harissa-yoghurt","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/one-pot-chicken-thigh-shawarma-couscous-with-harissa-yoghurt","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["20 g","harissa paste"],["5.5 g","intense chicken stock mix"],["1","red pepper"],["3 g","Mediterranean-style seasoning"],["8 ml","soy sauce"],["250 g","diced chicken thigh"],["1 tsp","ground smoked paprika"],["1 g","smoked sea salt flakes"],["3","garlic clove"],["50 g","baby leaf salad"],["80 g","natural yoghurt"],["120 g","couscous"],["15 ml","red wine vinegar"],["1","red onion"],["as needed","Olive oil"],["as needed","Sugar"],["as needed","Water"],["as needed","Pepper"],["as needed","Salt"]],"lunchBucket":"grain","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-35eaf22b-e749-4277-9579-f5d0df64a42a","sourceId":"35eaf22b-e749-4277-9579-f5d0df64a42a","title":"Warming Herby Persian-Style Noodle Soup","subtitle":"This dish, inspired by Ash Reshteh, is a wholesome, herby soup with a green, aromatic broth, fine egg noodles, black beans and lentils.","time":30,"cost":19.08,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","vegetarian","soup recipes","asian","soup","quick"],"requiredEquipment":[],"sourceEquipment":["Saucepan","Kettle"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/2683_Warming-Herby-Persian-Noodle-Soup-V_003-1657622535793-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/warming-herby-persian-noodle-soup","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1 tsp","ground turmeric"],["1","leek"],["8 ml","soy sauce"],["250 g","cooked champagne lentils"],["80 g","soured cream"],["3","garlic clove"],["185 g","black beans"],["1","fine egg noodle nest"],["1","lemon"],["15 g","crispy onions"],["120 g","spinach"],["10 g","coriander & mint"],["10 g","parsley & dill"],["11 g","vegetable stock mix"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"]],"sourceIngredients":[["1 tsp","ground turmeric"],["1","leek"],["8 ml","soy sauce"],["250 g","cooked champagne lentils"],["80 g","soured cream"],["3","garlic clove"],["185 g","black beans"],["1","fine egg noodle nest"],["1","lemon"],["15 g","crispy onions"],["120 g","spinach"],["10 g","coriander & mint"],["10 g","parsley & dill"],["11 g","vegetable stock mix"]],"ingredientMeta":[{"name":"ground turmeric","amount":"1 tsp","shoppingName":"ground turmeric","marketChecked":true,"priceMatchType":"source-identity"},{"name":"leek","amount":"1","shoppingName":"leek","marketChecked":true,"priceMatchType":"source-identity"},{"name":"soy sauce","amount":"8 ml","shoppingName":"soy sauce","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cooked champagne lentils","amount":"250 g","shoppingName":"cooked champagne lentils","marketChecked":true,"priceMatchType":"source-identity"},{"name":"soured cream","amount":"80 g","shoppingName":"soured cream","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"3","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"black beans","amount":"185 g","shoppingName":"black beans","marketChecked":true,"priceMatchType":"source-identity"},{"name":"fine egg noodle nest","amount":"1","shoppingName":"fine egg noodle nest","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lemon","amount":"1","shoppingName":"lemon","marketChecked":true,"priceMatchType":"source-identity"},{"name":"crispy onions","amount":"15 g","shoppingName":"crispy onions","marketChecked":true,"priceMatchType":"source-identity"},{"name":"spinach","amount":"120 g","shoppingName":"spinach","marketChecked":true,"priceMatchType":"source-identity"},{"name":"coriander & mint","amount":"10 g","shoppingName":"coriander & mint","marketChecked":true,"priceMatchType":"source-identity"},{"name":"parsley & dill","amount":"10 g","shoppingName":"parsley & dill","marketChecked":true,"priceMatchType":"source-identity"},{"name":"vegetable stock mix","amount":"11 g","shoppingName":"vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Chop the leek in half lengthways, wash thoroughly to remove any grit from between the leaves, then top, tail and slice finely Peel and finely slice (don't chop!) the garlic Wash the spinach , then pat it dry with kitchen paper","Boil a kettle Heat a large pot with a drizzle of olive oil over a medium-low heat Once hot, add the sliced leek and a generous pinch of salt and cook for 3-4 min or until softened","Drain and rinse the black beans and champagne lentils Dissolve the vegetable stock mix in 650ml boiled water","Pick a few leaves from the dill , coriander , mint and parsley and set aside for garnish Pick the remaining mint leaves from their stalks, then chop all of the herbs together roughly, discard the mint stalks","Once the leek has softened, add the chopped garlic to the pot with the ground turmeric and cook for 30 secs or until fragrant Add the vegetable stock with the spinach , chopped herbs and soy sauce and bring to the boil over a high heat Season generously with a grind of black pepper","Add the fine egg noodles to the pot and stir them with a fork until separated and beginning to soften Add the drained black beans and lentils to the pot with a pinch of salt and cook for 2-3 min further or until the noodles are tender and everything’s warmed through","Once done, add the juice of 1/2 lemon and give everything a good mix up – this is your warming herby Persian-style noodle soup Cut the remaining lemon into wedges","Serve the warming herby Persian-style noodle soup in bowls Top with a dollop of soured cream and sprinkle over the crispy onions Garnish with the reserved herbs and a lemon wedge Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1651247016494-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1651247018966-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1651247025392-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1651247029152-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1651247034848-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1651247037766-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1651247042127-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/warming-herby-persian-noodle-soup","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/warming-herby-persian-noodle-soup","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1 tsp","ground turmeric"],["1","leek"],["8 ml","soy sauce"],["250 g","cooked champagne lentils"],["80 g","soured cream"],["3","garlic clove"],["185 g","black beans"],["1","fine egg noodle nest"],["1","lemon"],["15 g","crispy onions"],["120 g","spinach"],["10 g","coriander & mint"],["10 g","parsley & dill"],["11 g","vegetable stock mix"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"]],"lunchBucket":"soup","isLunch":true,"prepStyle":"quick","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-27f1acf4-3beb-4f70-b684-4f02c23b71c3","sourceId":"27f1acf4-3beb-4f70-b684-4f02c23b71c3","title":"King Prawn Soup With Orzo And Garlic Aioli","subtitle":"Switch up your soup of the day with this Mediterranean medley.","time":20,"cost":20.34,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","french","soup","quick"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Kettle","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/5642_King-Prawn--Saffron-Soup-with-Orzo-and-Garlic-Aiolli_003_0-1684415064791-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/king-prawn-saffron-soup-with-orzo-and-garlic-aioli","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["171 g","raw peeled king prawns"],["1","tomato"],["1","red pepper"],["1 tsp","ground smoked paprika"],["5.5 g","intense vegetable stock mix"],["25 ml","mayonnaise"],["1","shallot"],["15 g","roasted garlic paste"],["16 g","tomato paste"],["15 ml","Chinese rice wine"],["150 g","orzo"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"sourceIngredients":[["171 g","raw peeled king prawns"],["1","tomato"],["1","red pepper"],["1 tsp","ground smoked paprika"],["5.5 g","intense vegetable stock mix"],["25 ml","mayonnaise"],["1","shallot"],["15 g","roasted garlic paste"],["16 g","tomato paste"],["15 ml","Chinese rice wine"],["150 g","orzo"]],"ingredientMeta":[{"name":"raw peeled king prawns","amount":"171 g","shoppingName":"raw peeled king prawns","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato","amount":"1","shoppingName":"tomato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red pepper","amount":"1","shoppingName":"red pepper","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground smoked paprika","amount":"1 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"intense vegetable stock mix","amount":"5.5 g","shoppingName":"intense vegetable stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mayonnaise","amount":"25 ml","shoppingName":"mayonnaise","marketChecked":true,"priceMatchType":"source-identity"},{"name":"shallot","amount":"1","shoppingName":"shallot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"roasted garlic paste","amount":"15 g","shoppingName":"roasted garlic paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato paste","amount":"16 g","shoppingName":"tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Chinese rice wine","amount":"15 ml","shoppingName":"Chinese rice wine","marketChecked":true,"priceMatchType":"source-identity"},{"name":"orzo","amount":"150 g","shoppingName":"orzo","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Boil a kettle Chop your tomato[es] roughly Deseed your pepper[s] (scrape the seeds and pith out with a teaspoon) and dice Peel and finely dice your shallot[s]","Heat a large, wide-based pan (preferably non-stick with a matching lid) with a generous drizzle of olive oil over a medium heat Once hot, add the diced shallot with a pinch of salt and pepper and cook for 2-3 min or until starting to soften","While the shallot is softening, dissolve your vegetable stock mix , tomato paste and Chinese rice wine in 750ml boiled water – this is your stock","Once the shallots are softened, add half of your roasted garlic paste (you'll use the rest later!), smoked paprika , chopped tomato and chopped peppers to the pan and cook for 2-3 min or until fragrant","Once fragrant, add the stock , your orzo and a pinch of salt to the pan and bring to the boil over a high heat Once boiling, reduce the heat to medium-low and cook, covered, for an initial 8-11 min Tip: Stir the orzo occasionally to stop it from sticking!","Meanwhile, combine your mayo and the remaining roasted garlic paste in a small bowl with 1 tsp cold water – this is your garlic aioli","Drain and add your king prawns to the pan and cook, covered, for a further 4-5 min or until the prawns are cooked through and the orzo is tender – this is your king prawn soup","Serve the king prawn soup in bowls and top with the garlic aioli Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1681828153285-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1681828157088-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1681828161007-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1681828168722-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1681828176027-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1681828182618-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1681828186353-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/king-prawn-saffron-soup-with-orzo-and-garlic-aioli","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/king-prawn-saffron-soup-with-orzo-and-garlic-aioli","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["171 g","raw peeled king prawns"],["1","tomato"],["1","red pepper"],["1 tsp","ground smoked paprika"],["5.5 g","intense vegetable stock mix"],["25 ml","mayonnaise"],["1","shallot"],["15 g","roasted garlic paste"],["16 g","tomato paste"],["15 ml","Chinese rice wine"],["150 g","orzo"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"lunchBucket":"soup","isLunch":true,"prepStyle":"quick","light":true,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-29b56b2b-1a90-496a-ba8d-b902ca1046c9","sourceId":"29b56b2b-1a90-496a-ba8d-b902ca1046c9","title":"Greek-Style Salad Baguette With Crushed Potatoes","subtitle":"This is summer in a baguette.","time":10,"cost":15.22,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","greek","sandwich","quick"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-7351-2-Greek-Chopped-Baguette-With-Crushed-Mediterranean-Potatoes-V2-1_0-1739358724840-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/chopped-greek-salad-baguette-with-crushed-mediterranean-potatoes","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["100 g","Greek salad cheese"],["1","tomato"],["1","baguettes"],["10 g","parsley & dill"],["1","mini cosberg lettuce"],["3 g","Mediterranean-style seasoning"],["350 g","waxy potatoes"],["40 g","black olives"],["390 g","chickpeas"],["as needed","Olive oil"],["as needed","Salt"],["as needed","Pepper"]],"sourceIngredients":[["100 g","Greek salad cheese"],["1","tomato"],["1","baguettes"],["10 g","parsley & dill"],["1","mini cosberg lettuce"],["3 g","Mediterranean-style seasoning"],["350 g","waxy potatoes"],["40 g","black olives"],["390 g","chickpeas"]],"ingredientMeta":[{"name":"Greek salad cheese","amount":"100 g","shoppingName":"Greek salad cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato","amount":"1","shoppingName":"tomato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"baguettes","amount":"1","shoppingName":"baguettes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"parsley & dill","amount":"10 g","shoppingName":"parsley & dill","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mini cosberg lettuce","amount":"1","shoppingName":"mini cosberg lettuce","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Mediterranean-style seasoning","amount":"3 g","shoppingName":"Mediterranean-style seasoning","marketChecked":true,"priceMatchType":"source-identity"},{"name":"waxy potatoes","amount":"350 g","shoppingName":"waxy potatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"black olives","amount":"40 g","shoppingName":"black olives","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chickpeas","amount":"390 g","shoppingName":"chickpeas","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Before you begin... Get all your ingredients and equipment ready Skim through these steps, then wash your fruit and veg Note: Equipment and pan sizes vary. Make sure you cook food thoroughly (even if it takes you a little longer than 10 min)","Preheat the oven to 200°C/ 180°C (fan)/ gas 6 Add your waxy potatoes to a heatproof bowl, then cover the bowl with cling film and pierce a few holes in the top with a fork Put the bowl in the microwave for 6-8 min or until the potatoes are fork-tender","Chop your tomato[es] roughly Chop your black olives roughly Chop your parsley & dill finely, including the stalks Wash then remove leaves (2 per person!) from your lettuce and set aside, shred the inner core","Drain and rinse your chickpeas Combine half your Mediterranean seasoning with a generous drizzle of olive oil and a pinch of salt in a large bowl and stir it all together – this is your Greek-style salad dressing Add your drained chickpeas to the bowl and crush lightly with a fork until fully combined","Add your chopped tomatoes , chopped olives and shredded lettuce to the bowl with half of the chopped dill & parsley (you'll use the rest later!) Crumble your Greek salad cheese into the bowl and season with a grind of black pepper and give everything a good mix up","Add your baguette[s] to a baking tray and put the tray in the oven for 2-3 min or until warmed through and crusty Slice each warmed baguette in half (without cutting all the way through) and open it out like a book","Once the potatoes are fork-tender, add a drizzle of olive oil and the remaining Mediterranean seasoning with pinch of salt and pepper and crush lightly with a fork Tip: Just crush them gently, or they'll turn to mash! Stir through the remaining dill & parsley – these are your crushed Mediterranean potatoes","To assemble, lay two lettuce leafs on the bottom of each sliced baguette Divide the chopped Greek-style salad evenly in each baguette Serve the crushed Mediterranean potatoes to the side Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1731327717738-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1731327721961-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1731327726571-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1731327731851-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1731327736259-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1731327740533-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1731327746674-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/chopped-greek-salad-baguette-with-crushed-mediterranean-potatoes","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/chopped-greek-salad-baguette-with-crushed-mediterranean-potatoes","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["100 g","Greek salad cheese"],["1","tomato"],["1","baguettes"],["10 g","parsley & dill"],["1","mini cosberg lettuce"],["3 g","Mediterranean-style seasoning"],["350 g","waxy potatoes"],["40 g","black olives"],["390 g","chickpeas"],["as needed","Olive oil"],["as needed","Salt"],["as needed","Pepper"]],"lunchBucket":"sandwich","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-450983e7-6f88-4b77-b1b0-ec9cad523a61","sourceId":"450983e7-6f88-4b77-b1b0-ec9cad523a61","title":"One Tray Chicken Breast Alfredo Garlic Flatbread","subtitle":"The ultimate crossover for a night in.","time":25,"cost":25.01,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","american","wrap","quick"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/14124---Garlic-Chicken-Alfredo-Flatbread9327-1779440241568-1780581181857-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/chicken-breast-alfredo-garlic-flatbread","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["30 g","grated Italian hard cheese"],["5.5 g","chicken stock mix"],["1","Wildfarmed pizza bases"],["40 g","Cornish clotted cream"],["250 g","diced chicken breast"],["2","garlic clove"],["1","tomato"],["5 g","parsley"],["1","shallot"],["20 g","rocket"],["as needed","Olive oil"],["as needed","Butter"],["as needed","Salt"],["as needed","Pepper"],["as needed","Water"]],"sourceIngredients":[["30 g","grated Italian hard cheese"],["5.5 g","chicken stock mix"],["1","Wildfarmed pizza bases"],["40 g","Cornish clotted cream"],["250 g","diced chicken breast"],["2","garlic clove"],["1","tomato"],["5 g","parsley"],["1","shallot"],["20 g","rocket"]],"ingredientMeta":[{"name":"grated Italian hard cheese","amount":"30 g","shoppingName":"grated Italian hard cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chicken stock mix","amount":"5.5 g","shoppingName":"chicken stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Wildfarmed pizza bases","amount":"1","shoppingName":"Wildfarmed pizza bases","marketChecked":true,"priceMatchType":"source-identity"},{"name":"Cornish clotted cream","amount":"40 g","shoppingName":"Cornish clotted cream","marketChecked":true,"priceMatchType":"source-identity"},{"name":"diced chicken breast","amount":"250 g","shoppingName":"diced chicken breast","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"2","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato","amount":"1","shoppingName":"tomato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"parsley","amount":"5 g","shoppingName":"parsley","marketChecked":true,"priceMatchType":"source-identity"},{"name":"shallot","amount":"1","shoppingName":"shallot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"rocket","amount":"20 g","shoppingName":"rocket","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7, then take your chicken out of the fridge, open the packet and let it air Peel and finely chop (or grate) your garlic Peel and chop your shallot[s] into wedges Chop your parsley finely, including the stalks","Add a knob of butter and a drizzle of olive oil to a heatproof bowl with the chopped garlic and put it in the microwave for 30 sec or until melted Once melted, add half the chopped parsley (you'll use the rest later!) with a pinch of salt and pepper – this is your garlic butter","Add your pizza base[s] to a baking paper -lined baking tray Top your flatbread with your diced chicken and shallot wedges and pour over the garlic butter (reserve the bowl!) with a generous pinch of salt and pepper Tip: Doubled your protein? Do this in batches!","Put the tray in the oven for an initial 20-25 min or until the chicken is cooked through (no pink meat!) – this is your chicken garlic flatbread","While the flatbread is cooking, boil a little water in the kettle Wash your salad , then pat dry with kitchen paper Chop your tomato[es] finely","Combine your clotted cream and chicken stock mix in the reserved bowl (no need to wipe clean!) with 1 tsp boiled water and half your grated Italian hard cheese (you'll use the rest later!) Give everything a good mix up until it is a paste-like consistency – this is your Alfredo sauce","Once the chicken garlic flatbread is ready, remove the tray from the oven and dollop on your Alfredo sauce and the remaining chopped parsley Return the tray to the oven for a final 2-3 min or until the Alfredo sauce has melted – this is your chicken Alfredo garlic flatbread","Serve the chicken Alfredo garlic flatbread and top with the salad , chopped tomatoes and the remaining grated Italian hard cheese Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1781105421606-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1781105423837-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1781105426520-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1781105428719-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1781105432022-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1781105435570-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1781105438723-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/chicken-breast-alfredo-garlic-flatbread","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/chicken-breast-alfredo-garlic-flatbread","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["30 g","grated Italian hard cheese"],["5.5 g","chicken stock mix"],["1","Wildfarmed pizza bases"],["40 g","Cornish clotted cream"],["250 g","diced chicken breast"],["2","garlic clove"],["1","tomato"],["5 g","parsley"],["1","shallot"],["20 g","rocket"],["as needed","Olive oil"],["as needed","Butter"],["as needed","Salt"],["as needed","Pepper"],["as needed","Water"]],"lunchBucket":"wrap","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-b21d53ba-d0a9-4d0f-bba7-189cc4782927","sourceId":"b21d53ba-d0a9-4d0f-bba7-189cc4782927","title":"Smoked Basa With Leek & Sweet Potato Hash And Poached Egg","subtitle":"Rustle up this hearty hash in a hurry.","time":30,"cost":23.98,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","british","potato","quick"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Frying pan","Saucepan","Kettle","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-5106-2_Smoked-Basa-Leek--Potato-Hash-With-Poached-Egg-0381-1-1676299575116-1755869851996-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/smoked-basa-with-leek-sweet-potato-hash-and-poached-egg","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["2","free range egg"],["1","leek"],["1","spring onion"],["1","garlic clove"],["1","smoked basa fillets"],["5 g","dill"],["80 g","spinach"],["2","sweet potato"],["as needed","Butter"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"]],"sourceIngredients":[["2","free range egg"],["1","leek"],["1","spring onion"],["1","garlic clove"],["1","smoked basa fillets"],["5 g","dill"],["80 g","spinach"],["2","sweet potato"]],"ingredientMeta":[{"name":"free range egg","amount":"2","shoppingName":"free range egg","marketChecked":true,"priceMatchType":"source-identity"},{"name":"leek","amount":"1","shoppingName":"leek","marketChecked":true,"priceMatchType":"source-identity"},{"name":"spring onion","amount":"1","shoppingName":"spring onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"smoked basa fillets","amount":"1","shoppingName":"smoked basa fillets","marketChecked":true,"priceMatchType":"source-identity"},{"name":"dill","amount":"5 g","shoppingName":"dill","marketChecked":true,"priceMatchType":"source-identity"},{"name":"spinach","amount":"80 g","shoppingName":"spinach","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sweet potato","amount":"2","shoppingName":"sweet potato","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7 and boil a kettle Chop your potato[es] (skins on) into bite-sized pieces Add the chopped potatoes to a pot with plenty of boiled water and bring to the boil over a high heat Once boiling, reduce the heat to medium and cook for 12-15 min or until fork-tender, then drain and reserve the pot","Chop your leek[s] in half lengthways, wash thoroughly to remove any grit then top, tail and slice finely Peel and finely chop (or grate) your garlic Chop your dill finely, including the stalks Trim, then slice your spring onion[s] finely","Cut a large piece of tin foil and place it on a baking tray Tip: Cooking for 3 or more? Use 2 trays! Place your smoked basa fillet[s] in the centre of the foil Top each basa fillet with a small knob of butter and a pinch of salt and pepper","Scrunch the edges of the foil together around the fish to form a tightly sealed parcel[s] Put the tray[s] in the oven for 12-15 min or until the fish is cooked through (keep the basa in the foil parcels until ready to serve!) Tip: Your fish is cooked once it turns opaque and flakes easily","Heat a large, wide-based pan (preferably non-stick with a matching lid) with a generous drizzle of olive oil and a knob of butter over a medium-high heat Once the butter has melted, add the cooked potatoes , sliced leek and a generous pinch of salt Cook for 8-10 min or until the leek has softened and the potatoes are starting to brown, crushing them lightly as they cook Reboil the kettle","Wash your spinach and pat it dry with kitchen paper Add the spinach , chopped garlic , half the sliced spring onion and half the chopped dill (save the rest for garnish!) to the pan Stir it all together and cook for 2-3 min or until the spinach has wilted, then remove from the heat and keep covered until serving – this is your leek & potato hash","Bring the reserved pot with plenty of boiled water to the boil over a high heat Crack your egg[s] gently into the water and leave for 3 min Once done, gently transfer the egg[s] with a slotted spoon to kitchen paper or a clean tea-towel – this is your poached egg[s]","Serve the leek & potato hash topped with the smoked basa and poached egg Drizzle any buttery sauce from the fish parcel[s] over the potatoes Sprinkle the remaining dill and sliced spring onion all over and season with a pinch of salt and pepper Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1675785351416-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1675785361319-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1675785377953-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1675785394722-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1675785403595-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1675785412606-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1675785450475-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/smoked-basa-with-leek-sweet-potato-hash-and-poached-egg","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/smoked-basa-with-leek-sweet-potato-hash-and-poached-egg","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["2","free range egg"],["1","leek"],["1","spring onion"],["1","garlic clove"],["1","smoked basa fillets"],["5 g","dill"],["80 g","spinach"],["2","sweet potato"],["as needed","Butter"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"]],"lunchBucket":"potato","isLunch":true,"prepStyle":"quick","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-e00b7fae-acdd-4539-a2b9-c60d08afcc70","sourceId":"e00b7fae-acdd-4539-a2b9-c60d08afcc70","title":"Lean Beef & Black Bean Burrito Bowl With Brown Rice","subtitle":"All the flavour of a burrito, minus the tortilla.","time":40,"cost":27.55,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","mexican","wrap","cook"],"requiredEquipment":[],"sourceEquipment":["Frying pan","Saucepan","Kettle","Mixing bowl","Grater"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/1255_Beef--Black-Bean-Burrito-Bowl-2359-1614011528417-1756376809537-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/lean-beef-black-bean-burrito-bowl-with-brown-rice","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["1 tsp","ground cumin"],["2 tsp","ground smoked paprika"],["20 g","chipotle paste"],["40 g","cheddar cheese"],["390 g","black beans"],["5.5 g","beef stock mix"],["1","garlic clove"],["1","tomato"],["80 g","natural yoghurt"],["250 g","lean beef mince (<5% fat)"],["5 g","coriander"],["1","gem lettuce"],["1","lime"],["100 g","brown long grain rice"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"sourceIngredients":[["1 tsp","ground cumin"],["2 tsp","ground smoked paprika"],["20 g","chipotle paste"],["40 g","cheddar cheese"],["390 g","black beans"],["5.5 g","beef stock mix"],["1","garlic clove"],["1","tomato"],["80 g","natural yoghurt"],["250 g","lean beef mince (<5% fat)"],["5 g","coriander"],["1","gem lettuce"],["1","lime"],["100 g","brown long grain rice"]],"ingredientMeta":[{"name":"ground cumin","amount":"1 tsp","shoppingName":"ground cumin","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground smoked paprika","amount":"2 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"chipotle paste","amount":"20 g","shoppingName":"chipotle paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cheddar cheese","amount":"40 g","shoppingName":"cheddar cheese","marketChecked":true,"priceMatchType":"source-identity"},{"name":"black beans","amount":"390 g","shoppingName":"black beans","marketChecked":true,"priceMatchType":"source-identity"},{"name":"beef stock mix","amount":"5.5 g","shoppingName":"beef stock mix","marketChecked":true,"priceMatchType":"source-identity"},{"name":"garlic clove","amount":"1","shoppingName":"garlic clove","marketChecked":true,"priceMatchType":"source-identity"},{"name":"tomato","amount":"1","shoppingName":"tomato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"natural yoghurt","amount":"80 g","shoppingName":"natural yoghurt","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lean beef mince (<5% fat)","amount":"250 g","shoppingName":"lean beef mince (<5% fat)","marketChecked":true,"priceMatchType":"source-identity"},{"name":"coriander","amount":"5 g","shoppingName":"coriander","marketChecked":true,"priceMatchType":"source-identity"},{"name":"gem lettuce","amount":"1","shoppingName":"gem lettuce","marketChecked":true,"priceMatchType":"source-identity"},{"name":"lime","amount":"1","shoppingName":"lime","marketChecked":true,"priceMatchType":"source-identity"},{"name":"brown long grain rice","amount":"100 g","shoppingName":"brown long grain rice","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Rinse your brown rice , add it to a pot with plenty of cold water and bring to the boil over a high heat Once boiling, reduce the heat to medium and cook for 20-25 min or until it's tender with a slight bite Once cooked, drain, return it to the pot and keep covered until serving","Meanwhile, dice your tomato[es] Wash your lettuce , then pat it dry with kitchen paper and shred Peel and finely chop (or grate) your garlic","Heat a large, wide-based pan (preferably non-stick) with a drizzle of olive oil over a high heat Once very hot, add your mince and cook for 7-8 min or until crispy, breaking it up with a wooden spoon as you go Once crispy, add your ground cumin and cook for 2 min further (no pink meat!) – this is your crispy cumin mince","Meanwhile, boil half a kettle Grate your cheddar cheese Cut your lime[s] in half Add your natural yoghurt to a bowl with your chipotle paste (can't handle the heat? Go easy!) and give it a good mix up – this is your chipotle yoghurt","Transfer the crispy cumin mince to a plate and set aside Drain and rinse your black beans Return the pan (and any oil left in the pan from the mince) to a medium heat Once hot, add the drained black beans , ground smoked paprika and chopped garlic and cook for 1-2 min or until fragrant – these are your smoky beans","Meanwhile, dissolve your beef stock mix in 150ml boiled water Add the beef stock and the juice of half your lime[s] to the pan and cook for 3-4 min further Remove the smoky beans from the heat and mash into a semi-smooth paste – these are your refried smoky beans","In a bowl, combine the juice of the remaining lime with 1 tbsp olive oil , a pinch of salt and a grind of pepper Add the shredded lettuce and diced tomato and give it a good mix up – this is your chopped salad Chop your coriander roughly, including the stalks","To assemble your burrito bowl, top the cooked rice with the crispy cumin mince and serve the chopped salad and refried smoky beans to the side Drizzle over the chipotle yoghurt , sprinkle with the grated cheese and garnish with the chopped coriander Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1613490479839-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1613490485411-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1613490505696-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-4-1613490524495-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1613490535232-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-copy-1613490638685-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1613490682703-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/lean-beef-black-bean-burrito-bowl-with-brown-rice","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/lean-beef-black-bean-burrito-bowl-with-brown-rice","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["1 tsp","ground cumin"],["2 tsp","ground smoked paprika"],["20 g","chipotle paste"],["40 g","cheddar cheese"],["390 g","black beans"],["5.5 g","beef stock mix"],["1","garlic clove"],["1","tomato"],["80 g","natural yoghurt"],["250 g","lean beef mince (<5% fat)"],["5 g","coriander"],["1","gem lettuce"],["1","lime"],["100 g","brown long grain rice"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Water"]],"lunchBucket":"wrap","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-702f983a-9e57-43ae-a703-5b6b67aacf44","sourceId":"702f983a-9e57-43ae-a703-5b6b67aacf44","title":"One Tray Harissa Cod & Cherry Tomato Traybake","subtitle":"All hail the heady aroma of harissa.","time":35,"cost":19.39,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fusion","other","cook"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/4031_Harissa-Basa--Cherry-Tomato-Traybake_001-1681395167243-1756204648935-1761831042006-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/harissa-cod-cherry-tomato-traybake","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["20 g","harissa paste"],["1","cod fillets"],["2 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["160 g","fine green beans"],["125 g","cherry tomatoes"],["1","sweet potato"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"sourceIngredients":[["20 g","harissa paste"],["1","cod fillets"],["2 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["160 g","fine green beans"],["125 g","cherry tomatoes"],["1","sweet potato"]],"ingredientMeta":[{"name":"harissa paste","amount":"20 g","shoppingName":"harissa paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cod fillets","amount":"1","shoppingName":"cod fillets","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground smoked paprika","amount":"2 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"mayonnaise","amount":"25 ml","shoppingName":"mayonnaise","marketChecked":true,"priceMatchType":"source-identity"},{"name":"fine green beans","amount":"160 g","shoppingName":"fine green beans","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cherry tomatoes","amount":"125 g","shoppingName":"cherry tomatoes","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sweet potato","amount":"1","shoppingName":"sweet potato","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7 Chop your potato[es] (skins on) into bite-sized pieces Add the chopped potatoes to a baking tray (or two!) with a drizzle of olive oil and a pinch of salt and pepper Give everything a good mix up and put the tray[s] in the oven for an initial 18 min","Pat your fish fillet[s] dry with kitchen paper Add half your ground smoked paprika (save the rest for later!) to a plate with a pinch of salt and pepper and mix it together Add the fish fillet[s] to the plate and turn until fully coated, then set aside – this is your smoky fish fillet","Chop your cherry tomatoes in half","Trim, then chop your green beans in half","After the initial 18 min, remove the tray[s] from the oven Add the chopped tomatoes and chopped green beans to the tray[s] with a drizzle of olive oil Sprinkle over the remaining ground smoked paprika and give everything a good mix up","Add the smoky fish fillet[s] to the tray[s] with a drizzle of olive oil Return the tray[s] to the oven for a further 12-15 min or until the fish is cooked through, the potatoes are crisp and the vegetables have softened – this is your smoky fish tray bake Tip: Your fish is cooked once it turns opaque and flakes easily","Meanwhile, combine your mayo and harissa paste (can't handle the heat? Go easy!) in a small bowl and mix it all together – this is your harissa mayo","Serve the smoky fish tray bake with the harissa mayo drizzled over the top Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-1-1678289142017-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-2-1678289186240-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-3-1678289200884-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-4-1678289205733-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-5-1678290609117-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-6-1678290618538-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/Step-7-1678290622989-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/harissa-cod-cherry-tomato-traybake","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/harissa-cod-cherry-tomato-traybake","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["20 g","harissa paste"],["1","cod fillets"],["2 tsp","ground smoked paprika"],["25 ml","mayonnaise"],["160 g","fine green beans"],["125 g","cherry tomatoes"],["1","sweet potato"],["as needed","Pepper"],["as needed","Salt"],["as needed","Olive oil"]],"lunchBucket":"other","isLunch":true,"prepStyle":"cook","light":false,"prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true,"preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work."},{"id":"lunch-gousto-e619e245-96e9-4354-909a-411007e49dfb","sourceId":"e619e245-96e9-4354-909a-411007e49dfb","title":"One Tray Harissa Free Range Chicken Breast & Carrot Traybake","subtitle":"Leave the cooking to the oven with this veg-packed traybake.","time":40,"cost":24.4,"servings":2,"scaleSafe":true,"tags":["all gousto recipes","fusion","other","cook"],"requiredEquipment":[],"sourceEquipment":["Oven","Baking tray","Mixing bowl"],"image":"","sourceImageUrl":"https://production-media.gousto.co.uk/cms/mood-image/R-5445-2-Harissa-Chicken-Potato--Carrot-Traybake-With-Paprika-Yoghurt-2-1789720081372-x1500.jpg","imageSource":"https://www.gousto.co.uk/recipes/harissa-free-range-chicken-breast-carrot-traybake-w-paprika-yoghurt","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published Gousto UK recipe","ingredients":[["2","white potato"],["1","carrot"],["1","free range chicken breast portions"],["40 g","harissa paste"],["1 tsp","ground smoked paprika"],["50 g","baby leaf salad"],["80 g","natural yoghurt"],["15 ml","cider vinegar"],["1","red onion"],["1","sweet potato"],["as needed","Olive oil"],["as needed","Pepper"],["as needed","Salt"],["as needed","Sugar"]],"sourceIngredients":[["2","white potato"],["1","carrot"],["1","free range chicken breast portions"],["40 g","harissa paste"],["1 tsp","ground smoked paprika"],["50 g","baby leaf salad"],["80 g","natural yoghurt"],["15 ml","cider vinegar"],["1","red onion"],["1","sweet potato"]],"ingredientMeta":[{"name":"white potato","amount":"2","shoppingName":"white potato","marketChecked":true,"priceMatchType":"source-identity"},{"name":"carrot","amount":"1","shoppingName":"carrot","marketChecked":true,"priceMatchType":"source-identity"},{"name":"free range chicken breast portions","amount":"1","shoppingName":"free range chicken breast portions","marketChecked":true,"priceMatchType":"source-identity"},{"name":"harissa paste","amount":"40 g","shoppingName":"harissa paste","marketChecked":true,"priceMatchType":"source-identity"},{"name":"ground smoked paprika","amount":"1 tsp","shoppingName":"ground smoked paprika","marketChecked":true,"priceMatchType":"source-identity"},{"name":"baby leaf salad","amount":"50 g","shoppingName":"baby leaf salad","marketChecked":true,"priceMatchType":"source-identity"},{"name":"natural yoghurt","amount":"80 g","shoppingName":"natural yoghurt","marketChecked":true,"priceMatchType":"source-identity"},{"name":"cider vinegar","amount":"15 ml","shoppingName":"cider vinegar","marketChecked":true,"priceMatchType":"source-identity"},{"name":"red onion","amount":"1","shoppingName":"red onion","marketChecked":true,"priceMatchType":"source-identity"},{"name":"sweet potato","amount":"1","shoppingName":"sweet potato","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat the oven to 220°C/ 200°C (fan)/ gas 7 Take your chicken out of the fridge, open the packet and let it air Chop your potato[es] and sweet potato[es] (skins on) into small bite-sized pieces","Top, tail, and slice your carrot[s] into chunky discs on the diagonal Peel and chop your red onion[s] into thin wedges","Add the chopped potatoes , chopped carrot and onion wedges to a large tin foil -lined baking tray (or two!) Add a generous drizzle of olive oil , a generous pinch of salt and pepper and give everything a good mix up Put the tray[s] in the oven for an initial 15-17 min or until the potatoes are starting to soften","Meanwhile, add most of your ground smoked paprika (save some for later!), 1 tsp sugar , a generous drizzle of olive oil and half your cider vinegar (you'll use the rest later!) to a medium bowl Add a generous pinch of salt and pepper and give everything a good mix up – this is your marinade","Once the potatoes have slightly softened, remove the tray[s] from the oven and add your chicken , drizzle the marinade over the chicken then return the tray[s]to the oven and cook for a further 12-14 min or until almost cooked (reserve the bowl) (Doubled your protein? Do this in batches!) Remove the tray[s] from the oven, spread your harissa paste (can't handle the heat? Go easy!) over the chicken and return to the oven for a final 5-6 min or until the chicken is cooked through (no pink meat!) – this is your harissa chicken & carrot traybake","While the chicken is cooking, wipe the reserved bowl clean with kitchen paper Combine your natural yoghurt with the remaining ground smoked paprika and a pinch of salt in the reserved bowl Stir it all together – this is your paprika yoghurt","Wash your salad , then pat dry with kitchen paper","Serve the harissa chicken & carrot traybake with the salad to the side and drizzle over the paprika yoghurt Drizzle the salad with a little olive oil and the remaining cider vinegar and season with a pinch of salt and pepper Enjoy!"],"sourceStepImages":[{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-1-1686665877955-x1500.jpg","caption":"Step 1"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-2-1686665882329-x1500.jpg","caption":"Step 2"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-3-1686665890186-x1500.jpg","caption":"Step 3"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/03-01-24_09h19m53s-APIC-1704362303806-x1500.jpg","caption":"Step 4"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-5-1686665897414-x1500.jpg","caption":"Step 5"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-6-1686665901242-x1500.jpg","caption":"Step 6"},{"src":"https://production-media.gousto.co.uk/cms/recipe-step-image/step-7-1686665909959-x1500.jpg","caption":"Step 7"},{"src":"","caption":"Step 8"}],"sourceStepIngredientIds":[[],[],[],[],[],[],[],[]],"source":"Gousto UK","sourceUrl":"https://www.gousto.co.uk/recipes/harissa-free-range-chicken-breast-carrot-traybake-w-paprika-yoghurt","recipeSource":"Gousto UK","recipeSourceUrl":"https://www.gousto.co.uk/recipes/harissa-free-range-chicken-breast-carrot-traybake-w-paprika-yoghurt","recipeProvenance":"Published Gousto UK recipe retained as the cooking source. My Week only normalises it for planning and display.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","shoppingIngredients":[["2","whi