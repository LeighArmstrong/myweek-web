ovenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["500 g","Salad Potatoes"],["1","Red Onion"],["12 ml","Red Wine Vinegar"],["1","Bell Pepper"],["2","Garlic Clove"],["1 carton","Chickpeas"],["125 g","Baby Plum Tomatoes"],["1 sachet","Curry Powder Mix"],["75 g","Greek Style Natural Yoghurt"],["1 sachet","Dried Mint"],["40 g","Mango Chutney"],["40 g","Tamarind Chutney"],["1 tsp","Sugar for the Pickle"],["20 g","Butter"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["500 g","Salad Potatoes"],["1","Red Onion"],["12 ml","Red Wine Vinegar"],["1","Bell Pepper"],["2","Garlic Clove"],["1 carton","Chickpeas"],["125 g","Baby Plum Tomatoes"],["1 sachet","Curry Powder Mix"],["75 g","Greek Style Natural Yoghurt"],["1 sachet","Dried Mint"],["40 g","Mango Chutney"],["40 g","Tamarind Chutney"],["1 tsp","Sugar for the Pickle"],["20 g","Butter"]],"ingredientMeta":[{"id":"5dbc6e87b96bdd752017bc59","name":"Salad Potatoes","type":"salad-potatoes","family":"potato","amount":"500 g","sourceAmount":500,"sourceUnit":"grams","shipped":true,"shoppingName":"Salad Potatoes","marketLabel":"baby potatoes 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6fb4fd2cb95a598b456e","name":"Red Onion","type":"red onion","family":"onion","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Red Onion","marketLabel":"red onions x3","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555ca1774dab7190138b4568","name":"Red Wine Vinegar","type":"red wine vinegar","family":"vinegar","amount":"12 ml","sourceAmount":12,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Red Wine Vinegar","marketLabel":"cooking vinegar equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632cf717b4f4bc890195c7d3","name":"Bell Pepper","type":"bell-pepper","family":"pepper","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Bell Pepper","marketLabel":"peppers pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6387fd2cb99c598b4568","name":"Chickpeas","type":"organic chickpeas","family":"canned chickpeas","amount":"1 carton","sourceAmount":1,"sourceUnit":"carton(s)","shipped":true,"shoppingName":"Chickpeas","marketLabel":"chickpeas 400g, 240g drained","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5a3cee59c2880024501f6622","name":"Baby Plum Tomatoes","type":"baby-plum-tomatoes","family":"tomato","amount":"125 g","sourceAmount":125,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Plum Tomatoes","marketLabel":"fresh fruit equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556827b74dab71b6178b4567","name":"Curry Powder Mix","type":"curry-powder","family":"spice blend","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Curry Powder Mix","marketLabel":"curry spice blend equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a56e74dab71d76f8b4570","name":"Greek Style Natural Yoghurt","type":"natural-yoghurt","family":"yogurt","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Greek Style Natural Yoghurt","marketLabel":"yoghurts pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"67dd4b80200ef299d97100b5","name":"Dried Mint","type":"dried-mint","family":"none","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Dried Mint","marketLabel":"fresh mint 30g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55d366e84dab71542f8b4567","name":"Mango Chutney","type":"mango-chutney","family":"chutney","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Mango Chutney","marketLabel":"fresh fruit equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"685924bf5baaf2916c0537a0","name":"Tamarind Chutney","type":"tamarind-chutney","family":"none","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Tamarind Chutney","marketLabel":"chutney jar equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5e3416f081143769dd33ba49","name":"Sugar for the Pickle","type":"sugar-for-the-pickle-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Pickle","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60c73507053f5e815cd52d5b","name":"Butter","type":"butter-100g","family":"butter","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":false,"shoppingName":"Butter","marketLabel":"butter 500g","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Boil a full kettle. Halve the salad potatoes widthways (halve any large ones again). Put the potatoes onto a baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Spread out in a single layer, cut-side down. When the oven is hot, roast the potatoes on the top shelf, 20 mins.","Meanwhile, halve and peel the red onion. Slice half the onion as thinly as you can. Pop the sliced onion into a small bowl and add the red wine vinegar and sugar for the pickle (use the quantities listed in the ingredients). Add a pinch of salt, mix together and set aside to pickle. Cut the remaining onion into roughly 2-3cm wedges. Halve the bell pepper and discard the core and seeds. Slice into thin strips. Peel and grate the garlic (or use a garlic press). Drain and rinse the chickpeas in a sieve, then dry thoroughly with kitchen paper.","Spread the sliced pepper, onion wedges, baby plum tomatoes and chickpeas onto a baking tray. Drizzle with oil and sprinkle over half the curry powder. Season with salt and pepper, then toss to coat. Roast on the middle shelf of your oven until soft and slightly charred, 18-20 mins.","When the potatoes have cooked for 20 mins, remove them from the oven. Sprinkle over the remaining curry powder and toss to evenly coat. Use the bottom of a bowl or pan to lightly crush each potato. Drizzle the smashed potatoes with more oil, and return to the top shelf of your oven until crispy and golden, 10-15 mins.","Meanwhile, in another small bowl, combine the yoghurt with half the garlic and half the dried mint. Season with salt and pepper. When the vegetables and chickpeas have roasted, add the remaining garlic and butter (use the quantities listed in the ingredients) to the baking tray. Stir until well combined and the butter has melted.","Share the smashed potatoes between shallow serving bowls. Top with the buttery roast veg and chickpeas. Drizzle over the mint yoghurt, pickled onion, mango chutney, tamarind chutney and sprinkle with the remaining dried mint to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce366a9c9fe9127174bb/step-3737de00.jpg","caption":"Start the Potatoes"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce366a9c9fe9127174bb/step-cb7af210.jpg","caption":"Blanch the Onion"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce366a9c9fe9127174bb/step-e5eeaf20.jpg","caption":"Roast the Veg"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce366a9c9fe9127174bb/step-39629e30.jpg","caption":"Smash Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce366a9c9fe9127174bb/step-78ad3c40.jpg","caption":"Stir the Dressing"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce366a9c9fe9127174bb/step-2444a150.jpg","caption":"Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/aloo-chaat-inspired-loaded-potatoes-6967ce366a9c9fe9127174bb","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/aloo-chaat-inspired-loaded-potatoes-6967ce366a9c9fe9127174bb","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"potato","shoppingIngredients":[["500 g","Salad Potatoes"],["1","Red Onion"],["12 ml","Red Wine Vinegar"],["1","Bell Pepper"],["2","Garlic Clove"],["1 carton","Chickpeas"],["125 g","Baby Plum Tomatoes"],["1 sachet","Curry Powder Mix"],["75 g","Greek Style Natural Yoghurt"],["1 sachet","Dried Mint"],["40 g","Mango Chutney"],["40 g","Tamarind Chutney"],["1 tsp","Sugar for the Pickle"],["20 g","Butter"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work.","prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true},{"id":"halloumi-veg-couscous-lunch","sourceId":"69710d35933a02843ffb63dd","title":"Mexican Style Caramelised Onion and Chorizo Quesadillas","subtitle":"with Wedges, Sweetcorn and Baby Plum Tomato Salad","time":30,"cost":24.62,"servings":2,"scaleSafe":true,"tags":["comfort food","low carb","latin-american-faves","handhelds","mexican","handheld","quick","wrap"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Bowl","Sieve","Grater","Pan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R51_W52_UK_V30532-11_MainV30532-AP-1-1_var_high-df8e5dca.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/mexican-style-caramelised-onion-and-chorizo-quesadillas-69710d35933a02843ffb63dd","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["450 g","Potatoes"],["2","Onion"],["160 g","Sweetcorn"],["90 g","Mature Cheddar Cheese"],["125 g","Baby Plum Tomatoes"],["12 ml","Red Wine Vinegar"],["1 sachet","Mexican Style Spice Mix"],["4","Plain Taco Tortillas"],["50 g","Baby Leaf Mix"],["90 g","Diced Chorizo"],["0.5 tsp","Sugar for the Dressing"],["1 tbsp","Olive Oil for the Dressing"],["10 g","Butter"],["1 tsp","Sugar for the Onions"],["2 tbsp","Mayonnaise"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["450 g","Potatoes"],["2","Onion"],["160 g","Sweetcorn"],["90 g","Mature Cheddar Cheese"],["125 g","Baby Plum Tomatoes"],["12 ml","Red Wine Vinegar"],["1 sachet","Mexican Style Spice Mix"],["4","Plain Taco Tortillas"],["50 g","Baby Leaf Mix"],["90 g","Diced Chorizo"],["0.5 tsp","Sugar for the Dressing"],["1 tbsp","Olive Oil for the Dressing"],["10 g","Butter"],["1 tsp","Sugar for the Onions"],["2 tbsp","Mayonnaise"]],"ingredientMeta":[{"id":"5a39929ec9fd0814815939c2","name":"Potatoes","type":"potatoes","family":"potato","amount":"450 g","sourceAmount":450,"sourceUnit":"grams","shipped":true,"shoppingName":"Potatoes","marketLabel":"potatoes 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a59324dab71626c8b4575","name":"Onion","type":"onion","family":"onion","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Onion","marketLabel":"brown onions 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6de44dab71a6058b456a","name":"Sweetcorn","type":"sweetcorn","family":"corn","amount":"160 g","sourceAmount":160,"sourceUnit":"grams","shipped":true,"shoppingName":"Sweetcorn","marketLabel":"sweetcorn tin","marketChecked":true,"priceMatchType":"source-identity"},{"id":"69146769623e0c85b6821082","name":"Mature Cheddar Cheese","type":"cheddar-cheese","family":"hard cheese","amount":"90 g","sourceAmount":90,"sourceUnit":"grams","shipped":true,"shoppingName":"Mature Cheddar Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5a3cee59c2880024501f6622","name":"Baby Plum Tomatoes","type":"baby-plum-tomatoes","family":"tomato","amount":"125 g","sourceAmount":125,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Plum Tomatoes","marketLabel":"fresh fruit equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555ca1774dab7190138b4568","name":"Red Wine Vinegar","type":"red wine vinegar","family":"vinegar","amount":"12 ml","sourceAmount":12,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Red Wine Vinegar","marketLabel":"cooking vinegar equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60c89afa8e1c4145a37bc75f","name":"Mexican Style Spice Mix","type":"mexican-style-spice-mix","family":"spice blend","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Mexican Style Spice Mix","marketLabel":"seasoning blend equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"683727bfd9848b9dac04fe03","name":"Plain Taco Tortillas","type":"plain-taco-tortilla","family":"none","amount":"4","sourceAmount":3.996,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Plain Taco Tortillas","marketLabel":"wraps or tortillas x8","marketChecked":true,"priceMatchType":"source-identity"},{"id":"56b23e4ef8b25e4c2d8b4567","name":"Baby Leaf Mix","type":"premium baby leaf mix","family":"salad mix","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Leaf Mix","marketLabel":"lettuce or salad leaves","marketChecked":true,"priceMatchType":"source-identity"},{"id":"66ab6339f66002bbd100b304","name":"Diced Chorizo","type":"chorizo-diced","family":"none","amount":"90 g","sourceAmount":90,"sourceUnit":"grams","shipped":true,"shoppingName":"Diced Chorizo","marketLabel":"prepared pork product equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb425688281450b8bd079","name":"Sugar for the Dressing","type":"sugar-for-the-dressing-1-tsp","family":"single spice","amount":"0.5 tsp","sourceAmount":0.5,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Dressing","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb168688281450b8bd062","name":"Olive Oil for the Dressing","type":"olive-oil-for-the-dressing-1-tbsp","family":"oil","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Olive Oil for the Dressing","marketLabel":"cooking oil 1 litre","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60c73507053f5e815cd52d5b","name":"Butter","type":"butter-100g","family":"butter","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":false,"shoppingName":"Butter","marketLabel":"butter 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"610d5147a6d0dbd6f1c32b40","name":"Sugar for the Onions","type":"sugar-for-the-onions-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Onions","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbe487e8afb1b135f069bd2","name":"Mayonnaise","type":"mayonnaise-tbsp","family":"mayonnaise","amount":"2 tbsp","sourceAmount":2,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Mayonnaise","marketLabel":"mayonnaise 500ml","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Chop the potatoes into 2cm wide wedges (no need to peel). Pop the wedges onto a large baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Spread out in a single layer. Use two baking trays if necessary. When the oven is hot, roast on the middle shelf until golden, 30-40 mins. Turn halfway through.","Meanwhile, halve, peel and thinly slice the onions. Drain the sweetcorn in a sieve. Grate the cheese. Pop the cheese in a medium bowl. Halve the baby plum tomatoes. In a large bowl, add the red wine vinegar, sugar and olive oil for the dressing (use the quantities listed in the ingredients). Season with salt and pepper. Add the tomatoes and half the sweetcorn, toss to coat in the dressing, then set aside.","Heat a large frying pan on medium heat with the butter (use the quantities listed in the ingredients) and a drizzle of oil. Once the butter has melted, add the chorizo and onion. Season with salt and pepper and fry, stirring occasionally, until golden, 10-12 mins.","Add the Mexican style spice mix and sugar for the onions (use the quantities listed in the ingredients). Cook until caramelised, 1-2 mins more. Transfer the caramelised onion and chorizo to the cheese bowl with the remaining sweetcorn and toss everything to combine.","Lay the tortillas (2 per person) onto a lightly oiled baking tray and spoon the cheesy filling onto one half of each one. Fold the other side over to make a semi-circle. Press down to keep together. Rub a little oil over the top of each one, then bake on the top shelf of your oven until golden, 8-12 mins.","When everything's ready, add the baby leaves to the tomato bowl. Toss to coat in the dressing. Don't add the leaves too early or they'll go soggy. Share the quesadillas between your plates. Add a dollop of mayo (use the quantities listed in the ingredients). Serve the salad and wedges alongside."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69710d35933a02843ffb63dd/step-eaf2df00.jpg","caption":"Get Started"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69710d35933a02843ffb63dd/step-06b20510.jpg","caption":"Prep the Salad"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69710d35933a02843ffb63dd/step-f5ad4820.jpg","caption":"Caramelise the Onions"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69710d35933a02843ffb63dd/step-cf68b130.jpg","caption":"Spice Things Up"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69710d35933a02843ffb63dd/step-22de5840.jpg","caption":"Bake the Quesadillas"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69710d35933a02843ffb63dd/step-c66c2850.jpg","caption":"Finish and Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/mexican-style-caramelised-onion-and-chorizo-quesadillas-69710d35933a02843ffb63dd","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/mexican-style-caramelised-onion-and-chorizo-quesadillas-69710d35933a02843ffb63dd","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"wrap","shoppingIngredients":[["450 g","Potatoes"],["2","Onion"],["160 g","Sweetcorn"],["90 g","Mature Cheddar Cheese"],["125 g","Baby Plum Tomatoes"],["12 ml","Red Wine Vinegar"],["1 sachet","Mexican Style Spice Mix"],["4","Plain Taco Tortillas"],["50 g","Baby Leaf Mix"],["90 g","Diced Chorizo"],["0.5 tsp","Sugar for the Dressing"],["1 tbsp","Olive Oil for the Dressing"],["10 g","Butter"],["1 tsp","Sugar for the Onions"],["2 tbsp","Mayonnaise"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":false,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work.","prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true},{"id":"tahini-bean-couscous-lunch","sourceId":"6967ce27850f974aa212e20e","title":"Korean Style Chicken Breast and Ginger Pickled Salad","subtitle":"with Gochujang-Honey Dressing and Chips","time":40,"cost":21.76,"servings":2,"scaleSafe":true,"tags":["discovery","medium spice","pan-asian-plates","classic-plates","calorie smart","high protein","healthy options","tasty-adventures","korean","poultry","salad","cook"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Bowl","Grater","Rolling Pin","Baking Paper","Pan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R10_W46_UK_R34672-6_edit_chicken_Main_high-aa29a2c2.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/korean-style-chicken-breast-and-ginger-pickled-salad-6967ce27850f974aa212e20e","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["450 g","Potatoes"],["1","Cucumber"],["1","Carrot"],["10 ml","Soy Sauce"],["15 ml","Rice Vinegar"],["50 g","Gochujang Paste"],["15 g","Ginger Puree"],["20 g","Cornflour"],["2","British Chicken Breasts"],["15 g","Honey"],["1 tsp","Sugar for the Pickle"],["2 tbsp","Tomato Ketchup"],["2 tbsp","Mayonnaise"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["450 g","Potatoes"],["1","Cucumber"],["1","Carrot"],["10 ml","Soy Sauce"],["15 ml","Rice Vinegar"],["50 g","Gochujang Paste"],["15 g","Ginger Puree"],["20 g","Cornflour"],["2","British Chicken Breasts"],["15 g","Honey"],["1 tsp","Sugar for the Pickle"],["2 tbsp","Tomato Ketchup"],["2 tbsp","Mayonnaise"]],"ingredientMeta":[{"id":"5a39929ec9fd0814815939c2","name":"Potatoes","type":"potatoes","family":"potato","amount":"450 g","sourceAmount":450,"sourceUnit":"grams","shipped":true,"shoppingName":"Potatoes","marketLabel":"potatoes 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a54f4fd2cb9324b8b4573","name":"Cucumber","type":"cucumber","family":"cucumber","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Cucumber","marketLabel":"cucumber","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5f284dab71a6058b4567","name":"Carrot","type":"carrot","family":"carrot","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Carrot","marketLabel":"carrots 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"680b9d014a6668c89d92df5a","name":"Soy Sauce","type":"soy sauce","family":"sauce","amount":"10 ml","sourceAmount":10,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Soy Sauce","marketLabel":"soy sauce 150ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a68fa4dab71aa058b4568","name":"Rice Vinegar","type":"rice vinegar","family":"vinegar","amount":"15 ml","sourceAmount":15,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Rice Vinegar","marketLabel":"cooking vinegar equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"63e65a13838062841f0e7218","name":"Gochujang Paste","type":"gochujang-paste","family":"none","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Gochujang Paste","marketLabel":"cooking paste equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"59f334f92c3e085ecd21b7f2","name":"Ginger Puree","type":"ginger-puree","family":"ginger","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Ginger Puree","marketLabel":"fresh ginger 100g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5566065ffd2cb9046d8b4568","name":"Cornflour","type":"cornflour","family":"flour","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Cornflour","marketLabel":"cornflour 250g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5e56f8b25ed7288b4576","name":"British Chicken Breasts","type":"chicken-fillet","family":"chicken","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"British Chicken Breasts","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555363fff8b25e5e0c8b4567","name":"Honey","type":"honey","family":"honey","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5e3416f081143769dd33ba49","name":"Sugar for the Pickle","type":"sugar-for-the-pickle-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Pickle","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60f949dce5a270ab7dbce1ba","name":"Tomato Ketchup","type":"tomato-ketchup-1-tbsp-15g","family":"other drink","amount":"2 tbsp","sourceAmount":2,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Tomato Ketchup","marketLabel":"table sauce equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbe487e8afb1b135f069bd2","name":"Mayonnaise","type":"mayonnaise-tbsp","family":"mayonnaise","amount":"2 tbsp","sourceAmount":2,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Mayonnaise","marketLabel":"mayonnaise 500ml","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Chop the potatoes lengthways into 1cm slices, then chop into 1cm wide chips (no need to peel). Pop the chips onto a large baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Spread out in a single layer. Use two baking trays if necessary. When the oven is hot, bake on the top shelf until golden, 25-30 mins. Turn halfway through.","Meanwhile, trim the cucumber, then halve lengthways. Thinly slice widthways. Trim the carrot, then coarsely grate (no need to peel). In a medium bowl, combine the soy sauce, rice vinegar, a third of the gochujang paste, half the ginger puree and the sugar for the pickle (use the quantities listed in the ingredients). Add the carrot and cucumber to the dressing. Mix together well, then set aside to pickle.","Meanwhile, put the cornflour into a large bowl and season with salt and pepper. Mix to combine. Sandwich each chicken breast between two pieces of baking paper or cling film. Pop onto a board, then give it a bash with a rolling pin or the bottom of a saucepan until it’s 1-2cm thick. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Add the chicken to the bowl and turn to coat in the cornflour. Wash your hands and equipment after handling raw chicken.","Put a large frying pan on high heat and add enough oil to completely coat the bottom of the pan. You want the oil to be hot so the chicken fries properly - heat for 2-3 mins before you add the chicken. Once hot, carefully lay the chicken into the pan, reduce the heat to medium-high and fry until golden brown and cooked through, 5-6 mins each side. Once cooked, remove from the heat and place the chicken onto a plate lined with kitchen paper. The chicken is cooked when no longer pink in the middle.","While the chicken is frying, in another medium bowl, combine the remaining gochujang with the remaining ginger puree, honey and ketchup (use the quantities listed in the ingredients). Season with salt and pepper. If the measured honey is very thick, warm it briefly so it pours easily. Once the chicken has cooked, transfer it to the bowl of sauce. Turn the chicken in the sauce until evenly coated.","Share the chicken between your plates and spoon over any remaining sauce. Serve with the pickled salad and chips on the side. Add some mayonnaise (use the quantities listed in the ingredients) for dipping."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce27850f974aa212e20e/step-69979300.jpg","caption":"Start the Chips"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce27850f974aa212e20e/step-64139110.jpg","caption":"Get Pickling"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce27850f974aa212e20e/step-05a0ef20.jpg","caption":"Toss the Chicken"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce27850f974aa212e20e/step-98cf1330.jpg","caption":"Time to Fry"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce27850f974aa212e20e/step-36812540.jpg","caption":"Sauce Things Up"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce27850f974aa212e20e/step-0b87e950.jpg","caption":"Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/korean-style-chicken-breast-and-ginger-pickled-salad-6967ce27850f974aa212e20e","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/korean-style-chicken-breast-and-ginger-pickled-salad-6967ce27850f974aa212e20e","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"salad","shoppingIngredients":[["450 g","Potatoes"],["1","Cucumber"],["1","Carrot"],["10 ml","Soy Sauce"],["15 ml","Rice Vinegar"],["50 g","Gochujang Paste"],["15 g","Ginger Puree"],["20 g","Cornflour"],["2","British Chicken Breasts"],["15 g","Honey"],["1 tsp","Sugar for the Pickle"],["2 tbsp","Tomato Ketchup"],["2 tbsp","Mayonnaise"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work.","prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true},{"id":"banana-peanut-overnight-oats","sourceId":"697a56be9629deb2e47d7cde","title":"Honey Harissa Chicken Breast Traybake","subtitle":"with Oregano Chips, Greek Style Salad Cheese and Roasted Veg","time":40,"cost":19.17,"servings":2,"scaleSafe":true,"tags":["prepped in 10","family friendly","taste of middle east","sheet pan","high protein","medium spice","middle eastern","poultry","other","cook"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Aluminum Foil"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R46_W18_UK_R16226-5_Main_R16226-SP-1-9_edit_high-639556c3.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/honey-harissa-chicken-breast-traybake-697a56be9629deb2e47d7cde","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["450 g","Potatoes"],["1 sachet","Dried Oregano"],["80 g","Green Beans"],["160 g","Asparagus"],["2","British Chicken Breasts"],["50 g","Harissa Paste"],["50 g","Greek Style Salad Cheese"],["2 tbsp","Honey"],["2 tbsp","Mayonnaise"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["450 g","Potatoes"],["1 sachet","Dried Oregano"],["80 g","Green Beans"],["160 g","Asparagus"],["2","British Chicken Breasts"],["50 g","Harissa Paste"],["50 g","Greek Style Salad Cheese"],["2 tbsp","Honey"],["2 tbsp","Mayonnaise"]],"ingredientMeta":[{"id":"5a39929ec9fd0814815939c2","name":"Potatoes","type":"potatoes","family":"potato","amount":"450 g","sourceAmount":450,"sourceUnit":"grams","shipped":true,"shoppingName":"Potatoes","marketLabel":"potatoes 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5550da144dab718e128b456e","name":"Dried Oregano","type":"dried oregano","family":"oregano","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Dried Oregano","marketLabel":"dried herbs jar","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555080c2f8b25e4d4c8b4568","name":"Green Beans","type":"green beans","family":"beans","amount":"80 g","sourceAmount":80,"sourceUnit":"grams","shipped":true,"shoppingName":"Green Beans","marketLabel":"green beans 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a58da4dab71d76f8b4573","name":"Asparagus","type":"asparagus-bundles","family":"asparagus","amount":"160 g","sourceAmount":160,"sourceUnit":"grams","shipped":true,"shoppingName":"Asparagus","marketLabel":"fresh vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5e56f8b25ed7288b4576","name":"British Chicken Breasts","type":"chicken-fillet","family":"chicken","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"British Chicken Breasts","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556c80fdf8b25e246c8b4567","name":"Harissa Paste","type":"rose-harissa-paste","family":"Chili sauce","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Harissa Paste","marketLabel":"harissa paste 130g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6764b4a77de812ab26271141","name":"Greek Style Salad Cheese","type":"greek-style-cheese","family":"none","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Greek Style Salad Cheese","marketLabel":"feta 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6172cb313021d49a7feafc84","name":"Honey","type":"honey-1-tbsp","family":"honey","amount":"2 tbsp","sourceAmount":2,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbe487e8afb1b135f069bd2","name":"Mayonnaise","type":"mayonnaise-tbsp","family":"mayonnaise","amount":"2 tbsp","sourceAmount":2,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Mayonnaise","marketLabel":"mayonnaise 500ml","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Chop the potatoes lengthways into 1cm slices, then chop into 1cm wide chips (no need to peel). Pop the chips onto a large baking tray. Drizzle with oil, season with salt and pepper, sprinkle over the dried oregano, then toss to coat. Spread out in a single layer. Use two baking trays if necessary. When the oven is hot, bake on the middle shelf until golden, 30–35 mins. Turn halfway through.","Meanwhile, trim the green beans. Pop your green beans onto a piece of foil with a drizzle of oil and season with salt and pepper. Toss the coat. Fold the foil, sealing on all sides to create a parcel. Trim the bottom 2cm from the asparagus and discard.","Lay the chicken breasts onto one side of another large baking tray. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Drizzle with oil and season with salt and pepper. Wash your hands and equipment after handling raw chicken. Pop the green bean parcel onto the tray. Roast the chicken and beans on the top shelf of your oven for 8-10 mins.","After the 8-10 mins, remove the chicken tray from the oven. Using the back of a spoon, spread the harissa paste and honey (use the quantities listed in the ingredients) evenly over the chicken. Lay the asparagus on the other side of the chicken tray. Drizzle with oil, season with salt and pepper, then toss to coat.","Pop back on the top shelf of your oven until the chicken is cooked through and the veg is tender, 18-20 mins. The chicken is cooked when no longer pink in the middle.","Share the harissa chicken out between your serving plates with the chips and veg alongside. Crumble the Greek style salad cheese over the roasted veg. Serve with a dollop of mayonnaise (use the quantities listed in the ingredients) alongside for dipping."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/697a56be9629deb2e47d7cde/step-38489f00.jpg","caption":"Cook the Chips"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/697a56be9629deb2e47d7cde/step-dbf6b010.jpg","caption":"Get Prepped"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/697a56be9629deb2e47d7cde/step-4b458e20.jpg","caption":"Start Roasting"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/697a56be9629deb2e47d7cde/step-2e6f9c30.jpg","caption":"Add the Flavour and Veg"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/697a56be9629deb2e47d7cde/step-7a7e8e40.jpg","caption":"Finish Cooking"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/697a56be9629deb2e47d7cde/step-ce567c50.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/honey-harissa-chicken-breast-traybake-697a56be9629deb2e47d7cde","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/honey-harissa-chicken-breast-traybake-697a56be9629deb2e47d7cde","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"other","shoppingIngredients":[["450 g","Potatoes"],["1 sachet","Dried Oregano"],["80 g","Green Beans"],["160 g","Asparagus"],["2","British Chicken Breasts"],["50 g","Harissa Paste"],["50 g","Greek Style Salad Cheese"],["2 tbsp","Honey"],["2 tbsp","Mayonnaise"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work.","prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true},{"id":"apple-cinnamon-overnight-oats","sourceId":"697a56dbbcdfd65d69c378b5","title":"One Pot Prawn Udon Laksa Inspired Soup","subtitle":"with Bell Pepper, Green Beans and Lime","time":20,"cost":14.71,"servings":2,"scaleSafe":true,"tags":["quick","calorie smart","pescatarian","south/southeastasian","soup-stew","super quick","low carb","customer favourite","indonesian","seafood","soup"],"requiredEquipment":[],"sourceEquipment":["Garlic Press","Large Saucepan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R23_W44_UK_QR45642-3_Mainhigh-e3489306.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/one-pot-prawn-udon-laksa-inspired-soup-697a56dbbcdfd65d69c378b5","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["80 g","Green Beans"],["1","Bell Pepper"],["1","Garlic Clove"],["160 g","King Prawns"],["1","Lime"],["45 g","Yellow Thai Style Paste"],["180 ml","Coconut Milk"],["10 ml","Soy Sauce"],["220 g","Udon Noodles"],["150 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["80 g","Green Beans"],["1","Bell Pepper"],["1","Garlic Clove"],["160 g","King Prawns"],["1","Lime"],["45 g","Yellow Thai Style Paste"],["180 ml","Coconut Milk"],["10 ml","Soy Sauce"],["220 g","Udon Noodles"],["150 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"555080c2f8b25e4d4c8b4568","name":"Green Beans","type":"green beans","family":"beans","amount":"80 g","sourceAmount":80,"sourceUnit":"grams","shipped":true,"shoppingName":"Green Beans","marketLabel":"green beans 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632cf717b4f4bc890195c7d3","name":"Bell Pepper","type":"bell-pepper","family":"pepper","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Bell Pepper","marketLabel":"peppers pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632c5abbb4f4bc890195c7a6","name":"King Prawns","type":"king prawns","family":"seafood preparation","amount":"160 g","sourceAmount":160,"sourceUnit":"grams","shipped":true,"shoppingName":"King Prawns","marketLabel":"large king prawns 150g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6e2a4dab71a9058b4569","name":"Lime","type":"lime","family":"lime","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lime","marketLabel":"limes x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6762b662afc243b64a9fbac6","name":"Yellow Thai Style Paste","type":"yellow-curry-paste","family":"spice blend","amount":"45 g","sourceAmount":45,"sourceUnit":"grams","shipped":true,"shoppingName":"Yellow Thai Style Paste","marketLabel":"curry paste jar","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a62e1f8b25eef3e8b4567","name":"Coconut Milk","type":"coconut milk","family":"canned coconut milk","amount":"180 ml","sourceAmount":180,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Coconut Milk","marketLabel":"coconut milk 400ml tin","marketChecked":true,"priceMatchType":"source-identity"},{"id":"680b9d014a6668c89d92df5a","name":"Soy Sauce","type":"soy sauce","family":"sauce","amount":"10 ml","sourceAmount":10,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Soy Sauce","marketLabel":"soy sauce 150ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"67c6dfd779182248c93165ef","name":"Udon Noodles","type":"udon noodles","family":"other noodle","amount":"220 g","sourceAmount":220,"sourceUnit":"grams","shipped":true,"shoppingName":"Udon Noodles","marketLabel":"noodle pack equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"150 ml","sourceAmount":150,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Trim the green beans, then cut into thirds. Halve the bell pepper and discard the core and seeds. Slice into thin strips. Peel and grate the garlic (or use a garlic press).","Heat a drizzle of oil in a large saucepan on high heat. Once hot, add the sliced pepper and season with salt and pepper. Fry until softened and slightly charred, 4-5 mins. Continue to stir while it cooks.","Meanwhile, drain the prawns. Wash your hands and equipment after handling raw prawns. Cut the lime into wedges.","Once the pepper has softened, add the green beans, garlic and yellow Thai style paste. Fry until fragrant, 1 min. Once fragrant, stir in the coconut milk, soy and water for the sauce (use the quantities listed in the ingredients). Bring to the boil. Once boiling, stir in the prawns and cook for another 5-6 mins. The prawns are cooked when pink on the outside and opaque in the middle.","When the prawns have 2 mins left of cooking time, add the udon noodles to the laksa. Cook, using a fork to gently separate them, until warmed through, 2-3 mins. When everything's ready, remove the laksa from the heat and squeeze in some of the lime juice. Taste and season with salt, pepper and more lime juice if you feel it needs it.","Share the prawn noodle soup between serving bowls. Serve with any remaining lime wedges for squeezing over to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/697a56dbbcdfd65d69c378b5/step-3a2d3c00.jpg","caption":"Get Started"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/697a56dbbcdfd65d69c378b5/step-e9e20b10.jpg","caption":"Fry the Pepper"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/697a56dbbcdfd65d69c378b5/step-33479620.jpg","caption":"Finish the Prep"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/697a56dbbcdfd65d69c378b5/step-3e581b30.jpg","caption":"Simmer Simmer"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/697a56dbbcdfd65d69c378b5/step-d1dbaf40.jpg","caption":"All Together Now"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/697a56dbbcdfd65d69c378b5/step-95818550.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/one-pot-prawn-udon-laksa-inspired-soup-697a56dbbcdfd65d69c378b5","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/one-pot-prawn-udon-laksa-inspired-soup-697a56dbbcdfd65d69c378b5","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"soup","shoppingIngredients":[["80 g","Green Beans"],["1","Bell Pepper"],["1","Garlic Clove"],["160 g","King Prawns"],["1","Lime"],["45 g","Yellow Thai Style Paste"],["180 ml","Coconut Milk"],["10 ml","Soy Sauce"],["220 g","Udon Noodles"],["150 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work.","prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true},{"id":"banana-yoghurt-oat-pots","sourceId":"697a571ebcdfd65d69c3790e","title":"Quick Chipotle Pulled Chicken and Pepper Soup","subtitle":"with Homemade Tortilla Chips, Cheese and Kidney Beans","time":25,"cost":22.17,"servings":2,"scaleSafe":true,"tags":["quick","high protein","latin-american-faves","soup-stew","medium spice","mexican","poultry","soup"],"requiredEquipment":[],"sourceEquipment":["Large Saucepan","Bowl","Garlic Press","Potato Masher","Lid","Baking Tray","Grater"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R23_W27_UK_QR10870-36_Main_high-0f73db8b.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/quick-chipotle-pulled-chicken-and-pepper-soup-697a571ebcdfd65d69c3790e","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1","Bell Pepper"],["2","Garlic Clove"],["1 carton","Red Kidney Beans"],["20 g","Chipotle Paste"],["20 g","Chicken Stock Paste"],["1 carton","Tomato Passata"],["4","British Chicken Thighs"],["3.96","Plain Taco Tortillas"],["30 g","Mature Cheddar Cheese"],["40 g","Baby Spinach"],["75 g","Soured Cream"],["1 tsp","Sugar for the Sauce"],["175 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1","Bell Pepper"],["2","Garlic Clove"],["1 carton","Red Kidney Beans"],["20 g","Chipotle Paste"],["20 g","Chicken Stock Paste"],["1 carton","Tomato Passata"],["4","British Chicken Thighs"],["3.96","Plain Taco Tortillas"],["30 g","Mature Cheddar Cheese"],["40 g","Baby Spinach"],["75 g","Soured Cream"],["1 tsp","Sugar for the Sauce"],["175 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"632cf717b4f4bc890195c7d3","name":"Bell Pepper","type":"bell-pepper","family":"pepper","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Bell Pepper","marketLabel":"peppers pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55508469fd2cb974658b4567","name":"Red Kidney Beans","type":"organic red kidney beans","family":"beans","amount":"1 carton","sourceAmount":1,"sourceUnit":"carton(s)","shipped":true,"shoppingName":"Red Kidney Beans","marketLabel":"beans equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a70affd2cb95a598b456f","name":"Chipotle Paste","type":"chipotle paste","family":"Chili sauce","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Chipotle Paste","marketLabel":"cooking paste equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60002d898c8c0a188200a96d","name":"Chicken Stock Paste","type":"chicken-stock-paste","family":"stock concentrate","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Chicken Stock Paste","marketLabel":"chicken stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55672166f8b25e412f8b4567","name":"Tomato Passata","type":"tomato passata","family":"single ingredient paste","amount":"1 carton","sourceAmount":1,"sourceUnit":"carton(s)","shipped":true,"shoppingName":"Tomato Passata","marketLabel":"passata 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55508317f8b25e4d4c8b456a","name":"British Chicken Thighs","type":"chicken-thighs","family":"chicken","amount":"4","sourceAmount":4,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"British Chicken Thighs","marketLabel":"British chicken thigh fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"683727bfd9848b9dac04fe03","name":"Plain Taco Tortillas","type":"plain-taco-tortilla","family":"none","amount":"3.96","sourceAmount":3.96,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Plain Taco Tortillas","marketLabel":"wraps or tortillas x8","marketChecked":true,"priceMatchType":"source-identity"},{"id":"69146769623e0c85b6821082","name":"Mature Cheddar Cheese","type":"cheddar-cheese","family":"hard cheese","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Mature Cheddar Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555c9dd5fd2cb92f6c8b4569","name":"Baby Spinach","type":"baby spinach","family":"spinach","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Spinach","marketLabel":"spinach 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68382535f7d5496ac4a6a740","name":"Soured Cream","type":"soured-cream","family":"soured cream","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Soured Cream","marketLabel":"soured cream 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb612688281450b8bd07c","name":"Sugar for the Sauce","type":"sugar-for-the-sauce-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Sauce","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"175 ml","sourceAmount":175,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Halve the bell pepper and discard the core and seeds. Chop into 1cm strips. Heat a drizzle of oil in a large saucepan on medium-high heat. Once hot, add the sliced pepper and cook until softened, 5-6 mins.","Meanwhile, peel and grate the garlic (or use a garlic press). Pop half the kidney beans and their liquid into a medium bowl, then mash with a potato masher. Add the garlic and chipotle paste (add less if you'd prefer things milder) to the pepper pan and fry, 1 min more.","Add the whole and mashed beans, chicken stock paste, passata, sugar and water for the sauce (use the quantities listed in the ingredients) to the pepper. Stir to combine and bring to the boil. Once boiling, lower the heat to medium, add the chicken thighs and cover with a lid. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Simmer until the chicken is cooked, 15-20 mins, stirring halfway. Wash your hands and equipment after handling raw chicken. It's cooked when no longer pink in the middle.","Meanwhile, cut each tortilla (2 per person) into 8 triangles (use scissors if easier). Place on a large baking tray in a single layer (use two trays if needed) and drizzle with oil. Season with salt and pepper. When the oven is hot, bake on the top shelf until lightly golden brown and crisp, 5-7 mins. Keep an eye on them as they can brown quickly.","While everything cooks, grate the Cheddar cheese. Add the spinach to the pan a handful at a time until wilted and piping hot, 1-2 mins. When the soup is ready, remove from the heat. Transfer the chicken onto a board. Use two forks to shred the chicken as finely as you can. Stir the shredded chicken and half the cheese through the soup. Taste and season with salt and pepper if needed. Add a splash of water to loosen if it's a little thick.","Share the chipotle chicken soup between your bowls. Drizzle over the soured cream and swirl it in if you'd like. Sprinkle over the remaining cheese. Serve with the tortilla chips alongside for dipping."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/697a571ebcdfd65d69c3790e/step-641e7400.jpg","caption":"Cook the Pepper"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/697a571ebcdfd65d69c3790e/step-f9b88810.jpg","caption":"Bring on the Beans"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/697a571ebcdfd65d69c3790e/step-db02f520.jpg","caption":"Simmer the Soup"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/697a571ebcdfd65d69c3790e/step-5683d230.jpg","caption":"Bake the Tortillas"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/697a571ebcdfd65d69c3790e/step-c8750740.jpg","caption":"Finish Up"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/697a571ebcdfd65d69c3790e/step-a6834750.jpg","caption":"Garnish and Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/quick-chipotle-pulled-chicken-and-pepper-soup-697a571ebcdfd65d69c3790e","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/quick-chipotle-pulled-chicken-and-pepper-soup-697a571ebcdfd65d69c3790e","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"soup","shoppingIngredients":[["1","Bell Pepper"],["2","Garlic Clove"],["1 carton","Red Kidney Beans"],["20 g","Chipotle Paste"],["20 g","Chicken Stock Paste"],["1 carton","Tomato Passata"],["4","British Chicken Thighs"],["3.96","Plain Taco Tortillas"],["30 g","Mature Cheddar Cheese"],["40 g","Baby Spinach"],["75 g","Soured Cream"],["1 tsp","Sugar for the Sauce"],["175 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work.","prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true},{"id":"sweet-potato-chickpea-tray-lunch","sourceId":"69710d58384e652ce6a500a7","title":"Teriyaki Pulled Pork Tacos","subtitle":"with Smashed Avocado, Cheddar, Fries and Sriracha Slaw","time":45,"cost":24.03,"servings":2,"scaleSafe":true,"tags":["high protein","pan-asian-plates","handhelds","customer favourite","hellofresh specials","japanese","pork","handheld","cook","wrap"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Oven dish","Aluminum Foil","Grater","Small Bowl","Fork"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R77_W13_UK_SSF16461-13_Main_high-fb29ba46.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/teriyaki-pulled-pork-tacos-69710d58384e652ce6a500a7","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["450 g","Potatoes"],["425 g","Slow Cooked British Pork"],["1","Lime"],["0.5","Red Onion"],["1","Baby Gem Lettuce"],["50 g","Mature Cheddar Cheese"],["16 ml","Sriracha Sauce"],["96 g","Mayonnaise"],["120 g","Sliced Carrot and Cabbage Mix"],["75 g","Teriyaki Sauce"],["6","Plain Taco Tortillas"],["150 g","Smashed Avocado"],["1 tsp","Sugar for the Pickle"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["450 g","Potatoes"],["425 g","Slow Cooked British Pork"],["1","Lime"],["0.5","Red Onion"],["1","Baby Gem Lettuce"],["50 g","Mature Cheddar Cheese"],["16 ml","Sriracha Sauce"],["96 g","Mayonnaise"],["120 g","Sliced Carrot and Cabbage Mix"],["75 g","Teriyaki Sauce"],["6","Plain Taco Tortillas"],["150 g","Smashed Avocado"],["1 tsp","Sugar for the Pickle"]],"ingredientMeta":[{"id":"5a39929ec9fd0814815939c2","name":"Potatoes","type":"potatoes","family":"potato","amount":"450 g","sourceAmount":450,"sourceUnit":"grams","shipped":true,"shoppingName":"Potatoes","marketLabel":"potatoes 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5757f24df8b25e5a608b4567","name":"Slow Cooked British Pork","type":"pork-shoulder","family":"pork","amount":"425 g","sourceAmount":425,"sourceUnit":"grams","shipped":true,"shoppingName":"Slow Cooked British Pork","marketLabel":"pork cut equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6e2a4dab71a9058b4569","name":"Lime","type":"lime","family":"lime","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lime","marketLabel":"limes x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6fb4fd2cb95a598b456e","name":"Red Onion","type":"red onion","family":"onion","amount":"0.5","sourceAmount":0.5,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Red Onion","marketLabel":"red onions x3","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68ecc674fa624b85e8848c26","name":"Baby Gem Lettuce","type":"baby gem lettuce","family":"salad mix","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Baby Gem Lettuce","marketLabel":"lettuce or salad leaves","marketChecked":true,"priceMatchType":"source-identity"},{"id":"69146769623e0c85b6821082","name":"Mature Cheddar Cheese","type":"cheddar-cheese","family":"hard cheese","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Mature Cheddar Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5c3f3eadc445fa4233599443","name":"Sriracha Sauce","type":"sriracha (anchovy)","family":"Chili sauce","amount":"16 ml","sourceAmount":16,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Sriracha Sauce","marketLabel":"table sauce equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555c9d234dab7162138b4568","name":"Mayonnaise","type":"mayonnaise-tbsp","family":"mayonnaise","amount":"96 g","sourceAmount":96,"sourceUnit":"grams","shipped":true,"shoppingName":"Mayonnaise","marketLabel":"mayonnaise 500ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5be4237630006c222055d042","name":"Sliced Carrot and Cabbage Mix","type":"coleslaw-mix","family":"salad mix","amount":"120 g","sourceAmount":120,"sourceUnit":"grams","shipped":true,"shoppingName":"Sliced Carrot and Cabbage Mix","marketLabel":"carrots 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"67f0611cb777f3317f54763f","name":"Teriyaki Sauce","type":"teriyaki-sauce","family":"sauce","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Teriyaki Sauce","marketLabel":"teriyaki sauce 150ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"683727bfd9848b9dac04fe03","name":"Plain Taco Tortillas","type":"plain-taco-tortilla","family":"none","amount":"6","sourceAmount":6,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Plain Taco Tortillas","marketLabel":"wraps or tortillas x8","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5e285e8f144ad0555416175d","name":"Smashed Avocado","type":"guacamole","family":"avocado","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"Smashed Avocado","marketLabel":"avocado each","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5e3416f081143769dd33ba49","name":"Sugar for the Pickle","type":"sugar-for-the-pickle-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Pickle","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Chop the potatoes lengthways into 1cm slices, then chop into 1cm wide fries (no need to peel). Pop the fries onto a large baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Spread out in a single layer. Use two baking trays if necessary. When the oven is hot, bake on the top shelf until golden, 25-30 mins. Turn halfway through.","Meanwhile, remove the pork shoulder from the packaging. Place in an ovenproof dish along with the juices and cover loosely with foil. Roast on the middle shelf for 25-30 mins. Ensure the pork is piping hot throughout.","While everything's in the oven, halve the lime. Halve, peel and slice the red onion as thinly as you can (use the amount listed in the ingredients). Trim the baby gem, halve lengthways, then thinly slice. In a small bowl, combine the sliced onion, juice from half the lime and the sugar for the pickle (use the quantities listed in the ingredients). Add a pinch of salt, mix together and set aside to pickle. Grate the cheese.","In a medium bowl, combine the sriracha and half the mayo. Season with salt and pepper. Add the coleslaw mix and toss until evenly coated. Set aside.","Once cooked, remove the pork from the oven, then discard the foil and any cooking juices. Use two forks to shred the pork as finely as you can. Stir the teriyaki sauce and a squeeze of lime through the pork. Taste and season with salt and pepper if needed. Pop the tortillas (3 per person) into the oven to warm through, 1-2 mins.","When everything's ready, lay the warmed tortillas onto your plates. Spread the remaining mayo over the tacos using the back of a spoon. Top with handful of baby gem lettuce, pulled pork, a dollop of the smashed avocado and a few slices of pickled onion - as much as you'd like. Sprinkle over the cheese. Add the remaining pickled onion along with any liquids to the slaw. Toss to combine. Serve the tacos with the fries, sriracha slaw and any remaining smashed avocado on the side."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69710d58384e652ce6a500a7/step-163e6200.jpg","caption":"Get your Fries On"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69710d58384e652ce6a500a7/step-de21c810.jpg","caption":"Roast the Pork"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69710d58384e652ce6a500a7/step-8040f120.jpg","caption":"Get in a Pickle"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69710d58384e652ce6a500a7/step-10a2af30.jpg","caption":"Mix your Slaw"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69710d58384e652ce6a500a7/step-81744240.jpg","caption":"Teriyaki Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69710d58384e652ce6a500a7/step-0ea83250.jpg","caption":"Fill and Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/teriyaki-pulled-pork-tacos-69710d58384e652ce6a500a7","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/teriyaki-pulled-pork-tacos-69710d58384e652ce6a500a7","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"wrap","shoppingIngredients":[["450 g","Potatoes"],["425 g","Slow Cooked British Pork"],["1","Lime"],["0.5","Red Onion"],["1","Baby Gem Lettuce"],["50 g","Mature Cheddar Cheese"],["16 ml","Sriracha Sauce"],["96 g","Mayonnaise"],["120 g","Sliced Carrot and Cabbage Mix"],["75 g","Teriyaki Sauce"],["6","Plain Taco Tortillas"],["150 g","Smashed Avocado"],["1 tsp","Sugar for the Pickle"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work.","prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true},{"id":"chicken-pepper-tray-lunch","sourceId":"6967ce5d6a9c9fe9127174f4","title":"Sichuan Shui Zhu Yu Inspired Fish Broth","subtitle":"with Chilli Flakes, Ginger, Sesame and Rice","time":25,"cost":20.63,"servings":2,"scaleSafe":true,"tags":["pescatarian","quick","calorie smart","discovery","cuisine-spotlight","medium spice","high protein","healthy options","new","chinese","seafood","soup"],"requiredEquipment":[],"sourceEquipment":["Sieve","Kettle","Lid","Large Saucepan","Garlic Press"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R25_W12_UK_QR51739-5_Main_high-16434fce.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/sichuan-shui-zhu-yu-inspired-fish-broth-6967ce5d6a9c9fe9127174f4","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["150 g","Jasmine Rice"],["1","Bell Pepper"],["60 g","Baby Corn"],["2","Garlic Clove"],["1","Spring Onion"],["2","Basa Fillets"],["15 g","Ginger Puree"],["1 sachet","Chilli Flakes"],["25 g","Asian Broth Paste"],["10 ml","Soy Sauce"],["5 g","Roasted White Sesame Seeds"],["300 ml","Water for the Sauce"],["1 tbsp","Honey"],["as needed","cooking oil"]],"sourceIngredients":[["150 g","Jasmine Rice"],["1","Bell Pepper"],["60 g","Baby Corn"],["2","Garlic Clove"],["1","Spring Onion"],["2","Basa Fillets"],["15 g","Ginger Puree"],["1 sachet","Chilli Flakes"],["25 g","Asian Broth Paste"],["10 ml","Soy Sauce"],["5 g","Roasted White Sesame Seeds"],["300 ml","Water for the Sauce"],["1 tbsp","Honey"]],"ingredientMeta":[{"id":"59b020d9c2880076673eb222","name":"Jasmine Rice","type":"jasmine-rice","family":"rice","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"Jasmine Rice","marketLabel":"basmati rice 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632cf717b4f4bc890195c7d3","name":"Bell Pepper","type":"bell-pepper","family":"pepper","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Bell Pepper","marketLabel":"peppers pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556876f2fd2cb983298b4569","name":"Baby Corn","type":"baby corn","family":"corn","amount":"60 g","sourceAmount":60,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Corn","marketLabel":"fresh vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6684fd2cb9ba598b4567","name":"Spring Onion","type":"spring onion","family":"onion","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Spring Onion","marketLabel":"spring onions bunch","marketChecked":true,"priceMatchType":"source-identity"},{"id":"63ea5428bf26581163f3b45c","name":"Basa Fillets","type":"basa","family":"none","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Basa Fillets","marketLabel":"white fish equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"59f334f92c3e085ecd21b7f2","name":"Ginger Puree","type":"ginger-puree","family":"ginger","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Ginger Puree","marketLabel":"fresh ginger 100g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5fe8f8b25e1e268b4579","name":"Chilli Flakes","type":"chilli flakes","family":"spice blend","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Chilli Flakes","marketLabel":"chilli flakes 45g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6837ac14f7d5496ac4a6820d","name":"Asian Broth Paste","type":"asian-broth-paste","family":"none","amount":"25 g","sourceAmount":25,"sourceUnit":"grams","shipped":true,"shoppingName":"Asian Broth Paste","priceMatchType":"source-identity"},{"id":"680b9d014a6668c89d92df5a","name":"Soy Sauce","type":"soy sauce","family":"sauce","amount":"10 ml","sourceAmount":10,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Soy Sauce","marketLabel":"soy sauce 150ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68371fa942dc4b928197f185","name":"Roasted White Sesame Seeds","type":"roasted-white-sesame-seeds","family":"sesame seed","amount":"5 g","sourceAmount":5,"sourceUnit":"grams","shipped":true,"shoppingName":"Roasted White Sesame Seeds","marketLabel":"sesame seeds 100g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"300 ml","sourceAmount":300,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"6172cb313021d49a7feafc84","name":"Honey","type":"honey-1-tbsp","family":"honey","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Boil a half-full kettle. Pour the boiled water into a large saucepan with ¼ tsp salt on high heat. Add the rice and cook for 12-13 mins. Drain in a sieve and pop back in the pan. Cover with a lid and leave to the side until ready to serve.","Meanwhile, halve the bell pepper and discard the core and seeds. Chop into 2cm chunks. Chop the baby corn into 1cm thick rounds. Heat a drizzle of oil in a large saucepan on high heat. Once hot, add the pepper chunks and baby corn and fry until charred, 5-6 mins. Continue to stir while they cook.","Meanwhile, peel and grate the garlic (or use a garlic press). Trim and thinly slice the spring onion.","Pat the basa dry with kitchen paper and cut the basa into 4cm pieces. Wash your hands and equipment after handling raw fish. Once the veg is softened, reduce the heat and add the ginger puree, garlic, the white part of the spring onion and half the chilli flakes. Fry until fragrant, 1-2 mins.","Stir in the water for the broth (use the quantities listed in the ingredients), soy sauce and Asian broth paste and bring to the boil. Lower the heat to medium and add the basa pieces to the sauce, stirring to coat. Simmer gently until the fish is cooked, 5-8 mins. The fish is cooked when opaque in the middle. Stir the honey (use the quantities listed in the ingredients) into the broth.","Share the rice between your serving bowls. Spoon over the broth, fish pieces and veg. Sprinkle over the remaining chilli flakes (add less if you'd prefer things milder) and the remaining green part of the spring onion. Scatter over the sesame seeds to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce5d6a9c9fe9127174f4/step-d1eb0300.jpg","caption":"Get Started"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce5d6a9c9fe9127174f4/step-3a779010.jpg","caption":"Start Frying"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce5d6a9c9fe9127174f4/step-391b3120.jpg","caption":"Finish the Prep"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce5d6a9c9fe9127174f4/step-58dfb930.jpg","caption":"Cut the Basa"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce5d6a9c9fe9127174f4/step-d6167940.jpg","caption":"Simmer the Broth"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce5d6a9c9fe9127174f4/step-16516150.jpg","caption":"Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/sichuan-shui-zhu-yu-inspired-fish-broth-6967ce5d6a9c9fe9127174f4","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/sichuan-shui-zhu-yu-inspired-fish-broth-6967ce5d6a9c9fe9127174f4","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"soup","shoppingIngredients":[["150 g","Jasmine Rice"],["1","Bell Pepper"],["60 g","Baby Corn"],["2","Garlic Clove"],["1","Spring Onion"],["2","Basa Fillets"],["15 g","Ginger Puree"],["1 sachet","Chilli Flakes"],["25 g","Asian Broth Paste"],["10 ml","Soy Sauce"],["5 g","Roasted White Sesame Seeds"],["300 ml","Water for the Sauce"],["1 tbsp","Honey"],["as needed","cooking oil"]],"isLunch":true,"prepStyle":"quick","light":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work.","prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true},{"id":"halloumi-veg-tray-lunch","sourceId":"6967ce6d850f974aa212e28e","title":"Beef Korma Style Curry Loaded Jacket Potato","subtitle":"with Radish and Baby Leaf Salad","time":40,"cost":20.44,"servings":2,"scaleSafe":true,"tags":["south/southeastasian","classic-plates","family friendly","new","indian","beef","other","cook","potato"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Bowl","Garlic Press","Pan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R05_W12_UK_F17211-6_Main_high-3664ee15.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/beef-korma-style-curry-loaded-jacket-potato-6967ce6d850f974aa212e28e","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["2","Baking Potato"],["1","Red Onion"],["2","Garlic Clove"],["100 g","Radishes"],["12 ml","Red Wine Vinegar"],["240 g","British Beef Mince"],["50 g","Korma Curry Paste"],["75 g","Creme Fraiche"],["10 g","Chicken Stock Paste"],["15 g","Honey"],["50 g","Baby Leaf Mix"],["0.5 tsp","Sugar"],["1 tbsp","Olive Oil for the Dressing"],["75 ml","Water"],["to taste","salt"],["to taste","black pepper"],["15 g","butter"]],"sourceIngredients":[["2","Baking Potato"],["1","Red Onion"],["2","Garlic Clove"],["100 g","Radishes"],["12 ml","Red Wine Vinegar"],["240 g","British Beef Mince"],["50 g","Korma Curry Paste"],["75 g","Creme Fraiche"],["10 g","Chicken Stock Paste"],["15 g","Honey"],["50 g","Baby Leaf Mix"],["0.5 tsp","Sugar"],["1 tbsp","Olive Oil for the Dressing"],["75 ml","Water"]],"ingredientMeta":[{"id":"556857824dab717e1d8b4569","name":"Baking Potato","type":"baking-potato","family":"potato","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Baking Potato","marketLabel":"potatoes 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6fb4fd2cb95a598b456e","name":"Red Onion","type":"red onion","family":"onion","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Red Onion","marketLabel":"red onions x3","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5e285e7fa395ab02d4687bc8","name":"Radishes","type":"radishes","family":"radish","amount":"100 g","sourceAmount":100,"sourceUnit":"grams","shipped":true,"shoppingName":"Radishes","marketLabel":"fresh vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555ca1774dab7190138b4568","name":"Red Wine Vinegar","type":"red wine vinegar","family":"vinegar","amount":"12 ml","sourceAmount":12,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Red Wine Vinegar","marketLabel":"cooking vinegar equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556c1c67fd2cb99f468b4567","name":"British Beef Mince","type":"beef mince","family":"beef","amount":"240 g","sourceAmount":240,"sourceUnit":"grams","shipped":true,"shoppingName":"British Beef Mince","marketLabel":"5% fat beef mince 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5de10b3aa28b1766010e3f86","name":"Korma Curry Paste","type":"korma-curry-paste","family":"spice blend","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Korma Curry Paste","marketLabel":"curry paste jar","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555084f34dab718e128b4569","name":"Creme Fraiche","type":"creme-fraiche","family":"soured cream","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Creme Fraiche","marketLabel":"creme fraiche 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60002d898c8c0a188200a96d","name":"Chicken Stock Paste","type":"chicken-stock-paste","family":"stock concentrate","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":true,"shoppingName":"Chicken Stock Paste","marketLabel":"chicken stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555363fff8b25e5e0c8b4567","name":"Honey","type":"honey","family":"honey","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"56b23e4ef8b25e4c2d8b4567","name":"Baby Leaf Mix","type":"premium baby leaf mix","family":"salad mix","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Leaf Mix","marketLabel":"lettuce or salad leaves","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555093924dab71e7118b4568","name":"Sugar","type":"sugar-1-tsp","family":"single spice","amount":"0.5 tsp","sourceAmount":0.5,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb168688281450b8bd062","name":"Olive Oil for the Dressing","type":"olive-oil-for-the-dressing-1-tbsp","family":"oil","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Olive Oil for the Dressing","marketLabel":"cooking oil 1 litre","marketChecked":true,"priceMatchType":"source-identity"},{"id":"57484fa04dab7170318b4567","name":"Water","type":"water-100ml","family":"other drink","amount":"75 ml","sourceAmount":75,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 240°C/220°C fan/gas mark 9. Halve the potatoes lengthways and pop them onto a large baking tray. Drizzle with oil, season with salt and pepper, then rub to coat. Lay them cut-side down. When the oven is hot, bake on the top shelf of your oven until tender and a knife slips in easily, 30-40 mins. Alternatively, if you have a microwave, you can speed things up. Halve the potatoes lengthways, then prick all over with a knife. Rub with a little oil and season with salt. Place cut-side down onto a plate, then microwave on high until tender, 15-18 mins.","Meanwhile, halve, peel and thinly slice the red onion. Peel and grate the garlic (or use a garlic press). Trim and quarter the radishes. In a large bowl, combine the red wine vinegar, sugar and olive oil for the dressing (use the quantities listed in the ingredients). Season with salt and pepper and set aside.","When the potatoes have 10 mins remaining, heat a large frying pan on medium-high heat (no oil). Once hot, add the beef mince and onion. Fry until the mince has browned and the onion has softened, 5-6 mins. Use a spoon to break up the mince as it cooks. When the mince has browned, drain and discard any excess fat. Season with salt and pepper. Wash your hands and equipment after handling raw mince. It's cooked when no longer pink in the middle.","Add the garlic and korma curry paste to the pan. Cook until fragrant, 1 min. Stir in the creme fraiche, chicken stock paste, honey and water (use the quantities listed in the ingredients). Season with salt and pepper. Simmer until slightly thickened, 2-3 mins. Remove from the heat. Add a splash of water if it's a little too thick.","Just before serving, add the baby leaves and radishes to the dressing. Toss to coat. Don't add the leaves too early or they'll go soggy. Make kid friendly: If your kids aren't keen on dressing, save a portion of the salad / veg for them and mix the rest with the dressing for everyone else.","Share the potatoes between your plates and add 15 g butter to the cut sides of the potatoes. Roughly mash it into the potatoes with a fork. Top with the beef korma style curry. Serve the radish salad alongside."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce6d850f974aa212e28e/step-f4870700.jpg","caption":"Roast the Jacky-Ps"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce6d850f974aa212e28e/step-b94f5810.jpg","caption":"Do the Prep"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce6d850f974aa212e28e/step-4b8e8220.jpg","caption":"Fry the Beef"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce6d850f974aa212e28e/step-eb5aca30.jpg","caption":"Add the Flavour"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce6d850f974aa212e28e/step-cdfba840.jpg","caption":"Finishing Touches"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce6d850f974aa212e28e/step-500e0750.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/beef-korma-style-curry-loaded-jacket-potato-6967ce6d850f974aa212e28e","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/beef-korma-style-curry-loaded-jacket-potato-6967ce6d850f974aa212e28e","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"potato","shoppingIngredients":[["2","Baking Potato"],["1","Red Onion"],["2","Garlic Clove"],["100 g","Radishes"],["12 ml","Red Wine Vinegar"],["240 g","British Beef Mince"],["50 g","Korma Curry Paste"],["75 g","Creme Fraiche"],["10 g","Chicken Stock Paste"],["15 g","Honey"],["50 g","Baby Leaf Mix"],["0.5 tsp","Sugar"],["1 tbsp","Olive Oil for the Dressing"],["75 ml","Water"],["to taste","salt"],["to taste","black pepper"],["15 g","butter"]],"isLunch":true,"prepStyle":"cook","light":false,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work.","prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true},{"id":"sausage-tomato-tray-lunch","sourceId":"6967ce51850f974aa212e260","title":"Birria Style Pulled Beef and Cheese Tacos","subtitle":"with Soured Cream, Mozzarella, Wedges and Baby Plum Tomato Salad","time":45,"cost":27.35,"servings":2,"scaleSafe":true,"tags":["medium spice","latin-american-faves","classic-plates","high protein","mothers-day","hellofresh specials","mexican","beef","handheld","cook","wrap"],"requiredEquipment":[],"sourceEquipment":["Bowl","Grater","Baking Tray","Large Saucepan","Tongs","Colander","Baking Paper"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R47_W33_UK_SSF44036-4_Main_high-b6bbd176.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/birria-style-pulled-beef-and-cheese-tacos-6967ce51850f974aa212e260","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1 ball","Mozzarella"],["60 g","Mature Cheddar Cheese"],["125 g","Baby Plum Tomatoes"],["12 ml","Red Wine Vinegar"],["450 g","Potatoes"],["1 sachet","Mexican Style Spice Mix"],["20 g","Chipotle Paste"],["1 carton","Tomato Passata"],["6","Plain Taco Tortillas"],["28 g","Red Wine Stock Paste"],["280 g","Slow Cooked Beef"],["50 g","Baby Leaf Mix"],["75 g","Soured Cream"],["0.5 tsp","Sugar for the Dressing"],["1 tbsp","Olive Oil for the Dressing"],["1 tsp","Sugar for the Sauce"],["100 ml","Water for the Sauce"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1 ball","Mozzarella"],["60 g","Mature Cheddar Cheese"],["125 g","Baby Plum Tomatoes"],["12 ml","Red Wine Vinegar"],["450 g","Potatoes"],["1 sachet","Mexican Style Spice Mix"],["20 g","Chipotle Paste"],["1 carton","Tomato Passata"],["6","Plain Taco Tortillas"],["28 g","Red Wine Stock Paste"],["280 g","Slow Cooked Beef"],["50 g","Baby Leaf Mix"],["75 g","Soured Cream"],["0.5 tsp","Sugar for the Dressing"],["1 tbsp","Olive Oil for the Dressing"],["1 tsp","Sugar for the Sauce"],["100 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"555087684dab71e3118b4569","name":"Mozzarella","type":"mozzarella","family":"hard cheese","amount":"1 ball","sourceAmount":1,"sourceUnit":"ball(s)","shipped":true,"shoppingName":"Mozzarella","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"69146769623e0c85b6821082","name":"Mature Cheddar Cheese","type":"cheddar-cheese","family":"hard cheese","amount":"60 g","sourceAmount":60,"sourceUnit":"grams","shipped":true,"shoppingName":"Mature Cheddar Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5a3cee59c2880024501f6622","name":"Baby Plum Tomatoes","type":"baby-plum-tomatoes","family":"tomato","amount":"125 g","sourceAmount":125,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Plum Tomatoes","marketLabel":"fresh fruit equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555ca1774dab7190138b4568","name":"Red Wine Vinegar","type":"red wine vinegar","family":"vinegar","amount":"12 ml","sourceAmount":12,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Red Wine Vinegar","marketLabel":"cooking vinegar equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5a39929ec9fd0814815939c2","name":"Potatoes","type":"potatoes","family":"potato","amount":"450 g","sourceAmount":450,"sourceUnit":"grams","shipped":true,"shoppingName":"Potatoes","marketLabel":"potatoes 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60c89afa8e1c4145a37bc75f","name":"Mexican Style Spice Mix","type":"mexican-style-spice-mix","family":"spice blend","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Mexican Style Spice Mix","marketLabel":"seasoning blend equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a70affd2cb95a598b456f","name":"Chipotle Paste","type":"chipotle paste","family":"Chili sauce","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Chipotle Paste","marketLabel":"cooking paste equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55672166f8b25e412f8b4567","name":"Tomato Passata","type":"tomato passata","family":"single ingredient paste","amount":"1 carton","sourceAmount":1,"sourceUnit":"carton(s)","shipped":true,"shoppingName":"Tomato Passata","marketLabel":"passata 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"683727bfd9848b9dac04fe03","name":"Plain Taco Tortillas","type":"plain-taco-tortilla","family":"none","amount":"6","sourceAmount":6,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Plain Taco Tortillas","marketLabel":"wraps or tortillas x8","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5a4fc599c288003649295c52","name":"Red Wine Stock Paste","type":"red-wine-stock-pot","family":"stock concentrate","amount":"28 g","sourceAmount":28,"sourceUnit":"grams","shipped":true,"shoppingName":"Red Wine Stock Paste","marketLabel":"beef cooking concentrate equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"637f7b0b1ef09fb45a483bb5","name":"Slow Cooked Beef","type":"slow-cooked-beef","family":"none","amount":"280 g","sourceAmount":280,"sourceUnit":"grams","shipped":true,"shoppingName":"Slow Cooked Beef","marketLabel":"prepared beef equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"56b23e4ef8b25e4c2d8b4567","name":"Baby Leaf Mix","type":"premium baby leaf mix","family":"salad mix","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Leaf Mix","marketLabel":"lettuce or salad leaves","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68382535f7d5496ac4a6a740","name":"Soured Cream","type":"soured-cream","family":"soured cream","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Soured Cream","marketLabel":"soured cream 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb425688281450b8bd079","name":"Sugar for the Dressing","type":"sugar-for-the-dressing-1-tsp","family":"single spice","amount":"0.5 tsp","sourceAmount":0.5,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Dressing","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb168688281450b8bd062","name":"Olive Oil for the Dressing","type":"olive-oil-for-the-dressing-1-tbsp","family":"oil","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Olive Oil for the Dressing","marketLabel":"cooking oil 1 litre","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb612688281450b8bd07c","name":"Sugar for the Sauce","type":"sugar-for-the-sauce-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Sauce","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"100 ml","sourceAmount":100,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Drain the mozzarella and squeeze out as much liquid as you can. Pat it dry with kitchen paper, tear into small pieces, then season lightly with salt. Spread the pieces out on a fresh sheet of kitchen paper and set aside - this helps prevent the cheese from releasing moisture when baking later! Meanwhile, grate the Cheddar cheese. Halve the baby plum tomatoes. In a medium bowl, combine the red wine vinegar, sugar and olive oil for the dressing (use the quantities listed in the ingredients) with a pinch of salt and pepper. Add the tomatoes and toss to coat. Set aside.","Chop the potatoes into 2cm wide wedges (no need to peel). Pop the wedges onto a large baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Spread out in a single layer. Use two baking trays if necessary. When the oven is hot, roast on the top shelf until golden, 25-35 mins. Turn halfway through.","Meanwhile, heat a drizzle of oil in a large saucepan on medium-high heat. Add the Mexican style spice mix and cook until fragrant, 1 min. Add the chipotle paste (add less if you'd prefer things milder), passata, red wine stock paste, sugar and water for the sauce (use the quantities listed in the ingredients). Bring to the boil, add the beef and its juices. Season with salt and pepper. Use a spoon to break up the beef as it cooks. Simmer until thickened slightly, 4-5 mins. Ensure the beef is piping hot throughout.","Once cooked, remove the pan from the heat and pour through a colander set over a large bowl to separate the beef from the birria style sauce. Pop the sauce back into the saucepan. Set the pulled beef side ready for assembling. Using tongs, dip one side of each tortilla (3 per person) into the reserved birria style sauce. Don’t worry if a bit gets on both sides - just make sure at least one side is coated. Gently shake off any excess sauce.","Lay each dipped tortilla, sauce-side down, onto a large lined baking tray. Use two trays if needed. Sprinkle Cheddar cheese over half of each tortilla, then top with the drained pulled beef and a little mozzarella. Carefully fold each tortilla in half over the filling and press down gently to seal. Bake your birria tacos on the middle shelf of your oven until golden brown and bubbling, 15-17 mins.","When everything's ready, add the baby leaves to the tomato bowl and toss to dress the salad. Don't add the leaves too early or they'll go soggy. Share your beef birria style tacos between your plates. Serve the wedges, corn on the cob and tomato salad alongside. Serve the soured cream and remaining birria sauce in small bowls for dipping (reheat the sauce if needed)."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce51850f974aa212e260/step-5a5f2a00.jpg","caption":"Get Started"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce51850f974aa212e260/step-394be410.jpg","caption":"Time for the Wedges"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce51850f974aa212e260/step-d2c68720.jpg","caption":"Make your Birria Sauce"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce51850f974aa212e260/step-9194b830.jpg","caption":"Get Dipping"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce51850f974aa212e260/step-3733c040.jpg","caption":"Assemble and Bake"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/6967ce51850f974aa212e260/step-e2f7ad50.jpg","caption":"Finish and Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/birria-style-pulled-beef-and-cheese-tacos-6967ce51850f974aa212e260","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/birria-style-pulled-beef-and-cheese-tacos-6967ce51850f974aa212e260","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"wrap","shoppingIngredients":[["1 ball","Mozzarella"],["60 g","Mature Cheddar Cheese"],["125 g","Baby Plum Tomatoes"],["12 ml","Red Wine Vinegar"],["450 g","Potatoes"],["1 sachet","Mexican Style Spice Mix"],["20 g","Chipotle Paste"],["1 carton","Tomato Passata"],["6","Plain Taco Tortillas"],["28 g","Red Wine Stock Paste"],["280 g","Slow Cooked Beef"],["50 g","Baby Leaf Mix"],["75 g","Soured Cream"],["0.5 tsp","Sugar for the Dressing"],["1 tbsp","Olive Oil for the Dressing"],["1 tsp","Sugar for the Sauce"],["100 ml","Water for the Sauce"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work.","prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true},{"id":"tuna-chickpea-lemon-boxes","sourceId":"694bee4b2e3f6a49648ef4e2","title":"Cajun Spiced Smoked Fish Chowder","subtitle":"with Baby Spinach and Garlic Bread Dippers","time":40,"cost":23.68,"servings":2,"scaleSafe":true,"tags":["latin-american-faves","soup-stew","pescatarian","medium spice","cajunsk","seafood","soup","cook"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Garlic Press","Medium Saucepan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R25_W51_UK_R19729-5_Main_high-2578ac5d.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/cajun-spiced-smoked-fish-chowder-694bee4b2e3f6a49648ef4e2","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["450 g","Potatoes"],["1","Onion"],["3","Garlic Clove"],["1","Carrot"],["1","Ciabatta"],["1 sachet","Cajun Spice Mix"],["30 g","Tomato Puree"],["15 g","Vegetable Stock Paste"],["75 g","Creme Fraiche"],["200 g","Fish Pie Mix"],["40 g","Baby Spinach"],["20 g","Butter"],["1 tbsp","Olive Oil for the Garlic Bread"],["1.5 tbsp","Plain Flour"],["350 ml","Water for the Sauce"],["1 tsp","Sugar for the Sauce"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["450 g","Potatoes"],["1","Onion"],["3","Garlic Clove"],["1","Carrot"],["1","Ciabatta"],["1 sachet","Cajun Spice Mix"],["30 g","Tomato Puree"],["15 g","Vegetable Stock Paste"],["75 g","Creme Fraiche"],["200 g","Fish Pie Mix"],["40 g","Baby Spinach"],["20 g","Butter"],["1 tbsp","Olive Oil for the Garlic Bread"],["1.5 tbsp","Plain Flour"],["350 ml","Water for the Sauce"],["1 tsp","Sugar for the Sauce"]],"ingredientMeta":[{"id":"5a39929ec9fd0814815939c2","name":"Potatoes","type":"potatoes","family":"potato","amount":"450 g","sourceAmount":450,"sourceUnit":"grams","shipped":true,"shoppingName":"Potatoes","marketLabel":"potatoes 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a59324dab71626c8b4575","name":"Onion","type":"onion","family":"onion","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Onion","marketLabel":"brown onions 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"3","sourceAmount":3,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5f284dab71a6058b4567","name":"Carrot","type":"carrot","family":"carrot","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Carrot","marketLabel":"carrots 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68371fec42dc4b928197f195","name":"Ciabatta","type":"ciabatta","family":"bread dough","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Ciabatta","marketLabel":"bread loaf","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632c5aba35df7918d5096b2f","name":"Cajun Spice Mix","type":"cajun-style-spice","family":"spice blend","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Cajun Spice Mix","marketLabel":"seasoning blend equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a708af8b25ef93e8b4567","name":"Tomato Puree","type":"tomato-puree","family":"single ingredient paste","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Tomato Puree","marketLabel":"tomato puree 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"641093570565a60137055ba9","name":"Vegetable Stock Paste","type":"vegetable-stock-paste","family":"stock concentrate","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Vegetable Stock Paste","marketLabel":"vegetable stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555084f34dab718e128b4569","name":"Creme Fraiche","type":"creme-fraiche","family":"soured cream","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Creme Fraiche","marketLabel":"creme fraiche 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"653c500e2fab1d7bab10cc0f","name":"Fish Pie Mix","type":"fish-pie-mix","family":"none","amount":"200 g","sourceAmount":200,"sourceUnit":"grams","shipped":true,"shoppingName":"Fish Pie Mix","marketLabel":"white fish equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555c9dd5fd2cb92f6c8b4569","name":"Baby Spinach","type":"baby spinach","family":"spinach","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Spinach","marketLabel":"spinach 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60c73507053f5e815cd52d5b","name":"Butter","type":"butter-100g","family":"butter","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":false,"shoppingName":"Butter","marketLabel":"butter 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"602fb8be9c479d367f798aee","name":"Olive Oil for the Garlic Bread","type":"olive-oil-for-the-garlic-bread-1-tbsp","family":"oil","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Olive Oil for the Garlic Bread","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60f9470be5a270ab7dbce1b8","name":"Plain Flour","type":"plain-flour-1-tbsp","family":"flour","amount":"1.5 tbsp","sourceAmount":1.5,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Plain Flour","marketLabel":"plain flour 1.5kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"350 ml","sourceAmount":350,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"5fbeb612688281450b8bd07c","name":"Sugar for the Sauce","type":"sugar-for-the-sauce-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Sauce","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Chop the potatoes into 1cm chunks (no need to peel). Pop the chunks onto a large baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Spread out in a single layer. Use two baking trays if necessary. When the oven is hot, roast on the top shelf until golden, 18-20 mins. Turn halfway through.","Meanwhile, halve, peel and chop the onion into small pieces. Peel and grate the garlic (or use a garlic press). Trim the carrot, then quarter lengthways (no need to peel). Chop widthways into small pieces. Heat a drizzle of oil and the butter (use the quantities listed in the ingredients) in a medium saucepan on medium heat. Once the butter has melted, add the onion and carrot, season with salt and pepper and fry, stirring occasionally, until golden and softened, 8-10 mins.","While the veg is cooking, halve the ciabatta and lay onto a medium baking tray, cut-side up. Spread over half the garlic and drizzle with the olive oil for the garlic bread (use the quantities listed in the ingredients). Set aside. Stir the Cajun spice mix (add less if you'd prefer things milder) and remaining garlic into the veg pan. Fry for 1 min.","Next, stir in the tomato puree and fry for 1 min. Stir in the flour (use the quantities listed in the ingredients). Cook until it forms a paste, 1-2 mins - you've made a roux! Pour in the water for the sauce (use the quantities listed in the ingredients) a little at a time, followed by the veg stock paste and sugar for the sauce (use the quantities listed in the ingredients). Bring to the boil, stir and simmer until thickened, 3-4 mins.","When the potatoes are ready, add them to the sauce. Stir in the creme fraiche and bring to the boil. Drain the fish pie mix and pat dry with kitchen paper, then gently stir into the sauce. Simmer until the fish is cooked, 5-8 mins. Wash your hands and equipment after handling raw fish. The fish is cooked when opaque in the middle. Meanwhile, bake the garlic bread on the middle shelf of your oven until golden, 5-6 mins.","Once the fish is cooked, add the spinach to the pan a handful at a time until wilted and piping hot, 1-2 mins. Taste the chowder, and season with salt and pepper if needed. Add a splash of water if it's a little too thick. Share the chowder out between your bowls. Slice the garlic bread into fingers and serve on the side, for dipping."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/694bee4b2e3f6a49648ef4e2/step-b2d22b00.jpg","caption":"Roast the Potatoes"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/694bee4b2e3f6a49648ef4e2/step-271e8810.jpg","caption":"Fry the Veg"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/694bee4b2e3f6a49648ef4e2/step-48a9e020.jpg","caption":"Make the Garlic Bread"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/694bee4b2e3f6a49648ef4e2/step-55326530.jpg","caption":"Roux Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/694bee4b2e3f6a49648ef4e2/step-f9c6ff40.jpg","caption":"Poach the Fish"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/694bee4b2e3f6a49648ef4e2/step-9eb7c150.jpg","caption":"Finish and Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/cajun-spiced-smoked-fish-chowder-694bee4b2e3f6a49648ef4e2","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/cajun-spiced-smoked-fish-chowder-694bee4b2e3f6a49648ef4e2","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"soup","shoppingIngredients":[["450 g","Potatoes"],["1","Onion"],["3","Garlic Clove"],["1","Carrot"],["1","Ciabatta"],["1 sachet","Cajun Spice Mix"],["30 g","Tomato Puree"],["15 g","Vegetable Stock Paste"],["75 g","Creme Fraiche"],["200 g","Fish Pie Mix"],["40 g","Baby Spinach"],["20 g","Butter"],["1 tbsp","Olive Oil for the Garlic Bread"],["1.5 tbsp","Plain Flour"],["350 ml","Water for the Sauce"],["1 tsp","Sugar for the Sauce"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work.","prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true},{"id":"greek-chickpea-feta-boxes","sourceId":"694bee9539d4849fb457cad3","title":"BBQ Cajun Beef Loaded Jacket Potato","subtitle":"with Soured Cream, Smashed Avocado and Crispy Onions","time":40,"cost":17.19,"servings":2,"scaleSafe":true,"tags":["prepped in 10","medium spice","latin-american-faves","classic-plates","customer favourite","high protein","cajunsk","beef","other","cook","potato"],"requiredEquipment":["barbecue"],"sourceEquipment":["Baking Tray","Large Saucepan","Lid","Fork"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R17_W29_UK_R17578-9_MAIN_high-a524a682.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/bbq-cajun-beef-loaded-jacket-potato-694bee9539d4849fb457cad3","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["2","Baking Potato"],["240 g","British Beef Mince"],["30 g","Tomato Puree"],["1 sachet","Cajun Spice Mix"],["10 g","Beef Stock Paste"],["32 g","BBQ Sauce"],["75 g","Soured Cream"],["150 g","Smashed Avocado"],["1 sachet","Crispy Onions"],["20 g","Baby Leaf Mix"],["1 tsp","Sugar"],["100 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"],["15 g","butter"]],"sourceIngredients":[["2","Baking Potato"],["240 g","British Beef Mince"],["30 g","Tomato Puree"],["1 sachet","Cajun Spice Mix"],["10 g","Beef Stock Paste"],["32 g","BBQ Sauce"],["75 g","Soured Cream"],["150 g","Smashed Avocado"],["1 sachet","Crispy Onions"],["20 g","Baby Leaf Mix"],["1 tsp","Sugar"],["100 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"556857824dab717e1d8b4569","name":"Baking Potato","type":"baking-potato","family":"potato","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Baking Potato","marketLabel":"potatoes 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556c1c67fd2cb99f468b4567","name":"British Beef Mince","type":"beef mince","family":"beef","amount":"240 g","sourceAmount":240,"sourceUnit":"grams","shipped":true,"shoppingName":"British Beef Mince","marketLabel":"5% fat beef mince 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a708af8b25ef93e8b4567","name":"Tomato Puree","type":"tomato-puree","family":"single ingredient paste","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Tomato Puree","marketLabel":"tomato puree 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632c5aba35df7918d5096b2f","name":"Cajun Spice Mix","type":"cajun-style-spice","family":"spice blend","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Cajun Spice Mix","marketLabel":"seasoning blend equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60002d416cea0c18f31958a1","name":"Beef Stock Paste","type":"beef-stock-paste","family":"stock concentrate","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":true,"shoppingName":"Beef Stock Paste","marketLabel":"beef stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5581aae1fd2cb95d168b4569","name":"BBQ Sauce","type":"bbq-sauce","family":"sauce","amount":"32 g","sourceAmount":32,"sourceUnit":"grams","shipped":true,"shoppingName":"BBQ Sauce","marketLabel":"BBQ sauce equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68382535f7d5496ac4a6a740","name":"Soured Cream","type":"soured-cream","family":"soured cream","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Soured Cream","marketLabel":"soured cream 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5e285e8f144ad0555416175d","name":"Smashed Avocado","type":"guacamole","family":"avocado","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"Smashed Avocado","marketLabel":"avocado each","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6837308142dc4b928197f3b3","name":"Crispy Onions","type":"crispy-onions","family":"none","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Crispy Onions","marketLabel":"crispy onions 75g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"56b23e4ef8b25e4c2d8b4567","name":"Baby Leaf Mix","type":"premium baby leaf mix","family":"salad mix","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Leaf Mix","marketLabel":"lettuce or salad leaves","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555093924dab71e7118b4568","name":"Sugar","type":"sugar-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"100 ml","sourceAmount":100,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 240°C/220°C fan/gas mark 9. Halve the potatoes lengthways and pop them onto a baking tray. Drizzle with oil and season with salt and pepper.","Rub the oil over the potatoes, then lay them cut-side down. Bake on the top shelf of your oven until tender and a knife slips in easily, 30-40 mins. Alternatively, if you have a microwave, you can speed things up. Halve the potatoes lengthways, then prick all over with a knife. Rub with a little oil and season with salt. Place cut-side down onto a plate, then microwave on high until tender, 15-18 mins.","Meanwhile, heat a drizzle of oil in a wide-bottomed saucepan (with a lid) on medium-high heat. Once hot, add the beef mince and fry until browned, 2-3 mins. Use a spoon to break it up as it cooks. Wash your hands and equipment after handling raw mince. Once browned, drain and discard any excess fat. Season with salt and pepper.","Stir the tomato puree, Cajun spice mix, beef stock paste, sugar and water for the sauce (use the quantities listed in the ingredients) into the beef mince. Bring up to the boil, cover the pan with a lid, then lower to a simmer. Cook until thickened, 10-15 mins. The mince is cooked when no longer pink in the middle.","Once your chilli has thickened and the mince is cooked, stir through the BBQ sauce. Taste and season with salt and pepper if you feel it needs it. Once the potatoes are ready, remove them from your oven. Add 15 g butter to the cut sides of the potatoes. Roughly mash it into the potato with a fork.","Share your jacket potatoes between your plates and top with the Cajun beef mince. Finish with a dollop of soured cream, the smashed avocado and a sprinkle of crispy onions. Serve the baby leaves alongside finished with a drizzle of oil."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/694bee9539d4849fb457cad3/step-6383ee00.jpg","caption":"Get Prepped"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/694bee9539d4849fb457cad3/step-78773f10.jpg","caption":"Oven Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/694bee9539d4849fb457cad3/step-32f29820.jpg","caption":"Fry the Mince"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/694bee9539d4849fb457cad3/step-51a8f730.jpg","caption":"Simmer your Chilli"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/694bee9539d4849fb457cad3/step-29edd940.jpg","caption":"Finishing Touches"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/694bee9539d4849fb457cad3/step-e2610050.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/bbq-cajun-beef-loaded-jacket-potato-694bee9539d4849fb457cad3","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/bbq-cajun-beef-loaded-jacket-potato-694bee9539d4849fb457cad3","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"potato","shoppingIngredients":[["2","Baking Potato"],["240 g","British Beef Mince"],["30 g","Tomato Puree"],["1 sachet","Cajun Spice Mix"],["10 g","Beef Stock Paste"],["32 g","BBQ Sauce"],["75 g","Soured Cream"],["150 g","Smashed Avocado"],["1 sachet","Crispy Onions"],["20 g","Baby Leaf Mix"],["1 tsp","Sugar"],["100 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"],["15 g","butter"]],"isLunch":true,"prepStyle":"cook","light":false,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work.","prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true},{"id":"tofu-cucumber-sesame-boxes","sourceId":"69307368114b735a0061b8b5","title":"Baiana Inspired Veggie Moqueca Soup","subtitle":"with Parsnips and Chickpeas","time":45,"cost":13.08,"servings":2,"scaleSafe":true,"tags":["discovery","calorie smart","medium spice","veggie","latin-american-faves","soup-stew","customer favourite","brasiliansk","soup","cook"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Zester","Sieve","Garlic Press","Large Saucepan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R21_W06_UK_V27875-4_Main_Add_lime_zest_edit_high-72d36266.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/baiana-inspired-veggie-moqueca-soup-69307368114b735a0061b8b5","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1","Sweet Potato"],["3","Parsnip"],["1","Bell Pepper"],["3","Garlic Clove"],["1","Red Chilli"],["1","Lime"],["1 bunch","Coriander"],["1 carton","Chickpeas"],["15 g","Ginger Puree"],["1 sachet","Ground Turmeric"],["180 ml","Coconut Milk"],["15 g","Vegetable Stock Paste"],["1 tsp","Sugar"],["150 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1","Sweet Potato"],["3","Parsnip"],["1","Bell Pepper"],["3","Garlic Clove"],["1","Red Chilli"],["1","Lime"],["1 bunch","Coriander"],["1 carton","Chickpeas"],["15 g","Ginger Puree"],["1 sachet","Ground Turmeric"],["180 ml","Coconut Milk"],["15 g","Vegetable Stock Paste"],["1 tsp","Sugar"],["150 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"555082a2f8b25e56468b4568","name":"Sweet Potato","type":"sweet potato","family":"potato","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Sweet Potato","marketLabel":"sweet potatoes 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5568634a4dab71e81d8b4567","name":"Parsnip","type":"parsnip","family":"parsnip","amount":"3","sourceAmount":3,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Parsnip","marketLabel":"fresh vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632cf717b4f4bc890195c7d3","name":"Bell Pepper","type":"bell-pepper","family":"pepper","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Bell Pepper","marketLabel":"peppers pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"3","sourceAmount":3,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"597f3bd22c3e0823ee548883","name":"Red Chilli","type":"red-chilli","family":"chili","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Red Chilli","marketLabel":"red chillies x3","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6e2a4dab71a9058b4569","name":"Lime","type":"lime","family":"lime","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lime","marketLabel":"limes x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5f54fd2cb99c598b4567","name":"Coriander","type":"coriander","family":"coriander","amount":"1 bunch","sourceAmount":1,"sourceUnit":"bunch(es)","shipped":true,"shoppingName":"Coriander","marketLabel":"fresh coriander 30g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6387fd2cb99c598b4568","name":"Chickpeas","type":"organic chickpeas","family":"canned chickpeas","amount":"1 carton","sourceAmount":1,"sourceUnit":"carton(s)","shipped":true,"shoppingName":"Chickpeas","marketLabel":"chickpeas 400g, 240g drained","marketChecked":true,"priceMatchType":"source-identity"},{"id":"59f334f92c3e085ecd21b7f2","name":"Ginger Puree","type":"ginger-puree","family":"ginger","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Ginger Puree","marketLabel":"fresh ginger 100g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"57a452223933dc94258b4568","name":"Ground Turmeric","type":"ground-turmeric","family":"turmeric","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Ground Turmeric","marketLabel":"ground turmeric jar","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a62e1f8b25eef3e8b4567","name":"Coconut Milk","type":"coconut milk","family":"canned coconut milk","amount":"180 ml","sourceAmount":180,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Coconut Milk","marketLabel":"coconut milk 400ml tin","marketChecked":true,"priceMatchType":"source-identity"},{"id":"641093570565a60137055ba9","name":"Vegetable Stock Paste","type":"vegetable-stock-paste","family":"stock concentrate","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Vegetable Stock Paste","marketLabel":"vegetable stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555093924dab71e7118b4568","name":"Sugar","type":"sugar-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"150 ml","sourceAmount":150,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Chop the sweet potato into 2cm chunks (no need to peel). Trim the parsnips, then slice on a diagonal into rounds about 1cm thick (no need to peel). Pop the sweet potatoes and parsnips onto a large baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Spread out in a single layer. Use two baking trays if necessary. When the oven is hot, roast on the top shelf until golden and tender, 25-30 mins. Turn halfway through.","In the meantime, halve the bell pepper and discard the core and seeds. Chop into 2cm chunks. Peel and grate the garlic (or use a garlic press). Halve the red chilli lengthways, deseed, then finely chop. Zest and quarter the lime into wedges. Finely chop the coriander (stalks and all). Drain and rinse the chickpeas in a sieve.","Heat a drizzle of oil in a large, deep saucepan on medium heat. Once hot, add the pepper chunks and fry until softened, stirring occasionally, 8-10 mins.","Once the pepper has softened, add the garlic, ginger puree, turmeric and half the chilli (add less if you'd prefer things milder). Season with salt and pepper. Fry until fragrant, 1-2 mins. Stir in the coconut milk, vegetable stock paste, sugar and water for the sauce (use the quantities listed in the ingredients), then bring to the boil. Add the chickpeas, reduce the heat and simmer until the soup has thickened and the chickpeas are tender, 6-7 mins.","When everything's cooked, stir in the roasted veg, half the lime zest and a good squeeze of lime juice. Taste and season with more lime juice, salt and pepper if needed. Add a splash of water if it's a little thick.","Share the veggie moqueca between your bowls. Top with the coriander and remaining lime wedges for squeezing over. Sprinkle over the remaining lime zest and chilli to finish if you'd like to."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69307368114b735a0061b8b5/step-b4e5d200.jpg","caption":"Roast the Veg"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69307368114b735a0061b8b5/step-2e8a3610.jpg","caption":"Finish the Prep"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69307368114b735a0061b8b5/step-b3835620.jpg","caption":"Get Frying"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69307368114b735a0061b8b5/step-29ebe730.jpg","caption":"Build the Flavour"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69307368114b735a0061b8b5/step-359d7e40.jpg","caption":"Finishing Touches"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69307368114b735a0061b8b5/step-c211c450.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/baiana-inspired-veggie-moqueca-soup-69307368114b735a0061b8b5","rec