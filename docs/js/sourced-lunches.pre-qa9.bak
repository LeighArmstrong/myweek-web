  MW.SOURCED_LUNCHES=[{"id":"wrap-lunch","sourceId":"69badfecfff2efa4150ed4e7","title":"One Pot Creamy Leek and Bean Pesto Soup","subtitle":"with Spinach and Garlic Bread","time":25,"cost":15.54,"servings":2,"scaleSafe":true,"tags":["quick","veggie","classic-euro-dishes","soup-stew","source of fibre","low carb","european","soup"],"requiredEquipment":[],"sourceEquipment":["Garlic Press","Large Saucepan","Baking Tray","Sieve","Box Grater","Potato Masher"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R17_W07_UK_V31611-4_Main_low-35200704.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/one-pot-creamy-leek-and-butter-bean-pesto-soup-69badfecfff2efa4150ed4e7","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1","Leek"],["4","Garlic Clove"],["1","Ciabatta"],["1 carton","Mixed Beans"],["50 g","Mature Cheddar Cheese"],["15 ml","Cider Vinegar"],["15 g","Vegetable Stock Paste"],["150 g","Creme Fraiche"],["40 g","Baby Spinach"],["30 g","Basil Pesto with Cashew Nuts"],["1 sachet","Chilli Flakes"],["1 tbsp","Olive Oil for the Garlic Bread"],["1 tsp","Sugar"],["300 ml","Water for the Soup"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1","Leek"],["4","Garlic Clove"],["1","Ciabatta"],["1 carton","Mixed Beans"],["50 g","Mature Cheddar Cheese"],["15 ml","Cider Vinegar"],["15 g","Vegetable Stock Paste"],["150 g","Creme Fraiche"],["40 g","Baby Spinach"],["30 g","Basil Pesto with Cashew Nuts"],["1 sachet","Chilli Flakes"],["1 tbsp","Olive Oil for the Garlic Bread"],["1 tsp","Sugar"],["300 ml","Water for the Soup"]],"ingredientMeta":[{"id":"554a5e334dab71a9058b4567","name":"Leek","type":"leek","family":"leek","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Leek","marketLabel":"leeks 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"4","sourceAmount":4,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68371fec42dc4b928197f195","name":"Ciabatta","type":"ciabatta","family":"bread dough","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Ciabatta","marketLabel":"bread loaf","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a7056fd2cb959598b4573","name":"Mixed Beans","type":"organic mixed beans","family":"beans","amount":"1 carton","sourceAmount":1,"sourceUnit":"carton(s)","shipped":true,"shoppingName":"Mixed Beans","marketLabel":"beans equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5550e3084dab71a81c8b4569","name":"Mature Cheddar Cheese","type":"cheddar-cheese","family":"hard cheese","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Mature Cheddar Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"55b8eb44ae9270ec308b4567","name":"Cider Vinegar","type":"cider vinegar","family":"vinegar","amount":"15 ml","sourceAmount":15,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Cider Vinegar","marketLabel":"cider vinegar 350ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"641093570565a60137055ba9","name":"Vegetable Stock Paste","type":"vegetable-stock-paste","family":"stock concentrate","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Vegetable Stock Paste","marketLabel":"vegetable stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555084f34dab718e128b4569","name":"Creme Fraiche","type":"creme-fraiche","family":"soured cream","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"Creme Fraiche","marketLabel":"creme fraiche 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555c9dd5fd2cb92f6c8b4569","name":"Baby Spinach","type":"baby spinach","family":"spinach","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Spinach","marketLabel":"spinach 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68c412723cfb117858763a9f","name":"Basil Pesto with Cashew Nuts","type":"basil-pesto-sauce","family":"none","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Basil Pesto with Cashew Nuts","marketLabel":"nuts and seeds equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5fe8f8b25e1e268b4579","name":"Chilli Flakes","type":"chilli flakes","family":"spice blend","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Chilli Flakes","marketLabel":"chilli flakes 45g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"602fb8be9c479d367f798aee","name":"Olive Oil for the Garlic Bread","type":"olive-oil-for-the-garlic-bread-1-tbsp","family":"oil","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Olive Oil for the Garlic Bread","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555093924dab71e7118b4568","name":"Sugar","type":"sugar-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"63ed1e1ee1f41b99b9ea84a0","name":"Water for the Soup","type":"water-for-the-soup-100ml","family":"none","amount":"300 ml","sourceAmount":300,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Soup","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7 for the ciabatta. Trim the root and dark green leafy part from the leek and discard. Halve lengthways, then thinly slice. Peel and grate the garlic (or use a garlic press). Heat a drizzle of oil in a large saucepan on medium-high heat. Once hot, add the leek and season with salt and pepper. Cook the leek until softened, 4-6 mins, stirring occasionally.","Meanwhile, halve the ciabatta and lay onto a baking tray, cut-side up. Spread over half the garlic and drizzle with the olive oil for the garlic bread (use the quantities listed in the ingredients). Set aside. Drain and rinse the beans in a sieve. Grate the cheese.","Stir the remaining garlic and cider vinegar into the leek. Fry for 1 min. Add the sugar (use the quantities listed in the ingredients) and cook until caramelised, 1-2 mins more. Add the beans to the pan and roughly mash half of them using a potato masher or the back of a fork. Stir in the vegetable stock paste and water for the soup (use the quantities listed in the ingredients). Bring to the boil, then simmer until the sauce has thickened slightly, 4-5 mins.","Bake the garlic bread on the top shelf of your oven until golden, 4-5 mins. Meanwhile, stir the creme fraiche into the soup. Add spinach to the pan a handful at a time until wilted and piping hot, 1-2 mins.","When everything's ready, stir half the cheese into the soup. Taste the soup and season with salt and pepper if needed.","Divide the soup between your bowls. Drizzle over the pesto and top with the remaining cheese and chilli flakes (add less if you'd prefer things milder). Serve the garlic bread on the side."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69badfecfff2efa4150ed4e7/step-b9c17600.jpg","caption":"Fry the Leek"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69badfecfff2efa4150ed4e7/step-8c837210.jpg","caption":"Make the Garlic Bread"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69badfecfff2efa4150ed4e7/step-d01d1920.jpg","caption":"Stir in the Beans"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69badfecfff2efa4150ed4e7/step-2a5e1930.jpg","caption":"Simmer the Soup"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69badfecfff2efa4150ed4e7/step-adab6140.jpg","caption":"Cheese Time"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69badfecfff2efa4150ed4e7/step-581c6050.jpg","caption":"Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/one-pot-creamy-leek-and-butter-bean-pesto-soup-69badfecfff2efa4150ed4e7","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/one-pot-creamy-leek-and-butter-bean-pesto-soup-69badfecfff2efa4150ed4e7","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"soup","shoppingIngredients":[["1","Leek"],["4","Garlic Clove"],["1","Ciabatta"],["1 carton","Mixed Beans"],["50 g","Mature Cheddar Cheese"],["15 ml","Cider Vinegar"],["15 g","Vegetable Stock Paste"],["150 g","Creme Fraiche"],["40 g","Baby Spinach"],["30 g","Basil Pesto with Cashew Nuts"],["1 sachet","Chilli Flakes"],["1 tbsp","Olive Oil for the Garlic Bread"],["1 tsp","Sugar"],["300 ml","Water for the Soup"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work.","prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true},{"id":"couscous-lunch","sourceId":"69bae005d378378da7abd5fa","title":"Creamy Lemon, King Prawn and Bacon Linguine","subtitle":"with Samphire, Roasted Tomatoes, Spinach and Capers","time":25,"cost":18.28,"servings":2,"scaleSafe":true,"tags":["quick","regional-specialty","pasta-noodles","high protein","hellofresh specials","british","seafood","pasta"],"requiredEquipment":[],"sourceEquipment":["Baking Tray","Kettle","Large Saucepan","Pan","Garlic Press","Bowl","Colander"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R73_W21_UK_PR3364-17_main_high-41587b32.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/creamy-lemon-king-prawn-and-bacon-linguine-69bae005d378378da7abd5fa","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["125 g","Baby Plum Tomatoes"],["180 g","Linguine"],["80 g","Samphire"],["1","Garlic Clove"],["0.5","Lemon"],["250 g","Large King Prawns"],["60 g","British Smoked Bacon Lardons"],["150 g","Creme Fraiche"],["10 g","Vegetable Stock Paste"],["15 g","Capers**"],["100 g","Baby Spinach"],["50 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["125 g","Baby Plum Tomatoes"],["180 g","Linguine"],["80 g","Samphire"],["1","Garlic Clove"],["0.5","Lemon"],["250 g","Large King Prawns"],["60 g","British Smoked Bacon Lardons"],["150 g","Creme Fraiche"],["10 g","Vegetable Stock Paste"],["15 g","Capers**"],["100 g","Baby Spinach"],["50 ml","Water for the Sauce"]],"ingredientMeta":[{"id":"5a3cee59c2880024501f6622","name":"Baby Plum Tomatoes","type":"baby-plum-tomatoes","family":"tomato","amount":"125 g","sourceAmount":125,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Plum Tomatoes","marketLabel":"fresh fruit equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68373081d9848b9dac050010","name":"Linguine","type":"linguine","family":"other noodle","amount":"180 g","sourceAmount":180,"sourceUnit":"grams","shipped":true,"shoppingName":"Linguine","marketLabel":"pasta 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"574f0d84fd2cb99b6b8b4567","name":"Samphire","type":"samphire","family":"samphire","amount":"80 g","sourceAmount":80,"sourceUnit":"grams","shipped":true,"shoppingName":"Samphire","marketLabel":"fresh vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a72ebfd2cb95a598b4570","name":"Lemon","type":"lemon","family":"lemon","amount":"0.5","sourceAmount":0.5,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lemon","marketLabel":"lemons x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"624207fa4905355ff379039a","name":"Large King Prawns","type":"large-king-prawns","family":"seafood preparation","amount":"250 g","sourceAmount":250,"sourceUnit":"grams","shipped":true,"shoppingName":"Large King Prawns","marketLabel":"large king prawns 150g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6061f8b25ed7288b4577","name":"British Smoked Bacon Lardons","type":"pancetta","family":"pork","amount":"60 g","sourceAmount":60,"sourceUnit":"grams","shipped":true,"shoppingName":"British Smoked Bacon Lardons","marketLabel":"prepared pork product equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555084f34dab718e128b4569","name":"Creme Fraiche","type":"creme-fraiche","family":"soured cream","amount":"150 g","sourceAmount":150,"sourceUnit":"grams","shipped":true,"shoppingName":"Creme Fraiche","marketLabel":"creme fraiche 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"641093570565a60137055ba9","name":"Vegetable Stock Paste","type":"vegetable-stock-paste","family":"stock concentrate","amount":"10 g","sourceAmount":10,"sourceUnit":"grams","shipped":true,"shoppingName":"Vegetable Stock Paste","marketLabel":"vegetable stock cubes","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556812674dab71ef108b4568","name":"Capers**","type":"capers","family":"pickled","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Capers**","marketLabel":"jarred savoury ingredient equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555c9dd5fd2cb92f6c8b4569","name":"Baby Spinach","type":"baby spinach","family":"spinach","amount":"100 g","sourceAmount":100,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Spinach","marketLabel":"spinach 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb104688281450b8bd061","name":"Water for the Sauce","type":"water-for-the-sauce-100ml","family":"other drink","amount":"50 ml","sourceAmount":50,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 200°C/180°C fan/gas mark 6. Boil a full kettle. Meanwhile, pop the tomatoes onto a baking tray. Drizzle with oil and season with salt and pepper. When the oven is hot, roast on the middle shelf until they’re softened and starting to burst, 12-15 mins.","Pour the boiled water from your kettle into a large saucepan with ½ tsp salt on high heat. Add the linguine and bring back to the boil. Cook until tender, 12 mins. Add the samphire to the pan for the final 4 mins of cooking time.","bMeanwhile, peel and grate the garlic (or use a garlic press). Halve the lemon. Heat a drizzle of oil in a large frying pan on medium-high heat. Once hot, add the prawns and bacon. Cook until the bacon is golden, 4-5 mins. Add the garlic and cook for 1 min more. Wash your hands after handling raw prawns and meat. The prawns are cooked when pink on the outside and opaque in the middle. Cook bacon thoroughly.","Stir the creme fraiche, water for the sauce (use the quantities listed in the ingredients) and vegetable stock paste into the pan of prawns and bacon. Simmer until thickened, 2-3 mins. Once thickened, stir through a squeeze of lemon juice. Season to taste with salt and pepper. Add a splash of water if it's a little too thick.","Pop the roasted tomatoes into a medium bowl, stir through the capers and add a drizzle of oil, then set aside. Add the spinach to a colander, then drain the linguine and samphire into the colander on top of the spinach to wilt it. Stir the spinach, samphire and linguine into the sauce until everything's piping hot, 1-2 mins.","Taste your pasta and add another squeeze of lemon juice if needed. Cut any remaining lemon into wedges. Divide the pasta between your bowls and top with the tomatoes and capers. Serve with a lemon wedge alongside."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69bae005d378378da7abd5fa/step-a22e6c00.jpg","caption":"Roast the Tomatoes"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69bae005d378378da7abd5fa/step-ec045710.jpg","caption":"Cook the Pasta"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69bae005d378378da7abd5fa/step-a355b720.jpg","caption":"Start the Sauce"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69bae005d378378da7abd5fa/step-34d67630.jpg","caption":"Finish the Sauce"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69bae005d378378da7abd5fa/step-ba973440.jpg","caption":"Combine and Stir"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69bae005d378378da7abd5fa/step-b43d1d50.jpg","caption":"Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/creamy-lemon-king-prawn-and-bacon-linguine-69bae005d378378da7abd5fa","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/creamy-lemon-king-prawn-and-bacon-linguine-69bae005d378378da7abd5fa","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"pasta","shoppingIngredients":[["125 g","Baby Plum Tomatoes"],["180 g","Linguine"],["80 g","Samphire"],["1","Garlic Clove"],["0.5","Lemon"],["250 g","Large King Prawns"],["60 g","British Smoked Bacon Lardons"],["150 g","Creme Fraiche"],["10 g","Vegetable Stock Paste"],["15 g","Capers**"],["100 g","Baby Spinach"],["50 ml","Water for the Sauce"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"quick","light":false,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work.","prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true},{"id":"rice-bowl-lunch","sourceId":"69c2c4d1d00889bd558ce401","title":"Monkfish, Bacon and Pea Oven-Baked Risotto","subtitle":"with Rocket and Baby Plum Tomato Salad","time":40,"cost":28.99,"servings":2,"scaleSafe":true,"tags":["high protein","mediterranean","pasta-noodles","hellofresh specials","source of fibre","italian","seafood","rice","cook"],"requiredEquipment":[],"