,"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R13_W09_UK_V48355-5_Main_8_high-f53287a6.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/french-onion-style-bacon-soup-and-cheesy-ciabatta-693adbedc92924105eca72e5","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["4","Onion"],["130 g","Mature Cheddar Cheese"],["2","Garlic Clove"],["1","Apple"],["2","Ciabatta"],["15 ml","Cider Vinegar"],["28 g","Red Wine Stock Paste"],["15 g","Miso Paste"],["1 sachet","Dried Thyme"],["50 g","Baby Leaf Mix"],["20 g","Walnuts"],["90 g","British Smoked Bacon Lardons"],["30 g","Butter"],["1 tsp","Sugar for the Onions"],["1 tsp","Sugar for the Dressing"],["1 tbsp","Olive Oil for the Dressing"],["1.5 tbsp","Plain Flour"],["400 ml","Water for the Soup"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["4","Onion"],["130 g","Mature Cheddar Cheese"],["2","Garlic Clove"],["1","Apple"],["2","Ciabatta"],["15 ml","Cider Vinegar"],["28 g","Red Wine Stock Paste"],["15 g","Miso Paste"],["1 sachet","Dried Thyme"],["50 g","Baby Leaf Mix"],["20 g","Walnuts"],["90 g","British Smoked Bacon Lardons"],["30 g","Butter"],["1 tsp","Sugar for the Onions"],["1 tsp","Sugar for the Dressing"],["1 tbsp","Olive Oil for the Dressing"],["1.5 tbsp","Plain Flour"],["400 ml","Water for the Soup"]],"ingredientMeta":[{"id":"554a59324dab71626c8b4575","name":"Onion","type":"onion","family":"onion","amount":"4","sourceAmount":4,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Onion","marketLabel":"brown onions 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"69146769623e0c85b6821082","name":"Mature Cheddar Cheese","type":"cheddar-cheese","family":"hard cheese","amount":"130 g","sourceAmount":130,"sourceUnit":"grams","shipped":true,"shoppingName":"Mature Cheddar Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-