"Baking Tray","Bowl","Rolling Pin","Baking Paper","Pan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R79_W15_UK_SSF25541-13_Main_F1_high-b1e3deca.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/crispy-hoisin-chicken-tacos-and-sesame-chips-69838f85cb2a0d32532c0db1","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["450 g","Potatoes"],["5 g","Roasted White Sesame Seeds"],["2","British Chicken Breasts"],["50 g","Breadcrumbs"],["0.5","Cucumber"],["1","Baby Gem Lettuce"],["50 g","Aioli"],["30 g","Sambal Paste"],["120 g","Sliced Carrot and Cabbage Mix"],["22.5 ml","Rice Vinegar"],["80 g","Fresh Edamame Beans"],["60 g","Hoisin Sauce"],["6","Plain Taco Tortillas"],["1","Egg"],["0.25 tsp","Salt for the Breadcrumbs"],["1 tsp","Sugar for the Dressing"],["2 tbsp","Water for the Sauce"],["as needed","cooking oil"],["to taste","black pepper"]],"sourceIngredients":[["450 g","Potatoes"],["5 g","Roasted White Sesame Seeds"],["2","British Chicken Breasts"],["50 g","Breadcrumbs"],["0.5","Cucumber"],["1","Baby Gem Lettuce"],["50 g","Aioli"],["30 g","Sambal Paste"],["120 g","Sliced Carrot and Cabbage Mix"],["22.5 ml","Rice Vinegar"],["80 g","Fresh Edamame Beans"],["60 g","Hoisin Sauce"],["6","Plain Taco Tortillas"],["1","Egg"],["0.25 tsp","Salt for the Breadcrumbs"],["1 tsp","Sugar for the Dressing"],["2 tbsp","Water for the Sauce"]],"ingredientMeta":[{"id":"5a39929ec9fd0814815939c2","name":"Potatoes","type":"potatoes","family":"potato","amount":"450 g","sourceAmount":450,"sourceUnit":"grams","shipped":true,"shoppingName":"Potatoes","marketLabel":"potatoes 2kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"69bf48dde0e4e3eb76a03ea3","name":"Roasted White Sesame Seeds","type":"roasted-white-sesame-seeds","family":"sesame seed","amount":"5 g","sourceAmount":5,"sourceUnit":"grams","shipped":true,"shoppingName":"Roasted White Sesame Seeds","marketLabel":"sesame seeds 100g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5e56f8b25ed7288b4576","name":"British Chicken Breasts","type":"chicken-fillet","family":"chicken","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"British Chicken Breasts","marketLabel":"British chicken breast fillets 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68371e2f42dc4b928197f136","name":"Breadcrumbs","type":"breadcrumbs","family":"breadcrumbs","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Breadcrumbs","marketLabel":"bread loaf","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a54f4fd2cb9324b8b4573","name":"Cucumber","type":"cucumber","family":"cucumber","amount":"0.5","sourceAmount":0.5,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Cucumber","marketLabel":"cucumber","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68ecc674fa624b85e8848c26","name":"Baby Gem Lettuce","type":"baby gem lettuce","family":"salad mix","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Baby Gem Lettuce","marketLabel":"lettuce or salad leaves","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68a44d3d7e1f6c64ca674b57","name":"Aioli","type":"aioli","family":"none","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Aioli","marketLabel":"table sauce equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60accf96e728ee63dd0d01d2","name":"Sambal Paste","type":"sambal","family":"Chili sauce","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Sambal Paste","marketLabel":"cooking paste equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5be4237630006c222055d042","name":"Sliced Carrot and Cabbage Mix","type":"coleslaw-mix","family":"salad mix","amount":"120 g","sourceAmount":120,"sourceUnit":"grams","shipped":true,"shoppingName":"Sliced Carrot and Cabbage Mix","marketLabel":"carrots 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a68fa4dab71aa058b4568","name":"Rice Vinegar","type":"rice vinegar","family":"vinegar","amount":"22.5 ml","sourceAmount":22.5,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Rice Vinegar","marketLabel":"cooking vinegar equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6908bfe548e7b2ec1b0ec551","name":"Fresh Edamame Beans","type":"fresh-edamame-beans","family":"none","amount":"80 g","sourceAmount":80,"sourceUnit":"grams","shipped":true,"shoppingName":"Fresh Edamame Beans","marketLabel":"fresh green vegetable equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5568784e4dab71d51e8b4569","name":"Hoisin Sauce","type":"hoisin-sauce","family":"asian paste","amount":"60 g","sourceAmount":60,"sourceUnit":"grams","shipped":true,"shoppingName":"Hoisin Sauce","marketLabel":"Asian cooking sauce equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"683727bfd9848b9dac04fe03","name":"Plain Taco Tortillas","type":"plain-taco-tortilla","family":"none","amount":"6","sourceAmount":6,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Plain Taco Tortillas","marketLabel":"wraps or tortillas x8","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fc0f772688281450b8bd085","name":"Egg","type":"egg","family":"egg","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":false,"shoppingName":"Egg","marketLabel":"medium eggs x12","marketChecked":true,"priceMatchType":"source-identity"},{"id":"627c173e7497c13c5c9b98a0","name":"Salt for the Breadcrumbs","type":"salt-for-the-breadcrumbs","family":"single spice","amount":"0.25 tsp","sourceAmount":0.25,"sourceUnit":"tsp","shipped":false,"shoppingName":"Salt for the Breadcrumbs","marketLabel":"table salt 750g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb425688281450b8bd079","name":"Sugar for the Dressing","type":"sugar-for-the-dressing-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar for the Dressing","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60b8a3c08b148d1530c49fb7","name":"Water for the Sauce","type":"water-for-the-sauce","family":"other drink","amount":"2 tbsp","sourceAmount":2,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Water for the Sauce","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Chop the potatoes lengthways into 1cm slices, then chop into 1cm wide chips (no need to peel). Pop the chips onto a large baking tray. Drizzle with oil, sprinkle over the sesame seeds, season with salt and pepper, then toss to coat. Spread out in a single layer. Use two baking trays if necessary. When the oven is hot, bake on the top shelf until golden, 25-30 mins. Turn halfway through.","Meanwhile, sandwich each chicken breast between two pieces of baking paper. Pop onto a board, then give it a bash with a rolling pin or the bottom of a saucepan until it’s 1-2cm thick. Season with salt and pepper. Notice a stronger smell from your chicken? Don’t worry, this is normal due to packaging we use to keep it fresh. Crack the egg (use the quantities listed in the ingredients) into a medium bowl and whisk. Put the breadcrumbs into another bowl, season with the salt (use the quantities listed in the ingredients) and pepper. Dip the chicken into the egg and then the breadcrumbs, ensuring it's completely coated. Transfer to a clean plate. Wash your hands and equipment after handling raw chicken and discard any excess egg.","Pop a large frying pan on high heat and add enough oil to coat the bottom of the pan. You want the oil to be hot so the chicken fries properly - heat for 2-3 mins before you add the chicken. Once hot, carefully lay the chicken into the pan and fry until golden brown, 2-3 mins on each side. Adjust the heat if necessary. Transfer the chicken to a baking tray and bake on the middle shelf of your oven until cooked through, 8-10 mins. The chicken is cooked when no longer pink in the middle.","Meanwhile, trim the cucumber (use the amount listed in the ingredients), then pop onto a board and use a rolling pin to gently smack it a few times until split. Cut into roughly 2cm chunks. Trim the baby gem, halve lengthways, then thinly slice. In a large bowl, combine the aioli and half the sambal. Season with salt and pepper, then stir through the coleslaw mix. Set aside for now. In a medium bowl, combine the rice vinegar, remaining sambal and the sugar for the dressing (use the quantities listed in the ingredients). Season with salt and pepper. Stir in the smacked cucumber and edamame beans, then set aside for now.","Give the frying pan a quick clean. Just before everything's ready, return the frying pan to medium-high heat (no oil). Add the hoisin sauce and water for the sauce (use the quantities listed in the ingredients). Stir well, then bring to a simmer and heat through until piping hot, 1-2 mins. Meanwhile, pop the tortillas (3 per person) into the oven to warm through, 1-2 mins. Stir the baby gem into the bowl of sambal slaw and toss to coat.","Share the tortillas between your plates. Load on the sambal baby gem slaw, then top with the crispy chicken. Finish by spooning over the hoisin sauce. Serve the sesame chips and the smacked cucumber and edamame bean salad alongside."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f85cb2a0d32532c0db1/step-9a11e200.jpg","caption":"Chip, Chip, Hooray"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f85cb2a0d32532c0db1/step-0e01aa10.jpg","caption":"Bread the Chicken"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f85cb2a0d32532c0db1/step-9bae8a20.jpg","caption":"Time to Fry"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f85cb2a0d32532c0db1/step-e326dd30.jpg","caption":"Mix Things Up"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f85cb2a0d32532c0db1/step-f433d040.jpg","caption":"Finishing Touches"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f85cb2a0d32532c0db1/step-6d118b50.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/crispy-hoisin-chicken-tacos-and-sesame-chips-69838f85cb2a0d32532c0db1","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/crispy-hoisin-chicken-tacos-and-sesame-chips-69838f85cb2a0d32532c0db1","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"wrap","shoppingIngredients":[["450 g","Potatoes"],["5 g","Roasted White Sesame Seeds"],["2","British Chicken Breasts"],["50 g","Breadcrumbs"],["0.5","Cucumber"],["1","Baby Gem Lettuce"],["50 g","Aioli"],["30 g","Sambal Paste"],["120 g","Sliced Carrot and Cabbage Mix"],["22.5 ml","Rice Vinegar"],["80 g","Fresh Edamame Beans"],["60 g","Hoisin Sauce"],["6","Plain Taco Tortillas"],["1","Egg"],["0.25 tsp","Salt for the Breadcrumbs"],["1 tsp","Sugar for the Dressing"],["2 tbsp","Water for the Sauce"],["as needed","cooking oil"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work.","prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true},{"id":"black-bean-rice-lunch","sourceId":"69838f6acb2a0d32532c0d3e","title":"Sicilian Inspired Tuna and Ditali Pasta Salad","subtitle":"with Tomatoes, Bell Pepper and Lemon-Caper Dressing","time":35,"cost":14.44,"servings":2,"scaleSafe":true,"tags":["calorie smart","pescatarian","classic-euro-dishes","dinner-bowls","high protein","healthy options","low carb","european","seafood","salad","cook"],"requiredEquipment":[],"sourceEquipment":["Kettle","Colander","Large Saucepan","Baking Tray","Aluminum Foil","Bowl","Large Frying Pan"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R12_W35_UK_R34493-6_Main_R34493-1_var__high-436e1b8d.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/sicilian-inspired-tuna-and-ditali-pasta-salad-69838f6acb2a0d32532c0d3e","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["90 g","Ditali Pasta"],["3","Garlic Clove"],["1","Bell Pepper"],["2","Medium Tomato"],["1","Lemon"],["15 g","Capers**"],["25 g","Sun-Dried Tomato Paste"],["1","Courgette"],["1 tin","Skipjack Tuna in Water"],["50 g","Greek Style Salad Cheese"],["1 tbsp","Honey"],["2 tbsp","Olive Oil for the Dressing"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["90 g","Ditali Pasta"],["3","Garlic Clove"],["1","Bell Pepper"],["2","Medium Tomato"],["1","Lemon"],["15 g","Capers**"],["25 g","Sun-Dried Tomato Paste"],["1","Courgette"],["1 tin","Skipjack Tuna in Water"],["50 g","Greek Style Salad Cheese"],["1 tbsp","Honey"],["2 tbsp","Olive Oil for the Dressing"]],"ingredientMeta":[{"id":"68371e82d9848b9dac04fc52","name":"Ditali Pasta","type":"ditali-pasta","family":"none","amount":"90 g","sourceAmount":90,"sourceUnit":"grams","shipped":true,"shoppingName":"Ditali Pasta","marketLabel":"pasta 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"3","sourceAmount":3,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"632cf717b4f4bc890195c7d3","name":"Bell Pepper","type":"bell-pepper","family":"pepper","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Bell Pepper","marketLabel":"peppers pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"60070aba8e7046341a491fcb","name":"Medium Tomato","type":"medium-tomato","family":"tomato","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Medium Tomato","marketLabel":"tomatoes pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a72ebfd2cb95a598b4570","name":"Lemon","type":"lemon","family":"lemon","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Lemon","marketLabel":"lemons x4","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556812674dab71ef108b4568","name":"Capers**","type":"capers","family":"pickled","amount":"15 g","sourceAmount":15,"sourceUnit":"grams","shipped":true,"shoppingName":"Capers**","marketLabel":"jarred savoury ingredient equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5f327c6560efd3453038c2a8","name":"Sun-Dried Tomato Paste","type":"sundried-tomato-paste-duplicate","family":"single ingredient paste","amount":"25 g","sourceAmount":25,"sourceUnit":"grams","shipped":true,"shoppingName":"Sun-Dried Tomato Paste","marketLabel":"sun-dried tomato paste","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a727dfd2cb959598b4574","name":"Courgette","type":"courgette","family":"zucchini","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Courgette","marketLabel":"courgettes pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"66e4649086402bd101d35b2e","name":"Skipjack Tuna in Water","type":"skipjack-tuna-in-water","family":"none","amount":"1 tin","sourceAmount":1,"sourceUnit":"tin(s)","shipped":true,"shoppingName":"Skipjack Tuna in Water","marketLabel":"tuna tin","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6764b4a77de812ab26271141","name":"Greek Style Salad Cheese","type":"greek-style-cheese","family":"none","amount":"50 g","sourceAmount":50,"sourceUnit":"grams","shipped":true,"shoppingName":"Greek Style Salad Cheese","marketLabel":"feta 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6172cb313021d49a7feafc84","name":"Honey","type":"honey-1-tbsp","family":"honey","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb168688281450b8bd062","name":"Olive Oil for the Dressing","type":"olive-oil-for-the-dressing-1-tbsp","family":"oil","amount":"2 tbsp","sourceAmount":2,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Olive Oil for the Dressing","marketLabel":"cooking oil 1 litre","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Boil a full kettle. Pour the boiled water into a large saucepan with ½ tsp salt on high heat. Add the ditali pasta and bring back to the boil. Cook until tender, 10 mins. Once cooked, drain in a colander, rinse with cold water and pop back in the pan. Drizzle with oil and stir through to stop it sticking together.","Meanwhile, pop the garlic (unpeeled) into a small piece of foil with a drizzle of oil and scrunch to enclose it. When the oven is hot, roast the parcel until soft, 10-12 mins. Halve the bell pepper and discard the core and seeds. Chop into 2-3cm chunks. Put the pepper onto a baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Roast on the top shelf until soft and slightly charred, 14-16 mins.","Meanwhile, cut the tomatoes into 1-2cm chunks. Halve the lemon. Roughly chop the capers into small pieces. In a large bowl, combine the sun-dried tomato paste, honey and olive oil for the dressing (use the quantities listed in the ingredients) with half the lemon juice. Stir in the tomatoes and capers, then season with salt and pepper. Once the garlic has cooled, cut the end with scissors, squeeze it out of the skin and mash with a fork. Add the garlic to the bowl of tomatoes. Stir well to combine and set aside.","Trim the courgette and slice into 1cm thick rounds. Heat a drizzle of oil in a large frying pan on high heat. When hot, add the courgette and cook until charred, 3-4 mins each side. Once cooked, season with salt and pepper, then remove from the heat. Meanwhile, drain the tuna.","Add the cooked pasta, roasted pepper, courgette and tuna to the bowl of tomatoes. Stir well to coat everything in the dressing. Taste the salad and season with salt and pepper if needed.","Share the pasta salad between your bowls. Crumble over the Greek style salad cheese. Serve with any remaining lemon wedges for squeezing over to finish."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f6acb2a0d32532c0d3e/step-b2b9ff00.jpg","caption":"Boil the Pasta"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f6acb2a0d32532c0d3e/step-503bd110.jpg","caption":"Roast the Veg"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f6acb2a0d32532c0d3e/step-61c3f320.jpg","caption":"Macerate the Tomatoes"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f6acb2a0d32532c0d3e/step-7a25ab30.jpg","caption":"Char the Courgette"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f6acb2a0d32532c0d3e/step-97bdfc40.jpg","caption":"Toss the Salad"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f6acb2a0d32532c0d3e/step-fba9cf50.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/sicilian-inspired-tuna-and-ditali-pasta-salad-69838f6acb2a0d32532c0d3e","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/sicilian-inspired-tuna-and-ditali-pasta-salad-69838f6acb2a0d32532c0d3e","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"salad","shoppingIngredients":[["90 g","Ditali Pasta"],["3","Garlic Clove"],["1","Bell Pepper"],["2","Medium Tomato"],["1","Lemon"],["15 g","Capers**"],["25 g","Sun-Dried Tomato Paste"],["1","Courgette"],["1 tin","Skipjack Tuna in Water"],["50 g","Greek Style Salad Cheese"],["1 tbsp","Honey"],["2 tbsp","Olive Oil for the Dressing"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":true,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work.","prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true},{"id":"harissa-chickpea-couscous-lunch","sourceId":"69838f46a9a0ce52d27f07d7","title":"Oven-Baked Bacon, Butternut and Pea Risotto","subtitle":"with Onion and Pesto","time":40,"cost":22.58,"servings":2,"scaleSafe":true,"tags":["prepped in 10","family friendly","italian","pork","rice","cook"],"requiredEquipment":[],"sourceEquipment":["Kettle","Large Oven-Proof Pan","Garlic Press"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y26_R31_W15_UK_R16041-30_Main_high-e7519df9.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/oven-baked-bacon-butternut-and-pea-risotto-69838f46a9a0ce52d27f07d7","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["300 g","Diced Butternut Squash"],["1","Onion"],["90 g","British Smoked Bacon Lardons"],["2","Garlic Clove"],["175 g","Risotto Rice"],["1 sachet","White Wine Stock Powder"],["1 sachet","Mixed Herbs"],["120 g","Peas"],["30 g","Basil Pesto with Cashew Nuts"],["20 g","Grated Hard Italian Style Cheese"],["1 tsp","Sugar"],["600 ml","Boiled Water for the Risotto"],["20 g","Butter"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["300 g","Diced Butternut Squash"],["1","Onion"],["90 g","British Smoked Bacon Lardons"],["2","Garlic Clove"],["175 g","Risotto Rice"],["1 sachet","White Wine Stock Powder"],["1 sachet","Mixed Herbs"],["120 g","Peas"],["30 g","Basil Pesto with Cashew Nuts"],["20 g","Grated Hard Italian Style Cheese"],["1 tsp","Sugar"],["600 ml","Boiled Water for the Risotto"],["20 g","Butter"]],"ingredientMeta":[{"id":"6390aea6da082ea161fce4e7","name":"Diced Butternut Squash","type":"butternut-squash-diced","family":"none","amount":"300 g","sourceAmount":300,"sourceUnit":"grams","shipped":true,"shoppingName":"Diced Butternut Squash","marketLabel":"butternut squash","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a59324dab71626c8b4575","name":"Onion","type":"onion","family":"onion","amount":"1","sourceAmount":1,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Onion","marketLabel":"brown onions 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a6061f8b25ed7288b4577","name":"British Smoked Bacon Lardons","type":"pancetta","family":"pork","amount":"90 g","sourceAmount":90,"sourceUnit":"grams","shipped":true,"shoppingName":"British Smoked Bacon Lardons","marketLabel":"prepared pork product equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"58f11054d56afa789e7f2b22","name":"Garlic Clove","type":"garlic-clove","family":"garlic","amount":"2","sourceAmount":2,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Garlic Clove","marketLabel":"garlic bulbs equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a5992fd2cb95a598b456a","name":"Risotto Rice","type":"risotto-rice","family":"rice","amount":"175 g","sourceAmount":175,"sourceUnit":"grams","shipped":true,"shoppingName":"Risotto Rice","marketLabel":"risotto rice 500g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"691c9f53bc8059f9ea10a506","name":"White Wine Stock Powder","type":"white-wine-stock-powder","family":"none","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"White Wine Stock Powder","marketLabel":"vegetable stock concentrate equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"633c6597aa3f33c15c854bb0","name":"Mixed Herbs","type":"mixed-herbs","family":"none","amount":"1 sachet","sourceAmount":1,"sourceUnit":"sachet(s)","shipped":true,"shoppingName":"Mixed Herbs","marketLabel":"dried herbs jar","marketChecked":true,"priceMatchType":"source-identity"},{"id":"556d6384fd2cb954078b4567","name":"Peas","type":"peas","family":"peas","amount":"120 g","sourceAmount":120,"sourceUnit":"grams","shipped":true,"shoppingName":"Peas","marketLabel":"garden peas 910g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68c412723cfb117858763a9f","name":"Basil Pesto with Cashew Nuts","type":"basil-pesto-sauce","family":"none","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Basil Pesto with Cashew Nuts","marketLabel":"nuts and seeds equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5550865efd2cb974658b4568","name":"Grated Hard Italian Style Cheese","type":"grated-hard-italian-style-cheese-duplicate","family":"hard cheese","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Grated Hard Italian Style Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555093924dab71e7118b4568","name":"Sugar","type":"sugar-1-tsp","family":"single spice","amount":"1 tsp","sourceAmount":1,"sourceUnit":"tsp","shipped":false,"shoppingName":"Sugar","marketLabel":"granulated sugar 1kg","marketChecked":true,"priceMatchType":"source-identity"},{"id":"61f968097f9b41760f4d2295","name":"Boiled Water for the Risotto","type":"boiled-water-for-the-risotto-100ml","family":"other drink","amount":"600 ml","sourceAmount":600,"sourceUnit":"milliliter(s)","shipped":false,"shoppingName":"Boiled Water for the Risotto","marketLabel":"tap water","marketChecked":false,"priceMatchType":"source-identity"},{"id":"60c73507053f5e815cd52d5b","name":"Butter","type":"butter-100g","family":"butter","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":false,"shoppingName":"Butter","marketLabel":"butter 500g","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Pop the diced butternut squash onto a large baking tray. Drizzle with oil, season with salt and pepper, then toss to coat. Spread them out in a single layer. When the oven is hot, roast on the top shelf until soft and golden, 20-30 mins. Turn halfway through. Meanwhile, boil a full kettle. Halve, peel and chop the onion into small pieces.","Heat a drizzle of oil in a large, wide-bottomed ovenproof pan on medium heat. If you don't have an ovenproof pan, use a normal pan and transfer to an ovenproof dish before baking. Once hot, add the onion, season with salt and pepper and fry, stirring occasionally, until golden and softened, 8-10 mins. Add the sugar (use the quantities listed in the ingredients) and cook until caramelised, 1-2 mins more. If you prefer hob cooking your risotto, just use a normal pan.","When the onion is halfway through cooking, add the bacon lardons to the same pan. Fry, stirring occasionally, until golden, 4-5 mins. Wash your hands and equipment after handling raw meat. Cook bacon thoroughly. Meanwhile, peel and grate the garlic (or use a garlic press). Once the bacon has cooked, add the garlic to the pan and cook for 30 secs.","Add the risotto rice to the bacon and onion. Stir and cook until the edges of the rice are translucent, 1-2 mins. Stir in the white wine stock powder, mixed herbs and boiled water for the risotto (use the quantities listed in the ingredients). Season with salt and pepper. Bring back up to the boil, then pop a lid on the pan (or cover with foil) and bake on the middle shelf of your oven until the rice is cooked and the water has been absorbed, 25-30 mins. For hob cooking, pour in 2p: 800ml, 3p: 1200ml, 4p: 1600ml of boiled water a third at a time, stirring each time until the stock has been absorbed, 20-25 mins.","When the risotto is cooked, remove it from the oven, then stir in the peas until piping hot, 1-2 mins. Mix the pesto, hard Italian style cheese and butter (use the quantities listed in the ingredients) into the risotto until melted and well combined. Stir in the roasted butternut squash. Taste and season with salt and pepper if needed. Add a splash of water to loosen the risotto to your desired consistency.","Share the bacon, butternut and pea risotto between your bowls."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f46a9a0ce52d27f07d7/step-9d009f00.jpg","caption":"Add the Veg"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f46a9a0ce52d27f07d7/step-f20fbc10.jpg","caption":"Fry the Onion"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f46a9a0ce52d27f07d7/step-df806b20.jpg","caption":"Add the Bacon"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f46a9a0ce52d27f07d7/step-fce87530.jpg","caption":"Bake your Risotto"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f46a9a0ce52d27f07d7/step-3d641a40.jpg","caption":"Hey Pesto"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f46a9a0ce52d27f07d7/step-eeed2350.jpg","caption":"Serve Up"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/oven-baked-bacon-butternut-and-pea-risotto-69838f46a9a0ce52d27f07d7","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/oven-baked-bacon-butternut-and-pea-risotto-69838f46a9a0ce52d27f07d7","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app display, pantry visibility and supermarket planning.","sourcedCatalogue":true,"catalogueVersion":"0.31-source-lunch-240","lunchBucket":"rice","shoppingIngredients":[["300 g","Diced Butternut Squash"],["1","Onion"],["90 g","British Smoked Bacon Lardons"],["2","Garlic Clove"],["175 g","Risotto Rice"],["1 sachet","White Wine Stock Powder"],["1 sachet","Mixed Herbs"],["120 g","Peas"],["30 g","Basil Pesto with Cashew Nuts"],["20 g","Grated Hard Italian Style Cheese"],["1 tsp","Sugar"],["600 ml","Boiled Water for the Risotto"],["20 g","Butter"],["as needed","cooking oil"],["to taste","salt"],["to taste","black pepper"]],"isLunch":true,"prepStyle":"cook","light":false,"imageQa":{"status":"verified","reason":"Exact finished-dish photograph declared by the published recipe source."},"methodProvenance":"Published HelloFresh UK recipe retained as the cooking source.","preparationNote":"Prepare and cook this lunch at home. My Week scales it automatically to the lunch days and people selected for this week.","storageNote":"Cook fully at home, cool promptly and refrigerate within 1 to 2 hours. At work, eat cold where appropriate or reheat once in a microwave until steaming hot. No hob, oven, grill, toaster or sandwich press is assumed at work.","prepLocation":"home","workplaceEquipment":["microwave","kettle"],"workplaceReady":true},{"id":"lemon-feta-couscous-lunch","sourceId":"69838f3aa9a0ce52d27f078f","title":"Cheesy Chipotle Bean Quesadillas","subtitle":"with Tomato & Rocket Salad and Soured Cream","time":25,"cost":17.97,"servings":2,"scaleSafe":true,"tags":["quick","medium spice","veggie","ineligible-reco","latin-american-faves","handhelds","low carb","mexican","handheld","wrap"],"requiredEquipment":[],"sourceEquipment":["Bowl","Sieve","Grater","Potato Masher","Baking Tray"],"image":"","sourceImageUrl":"https://d3hvwccx09j84u.cloudfront.net/0,0/image/HF_Y25_R26_W25_UK_QR2692-83_Main_high-a7cfce9e.jpg","imageSource":"https://www.hellofresh.co.uk/recipes/cheesy-chipotle-bean-quesadillas-69838f3aa9a0ce52d27f078f","imageLicense":"Recipe source image","imageProvenance":"Exact finished-dish photograph from the published HelloFresh UK recipe","ingredients":[["1 carton","Mixed Beans"],["80 g","Mature Cheddar Cheese"],["20 g","Chipotle Paste"],["26 g","Smoky Base Paste"],["30 g","Tomato Puree"],["4","Super Soft Tortillas with Whole Wheat"],["125 g","Baby Plum Tomatoes"],["12 ml","Balsamic Vinegar"],["40 g","Wild Rocket"],["75 g","Soured Cream"],["1 tbsp","Honey"],["0.5 tbsp","Olive Oil for the Dressing"],["to taste","salt"],["to taste","black pepper"]],"sourceIngredients":[["1 carton","Mixed Beans"],["80 g","Mature Cheddar Cheese"],["20 g","Chipotle Paste"],["26 g","Smoky Base Paste"],["30 g","Tomato Puree"],["4","Super Soft Tortillas with Whole Wheat"],["125 g","Baby Plum Tomatoes"],["12 ml","Balsamic Vinegar"],["40 g","Wild Rocket"],["75 g","Soured Cream"],["1 tbsp","Honey"],["0.5 tbsp","Olive Oil for the Dressing"]],"ingredientMeta":[{"id":"554a7056fd2cb959598b4573","name":"Mixed Beans","type":"organic mixed beans","family":"beans","amount":"1 carton","sourceAmount":1,"sourceUnit":"carton(s)","shipped":true,"shoppingName":"Mixed Beans","marketLabel":"beans equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"69146769623e0c85b6821082","name":"Mature Cheddar Cheese","type":"cheddar-cheese","family":"hard cheese","amount":"80 g","sourceAmount":80,"sourceUnit":"grams","shipped":true,"shoppingName":"Mature Cheddar Cheese","marketLabel":"cheese pack","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a70affd2cb95a598b456f","name":"Chipotle Paste","type":"chipotle paste","family":"Chili sauce","amount":"20 g","sourceAmount":20,"sourceUnit":"grams","shipped":true,"shoppingName":"Chipotle Paste","marketLabel":"cooking paste equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6489bd550635a1e9befbb46e","name":"Smoky Base Paste","type":"smokey-base-paste","family":"none","amount":"26 g","sourceAmount":26,"sourceUnit":"grams","shipped":true,"shoppingName":"Smoky Base Paste","marketLabel":"cooking paste equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"554a708af8b25ef93e8b4567","name":"Tomato Puree","type":"tomato-puree","family":"single ingredient paste","amount":"30 g","sourceAmount":30,"sourceUnit":"grams","shipped":true,"shoppingName":"Tomato Puree","marketLabel":"tomato puree 200g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6837abf9f7d5496ac4a6808b","name":"Super Soft Tortillas with Whole Wheat","type":"wholemeal-tortilla","family":"bread dough","amount":"4","sourceAmount":4.002,"sourceUnit":"unit(s)","shipped":true,"shoppingName":"Super Soft Tortillas with Whole Wheat","marketLabel":"bread loaf","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5a3cee59c2880024501f6622","name":"Baby Plum Tomatoes","type":"baby-plum-tomatoes","family":"tomato","amount":"125 g","sourceAmount":125,"sourceUnit":"grams","shipped":true,"shoppingName":"Baby Plum Tomatoes","marketLabel":"fresh fruit equivalent","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5550927ef8b25e4d4c8b456c","name":"Balsamic Vinegar","type":"balsamic vinegar","family":"vinegar","amount":"12 ml","sourceAmount":12,"sourceUnit":"milliliter(s)","shipped":true,"shoppingName":"Balsamic Vinegar","marketLabel":"balsamic vinegar 250ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"555092a4f8b25ed3468b4569","name":"Wild Rocket","type":"rocket","family":"salad mix","amount":"40 g","sourceAmount":40,"sourceUnit":"grams","shipped":true,"shoppingName":"Wild Rocket","marketLabel":"rocket 60g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"68382535f7d5496ac4a6a740","name":"Soured Cream","type":"soured-cream","family":"soured cream","amount":"75 g","sourceAmount":75,"sourceUnit":"grams","shipped":true,"shoppingName":"Soured Cream","marketLabel":"soured cream 300ml","marketChecked":true,"priceMatchType":"source-identity"},{"id":"6172cb313021d49a7feafc84","name":"Honey","type":"honey-1-tbsp","family":"honey","amount":"1 tbsp","sourceAmount":1,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Honey","marketLabel":"runny honey 340g","marketChecked":true,"priceMatchType":"source-identity"},{"id":"5fbeb168688281450b8bd062","name":"Olive Oil for the Dressing","type":"olive-oil-for-the-dressing-1-tbsp","family":"oil","amount":"0.5 tbsp","sourceAmount":0.5,"sourceUnit":"tbsp","shipped":false,"shoppingName":"Olive Oil for the Dressing","marketLabel":"cooking oil 1 litre","marketChecked":true,"priceMatchType":"source-identity"}],"steps":["Preheat your oven to 220°C/200°C fan/gas mark 7. Drain and rinse the mixed beans in a sieve. Pop into a bowl and roughly mash with the back of a fork or a potato masher. Grate the Cheddar cheese.","Add the cheese, chipotle paste (add less if you'd prefer things milder), smoky base paste, tomato puree and honey (use the quantities listed in the ingredients) to the beans. Season with salt and pepper and mix together.","Lay the tortillas (2 per person) onto a lightly oiled baking tray and spoon the bean mixture onto one half of each one. Fold the other side of the tortilla over to make a semi-circle. Press down to keep together.","Rub a little oil over the top of each quesadilla. Bake on the top shelf of your oven until golden, 8-12 mins.","Meanwhile, halve the baby plum tomatoes. In a large bowl, mix together the balsamic vinegar and olive oil for the dressing (use the quantities listed in the ingredients). Season with salt and pepper, then add the tomatoes to the dressing and set aside.","When the quesadillas are ready, share between your plates. Add the rocket to the tomato bowl and toss together. Serve your cheesy chipotle quesadillas with the salad and a dollop of soured cream."],"sourceStepImages":[{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f3aa9a0ce52d27f078f/step-3ebb3100.jpg","caption":"Get Prepped"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f3aa9a0ce52d27f078f/step-3211cf10.jpg","caption":"Mix the Bean Filling"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f3aa9a0ce52d27f078f/step-c67ec720.jpg","caption":"Make your Quesadillas"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f3aa9a0ce52d27f078f/step-fb0c2e30.jpg","caption":"Time to Bake"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f3aa9a0ce52d27f078f/step-b0541940.jpg","caption":"Prep the Rest"},{"src":"https://d3hvwccx09j84u.cloudfront.net/0,0/69838f3aa9a0ce52d27f078f/step-fb011850.jpg","caption":"Finish and Serve"}],"sourceStepIngredientIds":[[],[],[],[],[],[]],"source":"HelloFresh UK","sourceUrl":"https://www.hellofresh.co.uk/recipes/cheesy-chipotle-bean-quesadillas-69838f3aa9a0ce52d27f078f","recipeSource":"HelloFresh UK","recipeSourceUrl":"https://www.hellofresh.co.uk/recipes/cheesy-chipotle-bean-quesadillas-69838f3aa9a0ce52d27f078f","recipeProvenance":"Published HelloFresh UK recipe retained as the cooking source; My Week normalisation is limited to app 